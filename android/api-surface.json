{
  "_": [
    "The dashboard's API as the companion app calls it: every path, the",
    "method, and the fields the app reads from the answer. test/appapi.mjs",
    "holds the running dashboard to this file, so a change that renames a",
    "field or a path the app reads fails the suite until the app is updated",
    "with it; and `api` here is the number server.py's APP_API and the app's",
    "TARGET_API both carry. Move all three together. A field listed is one",
    "the app draws or acts on; the app tolerates an extra one and blanks a",
    "missing one, so this is the contract, not the whole answer.",
    "types pins each field's type as the app reads it (R79 step 8; the language is",
    "scripts/dashboard/test/device-api.json's), a row's as LIST[].FIELD: a field",
    "whose type changes fails as one gone does. Adding a field is always allowed; a",
    "field or path may be removed only in the release after the app stopped reading",
    "it, with this file updated in the same change as the removal and a changelog",
    "line saying which app releases it leaves behind."
  ],
  "api": 9,
  "endpoints": [
    {"method": "GET", "path": "/api/meta", "fields": ["api", "version", "apk", "apk_sha256", "apk_url"]},
    {"method": "GET", "path": "/api/status", "fields": ["me", "can", "image", "host", "projects", "attention", "phone_asks", "welcome",
                                                       "sessions", "tmux_prefix", "doctor", "invites", "claude_auth", "agent_auth", "boot"],
     "invites": ["id", "project", "by", "kind"],
     "projects": ["name", "label", "git", "locked", "pending", "roadmap", "bugs", "session_at", "pinned", "prefs", "issues", "testing",
                  "archived", "locked_admin", "locked_me", "may_lock", "may_archive", "owner_mine", "owner_name", "session_node",
                  "session_nodes", "session_why", "last_claude", "last_agents", "yours", "brief", "mine", "session_boot"],
     "sessions": ["name"],
     "attention": ["kind", "node", "id", "from", "to", "window", "projects", "tools"],
     "can": ["admin"]},
    {"method": "GET", "path": "/api/phone", "fields": ["nodes", "asks"],
     "nodes": ["id", "name", "live", "phone", "owner", "mine", "lease", "lendable", "trust"],
     "asks": ["id", "kind", "why", "cmd", "project", "node", "node_name", "asker", "left", "detail", "env_keys", "name", "for"]},
    {"method": "GET", "path": "/api/phone/wait", "fields": ["token"]},
    {"method": "POST", "path": "/api/phone", "actions": ["allow", "deny", "pair", "connect", "lend", "take-back", "untrust", "disconnect"]},
    {"method": "GET", "path": "/api/pending?project=", "fields": ["pending", "counts", "gate"],
     "pending": ["id", "kind", "verb", "summary", "by", "settled"]},
    {"method": "POST", "path": "/api/pending", "actions": ["approve", "deny"]},
    {"method": "GET", "path": "/api/roadmap?project=", "fields": ["items", "rev", "session"],
     "items": ["id", "text", "steps", "shelved", "info"]},
    {"method": "POST", "path": "/api/roadmap", "actions": ["add", "shelve", "remove", "send"]},
    {"method": "GET", "path": "/api/bugs?project=", "fields": ["bugs"],
     "bugs": ["id", "title", "severity", "status", "area"]},
    {"method": "POST", "path": "/api/bugs", "actions": ["add", "status", "send"]},
    {"method": "GET", "path": "/api/rules?project=", "fields": ["rules", "standing", "conditional", "global"],
     "rules": ["name", "text", "files", "words"],
     "global": ["name", "text", "disabled", "off_here"]},
    {"method": "GET", "path": "/api/wiki?project=", "fields": ["pages", "rev"],
     "pages": ["name", "title", "by"]},
    {"method": "POST", "path": "/api/members", "actions": ["accept", "decline"]},
    {"method": "GET", "path": "/api/memory?project=", "fields": ["memories", "project"],
     "memories": ["name", "description", "type", "when"]},
    {"method": "GET", "path": "/api/artifacts?project=", "fields": ["artifacts", "build", "captures"],
     "artifacts": ["name", "path", "size"],
     "captures": ["name", "path", "kind"]},
    {"method": "GET", "path": "/api/version?project=", "fields": ["forms", "policy", "released", "dirty", "unreleased", "tag", "warn"]},
    {"method": "GET", "path": "/api/design?project=", "fields": ["language", "pages", "presets"],
     "pages": ["name", "platform", "frame", "blocks", "notes", "rules"]},
    {"method": "GET", "path": "/api/docker?project=", "fields": ["instances", "error"],
     "instances": ["project", "instance", "name", "owner", "running", "exists", "services", "ports", "built_rev", "route"]},
    {"method": "POST", "path": "/api/devapp", "actions": ["up", "down", "rebuild"]},
    {"method": "GET", "path": "/api/tests?project=", "fields": ["n", "total_ms", "last_wall_ms", "suspect", "undocumented", "suites"],
     "suites": ["suite", "n", "ms", "suspect", "fail"]},
    {"method": "GET", "path": "/api/transcripts?project=", "fields": ["rows"],
     "rows": ["project", "id", "at", "bytes", "first", "agent", "shared"]},
    {"method": "GET", "path": "/api/transcript?project=&id=&tz=", "needs": "a conversation's id, which test/transcripts.mjs makes and asks with"},
    {"method": "POST", "path": "/api/say", "actions": ["(a line, into the account's own session)"]},
    {"method": "GET", "path": "/api/artifact?project=&path=", "binary": true},
    {"method": "GET", "path": "/api/git?project=&what=status", "fields": ["branch", "upstream", "ahead", "behind", "files"]},
    {"method": "POST", "path": "/api/git", "actions": ["fetch", "pull", "push"]},
    {"method": "GET", "path": "/api/v1/nodes", "fields": ["nodes", "agent"],
     "nodes": ["id", "name", "state", "kind", "live", "config", "reported"]},
    {"method": "POST", "path": "/api/v1/nodes", "actions": ["lock", "unlock", "drain", "online"]},
    {"method": "GET", "path": "/api/v1/jobs", "fields": ["jobs"],
     "jobs": ["id", "type", "project", "state", "node", "exit_code", "queued", "started", "ended", "step", "error"]},
    {"method": "GET", "path": "/api/welcome", "fields": ["sections"],
     "sections": ["title", "entries"]},
    {"method": "GET", "path": "/api/toolchains?node=", "fields": ["items", "job", "root", "shared"],
     "items": ["name", "label", "about", "installed", "version", "size", "needs", "updatable"]},
    {"method": "POST", "path": "/api/toolchains", "actions": ["install", "remove"]},
    {"method": "GET", "path": "/api/users", "fields": ["users", "owner", "me", "roles", "projects"],
     "users": ["name", "role", "projects", "profile"]},
    {"method": "POST", "path": "/api/users", "actions": ["edit", "add", "remove"]},
    {"method": "GET", "path": "/api/profile", "fields": ["name", "role", "profile", "git", "git_ready", "logs"],
     "logs": ["project", "id", "at", "bytes", "first"]},
    {"method": "POST", "path": "/api/profile", "actions": ["save", "password"]},
    {"method": "POST", "path": "/api/prefs", "actions": ["(project settings)"]},
    {"method": "POST", "path": "/api/session", "actions": ["kill"]},
    {"method": "POST", "path": "/api/archive", "actions": ["(name and archived, true or false)"]},
    {"method": "POST", "path": "/api/lock", "actions": ["(name and locked, true or false; the answer names the sessions it ended)"]},
    {"method": "GET", "path": "/api/agents?node=", "fields": ["node", "name", "rows"],
     "rows": ["name", "agent", "label", "for", "installed", "latest", "state", "managed", "running", "error"],
     "needs": "an enrolled node's id"},
    {"method": "POST", "path": "/api/agents", "actions": ["install", "remove"]},
    {"method": "GET", "path": "/api/brief?project=", "fields": ["pending", "text"]},
    {"method": "POST", "path": "/api/brief", "actions": ["stage", "aside"]},
    {"method": "POST", "path": "/login", "actions": ["(a form of username, password and next: the cookie a session's terminal page is opened with)"]},
    {"method": "GET", "path": "/term/?arg=", "needs": "a ttyd, which test/editor.mjs starts and drives: the page a session's terminal is, in a WebView"}
  ],
  "types": {
    "/api/meta": {"api": "number", "version": "string", "apk": "string", "apk_sha256": "string", "apk_url": "string"},
    "/api/status": {"me": "string", "can": "object", "image": "object", "host": "string", "projects": "array", "attention": "array", "phone_asks": "number", "welcome": "object", "sessions": "array", "tmux_prefix": "string", "doctor": "object", "invites": "array", "projects[].name": "string", "projects[].label": "string", "projects[].git": "string|null", "projects[].locked": "boolean", "projects[].pending": "number", "projects[].roadmap": "number", "projects[].bugs": "number", "projects[].session_at": "string", "projects[].pinned": "boolean", "projects[].prefs": "object", "projects[].issues": "array", "projects[].testing": "any", "sessions[].name": "string", "can.admin": "boolean", "claude_auth": "object", "agent_auth": "object", "projects[].archived": "boolean", "projects[].locked_admin": "boolean", "projects[].locked_me": "boolean", "projects[].may_lock": "boolean", "projects[].may_archive": "boolean", "projects[].owner_mine": "boolean", "projects[].session_nodes": "array", "projects[].session_why": "string", "projects[].last_agents": "object", "projects[].yours": "object", "projects[].brief": "boolean"},
    "/api/phone": {"nodes": "array", "asks": "array", "nodes[].id": "string", "nodes[].name": "string", "nodes[].live": "boolean", "nodes[].phone": "object", "nodes[].owner": "any", "nodes[].mine": "boolean", "nodes[].lease": "any", "nodes[].lendable": "array", "nodes[].trust": "array"},
    "/api/phone/wait": {"token": "string"},
    "/api/pending?project=": {"pending": "array", "counts": "object", "gate": "object"},
    "/api/roadmap?project=": {"items": "array", "rev": "number", "session": "string"},
    "/api/bugs?project=": {"bugs": "array"},
    "/api/rules?project=": {"rules": "array", "standing": "number", "conditional": "number", "global": "array", "global[].name": "string", "global[].text": "string", "global[].disabled": "boolean", "global[].off_here": "boolean"},
    "/api/wiki?project=": {"pages": "array", "rev": "number"},
    "/api/memory?project=": {"memories": "array", "project": "string", "memories[].name": "string", "memories[].description": "string", "memories[].type": "string", "memories[].when": "number"},
    "/api/artifacts?project=": {"artifacts": "array", "build": "object", "captures": "array"},
    "/api/version?project=": {"forms": "object", "policy": "string", "released": "boolean", "dirty": "boolean", "unreleased": "number", "tag": "string", "warn": "any"},
    "/api/design?project=": {"language": "object", "pages": "array", "presets": "object"},
    "/api/docker?project=": {"instances": "array", "error": "string"},
    "/api/tests?project=": {"n": "number", "total_ms": "number", "last_wall_ms": "number", "suspect": "number", "undocumented": "number", "suites": "array"},
    "/api/transcripts?project=": {"rows": "array", "rows[].project": "string", "rows[].id": "string", "rows[].at": "number", "rows[].bytes": "number", "rows[].first": "string", "rows[].agent": "string", "rows[].shared": "boolean"},
    "/api/brief?project=": {"pending": "boolean", "text": "string"},
    "/api/git?project=&what=status": {"branch": "string", "upstream": "string", "ahead": "number", "behind": "number", "files": "array"},
    "/api/v1/nodes": {"nodes": "array", "agent": "object", "nodes[].id": "string", "nodes[].name": "string", "nodes[].state": "string", "nodes[].kind": "string", "nodes[].live": "any", "nodes[].config": "object", "nodes[].reported": "object"},
    "/api/v1/jobs": {"jobs": "array"},
    "/api/welcome": {"sections": "array", "sections[].title": "string", "sections[].entries": "array"},
    "/api/toolchains?node=": {"items": "array", "job": "object", "root": "string", "shared": "boolean", "items[].name": "string", "items[].label": "string", "items[].about": "string", "items[].installed": "boolean", "items[].version": "string", "items[].size": "string", "items[].needs": "array", "items[].updatable": "boolean"},
    "/api/users": {"users": "array", "owner": "string", "me": "string", "roles": "array", "projects": "array", "users[].name": "string", "users[].role": "string", "users[].projects": "array", "users[].profile": "object"},
    "/api/profile": {"name": "string", "role": "string", "profile": "object", "git": "object", "git_ready": "boolean", "logs": "array", "logs[].project": "string", "logs[].id": "string", "logs[].at": "number", "logs[].bytes": "number", "logs[].first": "string"}
  }
}
