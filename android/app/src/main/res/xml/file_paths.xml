<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider is allowed to hand out, and it is one directory:
     the cache subdirectory the downloaded APK lands in. A provider with a
     wider path would be a way to read the app's whole sandbox through an
     intent, which is the thing FileProvider exists to stop. -->
<paths>
    <cache-path name="apk" path="apk/" />
</paths>
