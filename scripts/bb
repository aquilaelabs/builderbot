#!/usr/bin/env bash
#
# `bb` — small convenience CLI inside the container.
#
set -euo pipefail

# The library next to this script, not a fixed /opt path: identical in the
# image (both live in /opt/builderbot/scripts), and it means a dry-run from a
# checkout uses that checkout's library instead of silently mixing new
# commands with the installed image's older helpers.
# shellcheck source=lib/common.sh
. "$(dirname "$(readlink -f "$0")")/lib/common.sh"
# The package manager — `bb sdk` and everything the Tools tab drives — is a
# third of this script's length and none of its subject, so it lives next door.
# shellcheck source=lib/sdk.sh
. "$(dirname "$(readlink -f "$0")")/lib/sdk.sh"

usage() {
    cat <<'EOF'
bb — BuilderBot helper

  bb status              show tool versions, runner state and mounted projects
  bb version             this project's version, and who is allowed to move it
  bb version --code      one form only: --code (Android versionCode), --quad
                         (= --win: manifest.json and Windows VERSIONINFO),
                         --msi, --pep440, --file, --semver, --json
  bb version bump PART   move the target: major|minor|patch, if policy allows
  bb version init X.Y.Z  give this project (or --for DIR) its first VERSION
  bb version --list      every version this repo carries: its own, and any
                         component — a directory with its own VERSION file
  bb version --for DIR   ask about one component instead of the project
  bb version policy      what a session may move here, and who decides
  bb changelog           this project's user-facing changelog (--for DIR)
  bb changelog add "..." log what a change means for the person using it;
                         the next version bump dates the accumulated lines
  bb projects            list mounted project directories
  bb shell               open a login shell as the builder user
  bb update              update Claude Code (and npm globals) in place
  bb login               run the Claude Code auth flow
  bb runner status       registration, and whether it is connected/busy
  bb runner stop         stop it and wait for GitHub to release the session
  bb runner start        start it if it is not already running
  bb runner restart      stop, then start (add --force to interrupt a job)
  bb emu start [API]     boot the emulator headless (e.g. `bb emu start 37`)
  bb emu stop            shut the emulator down
  bb emu status          adb devices
  bb emu list            configured API levels and the AVDs that exist
  bb emu log [-p] [N]    this boot's emulator log, or -p for the one before it
  bb emu gpu             which renderer a start would use, and why
  bb claude-md           is this project's CLAUDE.md environment block current?
  bb claude-md --update  refresh that block, leaving the project section alone
  bb claude-md --init    create a CLAUDE.md here from the shipped template
  bb lint [PATH]         lint the infrastructure files a repo carries: shell
                         scripts, Dockerfiles, GitHub workflows, compose, XML
  bb roadmap             this project's roadmap (add/done/rm/shelve/history)
  bb roadmap show N      one item in full: its details, its steps and theirs
  bb roadmap add "..." [--step "..."]   an item, or an ordered group of steps
  bb bug                 this project's bug tracker: open bugs, newest first
  bb bug find TEXT       search the reports themselves — area and repro included
  bb bug add "..."       report one; show N, note N, fix N, wontfix N, reopen N
  bb bug na N ["why"]    it was real and stopped applying — the feature went
  bb bug rm N ["why"]    delete a report that should not have been filed
  bb history [--find X]  one search over the notebook: roadmap, bugs, memory
                         and the scanner's logs
  bb findings [PATH]     digest scanner SARIF findings for this project
  bb findings --all      ...including findings in other projects' trees
  bb findings history    what the scanner stopped and started saying here
                         (-n N, --since 7d, --find TEXT, as the other logs)
  bb phone               what phone is connected, and what is waiting on you
  bb phone run --why "..." -- adb args...    ask to reach it; the operator
                         allows it on the dashboard and this runs it there
  bb ci-log              what CI printed on its last run here — the runner
                         keeps none of it, so the workflow archives it
  bb ci-log --list       the runs kept for this project, newest first
  bb logs [-f] [N]       show this boot's log (default: last 100 lines)
  bb logs -p [N]         show a previous boot's log (the log rotates per start)
  bb logs --list         list the kept boot logs, newest first
  bb doctor              check the things that usually go wrong

  Developing BuilderBot itself (this repo is the container's source):
  bb dashboard test [F]  browser-test the dashboard from this checkout, isolated
  bb dashboard dev [DIR] serve the live dashboard from DIR (default: ./scripts/dashboard)
  bb dashboard dev --off ...and put the image's copy back
  bb dashboard status    which copy of the dashboard is serving right now
  bb drift [REPO]        which files this checkout changed that the running
                         container is not serving yet
  bb shot URL... [FILE|DIR]  headless screenshot(s): --full --scale N --wait MS --resize W, auth via --auth
  bb favicon SVG [DIR]   favicon.ico (16-256) + apple-touch-icon.png + favicon.svg from one mark
  bb sdk                 SDKs kept outside the image: status, install X, remove X
EOF
}

# version LABEL COMMAND... — print a tool's version, or "-" when it is absent
# or answers with nothing.
version() {
    local label="$1"; shift
    local out
    out="$("$@" 2>/dev/null | head -1)" || out=""
    printf '  %-8s %s\n' "$label" "${out:--}"
}

cmd_status() {
    echo "== versions =="
    # First, because it is the identity of everything under it: every version
    # below came out of this image, and which image that is was otherwise
    # guessable only from the uptime. Stamped by CI at the end of the
    # Dockerfile; empty means the image was built some other way.
    # Above the commit, because it is the half a person can order. A sha
    # says which build; only this says which came first.
    printf '  %-8s %s\n' version "${BB_VERSION:-unstamped}"
    printf '  %-8s %s\n' image "$(
        if [ -n "${BB_IMAGE_REV:-}" ]; then
            printf '%.7s%s' "$BB_IMAGE_REV" \
                "${BB_IMAGE_BUILT:+ (built $BB_IMAGE_BUILT)}"
        else
            printf 'unstamped'
        fi)"
    version claude claude --version
    version node   node --version
    version npm    npm --version
    version python python3 --version
    version uv     uv --version
    version git    git --version
    version gh     gh --version
    version docker docker --version
    version mise   mise --version
    version java   java --version
    version adb    adb --version
    version pw     playwright --version
    printf '  %-8s %s\n' runner "$(cat "${RUNNER_DIR}/.runner-version" 2>/dev/null || echo '-')"
    echo
    # What is installed beyond the image, and where. Here rather than only in
    # `bb sdk` because this is the command a session runs first, and "is
    # flutter on this box" should not need a second guess.
    echo "== sdk =="
    local root have=""
    root="$(sdk_root)"
    for t in $SDK_TOOLCHAINS; do
        [ "$t" = android ] && continue
        sdk_have "$root" "$t" && have="${have:+$have }$t"
    done
    printf '  %-8s %s%s\n' root "$root" \
        "$(is_mountpoint "$root" && printf ' (share)' || printf ' (home volume)')"
    printf '  %-8s %s\n' installed "${have:-none — see: bb sdk}"
    echo
    echo "== runner =="
    if [ -f "${RUNNER_DIR}/.runner" ]; then
        jq -r '"  name: \(.agentName)\n  url:  \(.gitHubUrl)"' "${RUNNER_DIR}/.runner" 2>/dev/null \
            || echo "  registered"
        if pgrep -f 'Runner.Listener' >/dev/null; then
            echo "  state: listening for jobs"
        else
            echo "  state: starting up or between jobs"
        fi
    elif runner_pid >/dev/null; then
        # Ephemeral gap, not an outage — see the same case in cmd_runner.
        echo "  re-registering — a job just finished, back in seconds"
    else
        echo "  not registered (ENABLE_RUNNER=${ENABLE_RUNNER:-true})"
    fi
    echo
    cmd_projects
}

cmd_projects() {
    echo "== projects (${WORKSPACE}) =="
    local d found=0
    for d in "$WORKSPACE"/*/; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in _work) continue ;; esac
        found=1
        if [ -d "$d/.git" ]; then
            printf '  %-40s git: %s\n' "$(basename "$d")" "$(git_branch "$d")"
        else
            printf '  %-40s (not a git repo)\n' "$(basename "$d")"
        fi
    done
    [ "$found" -eq 1 ] || echo "  none mounted"
}

cmd_update() {
    log "updating Claude Code"
    install_claude_code "${CLAUDE_CODE_VERSION:-latest}" \
        || die "update failed — the image's baked-in version is still on PATH"
    claude --version
}

cmd_login() {
    # `claude auth login` is the flow built for this and does not leave a
    # session behind afterwards. The older path — start a session and use its
    # slash command — is the fallback for an image whose claude predates the
    # subcommand, which is exactly the case a first-time setup can be in.
    if claude auth --help >/dev/null 2>&1; then
        claude auth login
    else
        claude /login || claude
    fi
}

RUNNER_PIDFILE="${RUNNER_DIR}/.runner.pid"

# The supervisor, by pid rather than by command-line pattern. `pgrep -f
# runner.sh` matches any process that merely mentions the string — a grep, an
# editor, the shell running this very script — and a pkill on that pattern
# takes them with it.
runner_pid() {
    local pid
    pid="$(cat "$RUNNER_PIDFILE" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s' "$pid"
}

# The listener, matched on its executable path. The leading slash keeps the
# pattern from matching a command line that only names it — including the
# `pgrep -af Runner.Listener` we suggest to the user.
listener_pids() { pgrep -f '/Runner\.Listener' 2>/dev/null || true; }
worker_running() { pgrep -f '/Runner\.Worker' >/dev/null 2>&1; }

# runner_alive — anything that still holds this runner's GitHub session.
#
# Both halves matter. runner.sh is the supervisor; Runner.Listener is what is
# actually connected. Killing only the supervisor leaves the listener holding
# the session, which is what produces "A session for this runner already
# exists" followed by an endless "Runner connect error: Error: Conflict".
runner_alive() {
    runner_pid >/dev/null || [ -n "$(listener_pids)" ]
}

# runner_link — "ok" or "down", from the last connectivity marker the runner
# logged. A listener process being up says only that it is trying; the runner
# retries a rejected connection forever without exiting, so the process alone
# cannot tell a working runner from one stuck on Conflict.
runner_link() {
    local last
    last="$(tail -n 500 "$(bb_log_dir)/builderbot.log" 2>/dev/null \
            | grep -E 'Listening for Jobs|Runner reconnected|Runner connect error' \
            | tail -n 1 || true)"
    case "$last" in
        *"Runner connect error"*) printf 'down' ;;
        *)                        printf 'ok'   ;;   # also the unknown case
    esac
}

# runner_stop [--force] — bring the runner down and wait for it to let go.
#
# The waiting is the whole point. runner.sh drains any in-flight job and then
# deregisters, so "stopped" is not immediate; starting a second registration
# before the first has released the session is exactly what makes GitHub answer
# Conflict, and the old process's deregister would then tear down the
# registration the new one just made.
runner_stop() {
    local force=0 waited=0 grace="${RUNNER_STOP_GRACE:-90}" pid
    [ "${1:-}" = "--force" ] && force=1

    if worker_running && [ "$force" -eq 0 ]; then
        warn "a job is running right now — stopping would fail it on GitHub."
        warn "Wait for it to finish, or pass --force."
        return 1
    fi

    runner_alive || { echo "runner is not running"; return 0; }

    echo "stopping the runner…"
    pid="$(runner_pid || true)"
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
    pkill -TERM -f '/Runner\.Listener' 2>/dev/null || true

    while runner_alive && [ "$waited" -lt "$grace" ]; do
        sleep 1
        waited=$((waited + 1))
        [ $((waited % 10)) -eq 0 ] && echo "  still stopping… ${waited}s"
    done

    if runner_alive; then
        warn "runner did not stop within ${grace}s; killing it"
        pid="$(runner_pid || true)"
        [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null
        pkill -KILL -f '/Runner\.Listener' 2>/dev/null || true
        rm -f "$RUNNER_PIDFILE"
        sleep 2
        warn "a killed runner cannot deregister — GitHub may hold the old session"
        warn "for a minute or two and log Conflict until it expires."
        return 0
    fi
    echo "stopped cleanly after ${waited}s"
}

runner_start() {
    local out=/proc/1/fd/1 tries=10
    if runner_alive; then
        echo "runner is already running"
        return 0
    fi
    # PID 1's stdout is the container log, but /proc/1/fd is root-only — fall
    # back to the log file rather than let the redirect fail and take the
    # runner with it.
    [ -w "$out" ] || out="$(bb_log_dir)/builderbot.log"
    nohup /opt/builderbot/scripts/runner.sh >>"$out" 2>&1 &

    # Confirm it actually came up. Reporting "starting" and returning is how a
    # runner that died on launch gets reported as healthy by everything
    # downstream, including the dashboard.
    while [ "$tries" -gt 0 ]; do
        sleep 0.5
        if runner_alive; then echo "runner started"; return 0; fi
        tries=$((tries - 1))
    done
    warn "runner did not come up within 5s — see: bb logs"
    return 1
}

cmd_runner() {
    case "${1:-status}" in
        status)
            if [ -f "${RUNNER_DIR}/.runner" ]; then
                cat "${RUNNER_DIR}/.runner"
            elif runner_pid >/dev/null; then
                # An ephemeral registration is single-use: the runner
                # deregisters after every job and the supervisor re-registers
                # it moments later. Unregistered with the supervisor up is the
                # healthy between-jobs path, not an outage.
                echo "re-registering — an ephemeral runner deregisters after each job;"
                echo "the supervisor is up and a fresh registration lands in seconds"
            else
                echo "not registered"
            fi
            echo
            if worker_running; then
                echo "state: running a job"
            elif ! runner_alive; then
                echo "state: not running"
            elif [ "$(runner_link)" = "down" ]; then
                echo "state: cannot connect — retrying"
                tail -n 500 "$(bb_log_dir)/builderbot.log" 2>/dev/null \
                    | grep -E 'Runner connect error|session for this runner already exists' \
                    | tail -n 2 || true
                echo
                echo "If it says the session already exists, something else is holding this"
                echo "runner's name: another container using the same RUNNER_NAME, or a"
                echo "listener left behind by a half-finished restart. It clears when GitHub"
                echo "expires the old session — a minute or two. Check for a stray listener:"
                echo "    pgrep -af Runner.Listener"
            else
                echo "state: listening for jobs"
            fi
            ;;
        stop)    runner_stop "${2:-}" ;;
        start)   runner_start ;;
        restart) runner_stop "${2:-}" && runner_start ;;
        *) usage; exit 1 ;;
    esac
}

avd_exists() { avdmanager list avd 2>/dev/null | grep -q "Name: ${1}$"; }

# emu_avd [TARGET] — resolve which AVD to act on. A bare API level (37) maps to
# that version's AVD; anything else is taken as a literal name. With no target:
# ANDROID_AVD_NAME wins if set, then the first configured API level, then the
# unsuffixed name AVDs used before this was multi-version.
emu_avd() {
    local target="${1:-}" prefix="${ANDROID_AVD_PREFIX:-builderbot}" first
    if [ -n "$target" ]; then
        case "$target" in
            *[!0-9]*) printf '%s' "$target" ;;
            *)        printf '%s-%s' "$prefix" "$target" ;;
        esac
        return
    fi
    if [ -n "${ANDROID_AVD_NAME:-}" ]; then
        printf '%s' "$ANDROID_AVD_NAME"
        return
    fi
    first="$(printf '%s' "${ANDROID_SYSTEM_IMAGES:-${ANDROID_DEFAULT_API:-36}}" | tr ',' ' ' | awk '{print $1}')"
    if avd_exists "${prefix}-${first}"; then
        printf '%s-%s' "$prefix" "$first"
    else
        printf '%s' "$prefix"
    fi
}

# Does hardware GLES actually work here? Not "is there a GPU" — the card can be
# present, the Vulkan loader can find it, and EGL can still refuse to hand out
# a display, which is exactly the state this box was in for months. So this
# asks EGL itself, and believes the answer.
#
# Prints the vendor string on success and nothing on failure; the caller reads
# the exit status.
gpu_gles_ok() {
    [ -n "${DISPLAY:-}" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - <<'PY' 2>/dev/null
import ctypes, sys
try:
    egl = ctypes.CDLL("libEGL.so.1")
except OSError:
    sys.exit(1)
egl.eglQueryString.restype = ctypes.c_char_p
d = egl.eglGetDisplay(0)
if not d:
    sys.exit(1)
maj, mnr = ctypes.c_int(), ctypes.c_int()
if not egl.eglInitialize(d, ctypes.byref(maj), ctypes.byref(mnr)):
    sys.exit(1)
v = egl.eglQueryString(d, 0x3053)
v = v.decode() if v else ""
# Mesa answering means llvmpipe: a display, but software behind it, which is
# the trap this check exists to catch. Only a vendor driver counts.
if not v or "Mesa" in v:
    sys.exit(1)
print(v)
PY
}

# The serial of the running emulator, or empty. Matched by NAME, which is the
# only thing that actually distinguishes one.
#
# Not `adb -e`, which is the obvious answer and is wrong: adb means "the device
# on a local/TCP transport" by that, and a phone attached over wireless adb is
# exactly that. With a Pixel connected, `adb -e shell` reaches the Pixel and
# `adb -d` finds nothing at all. An emulator is emulator-NNNN; a wireless phone
# is IP:PORT; that difference is the test.
#
# `device` and not `offline`: an emulator appears in the list before it will
# answer, and treating the first sighting as ready is how `bb emu start` used
# to return before the thing had booted.
emu_serial() {
    adb devices 2>/dev/null \
        | awk '$1 ~ /^emulator-[0-9]+$/ && $2 == "device" { print $1; exit }'
}

cmd_emu() {
    local avd
    case "${1:-status}" in
        start)
            command -v emulator >/dev/null 2>&1 \
                || die "emulator is not installed in this image"
            if adb devices 2>/dev/null | grep -q '^emulator-'; then
                log "an emulator is already running"; adb devices; return 0
            fi
            avd="$(emu_avd "${2:-}")"
            avd_exists "$avd" \
                || die "AVD '${avd}' not found — add its API level to ANDROID_SYSTEM_IMAGES and restart, or see: bb emu list"
            [ -w /dev/kvm ] || warn "/dev/kvm not available — this will be very slow"
            # Software rendering by default. `-gpu host` does not work here
            # even with a GPU passed through and NVIDIA_DRIVER_CAPABILITIES=all:
            # the emulator finds the card for Vulkan and then fails at
            # "Failed to get EGL display", because NVIDIA's EGL wants a display
            # and this container has none. Bridging that needs an X server
            # (Xvfb) in EXTRA_APT_PACKAGES, which is the operator's call — so
            # the default stays software and says why rather than pretending.
            # What to render with. An explicit ANDROID_EMULATOR_GPU is obeyed
            # as given; otherwise the hardware path is *tested* rather than
            # assumed — 48-gpu-display starts an X server for the card at boot,
            # and if EGL answers on it with a vendor driver the emulator can
            # use the GPU. Anything else falls back to software, which is the
            # behaviour this box has always had.
            local gpu vendor
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                gpu="$ANDROID_EMULATOR_GPU"
            elif [ -S /tmp/.X11-unix/X0 ] && vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                gpu=host
                export DISPLAY="${DISPLAY:-:0}"
                log "hardware rendering: EGL answers on ${DISPLAY} (${vendor})"
            else
                gpu=swiftshader_indirect
            fi
            # Under a software GPU the guest has no DRM render node, so HWUI's
            # default Vulkan backend cannot initialise: the app draws, the view
            # hierarchy is complete, and every frame comes out blank. The guest
            # says so once in logcat — "E/MESA: Failed to open rendernode" — and
            # is otherwise silent about it, which is why this cost somebody a
            # day of thinking their own screen was broken.
            #
            # setprop from a shell fixes it and does not survive a reboot;
            # -prop sets it at boot, every boot. Only for the software modes:
            # with a real GPU the Vulkan backend is the faster one and should
            # be left alone.
            local hwui="${ANDROID_HWUI_RENDERER-skiagl}"
            local propargs=()
            case "$gpu" in
                swiftshader*|swangle*|guest|off)
                    [ -z "$hwui" ] || propargs=(-prop "debug.hwui.renderer=${hwui}") ;;
            esac
            # The log rotates rather than truncating. The emulator dies
            # silently under load — adb goes quiet, `bb emu stop` says there is
            # nothing to stop — and the only account of why is in the log the
            # *next* start used to overwrite before anybody could read it.
            if [ -s "$HOME/.android/emulator.log" ]; then
                mv -f "$HOME/.android/emulator.log" "$HOME/.android/emulator.log.1"
            fi
            log "starting AVD '${avd}' headless, -gpu ${gpu}${propargs:+, hwui ${hwui}} (log: bb emu log)"
            nohup emulator -avd "$avd" -no-window -no-audio -no-boot-anim \
                -gpu "$gpu" "${propargs[@]}" \
                > "$HOME/.android/emulator.log" 2>&1 &
            log "waiting for the device to come up..."
            # Bounded: a crashed emulator otherwise leaves this waiting forever
            # for a device that is never coming, with the reason sitting unread
            # in the log the timeout message points at.
            #
            # Waiting for THIS emulator, not for any device. A bare
            # wait-for-device is satisfied the instant it is asked when a phone
            # is attached over wireless adb, and this reported the emulator
            # ready before it had booted — a wrong answer rather than a missing
            # one, which is worse.
            local waited=0 serial=""
            while [ "$waited" -lt "${ANDROID_BOOT_TIMEOUT:-180}" ]; do
                serial="$(emu_serial)"
                [ -n "$serial" ] && break
                sleep 1; waited=$((waited + 1))
            done
            [ -n "$serial" ] \
                || die "the emulator did not appear within ${ANDROID_BOOT_TIMEOUT:-180}s — see ~/.android/emulator.log"
            log "emulator is up as ${serial}"
            adb devices
            ;;
        stop)
            # Named, for the same reason: without a serial this is "kill
            # whatever single device is attached", which with a phone connected
            # and no emulator is an emu command aimed at a handset.
            avd="$(emu_serial)"
            if [ -n "$avd" ]; then
                adb -s "$avd" emu kill 2>/dev/null || warn "emulator ${avd} did not stop"
            else
                warn "no emulator to stop"
            fi
            ;;
        status)
            # Everything attached, deliberately — a phone paired over wireless
            # adb shares this adb server, and knowing it is there is the point
            # when a command aimed at "the device" could mean either. The
            # emulator is the one named emulator-NNNN.
            adb devices -l
            ;;
        gpu)
            # "Which renderer would a start use, and why" — one command,
            # because the answer used to take an afternoon of reading logs.
            local v
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                printf 'ANDROID_EMULATOR_GPU is set: %s (used as given)\n' "$ANDROID_EMULATOR_GPU"
            elif [ ! -S /tmp/.X11-unix/X0 ]; then
                printf 'software (swiftshader_indirect): no X display for the GPU\n'
                command -v Xorg >/dev/null 2>&1 \
                    || printf '  this image has no X server — the GPU path needs one (see 48-gpu-display)\n'
                command -v nvidia-smi >/dev/null 2>&1 \
                    && printf '  the card is here: %s\n' \
                       "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
            elif v="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                printf 'hardware (-gpu host): EGL vendor %s on %s\n' "$v" "${DISPLAY:-:0}"
            else
                printf 'software (swiftshader_indirect): X is up but EGL gave no vendor driver\n'
                printf '  Mesa answering here means llvmpipe — software by a slower road\n'
            fi
            ;;
        log|logs)
            # This start's log, or the one before it. `-p` is the interesting
            # one: after a silent death, the previous log is the post-mortem,
            # and it is gone the moment somebody starts the emulator again.
            local f="$HOME/.android/emulator.log"
            [ "${2:-}" = "-p" ] || [ "${2:-}" = "--prev" ] && f="$f.1"
            [ -f "$f" ] || die "no emulator log at ${f}"
            tail -n "${3:-200}" "$f"
            ;;
        list)
            printf 'configured API levels: %s\n' "${ANDROID_SYSTEM_IMAGES:-${ANDROID_DEFAULT_API:-36}}"
            printf 'default for `bb emu start`: %s\n\n' "$(emu_avd)"
            avdmanager list avd 2>/dev/null \
                | grep -E 'Name:|Based on:' \
                | sed 's/^ */  /' \
                || printf '  (no AVDs)\n'
            ;;
        *) usage; exit 1 ;;
    esac
}

# ---- what CI said, from inside the container -------------------------------
# The self-hosted runner streams a job's console output to GitHub and keeps
# none of it: /workspace/_work/_diag holds the runner's own diagnostics, which
# name the failing step and its exit code and never a line of what it printed.
# With no PAT there is no API to ask either, so "CI is red — why?" had no
# answer in here for a job that ran in this very container. The lint workflow
# tees each check into /config/ci-logs/<repo>/ and this reads it.
cmd_ci_log() {
    local dir="${BB_CI_LOG_DIR:-/config/ci-logs}"
    local proj="" want="" list=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --list|-l) list=1 ;;
            --project) proj="${2:-}"; shift ;;
            -*) die "unknown option: $1" ;;
            *) want="$1" ;;
        esac
        shift
    done
    # The project this is run from, the same way `bb roadmap` decides.
    if [ -z "$proj" ]; then
        local here; here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one, or pass --project NAME" ;;
        esac
    fi
    local d="$dir/$proj"
    if [ ! -d "$d" ] || [ -z "$(find "$d" -maxdepth 1 -name '*.log' -print -quit 2>/dev/null)" ]; then
        log "no CI logs kept for ${proj}"
        log "only a job that runs on this box archives one, and only once the"
        log "workflow carrying the archive step has landed on the branch that ran"
        return 0
    fi
    # Newest first by mtime rather than by name: a re-run of an older run has a
    # lower id than a newer first attempt, so the number does not order them.
    local logs; mapfile -t logs < <(
        find "$d" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
    if [ "$list" = 1 ]; then
        echo "kept for ${proj}, newest first:"
        local f
        for f in "${logs[@]}"; do
            printf '  %-22s %s  %s\n' "$(basename "$f" .log)" \
                "$(date -r "$f" '+%d %b %H:%M')" \
                "$(sed -n 's/^result: //p' "$f" | head -1 || true)"
        done
        return 0
    fi
    local pick="${logs[0]}"
    if [ -n "$want" ]; then
        pick=""
        local f
        for f in "${logs[@]}"; do
            case "$(basename "$f" .log)" in "$want"|"$want"-*) pick="$f"; break ;; esac
        done
        [ -n "$pick" ] || die "no kept log for run ${want} — try: bb ci-log --list"
    fi
    cat "$pick"
}

cmd_logs() {
    local base logfile follow=0 lines=100 gen=""
    base="$(bb_log_dir)/builderbot.log"
    while [ $# -gt 0 ]; do
        case "$1" in
            -f) follow=1 ;;
            -l|--list)
                # Newest first, so the top of the list is the current boot.
                ls -1t "$base" "$base".[0-9]* 2>/dev/null \
                    || die "no logs in $(bb_log_dir)"
                return 0
                ;;
            -p|--prev)
                # The log rotates per container start, so generation N is the
                # Nth boot back. Bare -p means the previous one.
                case "${2:-}" in
                    ''|*[!0-9]*) gen=1 ;;
                    *) gen="$2"; shift ;;
                esac
                ;;
            *[0-9]*) lines="$1" ;;
        esac
        shift
    done
    if [ -n "$gen" ]; then
        logfile="${base}.${gen}"
    else
        logfile="$base"
    fi
    [ -f "$logfile" ] || die "no log at ${logfile} — see: bb logs --list"
    if [ "$follow" -eq 1 ]; then
        tail -n "$lines" -f "$logfile"
    else
        tail -n "$lines" "$logfile"
    fi
}

# Overridable for one reason: developing the template itself. `bb claude-md`
# compares a project against the image's copy, which is right everywhere except
# in a checkout of this repo, where the template being edited is the one under
# config/templates. The dashboard's server has had the same override for the
# same reason (its tests point it at a checkout).
TEMPLATE_MD="${TEMPLATE_MD:-/opt/builderbot/templates/project-CLAUDE.md}"
ENV_BEGIN='<!-- BUILDERBOT:ENV:BEGIN -->'
ENV_END='<!-- BUILDERBOT:ENV:END -->'

# Print the marked environment block of a file, markers included.
md_block() { awk -v b="$ENV_BEGIN" -v e="$ENV_END" \
    'index($0,b){f=1} f{print} index($0,e){exit}' "$1"; }

# Keep a project's CLAUDE.md environment section in step with the image.
#
# The block is delimited so refreshing it is a substitution rather than a
# judgment call: everything below the end marker is the project's own and is
# never read, compared or written. That is the whole point — the environment
# notes go stale every time the container gains a feature, and the project
# notes are the expensive part nobody wants to risk.
cmd_claude_md() {
    local mode=check target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --update) mode=update ;;
            --init)   mode=init ;;
            --check)  mode=check ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-$PWD/CLAUDE.md}"
    [ -f "$TEMPLATE_MD" ] || die "no template at ${TEMPLATE_MD} — is this an older image?"

    if [ ! -f "$target" ]; then
        if [ "$mode" = init ]; then
            cp "$TEMPLATE_MD" "$target"
            log "created ${target} — fill in the project section below the end marker"
            return 0
        fi
        die "no ${target}. Create one with: bb claude-md --init"
    fi

    if ! grep -qF "$ENV_BEGIN" "$target" || ! grep -qF "$ENV_END" "$target"; then
        warn "${target} has no BUILDERBOT:ENV markers"
        warn "It predates them, so which part is environment and which is yours"
        warn "cannot be determined safely. Merge once by hand — or ask Claude to —"
        warn "putting the block from ${TEMPLATE_MD} above your project section."
        return 1
    fi

    local tmp_new tmp_cur
    tmp_new="$(mktemp)"; tmp_cur="$(mktemp)"
    # shellcheck disable=SC2064 # expand the paths now, not at trap time
    trap "rm -f '$tmp_new' '$tmp_cur'" RETURN
    md_block "$TEMPLATE_MD" > "$tmp_new"
    md_block "$target"      > "$tmp_cur"

    if cmp -s "$tmp_new" "$tmp_cur"; then
        log "${target}: environment block is current"
        return 0
    fi

    if [ "$mode" != update ]; then
        log "${target}: environment block differs from the image's template"
        diff -u --label "$target" --label "$TEMPLATE_MD" "$tmp_cur" "$tmp_new" || true
        log "refresh just that block with: bb claude-md --update"
        return 0
    fi

    local out; out="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp_new' '$tmp_cur' '$out'" RETURN
    awk -v b="$ENV_BEGIN" -v e="$ENV_END" -v repl="$tmp_new" '
        index($0,b) { while ((getline line < repl) > 0) print line; skip=1; next }
        index($0,e) { skip=0; next }
        !skip       { print }
    ' "$target" > "$out"

    grep -qF "$ENV_END" "$out" || die "refused to write: the result lost its end marker"
    cat "$out" > "$target"
    log "${target}: environment block updated; your project section is untouched"
}

# Reduce a SARIF report to grouped markdown.
#
# This reads scan output and nothing else. The scanner itself lives outside the
# container on purpose — /reports is mounted read-only and no scanner binary is
# installed — so there is no way to start a scan from in here, by design. If the
# findings look stale, the fix is to re-run the scanner on the host.
#
# Raw SARIF is mostly metadata: a few hundred KB of it would fill a session's
# context before it reached the code the findings are about. Grouping by
# severity then rule, and listing bare locations under one message, keeps the
# same information at a fraction of the size.
FINDINGS_JQ='
def parts($p): ($p | ltrimstr("/") | split("/"));

# Everything up to and including the project directory is where the scanner
# saw the code, not where this container mounts it. Dropping that prefix makes
# the path openable from the project root.
def strip_path($p): parts($p) as $ps
  | ($ps | index($proj)) as $i
  | if $i != null then ($ps[($i + 1):] | join("/")) else ($ps | join("/")) end;

def rank: {"error":0, "warning":1, "note":2, "info":2, "none":3}[.] // 4;

[ .runs[]
  | (reduce ((.tool.driver.rules // [])[]) as $x
      ({}; .[$x.id] = { level: ($x.defaultConfiguration.level // "warning"),
                        desc:  ($x.shortDescription.text // $x.fullDescription.text // "") })) as $rules
  | .results[]?
  | (.locations[0].physicalLocation.artifactLocation.uri // "?") as $uri
  | { level: (.level // $rules[.ruleId].level // "warning"),
      rule:  (.ruleId // "unknown"),
      # The rule description beats the result message as a group heading. Some
      # tools (Trivy) put the artifact path on the message first line, so the
      # heading would name one file while the group lists several.
      msg:   ( if ($rules[.ruleId].desc // "") != "" then $rules[.ruleId].desc
               else ((.message.text // "") | split("\n")[0]) end ),
      mine:  ((parts($uri) | index($proj)) != null),
      # First two components identify the tree a finding came from, which is
      # what you need when the answer is "that is a different project".
      tree:  (parts($uri)[0:2] | join("/")),
      loc:   ( strip_path($uri)
               + ":" + ((.locations[0].physicalLocation.region.startLine // 0) | tostring) ) } ]
| . as $all
| (if $scope == "all" then $all else map(select(.mine)) end) as $rows
| ($rows | length) as $n
| if ($all | length) == 0 then "No findings.\n"
  elif $n == 0 then
    "No findings for \($proj). This report covers: "
    + (($all | map(.tree) | unique | join(", ")))
    + "\nRun with --all to see them anyway.\n"
  else
  ( "# Findings (\($n))"
  + (if $scope == "all" then " — all projects in this report\n"
     else " in \($proj), of \($all | length) in the report — --all for the rest\n" end)
  + ( $rows | group_by(.level) | sort_by(.[0].level | rank)
      | map( "\n## \(.[0].level) (\(length))\n"
             + ( group_by(.rule) | sort_by(-length)
                 | map( "\n### \(.[0].rule) (\(length))\n\(.[0].msg)\n"
                        + ( map("- \(.loc)") | unique | join("\n") ) + "\n" )
                 | join("") ) )
      | join("") ) )
  end'

# The shared to-do list, from a session's side. Same file the dashboard writes
# (/config/todos.json) and the same module reads it — one implementation, so a
# list edited from a phone and a list edited from a terminal cannot disagree.
#
# The project is the directory this is run in, not an argument: a session is
# already in its project, and asking it to name one is asking it to get one
# wrong.
cmd_roadmap() {
    local py
    # todo.py, still: the file is where the roadmap has always been implemented
    # and renaming it would move code the running image serves by absolute
    # path. The command is what the operator reads, and that is `bb roadmap`.
    py="$(dirname "$(readlink -f "$0")")/dashboard/todo.py"
    [ -f "$py" ] || die "todo.py is missing from this image"
    local proj="${BB_ROADMAP_PROJECT:-${BB_TODO_PROJECT:-}}"
    if [ -z "$proj" ]; then
        local here; here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, sys, time

spec = importlib.util.spec_from_file_location("todo", sys.argv[1])
todo = importlib.util.module_from_spec(spec)
spec.loader.exec_module(todo)


def write_json(path, obj):
    """Atomic, like the server's: a half-written list is read at every session
    start after it, which is a worse outcome than a failed write."""
    import os
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


import os
_state = os.environ.get("DASHBOARD_STATE", "/config")
todo.configure(write_json=write_json, state=_state)

# The tracker's half of a notebook batch. A batch spans both files, so the
# roadmap's begin/commit/revert have to reach the tracker as well — loaded
# beside todo.py rather than imported, for the same reason todo.py is: this
# has to be the copy sitting next to the script that was actually run.
_here = os.path.dirname(sys.argv[1])
_bugs = importlib.util.module_from_spec(
    importlib.util.spec_from_file_location("bugs", os.path.join(_here, "bugs.py")))
_bugs.__loader__.exec_module(_bugs)
_bugs.configure(write_json=write_json, state=_state)
_nb = importlib.util.module_from_spec(
    importlib.util.spec_from_file_location("notebook", os.path.join(_here, "notebook.py")))
_nb.__loader__.exec_module(_nb)
_nb.configure(todo_mod=todo, bugs_mod=_bugs)

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]


def show():
    rows = todo.items(proj)
    # The whole notebook's count, not the roadmap's: one batch covers both,
    # and a banner reporting half of it would read as "nothing much staged"
    # while a dozen tracker changes sat unrecorded.
    b = _nb.state(proj)
    if b:
        print(f"  [batch open — {b['changes']} change"
              f"{'' if b['changes'] == 1 else 's'} unrecorded across this "
              "notebook; bb roadmap commit, or revert]")
    if not rows:
        print(f"nothing on {proj}'s list")
        return
    for r in rows:
        # No done column: everything here is outstanding by construction, and
        # a box that is never ticked is a column of nothing. Shelved is worth
        # a column, because it is the one state that changes whether a line is
        # asking for anything.
        who = " (claude)" if r.get("by") == "claude" else ""
        mark = "~" if r.get("shelved") else " "
        print(f" {mark}{r['id']:>3}  {r['text']}{who}"
              + ("  [shelved]" if r.get("shelved") else ""))
        if r.get("info"):
            print("       details: " + r["info"].replace("\n", "\n                "))
        for i, st in enumerate(r.get("steps") or []):
            print(f"          {i + 1}. {st['text']}"
                  + ("  (sent)" if st.get("sent") else ""))
            if st.get("info"):
                print("             details: "
                      + st["info"].replace("\n", "\n                      "))


def bail(r):
    if r.get("error"):
        print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr)
        sys.exit(1)


if op in ("list", "ls"):
    show()
elif op == "show":
    # One item in full: its details, its steps and theirs. `list` cannot carry
    # this without becoming unreadable, and a session working item N wants
    # exactly N — the same reason `bb bug show` exists.
    if not rest:
        print("usage: bb roadmap show <n>", file=sys.stderr); sys.exit(1)
    r = next((x for x in todo.items(proj) if str(x.get("id")) == rest[0]), None)
    if r is None:
        print(f"[builderbot] ERROR: no item #{rest[0]} here", file=sys.stderr)
        sys.exit(1)
    who = " (claude)" if r.get("by") == "claude" else ""
    print(f"  #{r['id']}  {r['text']}{who}"
          + ("  [shelved]" if r.get("shelved") else ""))
    if r.get("info"):
        print("  details: " + r["info"].replace("\n", "\n           "))
    for i, st in enumerate(r.get("steps") or []):
        print(f"    {i + 1}. {st['text']}" + ("  (sent)" if st.get("sent") else ""))
        if st.get("info"):
            print("       details: " + st["info"].replace("\n", "\n                "))
elif op == "--prompt":
    sys.stdout.write(todo.prompt(proj))
elif op == "add":
    # `bb roadmap add "title" --step "..." --step "..."` — a change that needs
    # things done in an order is one item with steps, not several items that
    # can be handed over backwards.
    words, steps, i = [], [], 0
    while i < len(rest):
        if rest[i] == "--step":
            # A dangling --step used to fall through and become part of the
            # title, so `bb roadmap add "x" --step` quietly made an item called
            # "x --step" instead of saying what was missing.
            if i + 1 >= len(rest):
                print("[builderbot] ERROR: --step needs the step after it",
                      file=sys.stderr)
                sys.exit(1)
            steps.append(rest[i + 1]); i += 2
        else:
            words.append(rest[i]); i += 1
    r = todo.add(proj, " ".join(words).strip(), by="claude", steps=steps); bail(r)
    n = len(r["item"]["steps"])
    print(f"added {r['item']['id']}: {r['item']['text']}"
          + (f" ({n} steps)" if n else ""))
elif op == "done":
    # Off the list and into the log. There is no undoing it: a list is read to
    # find out what is left, so nothing finished stays on it, and the history
    # is where the words live afterwards.
    if not rest:
        print("usage: bb roadmap done <n>", file=sys.stderr); sys.exit(1)
    r = todo.tick(proj, rest[0], by="claude"); bail(r)
    print(f"done {rest[0]}: {r['item']['text']}")
elif op in ("rm", "remove"):
    # The reason rides with the deletion. Nothing here can be undone, so the
    # only thing that stops the next reader putting it straight back is a note
    # saying why it went.
    if not rest:
        print("usage: bb roadmap rm <n> [\"why it is going\"]", file=sys.stderr); sys.exit(1)
    r = todo.remove(proj, rest[0], by="claude", why=" ".join(rest[1:])); bail(r)
    print(f"removed {rest[0]}")
elif op in ("begin", "commit", "revert"):
    # Working something out is not a series of decisions the operator has to
    # read; it is arriving at one. The work still lands as it happens — hiding
    # it would be worse than a noisy log — but the record is written once, at
    # commit, saying what changed rather than every step of getting there.
    #
    # One batch over the WHOLE notebook: the roadmap and the tracker both.
    # A plan usually moves because of what the tracker now says, and letting
    # one be committed while the other is reverted would leave a roadmap
    # describing work against a tracker that never recorded why.
    if op == "begin":
        bail(_nb.begin(proj))
        print(f"batch open on {proj}'s notebook — the roadmap and the bug "
              "tracker both. Commit or revert it")
    elif op == "commit":
        r = _nb.commit(proj); bail(r)
        print(f"committed: {r['written']} entr{'y' if r['written'] == 1 else 'ies'}"
              + (f", {r['folded']} folded into them" if r["folded"] else ""))
    else:
        r = _nb.revert(proj); bail(r)
        print(f"reverted: the roadmap and the tracker are back as they were, "
              f"{r['dropped']} change{'' if r['dropped'] == 1 else 's'} dropped")
elif op in ("mv", "move"):
    # The list's own order, not a group's. Both halves of restructuring belong
    # to a session: it is the one that knows a plan has to happen before the
    # item under it, and deleting and retyping to express that loses the words
    # and the record both.
    if len(rest) < 2 or rest[1] not in ("up", "down"):
        print("usage: bb roadmap mv <n> up|down", file=sys.stderr); sys.exit(1)
    r = todo.move(proj, rest[0], dir=-1 if rest[1] == "up" else 1, by="claude")
    bail(r)
    print(f"moved {rest[0]} {rest[1]}")
elif op == "shelve":
    # Parked, not dropped: a reason to keep it, no intention of doing it now.
    # One direction only. Putting something on the shelf is a thing a session
    # knows — it is blocked, or it is waiting on somebody — and it is loud:
    # the row goes dark at the bottom and the log says who did it. Taking one
    # *off* is reversing a decision the operator made for reasons the session
    # was not told, so it is theirs, and one tap in the panel.
    if not rest:
        print("usage: bb roadmap shelve <n>", file=sys.stderr); sys.exit(1)
    r = todo.shelve(proj, rest[0], True, by="claude"); bail(r)
    print(f"shelved {rest[0]} — say in your reply why, the operator unshelves it")
elif op == "edit":
    # A plan written last week can describe a design that has since moved.
    # Correcting it is better than working around it, and the history keeps
    # what it used to say.
    if len(rest) < 2:
        print("usage: bb roadmap edit <n> \"the new wording\"", file=sys.stderr); sys.exit(1)
    r = todo.edit(proj, rest[0], " ".join(rest[1:]), by="claude"); bail(r)
    print(f"reworded {rest[0]}")
elif op == "info":
    # The technical half, attached where the work is: which files, which
    # functions, the approach. `bb roadmap info N "..."` for an item,
    # `bb roadmap info N M "..."` for step M of it; "" clears.
    if len(rest) < 2:
        print("usage: bb roadmap info <n> [<step>] \"...\"", file=sys.stderr)
        sys.exit(1)
    if len(rest) >= 3 and rest[1].isdigit():
        n = int(rest[1])
        if n < 1:
            print("[builderbot] ERROR: step numbers start at 1", file=sys.stderr)
            sys.exit(1)
        r = todo.set_info(proj, rest[0], " ".join(rest[2:]),
                          step=n - 1, by="claude"); bail(r)
        print(f"details on step {rest[1]} of {rest[0]}")
    else:
        r = todo.set_info(proj, rest[0], " ".join(rest[1:]), by="claude"); bail(r)
        print(f"details on {rest[0]}")
elif op == "step":
    sub, srest = (rest[0] if rest else ""), rest[1:]

    def step_index(word):
        """A 1-based step number from the command line, as a 0-based index.

        Its own function because the expression it replaces read
        `_int(x) - 1 if _int(x) else None`, and Python's zero is falsy: step 0
        was not "invalid", it was "no step at all", so `step edit N 0 "..."`
        fell through to editing the item and renamed it. Every step verb had
        its own copy of that.
        """
        n = todo._int(word)
        if n is None or n < 1:
            print(f"[builderbot] ERROR: step numbers start at 1 (got {word!r})",
                  file=sys.stderr)
            sys.exit(1)
        return n - 1
    if sub == "add" and len(srest) >= 2:
        r = todo.add_step(proj, srest[0], " ".join(srest[1:]), by="claude"); bail(r)
        print(f"added a step to {srest[0]}")
    elif sub == "edit" and len(srest) >= 3:
        # 1-based on the way in, because that is how the step is numbered
        # everywhere a human reads it.
        r = todo.edit(proj, srest[0], " ".join(srest[2:]),
                      step=step_index(srest[1]),
                      by="claude"); bail(r)
        print(f"reworded step {srest[1]} of {srest[0]}")
    elif sub in ("rm", "remove") and len(srest) >= 2:
        r = todo.remove(proj, srest[0],
                        step=step_index(srest[1]),
                        by="claude", why=" ".join(srest[2:])); bail(r)
        print(f"removed step {srest[1]} of {srest[0]}")
    elif sub == "info" and len(srest) >= 2:
        r = todo.set_info(proj, srest[0], " ".join(srest[2:]),
                          step=step_index(srest[1]),
                          by="claude"); bail(r)
        print(f"details on step {srest[1]} of {srest[0]}")
    elif sub in ("mv", "move") and len(srest) >= 3 and srest[2] in ("up", "down"):
        # The other half of restructuring a plan. Without it a session that
        # finds two steps in the wrong order can only delete and retype them,
        # which loses both their words and the record of what really changed.
        r = todo.move(proj, srest[0],
                      step=step_index(srest[1]),
                      dir=-1 if srest[2] == "up" else 1, by="claude"); bail(r)
        print(f"moved step {srest[1]} of {srest[0]} {srest[2]}")
    else:
        print("usage: bb roadmap step add <n> \"...\" | step edit <n> <step> \"...\""
              " | step rm <n> <step> [\"why\"] | step mv <n> <step> up|down",
              file=sys.stderr)
        sys.exit(1)
elif op in ("history", "log"):
    # Narrowed on the way out, not on the way in: this is read by sessions as
    # often as by people, and a whole log pasted into a conversation costs
    # more context than the one line anybody wanted from it.
    limit, since, find, i = 20, None, None, 0
    while i < len(rest):
        a = rest[i]
        if a in ("-n", "--last") and i + 1 < len(rest):
            limit = todo._int(rest[i + 1]); i += 2
        elif a == "--all":
            limit = None; i += 1
        elif a == "--since" and i + 1 < len(rest):
            # A day count, or a date. Both are things somebody types from
            # memory; neither needs a library to read.
            v = rest[i + 1]
            n = todo._int(v.rstrip("d")) if v.rstrip("d").isdigit() else None
            if n is not None:
                since = int(time.time()) - n * 86400
            else:
                try:
                    since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
                except ValueError:
                    print(f"[builderbot] ERROR: not a date or a day count: {v}",
                          file=sys.stderr); sys.exit(1)
            i += 2
        elif a in ("--find", "-f") and i + 1 < len(rest):
            find = rest[i + 1]; i += 2
        else:
            print("usage: bb roadmap history [-n N|--all] [--since 7d|YYYY-MM-DD] "
                  "[--find TEXT]", file=sys.stderr)
            sys.exit(1)
    h = todo.history(proj, limit=limit, since=since, find=find)
    if not h:
        print(f"nothing on {proj}'s list matches that")
    for e in h:
        when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
        where = f" step {e['step'] + 1} of" if e.get("step") is not None else ""
        print(f"  {when}  {e.get('by', ''):>6}  {e.get('act', ''):<11}"
              f"{where} #{e.get('id')}  {e.get('text', '')}")
        if e.get("was"):
            print(f"{'':>32}was: {e['was']}")
        if e.get("why"):
            print(f"{'':>32}why: {e['why']}")
else:
    print("usage: bb roadmap [list|show N|add TEXT [--step ...]|edit N TEXT|"
          "info N [M] TEXT|step add|edit|rm|mv|info ...|mv N up|down|done N|"
          "rm N [WHY]|shelve N|begin|commit|revert|"
          "history [-n N] [--since D] [--find TEXT]]",
          file=sys.stderr)
    sys.exit(1)
PY
}

cmd_history() {
    # One search over all three of the notebook's logs — roadmap, bugs, and
    # what the dashboard did to the memories — tagged by source and merged by
    # time. `bb roadmap history` and `bb bug history` scope to one; this is for
    # "when did anything here mention the picker?", which is a question about
    # the notebook and not about a tab of it.
    local dir
    dir="$(dirname "$(readlink -f "$0")")/dashboard"
    local proj="${BB_ROADMAP_PROJECT:-${BB_TODO_PROJECT:-}}"
    if [ -z "$proj" ]; then
        local here; here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$dir" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys, time


def load_mod(dirname, name):
    spec = importlib.util.spec_from_file_location(name, f"{dirname}/{name}.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def write_json(path, obj):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, str(path))


dirname, proj, argv = sys.argv[1], sys.argv[2], sys.argv[3:]
state = os.environ.get("DASHBOARD_STATE", "/config")
todo = load_mod(dirname, "todo")
todo.configure(write_json=write_json, state=state)
bugs = load_mod(dirname, "bugs")
bugs.configure(write_json=write_json, state=state)
memory = load_mod(dirname, "memory")
memory.configure_log(write_json=write_json, state=state)
findings = load_mod(dirname, "findings")
findings.configure(write_json=write_json, state=state)

limit, since, find, i = 20, None, None, 0
while i < len(argv):
    a = argv[i]
    if a in ("-n", "--last") and i + 1 < len(argv):
        limit = int(argv[i + 1]); i += 2
    elif a == "--all":
        limit = None; i += 1
    elif a == "--since" and i + 1 < len(argv):
        v = argv[i + 1]
        if v.rstrip("d").isdigit():
            since = int(time.time()) - int(v.rstrip("d")) * 86400
        else:
            try:
                since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
            except ValueError:
                print(f"[builderbot] ERROR: not a date or a day count: {v}",
                      file=sys.stderr)
                sys.exit(1)
        i += 2
    elif a in ("--find", "-f") and i + 1 < len(argv):
        find = argv[i + 1]; i += 2
    else:
        print("usage: bb history [-n N|--all] [--since 7d|YYYY-MM-DD] "
              "[--find TEXT]", file=sys.stderr)
        sys.exit(1)

rows = []
# All four views, so "when did anything here mention X" means all of it. The
# findings log is the one nobody wrote: its rows carry no `by`, which reads
# correctly in this column as a blank rather than a name.
for tag, mod in (("roadmap", todo), ("bugs", bugs), ("memory", memory),
                 ("scanner", findings)):
    for e in mod.history(proj, since=since, find=find):
        rows.append((tag, e))
rows.sort(key=lambda te: -te[1].get("at", 0))
if limit:
    rows = rows[:limit]
if not rows:
    print(f"nothing in {proj}'s notebook matches that")
for tag, e in rows:
    when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
    where = f" step {e['step'] + 1} of" if e.get("step") is not None else ""
    ident = f" #{e['id']}" if e.get("id") is not None else ""
    print(f"  {when}  {tag:>7}  {e.get('by', ''):>6}  {e.get('act', ''):<11}"
          f"{where}{ident}  {e.get('text', '')}")
    if e.get("was"):
        print(f"{'':>41}was: {e['was']}")
    for k in ("why", "note"):
        if e.get(k):
            print(f"{'':>41}{k}: {e[k]}")
PY
}

cmd_bug() {
    # The bug tracker's CLI half — the side a session drives. Same shape as
    # cmd_todo: the project from the working directory (or BB_BUG_PROJECT for
    # callers that are not in one, like bb-tty), the module loaded from the
    # file beside this script so the checkout's copy is the one under test.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/bugs.py"
    [ -f "$py" ] || die "bugs.py is missing from this image"
    local proj="${BB_BUG_PROJECT:-}"
    if [ -z "$proj" ]; then
        local here; here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, sys, time

spec = importlib.util.spec_from_file_location("bugs", sys.argv[1])
bugs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bugs)


def write_json(path, obj):
    """Atomic, like the server's: a half-written tracker is worse than a
    failed write."""
    import os
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, str(path))


import os
_state = os.environ.get("DASHBOARD_STATE", "/config")
bugs.configure(write_json=write_json, state=_state)

# The roadmap's half of a notebook batch, and the coordinator over the two.
# `bb bug begin` and `bb roadmap begin` are the same command reached from
# either tab's name — one batch covers the notebook, so it would be a lie for
# the tracker to have a private one.
_here = os.path.dirname(sys.argv[1])


def _load(name):
    sp = importlib.util.spec_from_file_location(name, os.path.join(_here, name + ".py"))
    m = importlib.util.module_from_spec(sp)
    sp.loader.exec_module(m)
    return m


_todo = _load("todo")
_todo.configure(write_json=write_json, state=_state)
_nb = _load("notebook")
_nb.configure(todo_mod=_todo, bugs_mod=bugs)

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]


def bail(r):
    if r.get("error"):
        print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr)
        sys.exit(1)


def line(b):
    mark = " " if b.get("status") == "open" else "x"
    extra = "" if b.get("status") == "open" else f"  [{b['status']}]"
    return (f"  [{mark}] {b['id']:>3}  ({b.get('severity', 'medium')})  "
            f"{b['title']}{extra}")


def show(b):
    print(line(b))
    for k in ("area", "repro", "expected", "actual", "notes"):
        if b.get(k):
            body = b[k].replace("\n", "\n" + " " * 12)
            print(f"  {k:>8}: {body}")
    when = time.strftime("%d %b %H:%M", time.localtime(b.get("at", 0)))
    print(f"  {'by':>8}: {b.get('by', '?')} · {when}"
          + (f" · {b['status']}: {b.get('status_note', '')}"
             if b.get("status") != "open" else ""))


def rows():
    return bugs.payload(proj)["bugs"]


def pull_flags(args):
    """--sev/--area/--repro/--expected/--actual/--notes out of an argv,
    leaving the words that make the title."""
    words, out, i = [], {}, 0
    names = {"--sev": "severity", "--severity": "severity", "--area": "area",
             "--repro": "repro", "--expected": "expected",
             "--actual": "actual", "--notes": "notes"}
    while i < len(args):
        if args[i] in names:
            if i + 1 >= len(args):
                print(f"[builderbot] ERROR: {args[i]} needs a value after it",
                      file=sys.stderr)
                sys.exit(1)
            out[names[args[i]]] = args[i + 1]; i += 2
        else:
            words.append(args[i]); i += 1
    return " ".join(words).strip(), out


if op in ("list", "ls"):
    # Same banner the roadmap's listing carries, for the same batch. A session
    # that opened one on the roadmap and then came here to file something
    # should not have to remember that its notes are unrecorded.
    _b = _nb.state(proj)
    if _b:
        print(f"  [batch open — {_b['changes']} change"
              f"{'' if _b['changes'] == 1 else 's'} unrecorded across this "
              "notebook; bb bug commit, or revert]")
    open_rows = [b for b in rows() if b.get("status") == "open"]
    if not open_rows:
        print(f"no open bugs on {proj} — `bb bug all` includes the closed ones")
    for b in open_rows:
        print(line(b))
elif op == "all":
    if not rows():
        print(f"nothing in {proj}'s bug tracker")
    for b in rows():
        print(line(b))
elif op in ("begin", "commit", "revert"):
    # The same batch `bb roadmap begin` opens — one over the whole notebook,
    # reached from whichever tab's name you happened to be thinking in.
    if op == "begin":
        bail(_nb.begin(proj))
        print(f"batch open on {proj}'s notebook — the bug tracker and the "
              "roadmap both. Commit or revert it")
    elif op == "commit":
        r = _nb.commit(proj); bail(r)
        print(f"committed: {r['written']} entr{'y' if r['written'] == 1 else 'ies'}"
              + (f", {r['folded']} folded into them" if r["folded"] else ""))
    else:
        r = _nb.revert(proj); bail(r)
        print(f"reverted: the tracker and the roadmap are back as they were, "
              f"{r['dropped']} change{'' if r['dropped'] == 1 else 's'} dropped")
elif op in ("find", "search"):
    # Over the bugs themselves, not over the log. `history --find` searches
    # what happened; this searches what is *on file* — the area and the repro
    # above all, which is how you find out whether the thing you just tripped
    # over is already known.
    if not rest:
        print("usage: bb bug find <text>", file=sys.stderr); sys.exit(1)
    needle = " ".join(rest).lower()
    hits = [b for b in rows()
            if any(needle in str(b.get(k, "")).lower()
                   for k in ("title", "area", "repro", "expected", "actual",
                             "notes", "status_note"))]
    if not hits:
        print(f"nothing in {proj}'s tracker mentions that")
    for b in hits:
        print(line(b))
elif op == "show":
    if not rest:
        print("usage: bb bug show <n>", file=sys.stderr); sys.exit(1)
    b = next((x for x in rows() if str(x.get("id")) == rest[0]), None)
    if b is None:
        print(f"[builderbot] ERROR: no bug #{rest[0]} here", file=sys.stderr)
        sys.exit(1)
    show(b)
elif op == "add":
    title, flags = pull_flags(rest)
    r = bugs.add(proj, title, by="claude",
                 severity=flags.pop("severity", "medium"), **flags)
    bail(r)
    print(f"filed #{r['bug']['id']}: {r['bug']['title']}")
elif op == "note":
    # The everyday update: what a session learned about a bug it did not fix.
    # Appended rather than replacing, because the last analysis is not made
    # wrong by the next one — it is how the next one starts.
    if len(rest) < 2:
        print("usage: bb bug note <n> \"what you learned\"", file=sys.stderr)
        sys.exit(1)
    b = next((x for x in rows() if str(x.get("id")) == rest[0]), None)
    if b is None:
        print(f"[builderbot] ERROR: no bug #{rest[0]} here", file=sys.stderr)
        sys.exit(1)
    stamp = time.strftime("%d %b", time.localtime())
    body = (b.get("notes", "") + f"\n\n[{stamp}] " + " ".join(rest[1:])).strip()
    r = bugs.edit(proj, rest[0], by="claude", act="noted", notes=body); bail(r)
    print(f"noted on #{rest[0]}")
elif op == "edit":
    if len(rest) < 3 or rest[1] not in ("title", "sev", "severity", "area",
                                        "repro", "expected", "actual", "notes"):
        print("usage: bb bug edit <n> title|sev|area|repro|expected|actual|notes"
              " \"...\"", file=sys.stderr)
        sys.exit(1)
    k = "severity" if rest[1] in ("sev", "severity") else rest[1]
    r = bugs.edit(proj, rest[0], by="claude", **{k: " ".join(rest[2:])})
    bail(r)
    print(f"updated {k} on #{rest[0]}")
elif op in ("rm", "remove"):
    # For a report that should not exist — mis-filed, a duplicate, the wrong
    # project. A bug that was real and is dealt with gets `fix` or `wontfix`,
    # which keeps it; this does not, and says why in the log.
    if not rest:
        print("usage: bb bug rm <n> [\"why it should not have been filed\"]",
              file=sys.stderr)
        sys.exit(1)
    r = bugs.remove(proj, rest[0], why=" ".join(rest[1:]), by="claude"); bail(r)
    print(f"removed #{rest[0]} — closing keeps a bug, this does not")
elif op in ("fix", "wontfix", "na", "reopen"):
    if not rest:
        print(f"usage: bb bug {op} <n> [\"note\"]", file=sys.stderr); sys.exit(1)
    status = {"fix": "fixed", "wontfix": "wontfix", "na": "na",
              "reopen": "open"}[op]
    r = bugs.set_status(proj, rest[0], status,
                        note=" ".join(rest[1:]), by="claude")
    bail(r)
    print(f"#{rest[0]} {status}")
elif op in ("history", "log"):
    # The same filters `bb roadmap history` takes, because whoever learned one
    # should not have to learn the other. `bb history` merges all four.
    limit, since, find, i = 20, None, None, 0
    while i < len(rest):
        a = rest[i]
        if a in ("-n", "--last") and i + 1 < len(rest):
            limit = int(rest[i + 1]); i += 2
        elif a == "--all":
            limit = None; i += 1
        elif a == "--since" and i + 1 < len(rest):
            v = rest[i + 1]
            if v.rstrip("d").isdigit():
                since = int(time.time()) - int(v.rstrip("d")) * 86400
            else:
                try:
                    since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
                except ValueError:
                    print(f"[builderbot] ERROR: not a date or a day count: {v}",
                          file=sys.stderr)
                    sys.exit(1)
            i += 2
        elif a in ("--find", "-f") and i + 1 < len(rest):
            find = rest[i + 1]; i += 2
        else:
            print("usage: bb bug history [-n N|--all] [--since 7d|YYYY-MM-DD] "
                  "[--find TEXT]", file=sys.stderr)
            sys.exit(1)
    h = bugs.history(proj, limit=limit, since=since, find=find)
    if not h:
        print(f"nothing in {proj}'s tracker matches that")
    for e in h:
        when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
        print(f"  {when}  {e.get('by', ''):>6}  {e.get('act', ''):<9}"
              f"  #{e.get('id')}  {e.get('text', '')}")
        if e.get("note"):
            print(f"{'':>30}note: {e['note']}")
elif op == "--prompt":
    sys.stdout.write(bugs.prompt(proj))
else:
    print("usage: bb bug [list|all|show N|find TEXT|begin|commit|revert|add TITLE [--sev S] [--area ..] "
          "[--repro ..]|note N TEXT|edit N FIELD TEXT|fix N [NOTE]|"
          "wontfix N [WHY]|na N [WHY]|reopen N|rm N [WHY]|"
          "history [-n N] [--since D] [--find TEXT]]", file=sys.stderr)
    sys.exit(1)
PY
}

# The Analysis tab's log, for a session. Its own subcommand rather than a flag,
# because it answers a different question: not what the scanner says now, which
# is what the report is for, but what it has stopped and started saying — a
# finding that is simply absent this week leaves no other trace at all.
# ---- the phone, through the operator ---------------------------------------
# A session does not reach the handset itself. It says what it wants and why,
# the dashboard puts that in front of the operator, and on Allow the DASHBOARD
# runs it and hands back the output. So "did Claude touch my phone" has one
# answer, and it is on the card rather than in a scroll of transcript.
#
# The phone is on an adb server of its own, so a plain `adb devices` in a
# session shows the emulator and nothing else. That is the point: not a rule
# to remember, an address that was never given out.
cmd_phone() {
    local sub="${1:-status}" why="" auth url
    url="http://127.0.0.1:${DASHBOARD_PORT:-8080}/api/phone"
    auth="${DASHBOARD_AUTH:-}"
    [ -n "$auth" ] || die "DASHBOARD_AUTH is not set — this talks to the dashboard"
    shift || true
    case "$sub" in
        status)
            # A quoted heredoc, not `python3 -c` inside single quotes: the
            # escaping that needs is a minefield and this shipped broken once,
            # with a SyntaxError where the phone's model should have been.
            # The JSON arrives by environment, not by pipe: `python3 -` takes
            # its PROGRAM from stdin, so a heredoc and a pipe are competing for
            # the same channel and the heredoc wins — which is how this came to
            # be parsing an empty stdin as JSON.
            local body
            body="$(curl -fsS -u "$auth" "$url")" \
                || die "could not reach the dashboard on ${url}"
            BB_PHONE_JSON="$body" python3 - <<'PY'
import json, os

d = json.loads(os.environ["BB_PHONE_JSON"])
p = d.get("phone")
if p:
    print("phone:   {} ({})".format(p.get("model") or "phone", p.get("serial")))
else:
    print("phone:   not connected")
for a in d.get("asks") or []:
    print("waiting: #{} {}".format(a.get("id"), a.get("why")))
PY
            ;;
        run)
            # `--why` is required, not polite. The operator is being asked
            # about a command they did not write; without a sentence saying
            # what it is for, Allow is a guess.
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) why="${2:-}"; shift 2 ;;
                    --) shift; break ;;
                    *) die "usage: bb phone run --why \"what this is for\" -- adb args..." ;;
                esac
            done
            [ -n "$why" ] || die "bb phone run needs --why \"what this is for\""
            [ $# -gt 0 ] || die "nothing to run — put the adb arguments after --"
            BB_PHONE_WHY="$why" BB_PHONE_URL="$url" BB_PHONE_AUTH="$auth" \
                python3 - "$@" <<'PY'
import json, os, sys, time, urllib.request, base64

url, auth = os.environ["BB_PHONE_URL"], os.environ["BB_PHONE_AUTH"]
hdr = {"Content-Type": "application/json",
       "Authorization": "Basic " + base64.b64encode(auth.encode()).decode()}


def post(body):
    req = urllib.request.Request(url, json.dumps(body).encode(), hdr)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return json.load(e)
        except Exception:
            return {"error": f"HTTP {e.code}"}
    except Exception as e:
        return {"error": str(e)}


r = post({"action": "ask", "why": os.environ["BB_PHONE_WHY"], "cmd": sys.argv[1:]})
if r.get("error"):
    print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr); sys.exit(1)
rid = r["id"]
print(f"[builderbot] asked the operator (#{rid}) — waiting up to 15 minutes "
      "for Allow on the dashboard's Phone card", file=sys.stderr)
# Polled rather than pushed: this is a shell command waiting on a person, and
# a person is slow in a way no callback improves.
for _ in range(900):
    time.sleep(1)
    o = post({"action": "outcome", "id": rid})
    if o.get("error"):
        print(f"[builderbot] ERROR: {o['error']}", file=sys.stderr); sys.exit(1)
    if o["state"] == "denied":
        print("[builderbot] the operator said no", file=sys.stderr); sys.exit(1)
    if o["state"] == "done":
        sys.stdout.write(o.get("out") or "")
        sys.exit(o.get("code") or 0)
print("[builderbot] nobody answered within fifteen minutes", file=sys.stderr)
sys.exit(1)
PY
            ;;
        *) die "usage: bb phone [status|run --why \"...\" -- adb args...]" ;;
    esac
}

cmd_findings_history() {
    local py proj here
    py="$(dirname "$(readlink -f "$0")")/dashboard/findings.py"
    [ -f "$py" ] || die "findings.py is missing from this image"
    proj="${BB_FINDINGS_PROJECT:-}"
    if [ -z "$proj" ]; then
        here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys, time

spec = importlib.util.spec_from_file_location("findings", sys.argv[1])
fx = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fx)


def write_json(path, obj):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, str(path))


fx.configure(write_json=write_json,
             state=os.environ.get("DASHBOARD_STATE", "/config"))
proj, argv = sys.argv[2], sys.argv[3:]

# The same three filters the other logs take, parsed the same way — a day
# count or a date, because both are things somebody types from memory.
limit, since, find, i = 20, None, None, 0
while i < len(argv):
    a = argv[i]
    if a in ("-n", "--last") and i + 1 < len(argv):
        limit = fx._int(argv[i + 1]); i += 2
    elif a == "--all":
        limit = None; i += 1
    elif a == "--since" and i + 1 < len(argv):
        v = argv[i + 1]
        n = fx._int(v.rstrip("d")) if v.rstrip("d").isdigit() else None
        if n is not None:
            since = int(time.time()) - n * 86400
        else:
            try:
                since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
            except ValueError:
                print(f"[builderbot] ERROR: not a date or a day count: {v}",
                      file=sys.stderr); sys.exit(1)
        i += 2
    elif a in ("--find", "-f") and i + 1 < len(argv):
        find = argv[i + 1]; i += 2
    else:
        print("usage: bb findings history [-n N|--all] [--since 7d|YYYY-MM-DD] "
              "[--find TEXT]", file=sys.stderr)
        sys.exit(1)

h = fx.history(proj, limit=limit, since=since, find=find)
if not h:
    print(f"nothing in {proj}'s findings log matches that")
    print("the first scan of a project is its starting point rather than an "
          "entry, so this fills in from the second one onwards")
for e in h:
    when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
    print(f"  {when}  {e.get('act', ''):<8}  {e.get('text', '')}")
    if e.get("note"):
        print(f"{'':>24}{e['note']}")
PY
}

cmd_findings() {
    local target="" scope=mine proj
    # `bb findings history` reads the notebook's fourth log — what the scanner
    # has stopped and started saying here. Handed straight to the same helper
    # the other three use, so the filters are the ones already learned.
    if [ "${1:-}" = history ]; then
        shift; cmd_findings_history "$@"; return
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) scope=all ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-${FINDINGS_DIR:-/reports}}"
    command -v jq >/dev/null 2>&1 || die "jq is required for 'bb findings'"

    # SARIF paths are recorded relative to wherever the scanner saw the code,
    # which is not where this container mounts it. Dropping everything up to
    # and including the project directory name makes them repo-relative, so the
    # paths in the digest can be opened directly.
    proj="${FINDINGS_PROJECT:-$(basename "$PWD")}"

    local -a files=()
    if [ -f "$target" ]; then
        files=("$target")
    elif [ -d "$target" ]; then
        mapfile -t files < <(find "$target" -maxdepth 2 -type f \
            \( -name '*.sarif' -o -name '*.sarif.json' \) | sort)
    else
        die "no such file or directory: ${target} (mount your scanner's reports at /reports:ro)"
    fi

    [ "${#files[@]}" -gt 0 ] \
        || die "no .sarif files under ${target} — has the scanner run yet?"

    local f
    for f in "${files[@]}"; do
        printf '<!-- %s -->\n' "$f"
        jq -r --arg proj "$proj" --arg scope "$scope" "$FINDINGS_JQ" "$f" \
            || warn "could not parse ${f} as SARIF"
    done
}

# Lint the infrastructure files of the repo at PATH (default: here).
#
# This is the environment's lint, not the project's: shell scripts, Dockerfiles,
# workflows, compose files and XML are what every project in this container
# carries regardless of language, and they are exactly the files whose failures
# otherwise surface for the first time in a CI run. A project's own linters
# (eslint, ruff configs, gradle checks) stay the project's business — they have
# their own configuration and this must not second-guess it.
#
# Each check is skipped, visibly, when its tool is missing — an image from
# before these tools shipped should say so rather than pass by omission.
cmd_lint() {
    local root="${1:-$PWD}" rc=0 skipped=0
    [ -d "$root" ] || die "no such directory: ${root}"
    cd "$root"

    section() { printf '== %s ==\n' "$1"; }
    need() { # need TOOL — false (and say so) when it is not installed
        command -v "$1" >/dev/null 2>&1 && return 0
        printf '  [skip] %s is not in this image (predates it? update the container)\n' "$1"
        skipped=1
        return 1
    }
    # Files come from git when this is a repo, so vendored trees a project
    # ignores (node_modules, build output) are not dragged in; otherwise a
    # pruned find covers a directory that never got a .git.
    files() { # files GLOB...
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            git ls-files -z -- "$@" 2>/dev/null
        else
            local -a args=() g
            for g in "$@"; do args+=(-o -path "./$g"); done
            find . \( -name .git -o -name node_modules -o -name _work \) -prune \
                -o -type f \( "${args[@]:1}" \) -print0 2>/dev/null
        fi
    }

    # Shell scripts, by shebang — the same selection CI's lint workflow makes,
    # so passing here means passing there.
    section "shell scripts (shellcheck)"
    if need shellcheck; then
        local -a shells=()
        while IFS= read -r -d '' f; do
            head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*\b(ba)?sh\b' \
                && shells+=("$f")
        done < <(files '*')
        if [ "${#shells[@]}" -eq 0 ]; then
            echo "  none found"
        elif shellcheck -x -S warning "${shells[@]}"; then
            printf '  [ok]   %s script(s) clean\n' "${#shells[@]}"
        else
            printf '  [FAIL] shellcheck findings above\n'
            rc=1
        fi
    fi

    section "dockerfiles (hadolint)"
    if need hadolint; then
        local -a dfs=() f
        while IFS= read -r -d '' f; do dfs+=("$f"); done \
            < <(files 'Dockerfile' '*/Dockerfile' 'Dockerfile.*' '*/Dockerfile.*')
        if [ "${#dfs[@]}" -eq 0 ]; then
            echo "  none found"
        # hadolint reads .hadolint.yaml from the working directory on its own.
        elif hadolint "${dfs[@]}"; then
            printf '  [ok]   %s dockerfile(s) clean\n' "${#dfs[@]}"
        else
            printf '  [FAIL] hadolint findings above\n'
            rc=1
        fi
    fi

    section "github workflows (actionlint)"
    if compgen -G '.github/workflows/*.yml' >/dev/null \
        || compgen -G '.github/workflows/*.yaml' >/dev/null; then
        if need actionlint; then
            # A repo that declares its runner's labels wins; otherwise build the
            # declaration from this container's own RUNNER_LABELS, so runs-on
            # lines targeting this box are checked against what it really
            # carries — the "Waiting for a runner" label mismatch, caught here.
            local -a args=()
            if [ ! -f .github/actionlint.yaml ] && [ ! -f .github/actionlint.yml ] \
                && [ -n "${RUNNER_LABELS:-}" ]; then
                local cfg
                cfg="$(mktemp)"
                # shellcheck disable=SC2064 # expand now, not at trap time
                trap "rm -f '$cfg'" RETURN
                printf 'self-hosted-runner:\n  labels:\n' > "$cfg"
                printf '%s\n' "${RUNNER_LABELS//,/$'\n'}" \
                    | sed 's/^/    - /' >> "$cfg"
                args+=(-config-file "$cfg")
            fi
            # The workflow files are named explicitly: bare `actionlint` walks
            # up looking for a git repository and refuses a plain directory.
            local -a wfs=()
            local wf
            for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
                [ -e "$wf" ] && wfs+=("$wf")
            done
            if actionlint "${args[@]}" "${wfs[@]}"; then
                echo "  [ok]   workflows clean"
            else
                printf '  [FAIL] actionlint findings above\n'
                rc=1
            fi
        fi
    else
        echo "  none found"
    fi

    section "compose files (docker compose config)"
    local -a composes=() cf
    while IFS= read -r -d '' cf; do composes+=("$cf"); done \
        < <(files 'docker-compose.yml' 'docker-compose.yaml' 'compose.yml' 'compose.yaml')
    if [ "${#composes[@]}" -eq 0 ]; then
        echo "  none found"
    elif need docker; then
        for cf in "${composes[@]}"; do
            # Validation only — no daemon involved. An .env.example stands in
            # for the gitignored .env so required variables interpolate.
            local -a envarg=()
            [ -f .env ] || { [ -f .env.example ] && envarg=(--env-file .env.example); }
            if docker compose "${envarg[@]}" -f "$cf" config -q 2>&1 | sed 's/^/  /'; then
                printf '  [ok]   %s\n' "$cf"
            else
                printf '  [FAIL] %s\n' "$cf"
                rc=1
            fi
        done
    fi

    section "xml"
    local -a xmls=() x
    while IFS= read -r -d '' x; do xmls+=("$x"); done < <(files '*.xml')
    if [ "${#xmls[@]}" -eq 0 ]; then
        echo "  none found"
    else
        for x in "${xmls[@]}"; do
            # One line on failure, not a traceback — the line and column are
            # the useful part.
            if python3 -c "
import sys, xml.dom.minidom, xml.parsers.expat
try:
    xml.dom.minidom.parse(sys.argv[1])
except xml.parsers.expat.ExpatError as e:
    raise SystemExit(f'  {e}')
" "$x"; then
                printf '  [ok]   %s\n' "$x"
            else
                printf '  [FAIL] %s\n' "$x"
                rc=1
            fi
        done
    fi

    # Only where both halves exist, which is this repo: `bb help` and the
    # README's command list are two copies of one thing, and the copy nobody
    # runs is the one that goes stale — `bb sdk migrate` outlived its code in
    # the README because nothing compared them.
    if [ -f scripts/bb ] && [ -f README.md ] && grep -q '^bb status ' README.md; then
        section "docs (bb help vs README)"
        local missing extra
        missing="$(comm -23 \
            <(sed -n 's/^  bb \([a-z-]*\).*/\1/p' scripts/bb | sort -u) \
            <(sed -n 's/^bb \([a-z-]*\).*/\1/p' README.md | sort -u))"
        extra="$(comm -13 \
            <(sed -n 's/^  bb \([a-z-]*\).*/\1/p' scripts/bb | sort -u) \
            <(sed -n 's/^bb \([a-z-]*\).*/\1/p' README.md | sort -u))"
        if [ -z "$missing" ] && [ -z "$extra" ]; then
            echo "  [ok]   every command in bb help is in the README, and back"
        else
            [ -n "$missing" ] && printf '  [FAIL] in bb help, missing from README: %s\n' "$(echo "$missing" | tr '\n' ' ')"
            [ -n "$extra" ] && printf '  [FAIL] in README, not a bb command: %s\n' "$(echo "$extra" | tr '\n' ' ')"
            rc=1
        fi
    fi

    echo
    if [ "$rc" -ne 0 ]; then
        echo "lint: FAILURES above"
    elif [ "$skipped" -ne 0 ]; then
        echo "lint: clean, but some checks were skipped"
    else
        echo "lint: clean"
    fi
    return "$rc"
}

# ---- developing the container from inside it -----------------------------
# This repo IS the container's source, and the thing every session trips over
# first is that editing a file here changes nothing until an image is built
# and the container updated. These commands shorten that loop where it can be
# shortened — the dashboard is one Python file and one HTML file, nothing to
# compile — and say plainly what is and is not live where it cannot.

# The dashboard server process, by PID. Anchored on the script path so a
# shell whose command line merely mentions the dashboard is never matched —
# an unanchored pkill here once killed the real dashboard and, another time,
# the very shell that ran it.
dashboard_pid() {
    pgrep -f '^python3 [^ ]*/dashboard/server\.py$' 2>/dev/null | head -1
}

# The directory the running dashboard was started from, read off its command
# line — so "which copy is live" is a fact, not a guess from a marker file.
dashboard_dir() {
    local pid; pid="$(dashboard_pid)" || true
    [ -n "$pid" ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" | sed -E 's#^python3 (.*)/server\.py *$#\1#'
}

cmd_dashboard() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        test)
            # The repo's harness, not the image's: the point is to test the
            # checkout you are editing. Falls back to the installed copy for a
            # bare `bb dashboard test` outside a checkout.
            local here="${BB_REPO:-$PWD}/scripts/dashboard/test/run.sh"
            [ -x "$here" ] || here=/opt/builderbot/scripts/dashboard/test/run.sh
            [ -x "$here" ] || die "no dashboard test harness at $here"
            exec bash "$here" "$@"
            ;;
        dev)
            local dir="${1:-$PWD/scripts/dashboard}" pid env_pid
            if [ "$dir" = "--off" ]; then dir=/opt/builderbot/scripts/dashboard; fi
            dir="$(cd "$dir" 2>/dev/null && pwd)" || die "no such directory: ${1:-$PWD/scripts/dashboard}"
            [ -f "$dir/server.py" ] && [ -f "$dir/index.html" ] \
                || die "$dir does not hold a dashboard (server.py + index.html)"
            pid="$(dashboard_pid)" || true
            [ -n "$pid" ] || die "the dashboard is not running (ENABLE_DASHBOARD / DASHBOARD_AUTH?) — nothing to swap"
            env_pid="$pid"
            if [ "$(dashboard_dir)" = "$dir" ]; then
                log "dashboard: already serving from $dir"; return 0
            fi
            # Same environment the running one has — port, terminal port,
            # credential — read from the process, never printed. Only the
            # script changes.
            local envs=()
            while IFS= read -r -d '' kv; do
                case "$kv" in DASHBOARD_*=*|WORKSPACE=*|FINDINGS_DIR=*|BUILDER_HOME=*|BB_LOG_DIR=*) envs+=("$kv") ;; esac
            done < "/proc/$env_pid/environ"
            kill "$pid"
            for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
            # -u CLAUDECODE: this subcommand is usually run *by* a Claude
            # session, and `env` without -i hands the child everything the
            # caller has. The dashboard inheriting that variable makes its own
            # Install button refuse, quoting a message that tells the operator
            # to use the dashboard.
            nohup env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT "${envs[@]}" \
                python3 "$dir/server.py" >> "$(bb_log_dir)/dashboard.log" 2>&1 &
            sleep 1
            [ -n "$(dashboard_pid)" ] || die "the new dashboard did not stay up — see $(bb_log_dir)/dashboard.log"
            log "dashboard: now serving from $dir (pid $(dashboard_pid))"
            log "this lasts until the container restarts; 'bb dashboard dev --off' puts the image's copy back"
            ;;
        status)
            local d; d="$(dashboard_dir)" || { echo "dashboard: not running"; return 0; }
            if [ "$d" = /opt/builderbot/scripts/dashboard ]; then
                echo "dashboard: serving the image's copy ($d)"
            else
                echo "dashboard: serving a DEV copy from $d — 'bb dashboard dev --off' reverts"
            fi
            ;;
        *) die "usage: bb dashboard test|dev|status" ;;
    esac
}

# bb drift — what this checkout has changed that the running container is
# not serving. Compares the image's /opt/builderbot/scripts and the shipped
# templates against the repo's, file by file. Answers the question every
# session asks itself after editing anything here.
cmd_drift() {
    local repo="${1:-$PWD}" n=0
    [ -d "$repo/scripts" ] || die "$repo does not look like the BuilderBot checkout (no scripts/)"
    local pairs=("$repo/scripts:/opt/builderbot/scripts"
                 "$repo/config/templates:/opt/builderbot/templates")
    for pair in "${pairs[@]}"; do
        local src="${pair%%:*}" live="${pair##*:}"
        [ -d "$live" ] || { echo "  (no $live in this image)"; continue; }
        while IFS= read -r line; do
            n=$((n+1)); echo "  $line"
        done < <(diff -rq --exclude='__pycache__' --exclude='test' "$src" "$live" 2>/dev/null \
                 | sed -E "s#^Files $src/(.*) and $live/.* differ#changed: \1#; \
                           s#^Only in $src/?(.*): (.*)#new here: \1/\2#; \
                           s#^Only in $live/?(.*): (.*)#only in image: \1/\2#; s#: /#: #")
    done
    if [ "$n" = 0 ]; then
        echo "no drift: the running container is serving what this checkout holds"
    else
        echo "$n file(s) differ — the running container is NOT serving these; a change is live"
        echo "only after CI builds a new image and the container updates (or 'bb dashboard dev' for the dashboard)"
    fi
    if d="$(dashboard_dir 2>/dev/null)" && [ "$d" != /opt/builderbot/scripts/dashboard ]; then
        echo "dashboard: serving a dev copy from $d"
    fi
}

# Where Chromium actually is, in the order the answers can be trusted:
# PLAYWRIGHT_BROWSERS_PATH (what the image sets and any project honors), then
# the SDK share directly, then the historical /opt path. Resolved rather than
# hardcoded because the browsers moved out of the image: the /opt entry is a
# symlink the startup hook makes, and a hook that could not make it — /opt is
# root-owned — used to leave every screenshot command dead with the bytes
# sitting right there on the share.
find_chromium() {
    local base exe
    for base in "${PLAYWRIGHT_BROWSERS_PATH:-}" "$(sdk_root)/playwright" /opt/pw-browsers; do
        [ -n "$base" ] && [ -d "$base" ] || continue
        exe="$base/chromium"
        [ -x "$exe" ] && { printf '%s' "$exe"; return 0; }
        exe="$(find -L "$base" -path '*/chromium-*/chrome-linux*/chrome' -type f 2>/dev/null | head -1)"
        [ -n "$exe" ] && [ -x "$exe" ] && { printf '%s' "$exe"; return 0; }
    done
    die "no Playwright chromium found — install the browsers with: bb sdk install playwright"
}

# bb shot — headless screenshots, for showing the operator visual state from
# a box with no display. Playwright's Chromium from the image.
#
# One URL keeps the old shape (bb shot URL [FILE]). Several URLs share one
# browser and land in a directory, each named from its path (/ -> index.png).
# --full and --scale exist because README screenshots need the whole page at
# 2x — capabilities MediaReducer's tools/screenshots grew privately before
# this subsumed them; --resize is the imagemagick downscale that keeps those
# PNGs repo-sized; --wait absorbs pages whose async fetches settle after
# networkidle, because a screenshot of a spinner is not a screenshot of the
# page. The intended split: a project's own script boots its app into a
# photogenic state, then ends with one bb shot line.
cmd_shot() {
    local auth="${DASHBOARD_AUTH:-}" width=1280 height=800 scale=1 wait=0
    local full=0 resize="" out="" mode=file urls=()
    # Used by the test harness, which needs the same answer this does and
    # should not re-implement the search to get it.
    if [ "${1:-}" = --print-chromium ]; then find_chromium; printf '\n'; return 0; fi
    while [ $# -gt 0 ]; do
        case "$1" in
            --auth)   auth="$2"; shift 2 ;;
            --size)   width="${2%x*}"; height="${2#*x}"; shift 2 ;;
            --scale)  scale="$2"; shift 2 ;;
            --wait)   wait="$2"; shift 2 ;;
            --resize) resize="${2%x}"; shift 2 ;;
            --full)   full=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) case "$1" in
                   # Scheme-tagged, because page.goto needs one anyway: a bare
                   # host:port would produce a blank shot, so it is refused
                   # here where the message can say why.
                   http://*|https://*) urls+=("$1") ;;
                   *) [ -z "$out" ] || die "two outputs given: ${out} and $1"
                      out="$1" ;;
               esac; shift ;;
        esac
    done
    [ "${#urls[@]}" -gt 0 ] || die \
        "usage: bb shot URL... [FILE|DIR] [--auth user:pass] [--size WxH] [--full] [--scale N] [--wait MS] [--resize W]
URLs need their scheme (http:// or https://)"
    case "${width}${height}${scale}${wait}${resize}" in
        *[!0-9]*) die "--size WxH, --scale N, --wait MS and --resize W take whole numbers" ;;
    esac
    if [ -n "$resize" ] && ! command -v convert >/dev/null 2>&1; then
        die "--resize needs imagemagick's convert"
    fi

    # One output name only fits one shot; with several URLs (or a trailing
    # slash, or an existing directory) the output is a directory and the
    # names come from the URLs.
    if [ "${#urls[@]}" -gt 1 ]; then
        mode=dir; out="${out:-.}"; mkdir -p "$out"
    elif [ -n "$out" ] && { [ -d "$out" ] || [ "${out%/}" != "$out" ]; }; then
        mode=dir; mkdir -p "$out"
    else
        out="${out:-shot-$(date +%H%M%S).png}"
    fi

    local chrome; chrome="$(find_chromium)"
    local files
    files="$(NODE_PATH="${NODE_PATH:-/usr/lib/node_modules}" node - \
        "$chrome" "$auth" "$width" "$height" "$scale" "$wait" "$full" \
        "$mode" "$out" "${urls[@]}" <<'EOF'
const { chromium } = require("playwright");
const path = require("path");
const [exe, auth, w, h, scale, wait, full, mode, dest, ...urls] = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  const [username, password] = auth.includes(":") ? auth.split(/:(.*)/) : [null, null];
  // Credentials go both ways: httpCredentials answers a server that
  // challenges, the preemptive Authorization header satisfies one that
  // deliberately never does (the dashboard, whose challenge-free 401s are
  // what keep browsers from popping their own dialog).
  const ctx = await b.newContext({
    viewport: { width: +w, height: +h },
    deviceScaleFactor: +scale,
    ...(username ? { httpCredentials: { username, password },
                     extraHTTPHeaders: { Authorization: "Basic "
                       + Buffer.from(auth).toString("base64") } } : {}) });
  const p = await ctx.newPage();
  const taken = new Set();
  for (const url of urls) {
    await p.goto(url, { waitUntil: "networkidle" }).catch(() => {});
    if (+wait) await p.waitForTimeout(+wait);
    let out = dest;
    if (mode === "dir") {
      // Named from the path so reruns overwrite their own shots — with a
      // counter only for two URLs that share a path (e.g. differing query).
      const u = new URL(url);
      // No leading dash or dot: "/?view=x" would otherwise slug to
      // "-view-x.png", which convert then parses as an option. Capped at 80
      // because a long query string made a filename longer than the 255 a
      // filesystem takes, and the whole run died on ENAMETOOLONG.
      const s = ((u.pathname + u.search).replace(/^\/+|\/+$/g, "")
        .replace(/[^A-Za-z0-9._-]+/g, "-").replace(/^[-.]+/, "") || "index")
        .slice(0, 80);
      let name = s, n = 2;
      while (taken.has(name)) name = `${s}-${n++}`;
      taken.add(name);
      out = path.join(dest, name + ".png");
    }
    await p.screenshot({ path: out, fullPage: full === "1" });
    console.log(out);
  }
  await b.close();
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
)"
    if [ -n "$resize" ]; then
        # In place: the full-size original is scaffolding, the downscale is
        # the deliverable — keeping both would double the repo cost the flag
        # exists to avoid. -strip drops metadata for the same reason.
        while IFS= read -r f; do
            [ -n "$f" ] && convert "$f" -resize "${resize}x" -strip "$f"
        done <<< "$files"
    fi
    printf '%s\n' "$files"
}

# bb favicon — one SVG mark in, the favicon set a web app actually needs out:
# favicon.ico carrying every small size in one file (the bare /favicon.ico
# request browsers make on their own has no way to ask for a particular one),
# apple-touch-icon.png at 180 for iOS home screens, and the SVG copied
# alongside for browsers that prefer vector.
#
# Rasterized by Playwright's Chromium, packed by ImageMagick — that split
# because the image's ImageMagick writes ICO but carries no SVG delegate,
# and Chromium renders any SVG exactly the way a browser tab will show it.
# The mark itself stays the project's own; this is only the packaging every
# project would otherwise re-learn. (Generalized from the private tool
# MediaReducer grew for this, minus its PIL dependency, which the container
# python does not carry.)
cmd_favicon() {
    local svg="" out="" bg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bg) bg="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) if [ -z "$svg" ]; then svg="$1"; else out="$1"; fi; shift ;;
        esac
    done
    [ -n "$svg" ] || die "usage: bb favicon LOGO.svg [OUTDIR] [--bg COLOR]"
    [ -f "$svg" ] || die "no such file: $svg"
    # Only ever an argv to convert, but a color is a name or #hex, and saying
    # so beats handing ImageMagick something to be confused by.
    case "$bg" in *[!#A-Za-z0-9]*) die "--bg takes a CSS color name or #hex" ;; esac
    out="${out:-.}"
    mkdir -p "$out"
    command -v convert >/dev/null 2>&1 || die "imagemagick's convert is required"
    local chrome; chrome="$(find_chromium)"

    local tmp
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064 # expand the path now, not at trap time
    trap "rm -rf '$tmp'" RETURN
    # A page that is nothing but the mark, edge to edge: Chromium sizes the
    # SVG to the viewport, so the one file serves every raster size.
    {
        printf '<!doctype html><style>html,body{margin:0;height:100%%}svg{display:block;width:100vw;height:100vh}</style>\n'
        cat "$svg"
    } > "$tmp/mark.html"
    NODE_PATH="${NODE_PATH:-/usr/lib/node_modules}" node - "$chrome" "$tmp" <<'EOF'
const { chromium } = require("playwright");
const [exe, tmp] = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  for (const px of [16, 32, 48, 64, 128, 180, 256]) {
    const p = await b.newPage({ viewport: { width: px, height: px } });
    await p.goto(`file://${tmp}/mark.html`);
    await p.screenshot({ path: `${tmp}/${px}.png`, omitBackground: true });
    await p.close();
  }
  await b.close();
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
    convert "$tmp/16.png" "$tmp/32.png" "$tmp/48.png" "$tmp/64.png" \
            "$tmp/128.png" "$tmp/256.png" "$out/favicon.ico"
    if [ -n "$bg" ]; then
        # iOS composites the touch icon onto black when it is transparent;
        # --bg flattens it onto the color the caller actually wants.
        convert "$tmp/180.png" -background "$bg" -flatten "$out/apple-touch-icon.png"
    else
        cp "$tmp/180.png" "$out/apple-touch-icon.png"
    fi
    # Copied unless it already IS the output — regenerating in place is the
    # normal workflow and cp would fail on the self-copy.
    [ "$(readlink -f "$svg")" = "$(readlink -f "$out/favicon.svg")" ] \
        || cp "$svg" "$out/favicon.svg"
    log "wrote ${out}/favicon.ico (16-256), apple-touch-icon.png (180), favicon.svg"
}


cmd_doctor() {
    local ok=0
    check() { # check DESCRIPTION COMMAND...
        local desc="$1"; shift
        if "$@" >/dev/null 2>&1; then
            printf '  [ok]   %s\n' "$desc"
        else
            printf '  [FAIL] %s\n' "$desc"; ok=1
        fi
    }
    echo "== doctor =="
    check "claude on PATH"            command -v claude
    check "workspace writable"        test -w "$WORKSPACE"
    check "home writable"             test -w "$HOME"
    check "git identity configured"   git config --get user.email
    # No -f here: we only care that the connection and TLS handshake work.
    # These endpoints answer a bare GET with 4xx, which -f would treat as an error.
    check "anthropic api reachable"   curl -sS -m 10 -o /dev/null https://api.anthropic.com/
    check "github api reachable"      curl -sS -m 10 -o /dev/null https://api.github.com/
    if [ -S /var/run/docker.sock ]; then
        check "docker socket usable"  docker info
    else
        printf '  [skip] docker socket not mounted\n'
    fi
    # nvidia-smi is injected by the container runtime, never installed in the
    # image — its absence means no GPU was passed through.
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        printf '  [ok]   nvidia gpu: %s\n' \
            "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        # Compute works with the default capabilities; GL/EGL/Vulkan do not.
        # The vendor ICD only lands when capabilities include graphics, so test
        # for the file rather than trusting the variable.
        if [ ! -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
            printf '  [FAIL] nvidia gpu present but no EGL — set NVIDIA_DRIVER_CAPABILITIES=all\n'
            printf '         (currently %s; compute works, -gpu host does not)\n' \
                "${NVIDIA_DRIVER_CAPABILITIES:-unset, so the default compute,utility applies}"
            ok=1
        # The library being present is not the question anyone is asking. It
        # was reported as [ok] here for months while every attempt at hardware
        # rendering fell back to software, because NVIDIA's EGL also needs an X
        # server carrying its own GLX module and there was none. So ask EGL.
        elif vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
            printf '  [ok]   nvidia graphics stack usable (EGL vendor: %s)\n' "$vendor"
        elif [ -S /tmp/.X11-unix/X0 ]; then
            printf '  [warn] nvidia EGL is installed but gave no vendor driver on the X display\n'
            printf '         — Mesa answering means llvmpipe; the emulator will use software\n'
        else
            printf '  [warn] nvidia EGL is installed but has no display to render on\n'
            printf '         — %s; the emulator will use software (bb emu gpu)\n' \
                "$(command -v Xorg >/dev/null 2>&1 \
                   && echo "the X server did not start, see /var/log/xorg-builderbot.log" \
                   || echo "this image has no X server")"
        fi
    elif command -v nvidia-smi >/dev/null 2>&1; then
        printf '  [FAIL] nvidia-smi present but no GPU visible — check --runtime=nvidia --gpus all\n'
        ok=1
    else
        printf '  [skip] no nvidia gpu passed through\n'
    fi
    if [ -n "${GITHUB_PAT:-}" ]; then
        printf '  [ok]   runner credential: GITHUB_PAT in environment (visible to sessions)\n'
    elif sudo -n /opt/builderbot/scripts/mint-runner-token --check >/dev/null 2>&1; then
        # Presence is not validity — ask GitHub, so a revoked or expired token
        # cannot keep reporting [ok] here.
        if sudo -n /opt/builderbot/scripts/mint-runner-token --validate >/dev/null 2>&1; then
            printf '  [ok]   runner credential: shielded, and GitHub accepts the token\n'
        else
            printf '  [FAIL] runner credential: shielded but GitHub rejected it (revoked/expired?) — see: bb logs\n'
            ok=1
        fi
    else
        printf '  [skip] no runner credential (fine if ENABLE_RUNNER=false)\n'
    fi
    if gh auth status >/dev/null 2>&1; then
        printf '  [ok]   git over https authenticated (gh)\n'
    else
        printf '  [skip] git over https not authenticated (set GIT_PAT, or use an ssh key)\n'
    fi
    local ssh_src=""
    if ssh-add -l >/dev/null 2>&1; then
        ssh_src="shielded agent key"
    elif compgen -G "$HOME/.ssh/id_*" >/dev/null; then
        ssh_src="key file in ~/.ssh"
    fi
    # Distinguish "no key" from "key loaded but the agent is unreachable from
    # this uid", which is otherwise indistinguishable and very confusing.
    if [ -z "$ssh_src" ] && [ -S "${SSH_AUTH_SOCK:-/run/ssh-agent.sock}" ]; then
        printf '  [FAIL] an agent socket exists but this user cannot use it — see: bb logs | grep ssh\n'
        ok=1
    fi
    if [ -n "$ssh_src" ]; then
        # A successful GitHub ssh auth still exits nonzero (no shell access),
        # so judge by the greeting instead of the exit code. On failure report
        # what ssh actually said — host-key verification, a refused key and an
        # unreachable agent all look identical otherwise.
        local ssh_out ssh_why
        ssh_out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 git@github.com 2>&1 || true)"
        if printf '%s' "$ssh_out" | grep -q 'successfully authenticated'; then
            printf '  [ok]   github ssh auth works (%s)\n' "$ssh_src"
        else
            ssh_why="$(printf '%s' "$ssh_out" \
                | grep -iE 'permission denied|host key verification|remote host identification|no such identity|sign_and_send|connection closed|could not resolve|timed out' \
                | head -1)"
            printf '  [FAIL] %s but github auth failed: %s\n' \
                "$ssh_src" "${ssh_why:-$(printf '%s' "$ssh_out" | head -1)}"
            printf '         diagnose with: ssh -vT git@github.com\n'
            ok=1
        fi
    else
        printf '  [skip] no ssh key (agent empty, nothing in ~/.ssh)\n'
    fi
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        printf '  [ok]   ANTHROPIC_API_KEY set\n'
    elif [ -f "$HOME/.claude.json" ] || [ -d "$HOME/.claude" ]; then
        printf '  [ok]   Claude Code credentials present in %s\n' "$HOME"
    else
        printf '  [warn] no ANTHROPIC_API_KEY and no saved login — run `bb login`\n'
    fi
    return $ok
}

# Bare `bb` prints what it can do. It used to run `status`, which is the same
# wall of tool versions `bb status` gives you — an answer to a question nobody
# typing `bb` on its own was asking.
# bb version — this project's version identity, in whatever form is asking.
#
# The shell half is deliberately thin: everything that decides what a version
# IS lives in dashboard/version.py, because the notebook needs the same answers
# and two implementations of "what version is this" would drift the week one of
# them was touched. This resolves which project is being asked about and prints
# what the module returns.
cmd_version() {
    local py proj here
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys

spec = importlib.util.spec_from_file_location("version", sys.argv[1])
version = importlib.util.module_from_spec(spec)
spec.loader.exec_module(version)

# The changelog rides with the version: a bump dates its Unreleased section
# in the same commit, so the module that bumps needs the module that rolls.
_clpath = os.path.join(os.path.dirname(sys.argv[1]), "changelog.py")
_clspec = importlib.util.spec_from_file_location("changelog", _clpath)
changelog = importlib.util.module_from_spec(_clspec)
_clspec.loader.exec_module(changelog)


def write_json(path, obj):
    """Atomic, like the server's — a half-written policy file is read at every
    bump after it."""
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


version.configure(workspace=os.environ.get("BB_WORKSPACE", "/workspace"),
                  state=os.environ.get("DASHBOARD_STATE", "/config"),
                  write_json=write_json, changelog_mod=changelog)

proj, argv = sys.argv[2], sys.argv[3:]

# --for NAME asks about a component: a directory with its own VERSION file.
# Pulled out of argv first so it can sit anywhere, which is what anybody
# typing `bb version --for extension --code` expects.
comp = ""
if "--for" in argv:
    i = argv.index("--for")
    if i + 1 >= len(argv):
        print("--for needs a component directory", file=sys.stderr)
        raise SystemExit(1)
    comp = argv[i + 1]
    argv = argv[:i] + argv[i + 2:]

USAGE = ("bb version [--for DIR] "
         "[--semver|--code|--quad|--win|--msi|--pep440|--file|--json]\n"
         "bb version --list                 every version this repo carries\n"
         "bb version [--for DIR] bump major|minor|patch\n"
         "bb version [--for DIR] init X.Y.Z    give one its first VERSION\n"
         "bb version policy")


def fail(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def policy_line():
    pol = version.policy(proj)
    allowed = version.allows(pol)
    return (f"{pol}" + (f" — a session may move {', '.join(allowed)}"
                        if allowed else " — the operator only"))


if argv and argv[0] == "bump":
    if len(argv) < 2:
        fail("bb version bump major|minor|patch")
    # `by` is not a flag: this runs AS the session, so the only honest value
    # is the one the policy is about. The operator's bumps come from the
    # dashboard, which calls bump() directly.
    r = version.bump(proj, argv[1], by="claude", comp=comp)
    if r.get("error"):
        fail(r["error"])
    print(f"{proj}{'/' + comp if comp else ''} {r['was']} -> {r['target']}  "
          f"({r['part']}, committed {r['commit']}, not pushed)")
    if r.get("note"):
        print(f"note: {r['note']}")
    raise SystemExit(0)

if argv and argv[0] == "init":
    if len(argv) < 2:
        fail("bb version init X.Y.Z [--for DIR]")
    r = version.init(proj, argv[1], by="claude", comp=comp)
    if r.get("error"):
        fail(r["error"])
    print(f"{proj}{'/' + comp if comp else ''} is now {r['target']}  "
          f"(committed {r['commit']}, not pushed)")
    raise SystemExit(0)

if argv and argv[0] == "policy":
    # Read-only on purpose: a session should be able to see the limit it is
    # held to and never to move it.
    print(f"{proj}: {policy_line()}")
    print("the operator changes this on the project's Artifacts tab")
    raise SystemExit(0)

if argv and argv[0] == "--list":
    # What this repo actually carries. One line for a normal project; more
    # only where somebody put a VERSION file in a subdirectory.
    rows = [("", version.render(proj))] + [
        (c, version.render(proj, c)) for c in version.components(proj)]
    for name, rv in rows:
        label = f"{proj}/{name}" if name else proj
        print(f"  {label:<28} {rv['forms']['semver'] or '(none)'}")
    if len(rows) == 1:
        print("\n  one version for the whole repo. A directory with its own "
              "VERSION\n  file becomes a component with its own — see "
              "`bb version --for DIR`.")
    raise SystemExit(0)

v = version.render(proj, comp)
forms = v["forms"]

if argv and argv[0] == "--json":
    print(json.dumps(v, indent=1))
    raise SystemExit(0)

# --win is an alias rather than its own form: a Windows VERSIONINFO resource
# and a Firefox manifest want the identical four-integer string, and shipping
# two names for one value is cheaper than making somebody work that out.
FLAGS = {"--semver": "semver", "--code": "code", "--quad": "quad",
         "--win": "quad", "--moz": "quad", "--msi": "msi",
         "--pep440": "pep440", "--file": "file"}
if argv:
    key = FLAGS.get(argv[0])
    if key is None:
        fail(USAGE)
    if v.get("error"):
        fail(v["error"])
    if forms[key] is None:
        fail(
             f"no {argv[0]} form here: {proj} has no VERSION file, and that "
             "format cannot be produced without one")
    print(forms[key])
    raise SystemExit(0)

# The human summary.
if v.get("error"):
    print(f"{proj}: {v['error']}")
if forms["semver"]:
    # Not "[released]" beside "+dirty": HEAD being tagged does not make an
    # uncommitted tree the release, and the two claims side by side read as a
    # contradiction because they are one.
    print(f"{proj}{'/' + comp if comp else ''} {forms['semver']}"
          + ("   [released]" if v["released"] and not v["dirty"] else ""))
else:
    print(f"{proj}: no version could be determined")
print("  building towards  " + (
    v["target"] or ("(VERSION is there but unreadable — see above)"
                    if v.get("error") else "(no VERSION file — add one to opt in)")))
if v["ordinal"] is not None:
    print(f"  ordinal           {v['ordinal']}")
if v["sha"]:
    print(f"  commit            {v['sha']}"
          + ("  (working tree dirty)" if v["dirty"] else ""))

# What this container is running, but only where that is a comparison rather
# than a coincidence: BB_VERSION is the image's, and the image is built from
# THIS repo. Beside any other project's version it would be noise.
own = not comp and (version.root(proj) / "config/templates/project-CLAUDE.md").is_file()
running = os.environ.get("BB_VERSION", "").strip()
if own and running:
    print(f"  running here      {running}")
    if forms["semver"] and running != forms["semver"]:
        print("                    differs from this checkout — the box serves"
              " whatever image it last pulled")

print(f"  who may bump      {policy_line()}")

comps = version.components(proj)
if comps and not comp:
    print(f"  components        {', '.join(comps)}"
          f"   (bb version --for {comps[0]})")
since = version.since_bump(proj, comp)
if since.get("commits"):
    print(f"  since that target {since['commits']} commit"
          + ("" if since["commits"] == 1 else "s"))
if v.get("warn"):
    print(f"  warning           {v['warn']}")

other = [(f, forms[k]) for f, k in (("--code", "code"), ("--quad/--win", "quad"),
                                    ("--msi", "msi"), ("--pep440", "pep440"),
                                    ("--file", "file")) if forms[k]]
if other:
    print()
    for flag, val in other:
        print(f"  {flag:<12} {val}")
PY
}

# bb changelog — the user-facing record beside VERSION, per project or
# component. A session logs what changed for the person using the product;
# the next bump dates the accumulated lines. Writing goes through `add` so
# the shape stays uniform; reading is just the file.
cmd_changelog() {
    local py proj here
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        here="$(pwd -P)"
        case "$here" in
            "$WORKSPACE"/*) proj="${here#"$WORKSPACE"/}"; proj="${proj%%/*}" ;;
            *) die "not inside a project under ${WORKSPACE} — cd into one first" ;;
        esac
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, os, sys

spec = importlib.util.spec_from_file_location("version", sys.argv[1])
version = importlib.util.module_from_spec(spec)
spec.loader.exec_module(version)
_clspec = importlib.util.spec_from_file_location(
    "changelog", os.path.join(os.path.dirname(sys.argv[1]), "changelog.py"))
changelog = importlib.util.module_from_spec(_clspec)
_clspec.loader.exec_module(changelog)
version.configure(workspace=os.environ.get("BB_WORKSPACE", "/workspace"),
                  state=os.environ.get("DASHBOARD_STATE", "/config"),
                  write_json=lambda *a: None)

proj, argv = sys.argv[2], sys.argv[3:]
comp = ""
if "--for" in argv:
    i = argv.index("--for")
    if i + 1 >= len(argv):
        print("--for needs a component directory", file=sys.stderr)
        raise SystemExit(1)
    comp = argv[i + 1]
    argv = argv[:i] + argv[i + 2:]

d = version._sub(proj, comp)
if d is None:
    print(f"no such component here: {comp}", file=sys.stderr)
    raise SystemExit(1)

if argv and argv[0] == "add":
    if len(argv) < 2 or not argv[1].strip():
        print('bb changelog add "what changed, for the person using it" '
              '[--for DIR]', file=sys.stderr)
        raise SystemExit(1)
    # Stamped with HEAD: the instruction in the template is to log after
    # committing, so the sha names the commit the entry describes.
    sha = version._git(proj, "rev-parse", "--short=7", "HEAD") or ""
    r = changelog.add(d, argv[1], sha=sha)
    if r.get("error"):
        print(r["error"], file=sys.stderr)
        raise SystemExit(1)
    n = len(changelog.unreleased(d))
    print(f"logged{' (new ' + changelog.FILE + ')' if r.get('created') else ''} — "
          f"{n} unreleased entr{'y' if n == 1 else 'ies'} now waiting for a bump")
    raise SystemExit(0)

if argv:
    print("bb changelog [--for DIR]         read it\n"
          'bb changelog add "..." [--for DIR]   log a user-facing change',
          file=sys.stderr)
    raise SystemExit(1)

text = changelog.read(d)
if text is None:
    print(f"no {changelog.FILE} here yet — the first "
          f"`bb changelog add` creates it")
    raise SystemExit(0)
print(text, end="")
PY
}

case "${1:-help}" in
    status)   cmd_status ;;
    version)  shift; cmd_version "$@" ;;
    changelog) shift; cmd_changelog "$@" ;;
    projects) cmd_projects ;;
    shell)    exec bash -l ;;
    update)   cmd_update ;;
    login)    cmd_login ;;
    runner)   shift; cmd_runner "$@" ;;
    emu)      shift; cmd_emu "$@" ;;
    claude-md|claudemd) shift; cmd_claude_md "$@" ;;
    lint)     shift; cmd_lint "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    # `todo` still works: sessions started before the rename carry it in their
    # prompt, and a live conversation should not break on a word change.
    roadmap|todo) shift; cmd_roadmap "$@" ;;
    bug|bugs) shift; cmd_bug "$@" ;;
    history)  shift; cmd_history "$@" ;;
    logs)     shift; cmd_logs "$@" ;;
    ci-log)   shift; cmd_ci_log "$@" ;;
    phone)    shift; cmd_phone "$@" ;;
    doctor)   cmd_doctor ;;
    dashboard) shift; cmd_dashboard "$@" ;;
    drift)    shift; cmd_drift "$@" ;;
    shot)     shift; cmd_shot "$@" ;;
    favicon)  shift; cmd_favicon "$@" ;;
    sdk)      shift; cmd_sdk "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
