#!/usr/bin/env bash
#
# `bb` — small convenience CLI inside the container.
#
set -euo pipefail

. /opt/builderbot/scripts/lib/common.sh

usage() {
    cat <<'EOF'
bb — BuilderBot helper

  bb status              show tool versions, runner state and mounted projects
  bb projects            list mounted project directories
  bb shell               open a login shell as the builder user
  bb update              update Claude Code (and npm globals) in place
  bb login               run the Claude Code auth flow
  bb runner status       registration, and whether it is connected/busy
  bb runner stop         stop it and wait for GitHub to release the session
  bb runner start        start it if it is not already running
  bb runner restart      stop, then start (add --force to interrupt a job)
  bb emu start [API]     boot the emulator headless (e.g. `bb emu start 37`)
  bb emu stop            shut the emulator down
  bb emu status          adb devices
  bb emu list            configured API levels and the AVDs that exist
  bb claude-md           is this project's CLAUDE.md environment block current?
  bb claude-md --update  refresh that block, leaving the project section alone
  bb claude-md --init    create a CLAUDE.md here from the shipped template
  bb findings [PATH]     digest scanner SARIF findings for this project
  bb findings --all      ...including findings in other projects' trees
  bb logs [-f] [N]       show this boot's log (default: last 100 lines)
  bb logs -p [N]         show a previous boot's log (the log rotates per start)
  bb logs --list         list the kept boot logs, newest first
  bb doctor              check the things that usually go wrong
EOF
}

# version LABEL COMMAND... — print a tool's version, or "-" when it is absent
# or answers with nothing.
version() {
    local label="$1"; shift
    local out
    out="$("$@" 2>/dev/null | head -1)" || out=""
    printf '  %-8s %s\n' "$label" "${out:--}"
}

cmd_status() {
    echo "== versions =="
    version claude claude --version
    version node   node --version
    version npm    npm --version
    version python python3 --version
    version uv     uv --version
    version git    git --version
    version gh     gh --version
    version docker docker --version
    version mise   mise --version
    version java   java --version
    version adb    adb --version
    version pw     playwright --version
    printf '  %-8s %s\n' runner "$(cat "${RUNNER_DIR}/.runner-version" 2>/dev/null || echo '-')"
    echo
    echo "== runner =="
    if [ -f "${RUNNER_DIR}/.runner" ]; then
        jq -r '"  name: \(.agentName)\n  url:  \(.gitHubUrl)"' "${RUNNER_DIR}/.runner" 2>/dev/null \
            || echo "  registered"
        if pgrep -f 'Runner.Listener' >/dev/null; then
            echo "  state: listening for jobs"
        else
            echo "  state: starting up or between jobs"
        fi
    else
        echo "  not registered (ENABLE_RUNNER=${ENABLE_RUNNER:-true})"
    fi
    echo
    cmd_projects
}

cmd_projects() {
    echo "== projects (${WORKSPACE}) =="
    local d found=0
    for d in "$WORKSPACE"/*/; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in _work) continue ;; esac
        found=1
        if [ -d "$d/.git" ]; then
            printf '  %-40s git: %s\n' "$(basename "$d")" "$(git_branch "$d")"
        else
            printf '  %-40s (not a git repo)\n' "$(basename "$d")"
        fi
    done
    [ "$found" -eq 1 ] || echo "  none mounted"
}

cmd_update() {
    log "updating Claude Code"
    install_claude_code "${CLAUDE_CODE_VERSION:-latest}" \
        || die "update failed — the image's baked-in version is still on PATH"
    claude --version
}

cmd_login() {
    claude /login || claude
}

RUNNER_PIDFILE="${RUNNER_DIR}/.runner.pid"

# The supervisor, by pid rather than by command-line pattern. `pgrep -f
# runner.sh` matches any process that merely mentions the string — a grep, an
# editor, the shell running this very script — and a pkill on that pattern
# takes them with it.
runner_pid() {
    local pid
    pid="$(cat "$RUNNER_PIDFILE" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s' "$pid"
}

# The listener, matched on its executable path. The leading slash keeps the
# pattern from matching a command line that only names it — including the
# `pgrep -af Runner.Listener` we suggest to the user.
listener_pids() { pgrep -f '/Runner\.Listener' 2>/dev/null || true; }
worker_running() { pgrep -f '/Runner\.Worker' >/dev/null 2>&1; }

# runner_alive — anything that still holds this runner's GitHub session.
#
# Both halves matter. runner.sh is the supervisor; Runner.Listener is what is
# actually connected. Killing only the supervisor leaves the listener holding
# the session, which is what produces "A session for this runner already
# exists" followed by an endless "Runner connect error: Error: Conflict".
runner_alive() {
    runner_pid >/dev/null || [ -n "$(listener_pids)" ]
}

# runner_link — "ok" or "down", from the last connectivity marker the runner
# logged. A listener process being up says only that it is trying; the runner
# retries a rejected connection forever without exiting, so the process alone
# cannot tell a working runner from one stuck on Conflict.
runner_link() {
    local last
    last="$(tail -n 500 "$(bb_log_dir)/builderbot.log" 2>/dev/null \
            | grep -E 'Listening for Jobs|Runner reconnected|Runner connect error' \
            | tail -n 1 || true)"
    case "$last" in
        *"Runner connect error"*) printf 'down' ;;
        *)                        printf 'ok'   ;;   # also the unknown case
    esac
}

# runner_stop [--force] — bring the runner down and wait for it to let go.
#
# The waiting is the whole point. runner.sh drains any in-flight job and then
# deregisters, so "stopped" is not immediate; starting a second registration
# before the first has released the session is exactly what makes GitHub answer
# Conflict, and the old process's deregister would then tear down the
# registration the new one just made.
runner_stop() {
    local force=0 waited=0 grace="${RUNNER_STOP_GRACE:-90}" pid
    [ "${1:-}" = "--force" ] && force=1

    if worker_running && [ "$force" -eq 0 ]; then
        warn "a job is running right now — stopping would fail it on GitHub."
        warn "Wait for it to finish, or pass --force."
        return 1
    fi

    runner_alive || { echo "runner is not running"; return 0; }

    echo "stopping the runner…"
    pid="$(runner_pid || true)"
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
    pkill -TERM -f '/Runner\.Listener' 2>/dev/null || true

    while runner_alive && [ "$waited" -lt "$grace" ]; do
        sleep 1
        waited=$((waited + 1))
        [ $((waited % 10)) -eq 0 ] && echo "  still stopping… ${waited}s"
    done

    if runner_alive; then
        warn "runner did not stop within ${grace}s; killing it"
        pid="$(runner_pid || true)"
        [ -n "$pid" ] && kill -KILL "$pid" 2>/dev/null
        pkill -KILL -f '/Runner\.Listener' 2>/dev/null || true
        rm -f "$RUNNER_PIDFILE"
        sleep 2
        warn "a killed runner cannot deregister — GitHub may hold the old session"
        warn "for a minute or two and log Conflict until it expires."
        return 0
    fi
    echo "stopped cleanly after ${waited}s"
}

runner_start() {
    local out=/proc/1/fd/1 tries=10
    if runner_alive; then
        echo "runner is already running"
        return 0
    fi
    # PID 1's stdout is the container log, but /proc/1/fd is root-only — fall
    # back to the log file rather than let the redirect fail and take the
    # runner with it.
    [ -w "$out" ] || out="$(bb_log_dir)/builderbot.log"
    nohup /opt/builderbot/scripts/runner.sh >>"$out" 2>&1 &

    # Confirm it actually came up. Reporting "starting" and returning is how a
    # runner that died on launch gets reported as healthy by everything
    # downstream, including the dashboard.
    while [ "$tries" -gt 0 ]; do
        sleep 0.5
        if runner_alive; then echo "runner started"; return 0; fi
        tries=$((tries - 1))
    done
    warn "runner did not come up within 5s — see: bb logs"
    return 1
}

cmd_runner() {
    case "${1:-status}" in
        status)
            if [ -f "${RUNNER_DIR}/.runner" ]; then
                cat "${RUNNER_DIR}/.runner"
            else
                echo "not registered"
            fi
            echo
            if worker_running; then
                echo "state: running a job"
            elif ! runner_alive; then
                echo "state: not running"
            elif [ "$(runner_link)" = "down" ]; then
                echo "state: cannot connect — retrying"
                tail -n 500 "$(bb_log_dir)/builderbot.log" 2>/dev/null \
                    | grep -E 'Runner connect error|session for this runner already exists' \
                    | tail -n 2 || true
                echo
                echo "If it says the session already exists, something else is holding this"
                echo "runner's name: another container using the same RUNNER_NAME, or a"
                echo "listener left behind by a half-finished restart. It clears when GitHub"
                echo "expires the old session — a minute or two. Check for a stray listener:"
                echo "    pgrep -af Runner.Listener"
            else
                echo "state: listening for jobs"
            fi
            ;;
        stop)    runner_stop "${2:-}" ;;
        start)   runner_start ;;
        restart) runner_stop "${2:-}" && runner_start ;;
        *) usage; exit 1 ;;
    esac
}

avd_exists() { avdmanager list avd 2>/dev/null | grep -q "Name: ${1}$"; }

# emu_avd [TARGET] — resolve which AVD to act on. A bare API level (37) maps to
# that version's AVD; anything else is taken as a literal name. With no target:
# ANDROID_AVD_NAME wins if set, then the first configured API level, then the
# unsuffixed name AVDs used before this was multi-version.
emu_avd() {
    local target="${1:-}" prefix="${ANDROID_AVD_PREFIX:-builderbot}" first
    if [ -n "$target" ]; then
        case "$target" in
            *[!0-9]*) printf '%s' "$target" ;;
            *)        printf '%s-%s' "$prefix" "$target" ;;
        esac
        return
    fi
    if [ -n "${ANDROID_AVD_NAME:-}" ]; then
        printf '%s' "$ANDROID_AVD_NAME"
        return
    fi
    first="$(printf '%s' "${ANDROID_SYSTEM_IMAGES:-35}" | tr ',' ' ' | awk '{print $1}')"
    if avd_exists "${prefix}-${first}"; then
        printf '%s-%s' "$prefix" "$first"
    else
        printf '%s' "$prefix"
    fi
}

cmd_emu() {
    local avd
    case "${1:-status}" in
        start)
            command -v emulator >/dev/null 2>&1 \
                || die "emulator is not installed in this image"
            if adb devices 2>/dev/null | grep -q '^emulator-'; then
                log "an emulator is already running"; adb devices; return 0
            fi
            avd="$(emu_avd "${2:-}")"
            avd_exists "$avd" \
                || die "AVD '${avd}' not found — add its API level to ANDROID_SYSTEM_IMAGES and restart, or see: bb emu list"
            [ -w /dev/kvm ] || warn "/dev/kvm not available — this will be very slow"
            # Software rendering by default: it is the only mode guaranteed to
            # work with no GPU passed through. With an NVIDIA GPU (and
            # NVIDIA_DRIVER_CAPABILITIES including graphics) try host; with
            # neither, swangle_indirect is usually faster than swiftshader.
            local gpu="${ANDROID_EMULATOR_GPU:-swiftshader_indirect}"
            log "starting AVD '${avd}' headless, -gpu ${gpu} (log: ~/.android/emulator.log)"
            nohup emulator -avd "$avd" -no-window -no-audio -no-boot-anim \
                -gpu "$gpu" \
                > "$HOME/.android/emulator.log" 2>&1 &
            log "waiting for the device to come up..."
            adb wait-for-device
            adb devices
            ;;
        stop)
            adb emu kill 2>/dev/null || warn "no emulator to stop"
            ;;
        status)
            adb devices -l
            ;;
        list)
            printf 'configured API levels: %s\n' "${ANDROID_SYSTEM_IMAGES:-35}"
            printf 'default for `bb emu start`: %s\n\n' "$(emu_avd)"
            avdmanager list avd 2>/dev/null \
                | grep -E 'Name:|Based on:' \
                | sed 's/^ */  /' \
                || printf '  (no AVDs)\n'
            ;;
        *) usage; exit 1 ;;
    esac
}

cmd_logs() {
    local base logfile follow=0 lines=100 gen=""
    base="$(bb_log_dir)/builderbot.log"
    while [ $# -gt 0 ]; do
        case "$1" in
            -f) follow=1 ;;
            -l|--list)
                # Newest first, so the top of the list is the current boot.
                ls -1t "$base" "$base".[0-9]* 2>/dev/null \
                    || die "no logs in $(bb_log_dir)"
                return 0
                ;;
            -p|--prev)
                # The log rotates per container start, so generation N is the
                # Nth boot back. Bare -p means the previous one.
                case "${2:-}" in
                    ''|*[!0-9]*) gen=1 ;;
                    *) gen="$2"; shift ;;
                esac
                ;;
            *[0-9]*) lines="$1" ;;
        esac
        shift
    done
    if [ -n "$gen" ]; then
        logfile="${base}.${gen}"
    else
        logfile="$base"
    fi
    [ -f "$logfile" ] || die "no log at ${logfile} — see: bb logs --list"
    if [ "$follow" -eq 1 ]; then
        tail -n "$lines" -f "$logfile"
    else
        tail -n "$lines" "$logfile"
    fi
}

TEMPLATE_MD=/opt/builderbot/templates/project-CLAUDE.md
ENV_BEGIN='<!-- BUILDERBOT:ENV:BEGIN -->'
ENV_END='<!-- BUILDERBOT:ENV:END -->'

# Print the marked environment block of a file, markers included.
md_block() { awk -v b="$ENV_BEGIN" -v e="$ENV_END" \
    'index($0,b){f=1} f{print} index($0,e){exit}' "$1"; }

# Keep a project's CLAUDE.md environment section in step with the image.
#
# The block is delimited so refreshing it is a substitution rather than a
# judgement call: everything below the end marker is the project's own and is
# never read, compared or written. That is the whole point — the environment
# notes go stale every time the container gains a feature, and the project
# notes are the expensive part nobody wants to risk.
cmd_claude_md() {
    local mode=check target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --update) mode=update ;;
            --init)   mode=init ;;
            --check)  mode=check ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-$PWD/CLAUDE.md}"
    [ -f "$TEMPLATE_MD" ] || die "no template at ${TEMPLATE_MD} — is this an older image?"

    if [ ! -f "$target" ]; then
        if [ "$mode" = init ]; then
            cp "$TEMPLATE_MD" "$target"
            log "created ${target} — fill in the project section below the end marker"
            return 0
        fi
        die "no ${target}. Create one with: bb claude-md --init"
    fi

    if ! grep -qF "$ENV_BEGIN" "$target" || ! grep -qF "$ENV_END" "$target"; then
        warn "${target} has no BUILDERBOT:ENV markers"
        warn "It predates them, so which part is environment and which is yours"
        warn "cannot be determined safely. Merge once by hand — or ask Claude to —"
        warn "putting the block from ${TEMPLATE_MD} above your project section."
        return 1
    fi

    local tmp_new tmp_cur
    tmp_new="$(mktemp)"; tmp_cur="$(mktemp)"
    # shellcheck disable=SC2064 # expand the paths now, not at trap time
    trap "rm -f '$tmp_new' '$tmp_cur'" RETURN
    md_block "$TEMPLATE_MD" > "$tmp_new"
    md_block "$target"      > "$tmp_cur"

    if cmp -s "$tmp_new" "$tmp_cur"; then
        log "${target}: environment block is current"
        return 0
    fi

    if [ "$mode" != update ]; then
        log "${target}: environment block differs from the image's template"
        diff -u --label "$target" --label "$TEMPLATE_MD" "$tmp_cur" "$tmp_new" || true
        log "refresh just that block with: bb claude-md --update"
        return 0
    fi

    local out; out="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp_new' '$tmp_cur' '$out'" RETURN
    awk -v b="$ENV_BEGIN" -v e="$ENV_END" -v repl="$tmp_new" '
        index($0,b) { while ((getline line < repl) > 0) print line; skip=1; next }
        index($0,e) { skip=0; next }
        !skip       { print }
    ' "$target" > "$out"

    grep -qF "$ENV_END" "$out" || die "refused to write: the result lost its end marker"
    cat "$out" > "$target"
    log "${target}: environment block updated; your project section is untouched"
}

# Reduce a SARIF report to grouped markdown.
#
# This reads scan output and nothing else. The scanner itself lives outside the
# container on purpose — /reports is mounted read-only and no scanner binary is
# installed — so there is no way to start a scan from in here, by design. If the
# findings look stale, the fix is to re-run the scanner on the host.
#
# Raw SARIF is mostly metadata: a few hundred KB of it would fill a session's
# context before it reached the code the findings are about. Grouping by
# severity then rule, and listing bare locations under one message, keeps the
# same information at a fraction of the size.
FINDINGS_JQ='
def parts($p): ($p | ltrimstr("/") | split("/"));

# Everything up to and including the project directory is where the scanner
# saw the code, not where this container mounts it. Dropping that prefix makes
# the path openable from the project root.
def strip_path($p): parts($p) as $ps
  | ($ps | index($proj)) as $i
  | if $i != null then ($ps[($i + 1):] | join("/")) else ($ps | join("/")) end;

def rank: {"error":0, "warning":1, "note":2, "info":2, "none":3}[.] // 4;

[ .runs[]
  | (reduce ((.tool.driver.rules // [])[]) as $x
      ({}; .[$x.id] = { level: ($x.defaultConfiguration.level // "warning"),
                        desc:  ($x.shortDescription.text // $x.fullDescription.text // "") })) as $rules
  | .results[]?
  | (.locations[0].physicalLocation.artifactLocation.uri // "?") as $uri
  | { level: (.level // $rules[.ruleId].level // "warning"),
      rule:  (.ruleId // "unknown"),
      # The rule description beats the result message as a group heading. Some
      # tools (Trivy) put the artifact path on the message first line, so the
      # heading would name one file while the group lists several.
      msg:   ( if ($rules[.ruleId].desc // "") != "" then $rules[.ruleId].desc
               else ((.message.text // "") | split("\n")[0]) end ),
      mine:  ((parts($uri) | index($proj)) != null),
      # First two components identify the tree a finding came from, which is
      # what you need when the answer is "that is a different project".
      tree:  (parts($uri)[0:2] | join("/")),
      loc:   ( strip_path($uri)
               + ":" + ((.locations[0].physicalLocation.region.startLine // 0) | tostring) ) } ]
| . as $all
| (if $scope == "all" then $all else map(select(.mine)) end) as $rows
| ($rows | length) as $n
| if ($all | length) == 0 then "No findings.\n"
  elif $n == 0 then
    "No findings for \($proj). This report covers: "
    + (($all | map(.tree) | unique | join(", ")))
    + "\nRun with --all to see them anyway.\n"
  else
  ( "# Findings (\($n))"
  + (if $scope == "all" then " — all projects in this report\n"
     else " in \($proj), of \($all | length) in the report — --all for the rest\n" end)
  + ( $rows | group_by(.level) | sort_by(.[0].level | rank)
      | map( "\n## \(.[0].level) (\(length))\n"
             + ( group_by(.rule) | sort_by(-length)
                 | map( "\n### \(.[0].rule) (\(length))\n\(.[0].msg)\n"
                        + ( map("- \(.loc)") | unique | join("\n") ) + "\n" )
                 | join("") ) )
      | join("") ) )
  end'

cmd_findings() {
    local target="" scope=mine proj
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) scope=all ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-${FINDINGS_DIR:-/reports}}"
    command -v jq >/dev/null 2>&1 || die "jq is required for 'bb findings'"

    # SARIF paths are recorded relative to wherever the scanner saw the code,
    # which is not where this container mounts it. Dropping everything up to
    # and including the project directory name makes them repo-relative, so the
    # paths in the digest can be opened directly.
    proj="${FINDINGS_PROJECT:-$(basename "$PWD")}"

    local -a files=()
    if [ -f "$target" ]; then
        files=("$target")
    elif [ -d "$target" ]; then
        mapfile -t files < <(find "$target" -maxdepth 2 -type f \
            \( -name '*.sarif' -o -name '*.sarif.json' \) | sort)
    else
        die "no such file or directory: ${target} (mount your scanner's reports at /reports:ro)"
    fi

    [ "${#files[@]}" -gt 0 ] \
        || die "no .sarif files under ${target} — has the scanner run yet?"

    local f
    for f in "${files[@]}"; do
        printf '<!-- %s -->\n' "$f"
        jq -r --arg proj "$proj" --arg scope "$scope" "$FINDINGS_JQ" "$f" \
            || warn "could not parse ${f} as SARIF"
    done
}

cmd_doctor() {
    local ok=0
    check() { # check DESCRIPTION COMMAND...
        local desc="$1"; shift
        if "$@" >/dev/null 2>&1; then
            printf '  [ok]   %s\n' "$desc"
        else
            printf '  [FAIL] %s\n' "$desc"; ok=1
        fi
    }
    echo "== doctor =="
    check "claude on PATH"            command -v claude
    check "workspace writable"        test -w "$WORKSPACE"
    check "home writable"             test -w "$HOME"
    check "git identity configured"   git config --get user.email
    # No -f here: we only care that the connection and TLS handshake work.
    # These endpoints answer a bare GET with 4xx, which -f would treat as an error.
    check "anthropic api reachable"   curl -sS -m 10 -o /dev/null https://api.anthropic.com/
    check "github api reachable"      curl -sS -m 10 -o /dev/null https://api.github.com/
    if [ -S /var/run/docker.sock ]; then
        check "docker socket usable"  docker info
    else
        printf '  [skip] docker socket not mounted\n'
    fi
    # nvidia-smi is injected by the container runtime, never installed in the
    # image — its absence means no GPU was passed through.
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        printf '  [ok]   nvidia gpu: %s\n' \
            "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        # Compute works with the default capabilities; GL/EGL/Vulkan do not.
        # The vendor ICD only lands when capabilities include graphics, so test
        # for the file rather than trusting the variable.
        if [ -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
            printf '  [ok]   nvidia graphics stack injected (EGL available)\n'
        else
            printf '  [FAIL] nvidia gpu present but no EGL — set NVIDIA_DRIVER_CAPABILITIES=all\n'
            printf '         (currently %s; compute works, -gpu host does not)\n' \
                "${NVIDIA_DRIVER_CAPABILITIES:-unset, so the default compute,utility applies}"
            ok=1
        fi
    elif command -v nvidia-smi >/dev/null 2>&1; then
        printf '  [FAIL] nvidia-smi present but no GPU visible — check --runtime=nvidia --gpus all\n'
        ok=1
    else
        printf '  [skip] no nvidia gpu passed through\n'
    fi
    if [ -n "${GITHUB_PAT:-}" ]; then
        printf '  [ok]   runner credential: GITHUB_PAT in environment (visible to sessions)\n'
    elif sudo -n /opt/builderbot/scripts/mint-runner-token --check >/dev/null 2>&1; then
        # Presence is not validity — ask GitHub, so a revoked or expired token
        # cannot keep reporting [ok] here.
        if sudo -n /opt/builderbot/scripts/mint-runner-token --validate >/dev/null 2>&1; then
            printf '  [ok]   runner credential: shielded, and GitHub accepts the token\n'
        else
            printf '  [FAIL] runner credential: shielded but GitHub rejected it (revoked/expired?) — see: bb logs\n'
            ok=1
        fi
    else
        printf '  [skip] no runner credential (fine if ENABLE_RUNNER=false)\n'
    fi
    if gh auth status >/dev/null 2>&1; then
        printf '  [ok]   git over https authenticated (gh)\n'
    else
        printf '  [skip] git over https not authenticated (set GIT_PAT, or use an ssh key)\n'
    fi
    local ssh_src=""
    if ssh-add -l >/dev/null 2>&1; then
        ssh_src="shielded agent key"
    elif compgen -G "$HOME/.ssh/id_*" >/dev/null; then
        ssh_src="key file in ~/.ssh"
    fi
    # Distinguish "no key" from "key loaded but the agent is unreachable from
    # this uid", which is otherwise indistinguishable and very confusing.
    if [ -z "$ssh_src" ] && [ -S "${SSH_AUTH_SOCK:-/run/ssh-agent.sock}" ]; then
        printf '  [FAIL] an agent socket exists but this user cannot use it — see: bb logs | grep ssh\n'
        ok=1
    fi
    if [ -n "$ssh_src" ]; then
        # A successful GitHub ssh auth still exits nonzero (no shell access),
        # so judge by the greeting instead of the exit code. On failure report
        # what ssh actually said — host-key verification, a refused key and an
        # unreachable agent all look identical otherwise.
        local ssh_out ssh_why
        ssh_out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 git@github.com 2>&1 || true)"
        if printf '%s' "$ssh_out" | grep -q 'successfully authenticated'; then
            printf '  [ok]   github ssh auth works (%s)\n' "$ssh_src"
        else
            ssh_why="$(printf '%s' "$ssh_out" \
                | grep -iE 'permission denied|host key verification|remote host identification|no such identity|sign_and_send|connection closed|could not resolve|timed out' \
                | head -1)"
            printf '  [FAIL] %s but github auth failed: %s\n' \
                "$ssh_src" "${ssh_why:-$(printf '%s' "$ssh_out" | head -1)}"
            printf '         diagnose with: ssh -vT git@github.com\n'
            ok=1
        fi
    else
        printf '  [skip] no ssh key (agent empty, nothing in ~/.ssh)\n'
    fi
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        printf '  [ok]   ANTHROPIC_API_KEY set\n'
    elif [ -f "$HOME/.claude.json" ] || [ -d "$HOME/.claude" ]; then
        printf '  [ok]   Claude Code credentials present in %s\n' "$HOME"
    else
        printf '  [warn] no ANTHROPIC_API_KEY and no saved login — run `bb login`\n'
    fi
    return $ok
}

# Bare `bb` prints what it can do. It used to run `status`, which is the same
# wall of tool versions `bb status` gives you — an answer to a question nobody
# typing `bb` on its own was asking.
case "${1:-help}" in
    status)   cmd_status ;;
    projects) cmd_projects ;;
    shell)    exec bash -l ;;
    update)   cmd_update ;;
    login)    cmd_login ;;
    runner)   shift; cmd_runner "$@" ;;
    emu)      shift; cmd_emu "$@" ;;
    claude-md|claudemd) shift; cmd_claude_md "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    logs)     shift; cmd_logs "$@" ;;
    doctor)   cmd_doctor ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
