#!/usr/bin/env bash
#
# `bb`: small convenience CLI inside the container.
#
set -euo pipefail

# The library next to this script, not a fixed /opt path: identical in the
# image (both live in /opt/builderbot/scripts), and it means a dry-run from a
# checkout uses that checkout's library instead of silently mixing new
# commands with the installed image's older helpers.
# shellcheck source=lib/common.sh
. "$(dirname "$(readlink -f "$0")")/lib/common.sh"
# The toolchain manager (`bb toolchains` and everything the Tools tab drives) is a
# third of this script's length and none of its subject, so it lives next door.
# shellcheck source=lib/sdk.sh
. "$(dirname "$(readlink -f "$0")")/lib/sdk.sh"
# shellcheck source=lib/preflight.sh
. "$(dirname "$(readlink -f "$0")")/lib/preflight.sh"
# The API client the network verbs share (lib/bbapi.py) and the programs
# behind them (lib/*-verbs.py, lib/report.py and the rest), run by path so
# a checkout's bb runs with the checkout's library.
BB_LIB="$(dirname "$(readlink -f "$0")")/lib"
export BB_LIB

# The reference's entries for one verb: each line that starts `bb VERB `,
# with the indented lines that continue it. Fails when there are none.
verb_help() {
    usage | awk -v v="$1" '/^bb / { on = ($2 == v) } on { print; n++ } END { exit n ? 0 : 1 }'
}

usage() {
    # The one owner of the bb reference: docs/reference.md's block is written
    # from this by tools/bb-ref.sh, and bb lint fails when the two differ
    # (R91 step 5). Column 0 for a verb, 19 in for a line that continues it.
    cat <<'EOF'
bb: BuilderBot helper

bb -p NAME VERB    any verb, about another project this one reads (its
                   settings name them): bb -p NAME roadmap, bb -p NAME map find X;
                   NAME is its shown name, its folder or its id (P3)
bb status          tool versions, runner registration, the projects here
bb version         this project's version, and who is allowed to move it
bb version --code  one form only: --code (Android versionCode), --quad (= --win:
                   manifest.json and Windows VERSIONINFO), --msi, --pep440,
                   --file, --semver, --json
bb version bump major|minor|patch    move the target, if the policy allows it.
                   A bump decides the number and closes the changelog under
                   it; it does not release anything. It commits on the branch
                   the checkout is on and pushes nothing, and says so when
                   that is not the branch builds come from. **Release** on the
                   Artifacts view is the second gesture: an annotated tag
                   (vX.Y.Z, or DIR-vX.Y.Z for a component) on the commit you
                   are on, pushed to the remote. Until that tag exists every
                   build reads X.Y.Z-dev.N+sha, which sorts BEFORE X.Y.Z,
                   heading for it rather than at it; from the tag on, a build
                   of that commit is the bare number. Releasing is the
                   operator's whatever the policy says, and a pushed tag is
                   never moved or deleted from the dashboard.
                   A repo that carries its number somewhere else as well
                   (an agent's protocol number, a template's stamp) declares
                   that by carrying an executable `tools/version-stamp`, run
                   from the repo root with the new version and the part that
                   moved. Whatever it changes is committed with VERSION, so
                   the bump is one commit or none: a hook that fails refuses
                   the bump rather than leaving the number moved and its twin
                   behind. A repo without one is unaffected
bb version init X.Y.Z  give this project (or --for DIR) its first VERSION
bb version set X.Y.Z   straight to a later version in one commit, allowed
                   when the policy allows the largest part it moves; from a
                   number never released (no tag), its changelog section is
                   dated as the new one
bb version unbump      take the last unreleased bump or set back; its
                   changelog section dissolves into Unreleased, the code
                   stays. Once: the bump before it is not taken back too.
                   A section dated under the wrong number is fixed with
                   unbump, then set to the number meant
bb version release --why "..."
                   tag this commit and publish the release, as Release on the
                   Artifacts view does, on the controller with the project's own
                   credentials. The project's settings say whether Claude may
                   (Tag and publish a release): auto releases, ask waits for
                   the project's owner, with --why as the reason
bb version release --edit --why "..." [--tag TAG] [--notes FILE] [--attach FILE]...
                   change the published release under the same setting, each
                   edit its own ask: the notes replaced whole (- reads stdin),
                   a build in dist/ or a committed file attached (one of the
                   same name replaced), (asset:NAME) in the notes the address
                   of that file on the release, for a screenshot
bb version release --remove NAME [--remove NAME]... --why "..." [--tag TAG]
                   take files off the published release, named as the forge
                   lists them: its own ask under the same setting, never part
                   of an edit, the names checked against the release first
bb version --list  every version this repo carries: its own, and any component
bb version --for DIR   ask about a component: a directory with its own VERSION
bb version policy  what a session may move here, and who decides. A
                   person picks it in the project's settings (Claude may:
                   Move the version) or on the Artifacts view, before or after
                   there is a version: locked (theirs entirely), may start
                   one (a session writes the FIRST version and moves nothing
                   after), patch, patch and minor, or anything
bb changelog       this project's user-facing changelog (--for DIR for a component)
bb changelog add "..." --cat NAME   log what a change means for the person using
                   it; the next version bump dates the accumulated lines. A
                   category is required, and the tool is where the rule lives:
                   Added (somebody can do something they could not), Changed
                   (already here, now different), Deprecated (going away),
                   Removed (gone), Fixed (was wrong, now right), Security
                   (act on it because of what it exposed). When two fit, the
                   one a reader would look under; something nobody using the
                   product would notice gets no entry. Run without a category
                   and it prints this. A name that means one of the six is
                   spelled the one way (`fix` files under Fixed), the six keep
                   their usual order among themselves, and a project that
                   files its own way names its own category, kept as typed and
                   placed at the end: a default, which a house rule overrides.
                   What order the categories and their lines sit in is still
                   the operator's, on the Changelog editor beside the version
bb changelog unreleased  the entries waiting for a bump, numbered straight
                   through the section by category, in the arranged order
bb changelog edit N "..."  reword one of them: a change that tweaks something
                   already logged this cycle corrects its line rather than adding one,
                   and the line gains that commit. --cat NAME on its own moves it
                   and leaves the words, filing it at the end of that category the
                   way add --cat does, so re-filing a line into its own category
                   sends it to the bottom, which is the ordering a session has.
                   --no-stamp corrects a line without claiming a commit made it,
                   which is what a pass over the wording is
bb changelog merge N M "..."   one line for several, carrying all their commits
bb changelog split N     back into one line per commit it carries
bb changelog rm N        drop one that stopped being true
bb projects        the project dirs here and their branches
bb shell           login shell as the builder user
bb login           Claude Code subscription auth flow, on the machine it is
                   run on. Nothing is copied anywhere: each node is signed in
                   for itself, from its row on the Nodes page or with this
bb login --check   what THIS machine is signed in as, told to the controller.
                   The login itself never travels
bb git push|fetch|pull|ls-remote [ARGS]
bb git policy      what a session may push here (its own branches, main) from
                   the project's Git view; the controller enforces it on the
                   relay, against the refs the push would write: a name that is
                   only on the remote, a tag, --all and deleting a branch there
                   are the operator's whatever the two settings say
                   git's network half, run where the credential is: from a
                   session on a node it goes through the controller
bb emu start [api] | stop | status | list | log [-p] | adopt
                   the project's own emulator: its phones are this project's
                   alone, made on the first start; adopt moves the account's
                   phones from before that into this project, once
bb emu touch tap X Y | hold X Y --ms N | glide X Y X Y... [--hand NAME] [--seed N] [--pre MS] [--hold MS] [--mark FILE]
                   a timed touch on the running emulator, in screen pixels;
                   a glide moves like a hand (steady, normal, shaky, or
                   ruler for the straight even stroke), repeatable by seed,
                   at the pace asked whatever a move costs the device;
                   --mark FILE is made when the finger arrives to be held
bb gpu             this node's NVIDIA card: how much of its memory is free, who is
                   computing on it, and whether this session may
bb gpu run [--mem MB] -- CMD
                   CMD with a turn on the card: one heavy job at a time per node, waiting
                   for its turn and for MB of free memory rather than failing on a full card
bb browser open --ext DIR [--firefox] [--url URL] [--headed]
                   Chrome (or Firefox) with an unpacked extension loaded, headless,
                   detached on a debugging port and a profile of its own: its id,
                   its port and the extension's id
bb browser go|eval|shot ID ...
                   go ID URL (ext:PAGE for the extension's own), eval ID JS (the
                   value as JSON), shot ID FILE (a PNG of the page on show)
bb browser list | stop ID|--all
                   the ones open; stop ends one by its process group and removes
                   its profile
bb proc [PATTERN]  this account's processes with PATTERN in their command line, never
                   the call's own shell (which pgrep -f matches): pid, age, command
bb proc stop PATTERN [--grace S]
                   end them: SIGTERM, then SIGKILL after S seconds (3)
bb proc wait PATTERN [--timeout S]
                   wait until none is left (600s), saying what is left if some is
bb tidy [--keep emulator|gpu|gradle|browser|server|tmp]... [--dry]
                   after a task or a batch of them, give back what it left holding:
                   this session's emulator (through bb emu stop), anything else of
                   its own on the NVIDIA card, its Gradle and Kotlin daemons, the
                   headless browsers a test left behind, a server it put in the
                   background and left listening (a dev server, a preview), and its
                   own files in /tmp, which in a session is memory; --keep one, with
                   the reason in your reply
bb lint [path]     lint a repo's infrastructure files: shell scripts,
                   Dockerfiles, workflows, compose files, XML
bb node busy [--json]
                   whether this node is quiet enough to time anything on: its load,
                   memory and card (what holds the card's memory, by kind), what
                   runs there by kind (emulators, Gradle, compilers, browsers,
                   other Claude sessions working, other projects' jobs, counted
                   and never named) and a verdict: quiet, busy, saturated
bb node wait-quiet [--level quiet|busy] [--timeout SECONDS]
                   wait until it is (quiet twice, ten seconds apart), before a
                   measurement; exits 1, saying how busy, if it never was
bb nodes           the machines enrolled as nodes, each with the agent it runs,
                   read-only in a terminal; the Nodes page is where they are edited
bb nodes show NAME one of them in full, by name or id: its agent against the one
                   this controller ships, and what Update agent would fix
bb nodes enroll-token NAME [--user U]
                   a new node's enrollment token, printed once, from a shell on
                   the controller: Enroll node's Just a token, for a scripted setup
bb projects adopt FOLDER [--name NAME]
                   a folder already under the projects share made a project, as
                   if BuilderBot had made it, from a shell on the controller: a
                   folder made by hand is not one until this says so
bb settings        this project's settings as the dashboard has them: node,
                   model, effort, build and test commands, lock. On a node
                   it is relayed from the controller, and it is what bb-tty
                   and bb build read there. `set build|test|outputs VALUE`
                   is the one write: a session fills a field in for the
                   operator, under the project's gate (below). `node NODE`,
                   from a shell on the controller, sets the project's node as
                   its Settings page does, for a scripted setup.
bb users           the dashboard's accounts. `passwd NAME` resets one from a
                   shell, which is the way back when the owner is locked out;
                   `claim NAME` makes the owner of a new install, as its first
                   page does, for a setup scripted from a shell
bb work            who else is working this project, and which files two of
                   you have uncommitted at once: read-only
bb jobs [-n N | ID]    the recent jobs: state, node, what ran, how it ended,
                   read-only; the Jobs page is where one is stopped. An id
                   prints that job's log, which is where a failed job says
                   what happened rather than only that it failed
bb run [opts] -- CMD   snapshot this tree, run CMD on the project's node and
                   stream the log back; `--out GLOB` brings what matches into
                   dist/ with its provenance; `--node` names another node
bb build           the project's build command on its node, with the outputs
                   it lists: all set in the project's settings dialog
bb test [ARGS]     the same for its test command; ARGS are appended to it, so a
                   suite that takes file names runs only those. Where it runs is
                   "Tests run" in the project's settings: on the node, which is the
                   default; inside its dev instance when that is up, else on the
                   node; or only inside it, where a container that is down is a
                   refusal naming it and nothing runs on the node
bb devapp          this project's dev instance: what it was built from, whether it is
                   running, and whether its daemon answers
bb devapp probe [--port N] [--path /x]
                   whether it answers on its node's loopback: each published port
                   open or refused, and the HTTP status of a GET of the path; a read,
                   so no root ask; --container NAME for another of the project's
bb devapp rebuild [--why "..."]
                   build it and bring it up. Only where the project has handed that
                   over: Claude may: Run its container, in its settings dialog and
                   the new-project dialog, reads deny (the default, refused with the
                   sentence that names it), ask (the reason goes to a person and the
                   command waits for Approve) or auto. Up, Down and a container of
                   any other shape stay the operator's. The build sees BB_BUILD_REV,
                   BB_BUILD_AT and BB_BUILD_VERSION, for a compose whose build.args
                   interpolate them, BB_BUILD_TAG, the version as an image tag
                   can carry it, and BB_DOCKER_GID, the node's docker group; its
                   other options are the compose file's own
bb devapp new [NAME] [--branch REF] [--compose FILE] [--override FILE] [--node NODE] [--env FILE] [--why "..."]
                   send the project to Docker, as the Artifacts view's Send to Docker
                   manager does, under the same setting: a container made from its
                   own compose file on its node, then built and started, and this
                   waits for the verdict. Unnamed, it is the project's own container
                   while it has none, then another beside it named for the project
                   with -2, -3 and on; a second needs ports of its own, so give it
                   an env that sets them with --env. --branch builds it
                   from that branch; --compose names another of its compose
                   files (site/compose.yml), the root's own by default; --override
                   lays another compose file from the tree over it, for this one
                   container (its own ports, env or an extra service). --node
                   puts it on a hosting node ticked under the project's Also
                   works on (marked Hosting only): built on the project's own
                   node and shipped there. On ask, one request carries all of it and
                   Approve makes and builds it
bb devapp remove [--why "..."]
                   take the container out of the manager, under the same setting;
                   its env and data stay for a remake, as the row's Remove leaves them
bb devapp env [set FILE|-] [--why "..."]
                   print the container's env, or replace it, under the same setting;
                   on ask, Approve writes it and builds nothing, since the card said
                   env set, and the rebuild is the next ask.
                   BuilderBot keeps it per container, never as a file in the project,
                   and points a compose line `env_file: .env` at it when it runs
bb devapp override FILE|none
                   lay another compose file from the tree over the container's own
                   (compose's -f after -f), or none; the next rebuild takes it, and a
                   service it adds is asked about as any new one is. On ask it is a
                   person's, in the container's settings
bb devapp ls       every container that belongs to this project on its node
bb devapp log NAME one of those containers' log
bb devapp start|stop|restart NAME [--why "..."]
                   one of those, under the same setting; --container NAME on the
                   other verbs reaches one written for this project
bb sign FILE [--for play|sideload] [--why "..."]
                   sign a build in dist/ with one of the project's keys, on its
                   node, as a job this session cannot look inside: the key and
                   its password never reach the session. --for play is the Play
                   upload key (the default for an .aab), sideload the app signing
                   key (the default for an .apk). The project's settings say
                   whether Claude may (Sign a build): auto signs, ask waits for
                   the project's owner to allow it, with --why as the reason.
                   Arrives in dist/ as NAME-signed.apk or .aab. --key NAME signs
                   with that key; without it, the key the build's package is
                   mapped to, else the project's default
bb sign keys       the project's keys by name, their fingerprints and which
                   package each signs (never a key or a password)
bb sign key new NAME --for play|sideload --why "..."
bb sign map PACKAGE KEY --why "..."
bb sign rotate OLD NEW --why "..."
                   a new key made on the controller, or an app's package mapped
                   to a key (KEY "" unmaps it), under Claude may: Manage signing
                   keys: auto does it, ask waits for the project's owner. rotate
                   moves the apps OLD's sideload key signs to NEW's: builds go out
                   signed with both and a proof, Android 9 and newer take NEW,
                   older devices keep checking OLD, which is kept for good
bb emu create API  build the AVD for an API level, installing its image if missing
bb emu install APK install an APK on the running emulator
bb emu shot [FILE] screenshot the emulator into dist/emu/
bb emu gfx PKG     a package's per-frame timings (gfxinfo framestats) into
                   dist/emu/, and every emu verb runs on the project's node
                   when it has one, its output coming back into dist/
bb emu images [--available]
                   the system images on this machine's toolchain store, or
                   every one there is; `bb emu flavors` says what each is for
bb emu image add|remove ID
                   put a system image on this machine's store, or take one
                   off: a full id or a flavor's short name (tv, wear,
                   playstore). The operator's, like bb toolchains install
bb ci-labels       the runner labels the registry knows; this box's and every
                   node runner's; `--write` regenerates .github/actionlint.yaml
bb findings        this project's scanner findings (--all for every project)
                   narrow with --level error|warning|note, --rule ID, --find TEXT
bb findings history   what the scanner stopped and started saying here
                      (-n N, --since 7d, --find TEXT, as the other logs)
bb findings sample [--remove]   write a clearly-fake report, so the Analysis
                      surfaces can be worked on where no scanner runs
bb token keep      store BB_TOKEN where this account's sessions on this
                   machine read it; the agent runs it for an idle session
bb roadmap            this project's roadmap: items are R1, R2, ...; bugs are B1, B2
bb roadmap show N     one item in full: its details, its steps and theirs (N is R12 or 12)
bb roadmap add "..."  put something on it; `done N` finished, `rm N [why]` abandoned
bb roadmap restore N  put a dropped one back from the history, as it was
bb roadmap reopen N   put back one finished since the last release, for the same goal
bb roadmap shelve N   park one without dropping it; `mv N up|down` moves it
bb roadmap unshelve N [WHY]   ask for one back: held for a person on the project to approve
bb roadmap add "..." --step "..." --step "..."   an ordered group of steps
bb roadmap edit N "..."               reword one; `step add|edit|rm|done` for one step
bb roadmap info N [M] "..."           add the technical details to one, or step M,
                                      under what is there (--replace sets them)
bb roadmap begin      work one out; `commit` records it as one change, `revert` undoes
bb roadmap pending    what a session added that is waiting for your approval
bb bug             the bug tracker: open bugs; `all`, `show N` for one in full
bb bug find TEXT   search the reports themselves: area, repro and notes too
bb bug begin       the same notebook batch `bb roadmap begin` opens; `commit`, `revert`
bb bug pending     reports a session filed that are waiting for your approval
bb bug add "..."   report one (--sev, --area, --repro, ...); `note N`, `fix N`,
                   `wontfix N`, `na N`, `reopen N`, `rm N`, `history`
bb tests run [ARGS]  run the project's test command, time it, and record the run: says first when it should
                   finish, and ends by NAMING what went wrong: the failed assertions per file, and for a file
                   that CRASHED the line it died on, the assertions that had already failed before it did,
                   and the fact that nothing after it ran. A crash prints no `FAIL` line and no totals, so a
                   run that only said "failures above" cost four whole runs to read once. ARGS go to the
                   command, so `bb tests run auth cards` times and records those two files and nothing else
bb tests last      that verdict again off the last run's log, running nothing
bb tests log [-f]  the last run's output, whole; -f follows a run still going. The
                   Tests view's Open the run's output sends this into the project's shell
bb devapp test [ARGS]  the project's test command inside its running dev instance, as a compose job on
                   its node: the whole log, and the job's exit code. `bb test` takes this path on its own
                   where "Tests run" in the project's settings says the dev instance, so a suite that
                   tests BuilderBot cannot disturb the BuilderBot it runs on (roadmap R48). Only for an
                   image that carries its tests: one built to ship has none, and a run inside it finds
                   nothing and passes. Claude may: Run its container is not asked: a test runs in a
                   container that is already up
bb tests unit      the python unit tier (scripts/dashboard/unit): the modules' rules without a server
                   or a browser, in under a second; preflight runs it before any suite
bb tests lab       the lab suites (test/lab-*.mjs) against real services rather than stand-ins.
                   Each names what it needs and skips in one line without it, so a missing service
                   is never a failure, and nothing records them: a lab run is a proof, not a timing.
                   Two services are known. A Gitea: the `gitea` service of BuilderBot's own dev
                   stack, under its compose file's `lab` profile, brought up from the Containers page
                   like any project's stack (`BB_LAB_GITEA`, the local one by default), and
                   a Forgejo beside it (`BB_LAB_FORGEJO`, port 3001), which the forge suite
                   runs against a second time under its own catalog entry. A real node,
                   through the controller it is enrolled on: `BB_LAB_CONTROLLER` (that dashboard's
                   address), `BB_LAB_TOKEN` (`user:password` for an administrator there, the lab's
                   own) and `BB_LAB_NODE` (the node by name or id). A job runs on that node, so name
                   one you are willing to have that happen to
bb tests projection  when a run should finish, from what the last one took (--secs for the number)
bb tests accept KEY "why"   the wait is the work: stop flagging it, saying why (--no undoes)
bb rules           the house rules for this project: the operator's and yours
bb rules show NAME one of them in full: what a conditional rule says
bb rules add NAME "..." [--files ...] [--words ...] [--doc PATH] [--check CMD]   leave one of your own
                   [--refuse "CMD, CMD"]: commands it refuses outright when a session runs one
                   [--replaces RULE]: the global rule it takes the place of in this project
                   [--why "..."]: the reason behind it, kept for show and the tab, never sent
bb rules edit NAME "..." | rm NAME ["why"]            change or drop yours
bb rules check [NAME|--all]   run the checks of the rules whose files you changed
bb rules history   what has changed them, by either of you
bb rules pending   rules a session added that are waiting for your approval
bb rules audit [DAYS]   your conversations here over DAYS (7): the commands a rule
                   refuses, run or tried, and the code map asked against grep
bb preamble        what a session started here is handed: rules, roadmap, bugs (--json for its size)
bb help TOPIC      one topic of the session briefing in full (start, where, map, build, tidy,
                   speed, capture, asks, notebook, versions, git, android, gpu, containers);
                   bb help topics lists them, bb help VERB one verb's lines
bb brief           the brief this project was started from: waiting for its first
                   Claude session, or kept after that session started
bb design          what this project looks like, from the notebook's Design view:
                   its design language in a line, and its pages
bb design show [ID|NAME]   the prompt for one page, or for the language alone:
                   the colors as tokens, the type, the shape, the layout
bb design file     docs/design-language.md as the notebook writes it
bb design json     the record: the language, the pages, and the presets by key
bb design schema   the record's shape with every limit, for a save that lands first time
bb design save FILE   write a record of that shape back, whole: how a session
                   puts a design language it was given into the notebook
bb wiki            the project's wiki, from the notebook's Wiki view: its pages,
                   who changed each last, and where it is pushed
bb wiki show NAME [--rev]   one page's Markdown (--rev: the revision a save checks)
bb wiki save NAME FILE|- [--why "..."]   write a page whole, new or rewritten,
                   under Claude may: Write the wiki: auto lands it, ask holds it
                   for the operator, deny refuses it, hidden keeps the whole
                   wiki from a session, reading included. A page changed since the
                   save began is refused rather than overwritten
bb wiki rm NAME [--why "..."]   take a page out, under the same setting
bb wiki mv OLD NEW   rename one; bb wiki history: the last changes
bb transcripts     your own conversations with Claude on this project, newest
                   first, as the Profile page lists them (bb -p NAME for one it reads)
bb transcripts show ID [--tz ZONE] [--all]   one of them as text: what was said,
                   every command Claude ran and what it answered; the newest
                   16 MB of a longer one, the whole of it with --all
bb transcripts fetch ID [--into DIR]   the file itself into this machine's folder
                   for it: how a node holding its projects as a synced copy
                   resumes a conversation it does not have (bb-tty runs it)
bb tests           the test registry: where the suite's time goes, slowest first
bb tests show KEY  one test: what it protects, what it exercises, its history
bb tests note KEY "..." [--how "..."]   what it protects, and what it really runs
bb tests describe --from FILE.json      fill many at once, in one write
bb tests ingest [LOG]  record a run's real durations (BB_TEST_TIMING=1 output)
bb tests drift     what the runner reported that this list does not, and back
bb tests flagged   the ones sitting on a round timeout rather than working
bb history         one search over the notebook's logs: roadmap, bugs, memory
                   (`--find X`, `--since 7d`, `-n N`)
bb roadmap history [-n N] [--since 7d] [--find TEXT]   what changed, narrowed
bb phone           what phone is connected, and what is waiting on you
bb phone run --why "..." -- adb args...
                   ask to reach it: the operator allows it on the dashboard
                   and the dashboard runs it, so a session never touches the
                   handset itself
bb phone lease     whether the phone is lent to this project, for how long, and
                   which of its apps the lease covers. While lent, each of
                   these asks the phone's owner and runs on their Approve
                   (--why "..." is the sentence they read), or at once
                   once they allowed this session's commands:
bb phone install dist/APP.apk   install one of this project's builds; its
                   package joins the lease
bb phone start|stop|ime|log PKG   run, stop, pick as keyboard, or read the
                   logcat of a lease app
bb phone shot      the screen, into dist/phone/
bb phone record [SECONDS] | record start [SECONDS] | record stop
                   a video into dist/phone/, with its reel beside it (the
                   frames that changed, with their times, in one picture);
                   start leaves it running while touches work the phone,
                   stop collects it
bb phone touch tap X Y | hold X Y [--ms N] | glide X Y X Y... [--hand NAME] [--seed N] |
                   text "..." | key back|enter|del|tab|space|up|down|left|right
                   only while a lease app is in front or is the keyboard;
                   --any-app asks the owner for that one touch on whatever is
                   in front (another project's keyboard), and Approve for this
                   session does not cover it; bb phone ui prints the screen's
                   layout under the same rule
bb container       what container asks are waiting on an administrator
bb container new --why "..." --name NAME --compose FILE [--env FILE] [--node NODE] [--for PROJECT]
                   a container built from a compose file the session wrote,
                   under the project's *Claude may: Run its container*: refused
                   at deny, asked at ask (an administrator reads the file on
                   the bell, and Approve registers it through the Containers page's own
                   New container path and starts its build), and at auto made
                   at once when it is this project's own on its own node; one
                   for another project or another node is always asked. A
                   published image is a compose naming it; a repository with a
                   Dockerfile is a compose with a build context on the projects
                   share. Never a user's to approve
bb root            what root commands are waiting on an administrator
bb root run --why "..." [--node NAME] -- CMD...
                   ask for ONE command as root on this project's node (or, with --node
                   NAME, on a node it hosts containers on; the row's root-asks switch
                   decides): an
                   administrator allows or denies it on the Nodes page or the
                   bell, and the node runs that command and nothing else. Not
                   sudo: a second command is a second question. A node's
                   Sessions section can turn root asks off altogether, and
                   the ask is then refused with that said
bb catchup         what has happened here lately: commits with the first line
                   of their bodies, what moved in the notebook, the builds this
                   box archived, and which image it is actually running
                   (`--since 7d`, `-n COMMITS`)
bb ci-log          what CI printed on its last run here (`--list` for the runs
                   kept, a run id for one, `--project NAME` from elsewhere);
                   for a project on GitHub's own runners, its runs and the end
                   of each failed job's log, read by the controller from GitHub
bb logs [-f] [N]   this boot's log
bb logs -p [N]     a previous boot's log
bb logs --list     the kept boot logs, newest first
bb logs --node NAME [--agent|--runner|--terminal|--nginx|--system|--kernel|--crash] [N]
                   a machine's own log: the agent's journal, the CI runner's,
                   the terminal server's, its nginx's where the nginx page put
                   one, this boot's system journal, its kernel ring, and the
                   previous boot's last lines (--crash: what the box said
                   before it went). Root's on that box: the enrolled
                   account is in neither `adm` nor `systemd-journal`, so a
                   session cannot read them at all. Offered only while **debug
                   mode** is on in Controller settings, the session's project
                   has been granted that node's logs under **Debug** in its
                   settings, its own node included, and the session's account
                   has the **debug** grant, which is the owner's unless a role
                   names it. The project is the session's own, proved by its
                   token. What can be read is a table of three streams;
                   anything else is refused, not run
bb diag [--json] [SECTION...]
                   the controller's diagnostics, read-only: its build and the
                   images it ran, its switches, the doctor's every check, each
                   node's agent and session half, the Claude plugins each
                   account installed on each node, the last day's jobs and the
                   failures, error lines from its own logs and the audit
                   trail, with anything shaped like a credential redacted. The
                   **debug** grant's: the owner's, or a role's that names it.
                   A session reads it only while **debug mode** is on, its
                   project is granted **the controller's diagnostics** under
                   Debug in its settings, and its account has the grant.
                   Its `reports` section is what sessions on any project
                   reported about BuilderBot, kept until a person clears them
bb report "..." [--area A] [--repro "..."]
                   a problem with BuilderBot itself, from a session on any
                   project: it goes into the controller's diagnostics rather
                   than the project's tracker (the briefing's notebook section
                   says so), redacted like the diagnostics, and nothing comes
                   back to follow up. A `bb bug add` whose words name
                   BuilderBot or a `bb` command is not filed but sent here,
                   unless `--here` says it is the project's own. *Claude may: Report
                   BuilderBot bugs* in a project's settings turns all of it off
                   for that project, rule and nudge included: BuilderBot's own
                   project, whose tracker those bugs belong in, has it off
bb report conversation N   the conversation a person sent with a report (the
                   end of it, redacted), behind the same gate
bb pc [VERB] [--why "..."]
                   a person's Windows PC lent to this project by the Windows
                   companion: bare, which PCs lend which verbs; a verb
                   (editor-start, editor-stop, game-start, game-stop, build,
                   shot, log, editor-call METHOD PATH) runs on the PC as its
                   person set it up there and waits for what it did, a
                   picture landing in dist/pc/. Under *Claude may: Use a lent
                   PC* (Deny by default; Ask puts each use in front of the
                   person at the PC); never a command string
bb doctor          check everything that usually goes wrong

# developing BuilderBot itself, from inside it
bb dashboard test  browser-test the dashboard from this checkout, isolated
bb dashboard dev   serve the live dashboard from ./scripts/dashboard (--off reverts)
bb dashboard status  which copy of the dashboard is serving
bb dashboard trace [SECONDS]  what the dashboard was asked over the last SECONDS, by endpoint and who asked, with how long each took
bb drift           what this checkout changed that the container is not serving
bb map VERB ...    the code map, which a session asks before grepping: find NAME,
                   who-calls NAME, calls NAME, defs FILE, draws ID|.class,
                   suites FILE..., state [FILE], sections FILE, unused [FILE],
                   addresses [FILE...], coverage, covered NAME, uncovered [FILE],
                   affected --base REF FILES..., languages (which files it
                   reads), build; bb map help says what each does
bb capture shot URL... [FILE|DIR] | --emu [PKG] [FILE] | --display :N [FILE]
                   one picture at rest: a page, the running emulator's screen,
                   or an X display (--drive F works the surface first). At rest
                   means shots a quarter second apart until a second of them
                   match, so a modal still arriving or a list still loading is
                   not the picture: the dashboard's own pages and the two other
                   sources settle by default, --settle asks it of any page, --now
                   takes the one shot at once. Into dist/shot/ for a page and
                   dist/emu/ for the emulator when no FILE is named.
                   A page that does not answer is no picture and exit 3; one
                   that answers 4xx or 5xx is shot, and the status said
bb capture reel --video FILE|--url URL|--emu [PKG]|--display :N [--seconds N] [--drive F]
                   eyes on change over time: the frames of a recording that changed,
                   each stamped with its time, tiled into dist/reel/NAME/sheet.png
                   beside frames.json (when, and how much moved). From a video, a
                   page Playwright records while --drive FILE.mjs works it, the
                   running emulator's screenrecord (with gfxinfo framestats beside
                   it), or an X display grabbed while a shell script drives it with
                   xdotool; the provisioner installs Xvfb and xdotool for that.
                   Only the sheet and frames.json land in dist/: the recording
                   and the full-size frames are on this machine's disk, where
                   frames.json says
bb capture ls      the captures in this project's dist/ (reels and emulator
                   shots), each with who asked and when: the Artifacts view's
                   Captures fold, in the terminal
bb capture prune [--days N] [NAME...]
                   remove those named now, or every capture older than N days.
                   A capture is somebody's until the project's "captures kept"
                   days are up (7 unless its settings say otherwise), and the
                   controller sweeps them when the Artifacts view draws: name
                   yours here to let them go sooner
bb tool            the tools toolchains add to a session, each under its own name
bb tool graphics CMD  pictures a session can make and then read back, with the
                   graphics toolchain on its node: info, resize, crop, compose,
                   annotate, diff, svg2png and optimize, into dist/img/, and
                   favicon SVG [DIR], a favicon set (ico + touch icon) from one mark
bb tool diagrams render FILE...  PlantUML (.puml) and Mermaid (.mmd) rendered to
                   PNG and SVG in dist/diagrams/, with the diagrams toolchain
bb tool docs read FILE...  a PDF, Word document, slide deck or spreadsheet as
                   Markdown on stdout, with the documents toolchain
bb tool docs pages FILE [--pages N-M] [--dpi N]  its pages as pictures in
                   dist/docs/NAME/, for layout, charts and scans; a file that
                   is not a PDF is made one by the office toolchain first
bb tool office convert FILE... [--to FORMAT]  LibreOffice with no window: a
                   document into pdf (the default), docx, xlsx, pptx or odt
bb tool sound make PRESET [--seed N] [--name N] [--wav]  a sound effect for an
                   app from sfxr's presets (blip, pickup, jump, laser, hit,
                   powerup, explosion, bloop), into dist/sound/ as OGG, with a
                   waveform and a spectrogram beside it to check it by; tone
                   HZ [--ms N] [--to HZ] makes a beep or a sweep, look FILE
                   draws any sound, presets lists them; say "TEXT" speaks it
                   into a WAV (piper) and hear FILE writes down what a
                   recording says with its times (whisper), which need the
                   audio toolchain
bb toolchains             SDKs kept outside the image: status, check, install X, update X, remove X
EOF
}

# version LABEL COMMAND...: print a tool's version, or "-" when it is absent
# or answers with nothing.
version() {
    local label="$1"; shift
    local out
    out="$("$@" 2>/dev/null | head -1)" || out=""
    printf '  %-8s %s\n' "$label" "${out:--}"
}

cmd_status() {
    # FIRST, because it is the question everything below is an answer to, and
    # because four places in the CLAUDE.md template told a session to ask this
    # command for it while it said nothing at all (B98). Whether a session is
    # on the controller or on a node decides whether adb reaches the emulator,
    # whether a plain `git push` works, and whether CI is this machine. The
    # nearest thing in the old output was `node v24.20.0`, which is Node.js
    # and reads exactly like an answer.
    echo "== where =="
    if on_node; then
        printf '  %-8s %s\n' machine "a node${BB_NODE:+, $BB_NODE}"
        printf '  %-8s %s\n' means \
            "builds, tests, CI and the emulator run here; pushing is bb git push"
        # The node's NVIDIA card, where it has one (R102): what it is, how
        # much of its memory is free, and whether this session may use it.
        local gpul; gpul="$(python3 "$BB_LIB/gpu.py" line 2>/dev/null || true)"
        [ -z "$gpul" ] || printf '  %-8s %s\n' gpu "$gpul"
    else
        printf '  %-8s %s\n' machine "the controller"
        printf '  %-8s %s\n' means \
            "builds go to this project's node; bb nodes says which"
    fi
    # Which credential bb is reaching the controller with and how long it
    # lasts. A session token renews itself on every call and the agent keeps
    # an idle session's fresh, so the copy in the environment is usually the
    # OLDER one and reads as expired to anything that looks only there: a
    # session reported exactly that as a fault once. Said here so renewal is
    # something to see rather than to trust.
    local tl; tl="$(bb_token_line)"
    [ -z "$tl" ] || printf '  %-8s %s\n' token "$tl"
    echo
    echo "== versions =="
    # First, because it is the identity of everything under it: every version
    # below came out of this image, and which image that is was otherwise
    # guessable only from the uptime. Stamped by CI at the end of the
    # Dockerfile; empty means the image was built some other way.
    # Above the commit, because it is the half a person can order. A sha
    # says which build; only this says which came first.
    if on_node; then
        # A node runs no controller image of its own, so BB_VERSION/BB_IMAGE_REV
        # are the controller's and unset here. What answers "which build is the
        # box on" from a session is the CONTROLLER's build, asked for over the
        # API rather than read off an env that was never set here (R62).
        printf '  %-8s %s\n' controller "$(bb_controller_stamp)"
    else
        printf '  %-8s %s\n' version "${BB_VERSION:-unstamped}"
        printf '  %-8s %s\n' image "$(
            if [ -n "${BB_IMAGE_REV:-}" ]; then
                printf '%.7s%s' "$BB_IMAGE_REV" \
                    "${BB_IMAGE_BUILT:+ (built $BB_IMAGE_BUILT)}"
            else
                printf 'unstamped'
            fi)"
    fi
    # Only where a session runs: the controller carries no Claude Code (R47),
    # and a dash against it there reads as something missing rather than as
    # something that was never meant to be here.
    if on_node; then version claude claude --version; fi
    version node   node --version
    version npm    npm --version
    version python python3 --version
    version uv     uv --version
    version git    git --version
    version gh     gh --version
    version docker docker --version
    version mise   mise --version
    version java   java --version
    version adb    adb --version
    version pw     playwright --version
    echo
    # What is installed beyond the image, and where. Here rather than only in
    # `bb toolchains` because this is the command a session runs first, and "is
    # flutter on this box" should not need a second guess.
    echo "== toolchains =="
    local root have=""
    root="$(sdk_root)"
    for t in $SDK_TOOLCHAINS; do
        [ "$t" = android ] && continue
        sdk_have "$root" "$t" && have="${have:+$have }$t"
    done
    printf '  %-8s %s%s\n' root "$root" \
        "$(is_mountpoint "$root" && printf ' (share)' || printf ' (home volume)')"
    printf '  %-8s %s\n' installed "${have:-none (see: bb toolchains)}"
    echo
    # CI runs on nodes (docs/nodes.md phase 7); `bb ci-labels` lists their
    # runners' labels and the Nodes tab shows each one's state.
    cmd_projects
}

cmd_projects() {
    if [ "${1:-}" = adopt ]; then
        # A folder already under the projects share made a project on
        # purpose (R84), for a setup scripted from a shell: by design a
        # folder made by hand is not one until somebody says so, and this
        # is that saying. An administrator's, from a shell on the controller.
        [ -z "${BB_TOKEN:-}${BB_ACCOUNT_UID:-}" ] && ! on_node \
            || die "bb projects adopt is run in a shell on the controller, not from a session"
        [ -n "${2:-}" ] || die "bb projects adopt FOLDER [--name NAME]: which folder under ${WORKSPACE}?"
        local name="" folder="$2"
        [ "${3:-}" = --name ] && name="${4:-}"
        BB_ADOPT_DIR="$folder" BB_ADOPT_NAME="$name" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
            WORKSPACE="$WORKSPACE" python3 "$BB_LIB/projects-adopt.py" "$(dirname "$(readlink -f "$0")")/dashboard"
        return
    fi
    echo "== projects (${WORKSPACE}) =="
    local d found=0
    for d in "$WORKSPACE"/*/; do
        [ -d "$d" ] || continue
        # Not a project, by the same mark the dashboard's list honors: the
        # toolchain store, a dev instance's build tree, anything the operator
        # chose to hide.
        [ -f "$d/.bbignore" ] && continue
        found=1
        # -e, not -d: a worktree's .git is a file naming its repository.
        if [ -e "$d/.git" ]; then
            printf '  %-40s git: %s\n' "$(basename "$d")" "$(git_branch "$d")"
        else
            printf '  %-40s (not a git repo)\n' "$(basename "$d")"
        fi
    done
    [ "$found" -eq 1 ] || echo "  none here"
}


# What this machine is signed in as, told to the controller (R47).
#
# The grant itself never moves. Every failure this had came from copying one
# OAuth pair to several machines: a refresh ROTATES the refresh token, so two
# copies sign each other out (bug #64), and a machine that was away holds one
# the server has retired (B100). Each machine signs in for itself now and
# keeps the grant it alone refreshes.
#
# So this is one sentence going up and no secret in it: "this account is
# signed in here as X", or that it is not, which is what the node's row and
# the project rows read.
#
# Never fatal, and quiet: this runs on every connection, where a controller
# that is restarting must cost a session nothing.
claude_login_check() {
    on_node || return 0
    [ -n "${BB_TOKEN:-}" ] || return 0
    BB_LOGIN_AUTH="$(bb_auth_header)" python3 "$BB_LIB/login-check.py" "${1:-}" || true
}

cmd_login() {
    # `--check` is the quiet half on its own: bb-tty runs it on every
    # connection, where an interactive flow would be wrong and a message
    # about nothing having changed would be noise.
    if [ "${1:-}" = --check ]; then
        on_node || return 0
        claude_login_check "${2:-}"
        return 0
    fi
    # `--list` is every account ON THIS MACHINE and what it is signed in to
    # Claude as, as JSON, changing nothing. The agent asks for it and carries
    # the answer up on its heartbeat, so the controller learns of a login made
    # here without waiting for a session to run and report one (B104).
    #
    # Read from the files rather than from `claude auth status`: those files
    # ARE what it reads, and this runs for every account on the box rather
    # than for one, where a subprocess each would be the cost of the thing.
    if [ "${1:-}" = --list ]; then
        BB_USERS_DIR="$BUILDER_USERS" python3 "$BB_LIB/login-list.py"
        return 0
    fi
    # `--out` is the sign-out run BY THE AGENT, in a claude-logout job, for
    # the account the dashboard asked about: `claude auth logout` in that
    # account's home on this machine, found the way --flow finds it.
    if [ "${1:-}" = --out ]; then
        local uid="${BB_ACCOUNT_UID:-}" base="${BUILDER_HOME:-$HOME}"
        local pinned="${BB_CLAUDE_PINNED:-/usr/local/lib/builderbot/claude}"
        [ -n "$uid" ] || die "a sign-out names the account it is for"
        HOME="$(user_home "$uid")" && export HOME
        PATH="$pinned:$base/.local/bin:$base/.npm-global/bin:$HOME/.local/bin:$PATH"; export PATH
        command -v claude >/dev/null 2>&1 \
            || die "Claude Code is not installed on this machine, so there is no login here to sign out of"
        claude auth logout || die "claude auth logout did not complete"
        log "signed out of Claude on ${BB_NODE:-this machine}"
        return 0
    fi
    # `--flow` is the sign-in run BY THE AGENT, in a claude-login job, with
    # that job's pty as its terminal (roadmap R47). The account is the one the
    # dashboard asked for and the home is resolved here, by the same user_home
    # a session on this machine gets: one implementation of "where does this
    # account live", rather than a second copy in the agent.
    #
    # The grant STAYS HERE. What goes up is which Anthropic account this
    # machine is now signed in as, so its row can name it.
    if [ "${1:-}" = --flow ]; then
        local uid="${BB_ACCOUNT_UID:-}" base="${BUILDER_HOME:-$HOME}"
        # The pinned dir is the agent's CLAUDE_DIR; BB_CLAUDE_PINNED is for
        # the suite, which runs on a machine that may carry a real one.
        local pinned="${BB_CLAUDE_PINNED:-/usr/local/lib/builderbot/claude}"
        [ -n "$uid" ] && HOME="$(user_home "$uid")" && export HOME
        mkdir -p "$HOME/.claude" 2>/dev/null || true
        # Claude Code from where a SESSION finds it (the agent's session
        # PATH): the pinned copy first, then the session account's own
        # ~/.local/bin, which is where the provisioner installs it, and only
        # then this account's. The agent runs this with its own PATH, and
        # the flow used to look in this account's home alone: the owner's
        # home IS the session account's, so it worked for them and for
        # nobody else, and a second account was told Claude Code was not
        # installed on a machine whose sessions ran it fine (24 Sep).
        PATH="$pinned:$base/.local/bin:$base/.npm-global/bin:$HOME/.local/bin:$PATH"; export PATH
        command -v claude >/dev/null 2>&1 \
            || die "Claude Code is not installed on this machine (looked on PATH, at $pinned and in $base/.local/bin): Update in the Nodes page's Claude Code section installs one copy every account runs"
        claude auth login || die "the sign-in did not complete"
        claude_login_check --loud || true
        return 0
    fi
    # ON A NODE the flow below runs in this terminal: this machine signs
    # itself in and keeps the grant it alone refreshes (R47).
    if on_node; then
        # Signed in already: said to the controller, so this node's row
        # reads it, and nothing else to do.
        [ "$(claude auth status --json 2>/dev/null \
             | tr -d ' ' | sed -n 's/.*"loggedIn":\([a-z]*\).*/\1/p')" != true ] \
            || { claude_login_check --loud || true; return 0; }
        log "sign in here: this machine keeps its own login, and no other machine's travels"
    fi
    # And on the controller there is nothing to run: Claude Code is installed
    # where sessions are, which is a node (R47). Sign in on a node's row
    # starts the flow there and takes the code back; this says the same.
    command -v claude >/dev/null 2>&1 \
        || die "this machine carries no Claude Code: a sign-in runs on a node, from Sign in on its row on the Nodes page (Claude Code), or by running this on the node itself"
    # `claude auth login` is the flow built for this and does not leave a
    # session behind afterwards. The older path (start a session and use its
    # slash command) is the fallback for an image whose claude predates the
    # subcommand, which is exactly the case a first-time setup can be in.
    if claude auth --help >/dev/null 2>&1; then
        claude auth login
    else
        claude /login || claude
    fi
    # ...and tell the controller who this machine is now signed in as, which
    # is what makes its row name it. Only --flow did this, so signing in
    # from a terminal left the row stale until a hook or the agent's own
    # clock caught up: minutes of a dashboard saying the opposite of the
    # machine. A no-op on a controller, where the check returns at once.
    claude_login_check --loud || true
}


# The AVDs, read from their own files rather than from avdmanager, which
# scans the whole SDK on the shared store first: 105 s on bb-sandbox for
# what these .ini files say outright (B425). The emulator reads the same
# place, ANDROID_AVD_HOME or ~/.android/avd.
avd_home() { printf '%s' "${ANDROID_AVD_HOME:-$HOME/.android/avd}"; }
avd_names() {
    local ini
    for ini in "$(avd_home)"/*.ini; do [ -f "$ini" ] && basename "$ini" .ini; done
}
avd_path() { sed -n 's/^path=//p' "$(avd_home)/${1}.ini" 2>/dev/null; }
avd_exists() { [ -f "$(avd_home)/${1}.ini" ]; }

# emu_adopt: the account's AVDs from before B511, moved into this
# project's folder whole (their installed apps and settings with them), for
# the one project that was using them; refused while one runs.
emu_adopt() {
    local legacy="$HOME/.android/avd" n moved="" held
    [ -n "${ANDROID_AVD_HOME:-}" ] && [ "$ANDROID_AVD_HOME" != "$legacy" ] \
        || { warn "bb emu adopt moves the account's shared AVDs into a project's own folder: run it inside a project"; return 1; }
    for n in $(for f in "$legacy"/*.ini; do [ -f "$f" ] && basename "$f" .ini; done); do
        held="$(ANDROID_AVD_HOME="$legacy" emu_held "$n")"
        [ -z "$held" ] || { warn "$n is running ($held): stop it first, then adopt"; return 1; }
        [ ! -e "$ANDROID_AVD_HOME/$n.ini" ] || { warn "this project already has an AVD named $n; nothing was moved"; return 1; }
    done
    for n in $(for f in "$legacy"/*.ini; do [ -f "$f" ] && basename "$f" .ini; done); do
        mv "$legacy/$n.avd" "$ANDROID_AVD_HOME/$n.avd" || { warn "could not move $n.avd"; return 1; }
        sed "s|^path=.*|path=$ANDROID_AVD_HOME/$n.avd|" "$legacy/$n.ini" > "$ANDROID_AVD_HOME/$n.ini" \
            && rm -f "$legacy/$n.ini"
        moved="$moved $n"
    done
    [ -n "$moved" ] || { warn "no shared AVDs in $legacy to adopt"; return 1; }
    rm -f "$legacy/.heir"
    log "adopted${moved} into $(bb_project): they are this project's alone now, with what is installed on them"
}

# emu_scrub SERIAL AVD: packages another project left on an adopted phone,
# named one a line in its bb-scrub.txt, uninstalled once on its first boot
# here (B511: BuilderBot's companion app, left on the phone Shebang adopts).
emu_scrub() {
    local f pkg
    f="$(avd_path "$2")/bb-scrub.txt"
    [ -f "$f" ] || return 0
    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        adb -s "$1" uninstall "$pkg" >/dev/null 2>&1 && log "removed ${pkg}, which another project had left on this phone"
    done < "$f"
    rm -f "$f"
}

# emu_room AVD: nothing when this node has the memory for one more emulator
# of that AVD, else the sentence why not. With a phone per project (B511)
# nothing makes two projects take turns any more, so the node's memory
# does: what the AVD is configured with, about a GB of the emulator's own
# beside it, and EMU_RESERVE_MB (2 GB) left for the builds and the rest, so
# a second emulator never starves a third session's Gradle (the operator, 6
# Oct: bb is what lends the emulator, so it should know how many fit).
# /proc/meminfo is the node's own; a session sees only its own processes,
# so how many emulators run here is the node's count, from bb node busy.
# Memory alone was not enough: two phones and a build left 5 GB, room by
# memory for a third, on a node already at load 9 on 8 cores (6 Oct). A node
# that bb node busy calls saturated has no room for another until it eases.
emu_room() {
    local cfg ram need avail reserve="${EMU_RESERVE_MB:-2048}" running busy
    busy="$("$0" node busy 2>/dev/null)"
    running="$(printf '%s\n' "$busy" | grep -o '[0-9]* emulator' | head -1 | cut -d' ' -f1)"
    if printf '%s\n' "$busy" | head -1 | grep -q ': saturated'; then
        printf "this node's processors are saturated (%s); %s emulator%s running on it now" \
            "$(printf '%s\n' "$busy" | head -1 | sed -n 's/.*saturated (\(.*\))$/\1/p')" \
            "${running:-0}" "$([ "${running:-0}" = 1 ] && echo " is" || echo "s are")"
        return 0
    fi
    cfg="$(avd_path "$1")/config.ini"
    ram="$(sed -n 's/^hw\.ramSize *= *\([0-9]*\).*/\1/p' "$cfg" 2>/dev/null | head -1)"
    need=$(( ${ram:-2048} + 1024 ))
    avail="$(awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo 2>/dev/null)"
    [ -n "$avail" ] || return 0
    [ "$avail" -lt $((need + reserve)) ] || return 0
    printf 'this node has %s MB of memory free, and another phone needs about %s MB with %s MB left for builds; %s emulator%s running on it now' \
        "$avail" "$need" "$reserve" "${running:-0}" "$([ "${running:-0}" = 1 ] && echo " is" || echo "s are")"
}

# emu_avd [TARGET]: resolve which AVD to act on. A bare API level (37) maps to
# that version's AVD; anything else is taken as a literal name. With no target:
# ANDROID_AVD_NAME wins if set, then the first configured API level, then the
# unsuffixed name AVDs used before this was multi-version.
# The API levels with a system image in the store, one per line, ascending.
emu_apis() {
    # The API levels with an image, read from the store's directory names.
    # Not sdk_images, which measures every image with du (gigabytes each,
    # over the share) for a size this throws away (B425).
    local base="${ANDROID_HOME:-/opt/android-sdk}/system-images" d
    [ -d "$base" ] || return 0
    find -L "$base" -mindepth 3 -maxdepth 3 -type d 2>/dev/null | while IFS= read -r d; do
        [ -n "$(ls -A "$d" 2>/dev/null)" ] && basename "$(dirname "$(dirname "$d")")"
    done | sed 's/^android-//' | sort -un
}

emu_avd() {
    local target="${1:-}" prefix="${ANDROID_AVD_PREFIX:-builderbot}" first
    if [ -n "$target" ]; then
        # A level is digits and a dot (37.0 is one): prefixed like 36, or
        # the AVD was named a bare "37.0" (report #70, B531).
        case "$target" in
            *[!0-9.]*) printf '%s' "$target" ;;
            *)         printf '%s-%s' "$prefix" "$target" ;;
        esac
        return
    fi
    if [ -n "${ANDROID_AVD_NAME:-}" ]; then
        printf '%s' "$ANDROID_AVD_NAME"
        return
    fi
    # An AVD that EXISTS, the newest of this prefix, before any guess from
    # the images: the store held a 37.0 image nobody had made an AVD for, so
    # the guess named builderbot-37.0, found nothing, fell back to the bare
    # name and `bb emu start` said "AVD 'builderbot' not found" one minute
    # after `bb emu create 36` said its AVD was ready (B209).
    local have
    have="$(avd_names | grep -E "^${prefix}-[0-9][0-9.]*$" | sort -V | tail -1)"
    if [ -n "$have" ]; then
        printf '%s' "$have"
        return
    fi
    # Nothing made yet: the newest whole API level the store holds an image
    # for, which is what `bb emu create` names and what a project's first
    # `bb emu start` makes (B511); a preview level (37.0) is never the guess.
    first="$(emu_apis | grep -E '^[0-9]+$' | tail -1)"
    printf '%s-%s' "$prefix" "${first:-36}"
}

# Whether the running emulator has finished booting: adb lists it as a
# device well before that, and an install or a launch aimed at it in between
# fails with nothing said. SERIAL is emu_serial's.
emu_booted() {
    [ "$(adb -s "$1" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]
}

# Does hardware GLES actually work here? Not "is there a GPU": the card can be
# present, the Vulkan loader can find it, and EGL can still refuse to hand out
# a display, which is exactly the state this box was in for months. So this
# asks EGL itself, and believes the answer.
#
# Prints the vendor string on success and nothing on failure; the caller reads
# the exit status.
#
# x_display_up, "is anything listening on :0", is in lib/common.sh, because
# the GPU startup hook has to ask it too.
gpu_gles_ok() {
    [ -n "${DISPLAY:-}" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    python3 "$BB_LIB/doctor-probes.py" egl 2>/dev/null
}

# The serial of the running emulator, or empty. Matched by NAME, which is the
# only thing that actually distinguishes one.
#
# Not `adb -e`, which is the obvious answer and is wrong: adb means "the device
# on a local/TCP transport" by that, and a phone attached over wireless adb is
# exactly that. With a Pixel connected, `adb -e shell` reaches the Pixel and
# `adb -d` finds nothing at all. An emulator is emulator-NNNN; a wireless phone
# is IP:PORT; that difference is the test.
#
# `device` and not `offline`: an emulator appears in the list before it will
# answer, and treating the first sighting as ready is how `bb emu start` used
# to return before the thing had booted.
emu_serial() {
    adb devices 2>/dev/null \
        | awk '$1 ~ /^emulator-[0-9]+$/ && $2 == "device" { print $1; exit }'
}

# emu_held AVD: a line saying the AVD is running somewhere this shell cannot
# reach, or nothing. Another Claude session of the same account on this node
# shares the AVD (it lives in the account's home) but not the view: its
# emulator is in that session's own processes and network, so adb here
# lists nothing, and a start here waited three minutes for an emulator that
# refused to run twice (30 Sep). The emulator holds a lock on the AVD while
# it runs, and writes when and how it started beside it.
emu_held() {
    local home="${ANDROID_AVD_HOME:-$HOME/.android/avd}" f at=""
    local lock="$home/$1.avd/multiinstance.lock"
    [ -e "$lock" ] || return 0
    command -v flock >/dev/null 2>&1 || return 0
    flock -n "$lock" true 2>/dev/null && return 0
    for f in "$home"/running/pid_*.ini; do
        [ -e "$f" ] || continue
        grep -qx "avd.name=$1" "$f" 2>/dev/null || continue
        at="$(date -d "@$(stat -c %Y "$f")" '+%H:%M' 2>/dev/null)"
    done
    printf '%s is running in another of your sessions on this node%s, which this one cannot reach: that session stops it with bb emu stop, or it stops when that session ends' \
        "$1" "${at:+ (started $at)}"
}

# The project's node, from the same file the settings dialog writes; "" when
# none is set. Read here rather than asked of the dashboard, so `bb emu` can
# decide where it is going before it says anything.
project_node() {
    # ON the node, the answer is "here", which this spells as no node at all:
    # every caller then does the thing locally, which is what being on the
    # project's node means (roadmap #24).
    on_node && return 0
    local proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/doctor-probes.py" prefs "$proj" 2>/dev/null
}

# bb emu on the project's node (docs/nodes.md phase 9): the same verb becomes
# a job there (the node runs this very bb from the bundle, with its own
# toolchain store as the SDK), and what it writes (a screenshot, a gfxinfo)
# comes back into dist/. `install FILE` sends the APK along from dist/.
emu_via_node() {
    local -a argv=("emu") files=()
    local a
    for a in "$@"; do argv+=("$a"); done
    if [ "${1:-}" = install ]; then
        local f="${2:-}"
        [ -n "$f" ] || die "bb emu install needs an APK in dist/"
        case "$f" in dist/*) ;; *) f="dist/${f#./}" ;; esac
        [ -f "$f" ] || die "${f} is not in this project's dist/; the node fetches the APK from there"
        files=("$f"); argv=("emu" "install" "$(basename "$f")")
    fi
    local auth
    auth="$(bb_auth_or_die)"
    local proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    # The credential rides the environment, never argv: ps shows argv to
    # every account on the box, and this is the person's own header.
    BB_EMU_FILES="$(printf '%s\n' "${files[@]}")" \
    BB_AUTH_HEADER="$auth" python3 "$BB_LIB/emu-job.py" "" "$proj" "${argv[@]}"
}

cmd_emu() {
    local avd
    # The system images on THIS machine's toolchain store, like bb toolchains:
    # a console on a node sees that node's, and nothing routes. The Emulator
    # tab is where a node is picked.
    case "${1:-}" in images|flavors|image) cmd_emu_images "$@"; return ;; esac
    # On the project's node when it has one (docs/nodes.md phase 9): the
    # emulator, the images and the GPU are that machine's. BB_EMU_LOCAL=1
    # keeps a verb here, for the box that still carries an emulator itself.
    if [ -z "${BB_EMU_LOCAL:-}" ] && [ -z "${BB_NODE_TOOLCHAINS:-}" ] && [ -n "$(project_node)" ]; then
        emu_via_node "$@"
        return
    fi
    # A controller runs no emulator (roadmap #24, 10c): the image carries no
    # SDK, and a project with no node has nowhere to run one. Said plainly,
    # before `emulator: not found` could say it badly. BB_EMU_LOCAL=1 is
    # the escape hatch for a box that still carries one.
    if ! on_node && [ -z "${BB_EMU_LOCAL:-}" ] && [ -z "${BB_NODE_TOOLCHAINS:-}" ]; then
        die "this project has no node, and the controller runs no emulator; bind a node in the project's settings dialog, and bb emu runs there"
    fi
    # The virtual phone is the project's, not the account's (B511). Its
    # AVDs lived in the account's ~/.android/avd, so every project's session
    # of one account booted the same phone with whatever another project had
    # installed and signed into: BuilderBot's own companion app, signed in
    # to the dev instance, turned up on Shebang-DevBoard's home screen (the
    # operator, 6 Oct). Each project has its own folder of AVDs now, and its
    # first start makes its phone. An ANDROID_AVD_HOME already set (the
    # Emulator tab's jobs, an operator's own) is left as it is.
    if [ -z "${ANDROID_AVD_HOME:-}" ]; then
        local eproj; eproj="$(bb_project 2>/dev/null || true)"
        if [ -n "$eproj" ]; then
            export ANDROID_AVD_HOME="$HOME/.android/avd-projects/$eproj"
            mkdir -p "$ANDROID_AVD_HOME" 2>/dev/null || true
            # The phones from before this are one project's to keep, named in
            # their .heir (the operator chose Shebang-DevBoard, 6 Oct): its
            # first start here takes them, rather than making a blank one.
            if [ "${1:-}" = start ] && [ "$(cat "$HOME/.android/avd/.heir" 2>/dev/null)" = "$eproj" ] \
               && [ -z "$(ls "$ANDROID_AVD_HOME"/*.ini 2>/dev/null)" ]; then
                emu_adopt || warn "the shared phones were not adopted; this start makes a new one"
            fi
        fi
    fi
    case "${1:-status}" in
        adopt)
            emu_adopt || exit 1
            ;;
        create)
            # An AVD for an API level: the system image and platform through
            # sdkmanager if they are not here, then avdmanager, on demand,
            # for a node whose store starts empty. The only way an image
            # arrives besides the Emulator tab, since the baseline hook went.
            local api="${2:-}" pkg name
            # A level is digits (36, 37.0), and anything else is help or a
            # mistake: -h was taken as a level, and sdkmanager went looking for
            # android--h (report #69, B528).
            case "$api" in
                -h|--help|"") echo "usage: bb emu create <api>: an AVD for that API level (36, 37.0), its system image and platform installed first if missing"; [ -n "$api" ]; return ;;
                *[!0-9.]*) die "bb emu create <api>: an API level is a number like 36 or 37.0, not '${api}'" ;;
            esac
            command -v sdkmanager >/dev/null 2>&1 || die "no sdkmanager in this node's toolchain store: say so in your reply; the operator adds android-tools on the Toolchains page with this node picked"
            # Google names a level "37.0" or "36.1" in its index some years,
            # and a person says 37: the level given is looked up against what
            # the index offers, so `bb emu create 37` installs android-37.0
            # rather than failing on a package that does not exist.
            if [ ! -d "${ANDROID_HOME:-/opt/android-sdk}/system-images/android-${api}/google_apis/x86_64" ]; then
                local found
                found="$(cmd_emu images --available 2>/dev/null \
                    | awk -F'\t' -v a="$api" '$3 == "google_apis" && ($2 == a || $2 == a ".0") { print $2; exit }')"
                [ -z "$found" ] || api="$found"
            fi
            pkg="system-images;android-${api};google_apis;x86_64"
            name="$(emu_avd "$api")"
            if [ ! -d "${ANDROID_HOME:-/opt/android-sdk}/system-images/android-${api}/google_apis/x86_64" ]; then
                log "installing ${pkg}: a couple of GB, kept on the store"
                sdkmgr --install "$pkg" || die "could not install ${pkg}"
            fi
            [ -d "${ANDROID_HOME:-/opt/android-sdk}/platforms/android-${api}" ] \
                || sdkmgr --install "platforms;android-${api}" || warn "could not install platforms;android-${api}"
            if avd_exists "$name"; then log "AVD '${name}' already exists"; return 0; fi
            # The AVD directory has to exist before avdmanager is asked, or
            # it ignores ANDROID_AVD_HOME and writes under ~/.android, where
            # the config line below is not found and the emulator dies with
            # "Broken AVD system path" (the dev VM, 25 Sep).
            [ -z "${ANDROID_AVD_HOME:-}" ] || mkdir -p "$ANDROID_AVD_HOME" 2>/dev/null || true
            echo no | avdmanager create avd -n "$name" -k "$pkg" --device pixel_7 >/dev/null \
                || die "AVD creation failed for ${name}"
            # The image path, written by hand. avdmanager is the android-tools
            # entry on the store, a different directory from the SDK, and it
            # writes image.sysdir.1 relative to the root it works out from its
            # own location; the emulator resolves that line against
            # ANDROID_HOME, and the two disagreed by one directory, so every
            # start died with "Broken AVD system path" (B209). This line is
            # what the emulator wants whatever avdmanager decided.
            # Where avdmanager put it, by its own word, rather than where it
            # was told to: the two have differed.
            local ini
            ini="$(avd_path "$name")"
            ini="${ini:-${ANDROID_AVD_HOME:-$HOME/.android/avd}/${name}.avd}/config.ini"
            if [ -f "$ini" ]; then
                sed -i "s|^image.sysdir.1=.*|image.sysdir.1=system-images/android-${api}/google_apis/x86_64/|" "$ini"
                # ...and room to install into. avdmanager's default /data is
                # 800 MB, of which a booted 37 left 32 MB: a 27 MB debug APK
                # did not fit, and the device tests ran none (report #70,
                # B531). 6 GB, as the AVDs made before had.
                if grep -q '^disk.dataPartition.size=' "$ini"; then
                    sed -i "s|^disk.dataPartition.size=.*|disk.dataPartition.size=${EMU_DATA_SIZE:-6G}|" "$ini"
                else
                    printf 'disk.dataPartition.size=%s\n' "${EMU_DATA_SIZE:-6G}" >> "$ini"
                fi
            else
                warn "no config.ini at ${ini}; if the emulator says Broken AVD system path, that file's image.sysdir.1 is the line"
            fi
            log "AVD '${name}' ready; bb emu start"
            ;;
        install)
            local apk="${2:-}" serial
            [ -f "$apk" ] || die "bb emu install <apk>: ${apk:-?} is not a file"
            serial="$(emu_serial)"; [ -n "$serial" ] || die "no emulator is running; bb emu start first"
            emu_booted "$serial" || die "the emulator is still booting; bb emu start waits for it, or try again in a moment"
            adb -s "$serial" install -r "$apk" || die "adb install failed"
            ;;
        shot)
            # The emulator's screen at rest, into dist/ so the Artifacts tab
            # lists it: bb capture shot --emu, which is where every shot lives now.
            shift; capture_shot --emu "$@"
            ;;
        touch)
            # A timed tap, hold or glide through sendevent (R101): adb's own
            # input verbs cost 300 ms a call and cannot time a gesture.
            shift; capture_env python3 "$BB_LIB/touch.py" "$@"
            ;;
        gfx)
            # Real per-frame timings for a package, from dumpsys gfxinfo
            # framestats, which works under any renderer, where screenrecord
            # does not (CLAUDE.md's Android section says why).
            local pkg="${2:-}" serial out="${3:-}"
            [ -n "$pkg" ] || die "bb emu gfx <package> [FILE]"
            serial="$(emu_serial)"; [ -n "$serial" ] || die "no emulator is running; bb emu start first"
            [ -n "$out" ] || { mkdir -p dist/emu; out="dist/emu/gfx-${pkg}-$(date +%Y%m%d-%H%M%S).txt"; }
            adb -s "$serial" shell dumpsys gfxinfo "$pkg" framestats > "$out" || die "dumpsys gfxinfo failed"
            log "gfxinfo: ${out} ($(grep -c '^[0-9]' "$out" 2>/dev/null || echo 0) frames)"
            ;;
        start)
            command -v emulator >/dev/null 2>&1 \
                || die "no emulator in this node's toolchain store: tick android:emulator on the Toolchains page with this node picked"
            if adb devices 2>/dev/null | grep -q '^emulator-'; then
                log "an emulator is already running"; adb devices; return 0
            fi
            avd="$(emu_avd "${2:-}")"
            # A project's first start makes its own phone (B511): the default
            # AVD is named for its API level, so it can be made here.
            if ! avd_exists "$avd" && [[ "$avd" =~ ^builderbot-([0-9]+)$ ]]; then
                log "this project has no phone of its own yet: making ${avd} (a minute or two, once)"
                ( cmd_emu create "${BASH_REMATCH[1]}" ) || die "could not make ${avd}; bb emu create ${BASH_REMATCH[1]} says why"
            fi
            avd_exists "$avd" \
                || die "AVD '${avd}' not found; bb emu create <api> builds one, and bb emu list shows what is here"
            # A share that went stale under this session (the store's shared
            # half over NFS, 6 Oct) reads as a missing image, and the emulator
            # said "Broken AVD system path", which sent a session after its AVD
            # (B526). Said as what it is: a remount reaches a new session.
            local imgs="${ANDROID_HOME:-/opt/android-sdk}/system-images" stale
            stale="$(LC_ALL=C stat -L "$imgs" "$imgs"/* 2>&1 >/dev/null | grep -m1 'Stale file handle' || true)"
            [ -z "$stale" ] || die "the toolchain store's system images answer 'Stale file handle' (${stale#stat: }): the share went stale under this session, not the AVD. A new session sees it mounted fresh; if a new one fails the same way, the node's mount needs remounting, which is the operator's (bb root run)"
            local held; held="$(emu_held "$avd")"
            [ -z "$held" ] || die "$held"
            # Room on the node for one more (emu_room): waited for a while,
            # since another project's emulator stopping or a build finishing
            # frees it, then refused with the numbers rather than started
            # into a machine that would kill something to make room.
            local room waited_room=0
            room="$(emu_room "$avd")"
            if [ -n "$room" ]; then
                log "waiting for room for another emulator: ${room}"
                while [ -n "$room" ] && [ "$waited_room" -lt "${EMU_ROOM_WAIT:-300}" ]; do
                    sleep 10; waited_room=$((waited_room + 10)); room="$(emu_room "$avd")"
                done
                [ -z "$room" ] || die "no room for another emulator: ${room}. Start it again once one stops; bb node busy says what is running"
                log "room for it now"
            fi
            [ -w /dev/kvm ] || warn "/dev/kvm not available; this will be very slow"
            # Software rendering by default. `-gpu host` does not work here
            # even with a GPU passed through and NVIDIA_DRIVER_CAPABILITIES=all:
            # the emulator finds the card for Vulkan and then fails at
            # "Failed to get EGL display", because NVIDIA's EGL wants a display
            # and this container has none. Bridging that needs an X server
            # (Xvfb) in EXTRA_APT_PACKAGES, which is the operator's call, so
            # the default stays software and says why rather than pretending.
            # What to render with. An explicit ANDROID_EMULATOR_GPU is obeyed
            # as given; otherwise the hardware path is *tested* rather than
            # assumed: where an X server for the card is up and EGL answers on
            # it with a vendor driver, the emulator can use the GPU. Nothing
            # starts that X server on a node yet (R20), so today this falls
            # back to software, which is the behavior this box has always had.
            local gpu vendor
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                gpu="$ANDROID_EMULATOR_GPU"
            elif x_display_up && vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                gpu=host
                export DISPLAY="${DISPLAY:-:0}"
                log "hardware rendering: EGL answers on ${DISPLAY} (${vendor})"
                # The card's memory is one pool for every session and job on
                # the node; an emulator drawing on it wants a few hundred MB.
                # Short of that, this one renders in software and says so,
                # rather than failing on a full card or starving a job on it.
                local vfree
                vfree="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc 0-9)"
                if [ -n "$vfree" ] && [ "$vfree" -lt "${EMU_GPU_MIN_MB:-768}" ]; then
                    gpu=swiftshader_indirect
                    log "the card has ${vfree} MB free, under the ${EMU_GPU_MIN_MB:-768} MB a phone draws with: rendering in software this time"
                fi
            else
                gpu=swiftshader_indirect
            fi
            # Under a software GPU the guest has no DRM render node, so HWUI's
            # default Vulkan backend cannot initialize: the app draws, the view
            # hierarchy is complete, and every frame comes out blank. The guest
            # says so once in logcat ("E/MESA: Failed to open rendernode") and
            # is otherwise silent about it, which is why this cost somebody a
            # day of thinking their own screen was broken.
            #
            # setprop from a shell fixes it and does not survive a reboot;
            # -prop sets it at boot, every boot. Only for the software modes:
            # with a real GPU the Vulkan backend is the faster one and should
            # be left alone.
            local hwui="${ANDROID_HWUI_RENDERER-skiagl}"
            local propargs=()
            case "$gpu" in
                swiftshader*|swangle*|guest|off)
                    [ -z "$hwui" ] || propargs=(-prop "debug.hwui.renderer=${hwui}") ;;
            esac
            # The log rotates rather than truncating. The emulator dies
            # silently under load (adb goes quiet, `bb emu stop` says there is
            # nothing to stop) and the only account of why is in the log the
            # *next* start used to overwrite before anybody could read it.
            #
            # Started, then waited for while it lives: up to
            # ANDROID_BOOT_TIMEOUT (600s) for one still booting, since a cold
            # boot of a new level on a busy node ran past the old 180 and was
            # called failed while it booted on (Shebang-DevBoard, 6 Oct); and
            # at once for one that has exited, whose reason is in the log.
            local serial="" epid="" waited=0 tries=0 why="" booted=""
            while :; do
                tries=$((tries + 1))
                # The previous run's log kept once, on the first try only: a
                # retry rotated it again, and a failed first try overwrote
                # the post-mortem `bb emu log -p` exists to keep.
                if [ "$tries" = 1 ] && [ -s "$HOME/.android/emulator.log" ]; then
                    mv -f "$HOME/.android/emulator.log" "$HOME/.android/emulator.log.1"
                fi
                log "starting AVD '${avd}' headless, -gpu ${gpu}${propargs:+, hwui ${hwui}} (log: bb emu log)"
                nohup emulator -avd "$avd" -no-window -no-audio -no-boot-anim \
                    -gpu "$gpu" "${propargs[@]}" \
                    > "$HOME/.android/emulator.log" 2>&1 &
                epid=$!
                log "waiting for the device to come up..."
                # Waiting for THIS emulator, not for any device. A bare
                # wait-for-device is satisfied the instant it is asked when a
                # phone is attached over wireless adb, and this reported the
                # emulator ready before it had booted.
                waited=0 serial=""
                while [ "$waited" -lt "${ANDROID_BOOT_TIMEOUT:-600}" ] && kill -0 "$epid" 2>/dev/null; do
                    [ -n "$serial" ] || serial="$(emu_serial)"
                    [ -n "$serial" ] && emu_booted "$serial" && break
                    sleep 2; waited=$((waited + 2))
                done
                booted=""
                if [ -n "$serial" ] && emu_booted "$serial"; then
                    [ "$gpu" = host ] && [ "$tries" -eq 1 ] || break
                    # Under the card a phone has died within a minute of
                    # booting, gfxstream saying "null ctx" (report #72,
                    # B530): watched a little longer, so that death falls
                    # back to software like one before the boot.
                    booted=1
                    local settle=0
                    while [ "$settle" -lt "${EMU_SETTLE:-30}" ] && kill -0 "$epid" 2>/dev/null; do
                        sleep 2; settle=$((settle + 2))
                    done
                    kill -0 "$epid" 2>/dev/null && break
                fi
                # Hardware rendering that broke: an out-of-memory from
                # glTexImage2D (0x505), a context preempted, a GLXBadContextTag.
                # On bb-sandbox an Android 37 phone filled the card to 7.5 GB of
                # 8 while it booted, past the 768 MB checked before it started,
                # and died; the session that met it retried by hand in software
                # (6 Oct, B530). So once, in software, by itself.
                if [ "$gpu" = host ] && [ "$tries" -eq 1 ] && ! kill -0 "$epid" 2>/dev/null \
                    && why="$(grep -m1 -oE 'err pre.{0,12}0x505|GL_OUT_OF_MEMORY|context was preempted|GLXBadContextTag|Failed to get EGL display|error null ctx' "$HOME/.android/emulator.log")"; then
                    warn "hardware rendering failed ${booted:+just after }as the phone booted (${why}); starting again in software, which leaves the card alone"
                    gpu=swiftshader_indirect
                    [ -z "$hwui" ] || propargs=(-prop "debug.hwui.renderer=${hwui}")
                    continue
                fi
                kill -0 "$epid" 2>/dev/null \
                    && die "the emulator${serial:+ appeared as ${serial} but} had not booted within ${ANDROID_BOOT_TIMEOUT:-600}s and is still running; bb emu log has what it says, and bb emu stop ends it"
                [ -n "$booted" ] && die "the emulator exited just after it booted; bb emu log -p has what it said"
                die "the emulator exited before it had booted; bb emu log -p has what it said"
            done
            # Root, every boot, where the build allows it: bb emu touch's
            # sendevent and an am start of an unexported activity need it. A
            # quick boot restores whatever the snapshot held, so this used to
            # be root only after a session had once run adb root itself, and
            # a cold boot took it away (reports 44 and 45, 1 Oct). A user
            # build (a Play Store image) has none to give, and says nothing.
            if [ "$(adb -s "$serial" shell getprop ro.debuggable 2>/dev/null | tr -d '\r')" = 1 ] \
                && [ "$(adb -s "$serial" shell id -u 2>/dev/null | tr -d '\r')" != 0 ]; then
                adb -s "$serial" root >/dev/null 2>&1 || true
                adb -s "$serial" wait-for-device >/dev/null 2>&1 || true
                local r=0
                while [ "$r" -lt 20 ] && [ "$(adb -s "$serial" shell id -u 2>/dev/null | tr -d '\r')" != 0 ]; do
                    sleep 0.5; r=$((r + 1))
                done
                if [ "$(adb -s "$serial" shell id -u 2>/dev/null | tr -d '\r')" = 0 ]; then
                    log "adb is root on ${serial} (a debuggable image: bb emu touch and am start of any activity work)"
                else
                    warn "adb root did not take on ${serial}: bb emu touch will say so"
                fi
            fi
            log "emulator is up as ${serial}, booted"
            emu_scrub "$serial" "$avd"
            adb devices
            ;;
        stop)
            # Named, for the same reason: without a serial this is "kill
            # whatever single device is attached", which with a phone connected
            # and no emulator is an emu command aimed at a handset.
            avd="$(emu_serial)"
            if [ -n "$avd" ]; then
                adb -s "$avd" emu kill 2>/dev/null || warn "emulator ${avd} did not stop"
            else
                local held; held="$(emu_held "$(emu_avd "")")"
                warn "${held:-no emulator to stop}"
            fi
            ;;
        status)
            # Everything attached, deliberately: a phone paired over wireless
            # adb shares this adb server, and knowing it is there is the point
            # when a command aimed at "the device" could mean either. The
            # emulator is the one named emulator-NNNN.
            adb devices -l
            if [ -z "$(emu_serial)" ]; then
                local held; held="$(emu_held "$(emu_avd "")")"
                if [ -n "$held" ]; then printf '%s\n' "$held"
                else printf 'no emulator is running; bb emu start\n'; fi
            fi
            ;;
        gpu)
            # "Which renderer would a start use, and why", in one command,
            # because the answer used to take an afternoon of reading logs.
            local v note
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                printf 'ANDROID_EMULATOR_GPU is set: %s (used as given)\n' "$ANDROID_EMULATOR_GPU"
            elif ! x_display_up; then
                printf 'software (swiftshader_indirect): no X display for the GPU\n'
                # What the display's unit last said about it (bb-sandbox
                # gpu-display, R20). The display dying hours into a boot used
                # to be silent: the emulator went on working, slower, and
                # every timing conclusion after it was wrong. The unit
                # restarts it three times and then stops; this is where it
                # says which of those happened.
                note="$(gpu_display_note)"
                [ -n "${note:-}" ] && printf '  the display unit says: %s\n' "$note"
                command -v Xorg >/dev/null 2>&1 \
                    || printf '  this machine has no X server: Set up GPU display on its row in the Nodes page gives the card one\n'
                command -v nvidia-smi >/dev/null 2>&1 \
                    && printf '  the card is here: %s\n' \
                       "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
            elif v="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                printf 'hardware (-gpu host): EGL vendor %s on %s\n' "$v" "${DISPLAY:-:0}"
            else
                printf 'software (swiftshader_indirect): X is up but EGL gave no vendor driver\n'
                printf '  Mesa answering here means llvmpipe, software by a slower road\n'
            fi
            ;;
        log|logs)
            # This start's log, or the one before it. `-p` is the interesting
            # one: after a silent death, the previous log is the post-mortem,
            # and it is gone the moment somebody starts the emulator again.
            local f="$HOME/.android/emulator.log"
            [ "${2:-}" = "-p" ] || [ "${2:-}" = "--prev" ] && f="$f.1"
            [ -f "$f" ] || die "no emulator log at ${f}"
            tail -n "${3:-200}" "$f"
            ;;
        list)
            printf 'API levels with a system image here: %s\n' "$(emu_apis | paste -sd, - | sed 's/^$/none; bb emu create <api> installs one/')"
            printf 'default for `bb emu start`: %s\n\n' "$(emu_avd)"
            # Read from the AVDs' own files, not avdmanager: it scans the
            # whole SDK on the shared store first and took 105 s on
            # bb-sandbox to print these two lines per AVD (B425).
            local n any=""
            while IFS= read -r n; do
                [ -n "$n" ] || continue
                any=1
                local cfg; cfg="$(avd_path "$n")/config.ini"
                printf '  Name: %s\n  Based on: %s %s %s\n' "$n" \
                    "$(sed -n 's/^target=//p' "$(avd_home)/${n}.ini")" \
                    "$(sed -n 's/^tag.id *= *//p' "$cfg" 2>/dev/null)" \
                    "$(sed -n 's/^abi.type *= *//p' "$cfg" 2>/dev/null)"
            done < <(avd_names)
            [ -n "$any" ] || printf '  (no AVDs)\n'
            ;;
        *) usage; exit 1 ;;
    esac
}

# ---- what CI said, from inside the container -------------------------------
# The self-hosted runner streams a job's console output to GitHub and keeps
# none of it: its own _diag directory holds the runner's diagnostics, which
# name the failing step and its exit code and never a line of what it printed.
# With no PAT there is no API to ask either, so "CI is red, why?" had no
# answer in here for a job that ran in this very container. The lint workflow
# tees each check into /config/ci-logs/<repo>/ and this reads it.
# Where CI logs are kept, resolved the same way the workflows resolve it:
# BB_CI_LOG_DIR first (on a node the agent sets it for jobs and sessions
# alike, and writes the same path into the runner's .env, so the archive is
# under the data store where the session account can read it), then /config
# on a controller because it survives an image update, then the home.
ci_log_dir() {
    if [ -n "${BB_CI_LOG_DIR:-}" ]; then printf '%s' "$BB_CI_LOG_DIR"
    elif [ -w /config ]; then printf '/config/ci-logs'
    else printf '%s/ci-logs' "$HOME"; fi
}

# Whether a project has workflows and none of them names a self-hosted
# runner: its jobs run on the forge's machines and nothing here keeps a log.
ci_hosted_only() {
    local wf="${WORKSPACE}/$1/.github/workflows"
    [ -d "$wf" ] || return 1
    [ -n "$(find "$wf" -maxdepth 1 \( -name '*.yml' -o -name '*.yaml' \) -print -quit 2>/dev/null)" ] || return 1
    ! grep -qs 'self-hosted' "$wf"/*.yml "$wf"/*.yaml
}

cmd_ci_log() {
    local dir; dir="$(ci_log_dir)"
    local proj="${BB_CILOG_PROJECT:-}" want="" list=0 whole=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --list|-l) list=1 ;;
            --all) whole=1 ;;
            --project) [ $# -ge 2 ] || die "--project needs a name"; proj="$2"; shift ;;
            -*) die "unknown option: $1" ;;
            *) want="$1" ;;
        esac
        shift
    done
    # A session reads its own project's CI and its reads', as the hosted
    # runs' route already holds; the kept files were read for any name.
    if [ -n "$proj" ] && [ -n "${BB_ACCOUNT_UID:-}" ] && [ "$proj" != "${BB_PROJECT:-}" ] \
       && ! printf ' %s ' "${BB_READS:-}" | grep -qF " $proj "; then
        die "$proj is not this project and not one it reads, so its CI logs are not this session's to read"
    fi
    # The project this is run from, the same way `bb roadmap` decides.
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one, or pass --project NAME"
    fi
    local d="$dir/$proj"
    # The workflows file a run under the REPOSITORY's name (GITHUB_REPOSITORY),
    # which is the project's only when nobody named it otherwise.
    if [ ! -d "$d" ]; then
        local repo
        repo="$(git -C "$WORKSPACE/$proj" remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[/:]##')"
        [ -n "$repo" ] && [ -d "$dir/$repo" ] && d="$dir/$repo"
    fi
    if [ ! -d "$d" ] || [ -z "$(find "$d" -maxdepth 1 -name '*.log' -print -quit 2>/dev/null)" ]; then
        # Nothing here means the job ran somewhere else, which since the lint
        # and dashboard workflows moved onto a node is the ordinary case. The
        # log is on that machine, under the same two-step path this resolves,
        # and the way to reach a node is the job channel (audited, scoped,
        # already built) rather than a share or a second credential.
        if ci_hosted_only "$proj"; then
            # GitHub keeps these, and hands a log only to a token: the
            # controller asks with its own, for this project (R115).
            local auth; auth="$(bb_auth_or_die)"
            local a=(); [ "$list" = 1 ] && a+=(--list); [ -n "$want" ] && a+=("$want")
            BB_CI_AUTH="$auth" BB_CI_PROJECT="$proj" python3 "$BB_LIB/cilog-hosted.py" "${a[@]}"
            return
        fi
        if [ -n "$(project_node 2>/dev/null)" ]; then
            log "nothing kept here; asking ${proj}'s node"
            # The project and the run name go into a shell string the node
            # runs: quoted for it, and a run is named by its id, not a path.
            case "$want" in */*|.*) die "bb ci-log RUN: a run is named by its id, not a path" ;; esac
            local remote
            local repo
            repo="$(git -C "$WORKSPACE/$proj" remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[/:]##')"
            remote='d="${BB_CI_LOG_DIR:-}"; [ -n "$d" ] || { [ -w /config ] \
                && d=/config/ci-logs || d="$HOME/ci-logs"; }; b="$d"; d="$d/"'"$(printf %q "$proj")"'
                [ -d "$d" ] || [ ! -d "$b/"'"$(printf %q "${repo:-$proj}")"' ] || d="$b/"'"$(printf %q "${repo:-$proj}")"
            if [ "$list" = 1 ]; then
                cmd_run --timeout 300 -- sh -c "$remote"'
                    [ -d "$d" ] || { echo "no CI logs kept on this node either"; exit 0; }
                    ls -1t "$d"/*.log 2>/dev/null | while read -r f; do
                        printf "%s  %s\n" "$(basename "$f" .log)" \
                          "$(date -r "$f" "+%Y-%m-%d %H:%M")"; done'
            else
                cmd_run --timeout 300 -- sh -c "$remote"'
                    [ -d "$d" ] || { echo "no CI logs kept on this node either"; exit 0; }
                    want='"$(printf %q "$want")"'
                    if [ -n "$want" ]; then f="$(ls -1 "$d"/"$want"*.log 2>/dev/null | head -1)"
                    else f="$(ls -1t "$d"/*.log 2>/dev/null | head -1)"; fi
                    [ -n "$f" ] || { echo "no kept log for that run"; exit 0; }
                    n="$(wc -l < "$f")"
                    if [ '"$whole"' = 1 ] || [ "$n" -le 3000 ]; then cat "$f"
                    else echo "[builderbot] the last 3000 of $n lines; --all prints all of it"; tail -n 3000 "$f"; fi'
            fi
            return 0
        fi
        log "no CI logs kept for ${proj}"
        log "only a job that runs on this box archives one, and only once the"
        log "workflow carrying the archive step has landed on the branch that ran"
        return 0
    fi
    # Newest first by mtime rather than by name: a re-run of an older run has a
    # lower id than a newer first attempt, so the number does not order them.
    local logs; mapfile -t logs < <(
        find "$d" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
    if [ "$list" = 1 ]; then
        echo "kept for ${proj}, newest first:"
        ci_log_rows "$d"
        return 0
    fi
    local pick="${logs[0]}"
    if [ -n "$want" ]; then
        pick=""
        local f
        for f in "${logs[@]}"; do
            case "$(basename "$f" .log)" in "$want"|"$want"-*) pick="$f"; break ;; esac
        done
        [ -n "$pick" ] || die "no kept log for run ${want}; try: bb ci-log --list"
    fi
    bb_cat_tail "$pick" "$whole" "bb ci-log $( [ -n "$want" ] && printf '%s ' "$want")--all"
}

# A kept log, its last 3000 lines unless the whole was asked for, saying so
# when it cut: a run's log can be megabytes, and a session reading it whole
# fills its context with the part nobody needed (B675).
bb_cat_tail() {
    local f="$1" whole="$2" more="$3" n
    n="$(wc -l < "$f" 2>/dev/null || echo 0)"
    if [ "$whole" = 1 ] || [ "$n" -le 3000 ]; then cat "$f"; return; fi
    echo "[builderbot] the last 3000 of ${n} lines; ${more} prints all of it"
    tail -n 3000 "$f"
}

# ---- what has happened here lately -----------------------------------------
# A session's prompt carries the roadmap and the bug tracker (the project's
# STATE) and nothing whatever about its recent past. So a conversation that
# opens with "it finally built" or "is that still broken?" costs four or five
# calls to reconstruct by hand: git log, a git show per commit for the body
# that actually explains it, bb status for the image, a history per notebook
# tab. This is that reconstruction, once, on one screen.
#
# Deliberately a pull and not a ritual: the notebook is already paid for in
# every prompt on this project, and most conversations never ask about last
# week. Reach for it when the first message refers to history.

# project_here: the project directory this was run from, or nothing.
project_here() {
    local here; here="$(pwd -P)"
    case "$here" in
        # A worktree is the project's, not a project called .worktrees.
        "$BB_WORKTREES"/*) here="${here#"$BB_WORKTREES"/}"; printf '%s' "${here%%/*}" ;;
        "$WORKSPACE"/*) here="${here#"$WORKSPACE"/}"; printf '%s' "${here%%/*}" ;;
        *) return 1 ;;
    esac
}

# dist_ignored: the briefing says a project's dist/ is gitignored, and a
# capture or a build writing there into a tree that does not ignore it put
# every reel in front of `git add -A` (MediaReducer B33, 7 Oct). Kept out
# in .git/info/exclude, the clone's own, so nothing is committed for it.
dist_ignored() {
    local p root ex
    p="$(project_here)" || return 0
    root="$WORKSPACE/$p"
    [ -e "$root/.git" ] || return 0
    git -C "$root" check-ignore -q dist/x 2>/dev/null && return 0
    # Through git, so a worktree (whose .git is a file) has it too.
    ex="$(git -C "$root" rev-parse --path-format=absolute --git-path info/exclude 2>/dev/null)" || return 0
    grep -qxF '/dist/' "$ex" 2>/dev/null && return 0
    { mkdir -p "${ex%/*}" && printf '%s\n' '/dist/' >> "$ex"; } 2>/dev/null || true
}

# trim_line TEXT: one line, capped so that a screen stays a screen. Counted in
# characters and not bytes: bash slices by character in this image's UTF-8
# locale, and the text being cut here is full of em dashes.
trim_line() {
    local t="$1" w="${2:-72}"
    if [ "${#t}" -gt "$w" ]; then
        printf '%s…' "${t:0:$((w - 1))}"
    else
        printf '%s' "$t"
    fi
}

# ci_log_rows DIR [LIMIT]: one line per archived CI run, newest first.
#
# Newest by mtime rather than by name: a re-run of an older run carries a lower
# id than a newer first attempt, so the number does not order them. The
# workflow's name comes off the header line because two workflows archive here
# now (the lint job and the image build's outcome) and a list that cannot
# tell them apart is a list of numbers.
ci_log_reason() {
    # The first thing that went wrong in an archived run, and which check it
    # was under. A row that says only "failure" is easy to scroll past, which
    # is how twelve consecutive red lint runs went unnoticed here, taking the
    # deterministic linters' signal down with them.
    awk '
        /^\[builderbot\] == / {
            sec = $0
            sub(/^\[builderbot\] == /, "", sec)
            sub(/ ==[ \t]*$/, "", sec)
            next
        }
        /Timeout [0-9]+ms exceeded/ || /^[ \t]*\[FAIL\]/ \
            || /^\[builderbot\] ERROR:/ || /^[ \t]*throw new Error/ \
            || /: error:/ || /^Error:/ {
            line = $0
            sub(/^[ \t]+/, "", line)
            if (sec != "") printf "%s: ", sec
            print line
            exit
        }
    ' "$1" 2>/dev/null | head -1
}


# The workflow a kept log came from, out of its first line. Two shapes,
# because the header's separator changed with the voice sweep and the logs
# already on the box were written by the old one: "# NAME on owner/repo"
# now, and "# NAME <sep> owner/repo" before it, where the separator was one
# character. Neither pattern needs that character written here.
ci_log_name() {
    local n
    n="$(sed -n '1s|^# \(.*\) on \([^ ]*/[^ ]*\)$|\1|p' "$1")"
    [ -n "$n" ] || n="$(sed -n '1s|^# \(.*\) . \([^ ]*/[^ ]*\)$|\1|p' "$1")"
    printf '%s' "$n"
}

ci_log_rows() {
    local d="$1" limit="${2:-0}" rows f reason
    [ -d "$d" ] || return 0
    rows="$(find "$d" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn | cut -d' ' -f2-)"
    [ -n "$rows" ] || return 0
    if [ "$limit" -gt 0 ]; then
        rows="$(printf '%s\n' "$rows" | head -n "$limit")"
    fi
    local result
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        # No result line means the closing step never ran: the job was killed
        # rather than finished, which on this box usually means the container
        # updated underneath it. Say so: a blank column reads like a bug in
        # this listing, and it is the opposite, a job whose end never happened.
        result="$(sed -n 's/^result: //p' "$f" | head -1)"
        printf '  %-20s %s  %-12s %s\n' "$(basename "$f" .log)" \
            "$(date -r "$f" '+%d %b %H:%M')" \
            "$(ci_log_name "$f")" \
            "${result:-(unfinished)}"
        # ...and why, when it is not a success. Which check failed and what it
        # said is the difference between a row somebody chases and a row
        # somebody scrolls past.
        if [ "${result:-}" != success ]; then
            reason="$(ci_log_reason "$f")"
            if [ -n "$reason" ]; then
                printf '  %-20s %s\n' "" "↳ $(trim_line "$reason" 88)"
            fi
        fi
    done <<< "$rows"
}

cmd_catchup() {
    local since="7d" n=8 gsince
    while [ $# -gt 0 ]; do
        case "$1" in
            --since) since="${2:-7d}"; shift ;;
            -n|--last) n="${2:-8}"; shift ;;
            *) die "usage: bb catchup [--since 7d] [-n COMMITS]" ;;
        esac
        # `|| break` because the option branches above have already consumed
        # their value: `bb catchup --since` with nothing after it would
        # otherwise shift an empty list and die under `set -e`.
        shift || break
    done
    case "$n" in ''|*[!0-9]*) die "-n takes a number" ;; esac
    # git understands "7 days ago" and not "7d"; the notebook's logs take "7d"
    # and a date. Accept the notebook's spelling and translate for git.
    case "$since" in
        [0-9]*d) gsince="${since%d} days ago" ;;
        *) gsince="$since" ;;
    esac

    echo "== this box =="
    printf '  %-9s %s\n' image "$(
        if [ -n "${BB_IMAGE_REV:-}" ]; then
            printf '%.7s%s' "$BB_IMAGE_REV" "${BB_IMAGE_BUILT:+ (built $BB_IMAGE_BUILT)}"
        else
            printf 'unstamped, built outside CI'
        fi)"
    printf '  %-9s %s\n' version "${BB_VERSION:-unstamped}"
    # The ledger the entrypoint keeps. Its last few lines answer "when did this
    # box change image, and what was it on before", which is most of what
    # "your fix is not working" turns out to be.
    local ledger; ledger="$(bb_image_log)"
    if [ -s "$ledger" ]; then
        while IFS=$'\t' read -r seen rev ver _built; do
            case "$seen" in '#'*|'') continue ;; esac
            printf '  %-9s %.7s  %-24s %s\n' ran "$rev" "$ver" \
                "since $(date -d "$seen" '+%d %b %H:%M' 2>/dev/null || printf '%s' "$seen")"
        done < <(grep -v '^#' "$ledger" | tail -3)
    else
        printf '  %-9s %s\n' ran "no ledger yet; this image predates it, or /config is not mounted"
    fi

    if git rev-parse --git-dir >/dev/null 2>&1; then
        # Remote-tracking refs go stale, and "level with main" read off a
        # week-old fetch is worse than no answer. Bounded and silent: a project
        # with no reachable remote should still get the rest of the screen.
        if git remote get-url origin >/dev/null 2>&1; then
            timeout 10 env GIT_TERMINAL_PROMPT=0 git fetch --quiet --no-tags origin \
                >/dev/null 2>&1 || true
        fi
        # Only meaningful where this checkout IS the image's source: elsewhere
        # the container's commit belongs to another repo entirely, and the
        # question answers itself by the rev being unknown here.
        if [ -n "${BB_IMAGE_REV:-}" ] && git cat-file -e "${BB_IMAGE_REV}^{commit}" 2>/dev/null; then
            local main behind
            main="$(git rev-parse --verify -q origin/main >/dev/null 2>&1 && echo origin/main || echo '')"
            if [ -n "$main" ] && git merge-base --is-ancestor "$BB_IMAGE_REV" "$main" 2>/dev/null; then
                behind="$(git rev-list --count "${BB_IMAGE_REV}..${main}" 2>/dev/null || echo '?')"
                if [ "$behind" = 0 ]; then
                    printf '  %-9s %s\n' serving "origin/main exactly: what is merged is what is running"
                else
                    # Being behind only matters if the missing commits are ones
                    # the image is BUILT from, the paths build-image.yml
                    # triggers on. Three merged doc commits leave the code in
                    # here current, and saying only "3 behind" sends somebody
                    # to `bb drift` to find that out.
                    local moved_inputs
                    moved_inputs="$(git diff --name-only "${BB_IMAGE_REV}..${main}" -- \
                        Dockerfile .dockerignore scripts config \
                        .github/workflows/build-image.yml 2>/dev/null | head -1)"
                    if [ -n "$moved_inputs" ]; then
                        printf '  %-9s %s\n' serving "$behind commit(s) behind origin/main, and they change the image; what is merged is NOT what is running"
                    else
                        printf '  %-9s %s\n' serving "$behind commit(s) behind origin/main, none of them image inputs; the code in here is current"
                    fi
                fi
            else
                printf '  %-9s %s\n' serving "an image built from a commit that is not on origin/main"
            fi
        fi

        local br up ahead behind dirty untracked
        br="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
        up="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
        if [ -n "$up" ]; then
            read -r ahead behind < <(git rev-list --left-right --count "HEAD...${up}" 2>/dev/null || echo "0 0")
            printf '  %-9s %s\n' branch "$br: ${ahead} ahead / ${behind} behind ${up}"
        else
            printf '  %-9s %s\n' branch "$br: no upstream"
        fi
        # And where it stands against MAIN, which is the half that decides
        # whether there is anything here to finish. "0 ahead / 0 behind its own
        # remote" reads as live work when the work is in fact merged and the
        # branch is parked, and a branch name reused across many PRs carries
        # nothing else to tell those apart.
        local mainref nahead
        mainref="$(git rev-parse --verify -q origin/main >/dev/null 2>&1 \
                   && echo origin/main || true)"
        if [ -n "$mainref" ] && [ "$br" != main ] && [ "$br" != '-' ]; then
            nahead="$(git rev-list --count "${mainref}..HEAD" 2>/dev/null || echo '?')"
            if [ "$nahead" = 0 ]; then
                printf '  %-9s %s\n' "vs main" "already in $mainref; nothing here is unmerged"
            else
                printf '  %-9s %s\n' "vs main" "$nahead commit(s) not in $mainref"
            fi
        fi
        dirty="$(git status --porcelain 2>/dev/null | grep -cv '^??' || true)"
        untracked="$(git status --porcelain 2>/dev/null | grep -c '^??' || true)"
        if [ "$dirty" = 0 ] && [ "$untracked" = 0 ]; then
            printf '  %-9s %s\n' tree "clean"
        else
            printf '  %-9s %s\n' tree "${dirty} changed, ${untracked} untracked; uncommitted work is here"
        fi

        echo
        echo "== commits since ${since} (merges omitted) =="
        # The subject says what changed; the first line of the body says why,
        # and in this repo that line is usually the most valuable thing a cold
        # session can read. --oneline throws it away, which is why this does
        # not use it.
        local rec sha day subj body line found=0
        while IFS= read -r -d $'\x1e' rec; do
            # tformat puts a newline after each record, so every record but the
            # first arrives with the previous one's line ending on the front.
            rec="${rec#$'\n'}"
            [ -n "$rec" ] || continue
            found=1
            sha="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            day="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            subj="${rec%%$'\x1f'*}"; body="${rec#*$'\x1f'}"
            printf '  %-6s  %-7s  %s\n' "$day" "$sha" "$(trim_line "$subj")"
            while IFS= read -r line; do
                case "$line" in
                    '') continue ;;
                    # Trailers are not why anything happened, and on a one-line
                    # commit they are the whole of %b.
                    [Cc]o-[Aa]uthored-[Bb]y:*|[Ss]igned-off-by:*|Claude-Session:*|http*) continue ;;
                esac
                printf '  %-6s  %-7s  %s\n' "" "" "$(trim_line "$line")"
                break
            done <<< "$body"
        done < <(git log --no-merges -n "$n" --since="$gsince" \
                     --date=format:'%d %b' \
                     --pretty=tformat:'%h%x1f%ad%x1f%s%x1f%b%x1e' 2>/dev/null)
        [ "$found" = 1 ] || echo "  nothing committed here in that window"
    fi

    local proj; proj="$(project_here || true)"
    if [ -n "$proj" ]; then
        echo
        echo "== the notebook =="
        # Its own log, not the tabs' contents: the open items are already in a
        # session's prompt, and what is missing from there is what MOVED.
        # One line per change, trimmed. `bb history` prints an entry's whole
        # text (which for a roadmap `info` is a page) and three of those is
        # the screen this command exists to be.
        local moved
        # -n is generous because the filter below throws lines away, and a
        # section starved to two rows is worse than one that scrolls.
        moved="$(cmd_history --since "$since" -n 24 2>/dev/null | while IFS= read -r line; do
                     case "$line" in
                         '  '[0-9][0-9]' '[A-Za-z][A-Za-z][A-Za-z]' '*) ;;
                         *) continue ;;
                     esac
                     # A roadmap `add` or `info` is already in the session's
                     # prompt verbatim (the whole open list is), so printing
                     # it here charges for it twice. What is NOT in the prompt
                     # is an item that has LEFT the list, which is exactly what
                     # `done` and `dropped` are, and they are the roadmap moves
                     # a cold session cannot otherwise discover. Bugs and
                     # memories stay whatever they did: neither arrives whole.
                     if [[ "$line" =~ ^\ \ [0-9]{2}\ [A-Za-z]{3}\ [0-9]{2}:[0-9]{2}\ \ roadmap\ \ [^\ ]+\ \ (add|info|edit)\  ]]; then
                         continue
                     fi
                     printf '%s\n' "$(trim_line "$line" 108)"
                 # sed, not head: head closes the pipe as soon as it has its
                 # eight lines and the loop above dies of SIGPIPE, taking the
                 # whole command out with rc=141 under `set -e`.
                 done | sed -n '1,8p')"
        if [ -n "$moved" ]; then
            printf '%s\n' "$moved"
            echo "  ('bb history' for these in full; the text is cut short here)"
        else
            echo "  nothing moved in that window"
        fi

        echo
        echo "== builds this box archived =="
        local dir rows; dir="$(ci_log_dir)/$proj"
        rows="$(ci_log_rows "$dir" 5)"
        if [ -n "$rows" ]; then
            printf '%s\n' "$rows"
            echo "  ('bb ci-log RUN' for one in full)"
        elif ci_hosted_only "$proj"; then
            # Its workflows name no self-hosted runner, so its jobs run on
            # GitHub's machines, which keep the log on GitHub: saying it is on
            # the node sent Shebang-DevBoard's session to bb ci-log for a run
            # it never kept (B443).
            echo "  none here: this project's workflows run on GitHub's own runners,"
            echo "  which keep the logs; 'bb ci-log --list' asks GitHub for them"
        elif [ -n "$(project_node 2>/dev/null)" ]; then
            # CI runs on the project's node now, so the records are there.
            # Not fetched here: catchup is read often and a job per read is
            # the wrong price for a summary. bb ci-log goes and gets them.
            echo "  none kept here: CI runs on this project's node, so its"
            echo "  records are there: 'bb ci-log --list' fetches them"
        else
            echo "  none kept; only a job that runs on this box archives one"
        fi

        # What the CI watch last found (R117), kept by the dashboard beside
        # its state: a red main branch, a moving runner label, an action a
        # major behind, a notice GitHub wrote on the newest run.
        local cw; cw="${DASHBOARD_STATE:-/config}/ciwatch/$proj.json"
        if [ -r "$cw" ]; then
            echo
            echo "== CI, as the daily look found it =="
            python3 - "$cw" <<'EOF' || true
import json
import sys
import time

r = json.load(open(sys.argv[1]))
# A look kept by older code (ciwatch.FORMAT) is no look: the dashboard looks
# again within the hour.
if r.get("format") != 3:
    print("  not looked at since BuilderBot was updated; the next look is within the hour")
    sys.exit(0)
age = int((time.time() - r.get("at", 0)) / 3600)
run = r.get("run") or {}
print(f"  looked {age} h ago" + (f" at {r['repo']} on GitHub" if r.get("repo") else "")
      + (f"; the newest run on {run.get('branch')} {run.get('ended') or 'ended ' + str(run.get('conclusion'))}" if run else ""))
for f in r.get("findings") or []:
    print(f"  {f.get('kind', ''):<7} {f.get('where', '')}: {f.get('text', '')[:300]}")
if not r.get("findings") and not r.get("workflows") and not run:
    print("  no workflow in .github/workflows: there is no CI here to watch")
elif not r.get("findings"):
    print("  nothing drifting")
if r.get("error"):
    print(f"  (GitHub: {r['error']})")
EOF
        fi
    fi
}

# On a node there is no container to have booted, so naming the controller's
# /config path here reads as a broken install rather than as the wrong
# machine. Says nothing at all on the controller, where the path is right.
logs_are_the_controllers() {
    on_node || return 0
    die "there is no container log here: this is a node, and that log is the" \
        "controller's. From here: \`bb diag errors\` for the controller's faults," \
        "\`bb jobs\` for a job's log, \`bb logs --node NAME --agent\` for a node's own," \
        "and \`bb ci-log\` for a CI run (the first three need the project's Debug grants)"
}

# bb diag: the controller's diagnostics (scripts/dashboard/diag.py). One
# request, so the gate is the server's: the debug grant anywhere, and a
# session only with debug mode on, its project granted it in its settings,
# and an account with the debug grant behind it. Read-only; secrets are redacted
# there, not here.
cmd_diag() {
    local json=0 sections=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1 ;;
            -h|--help) printf 'usage: bb diag [--json] [controller|images|settings|doctor|nodes|plugins|jobs|errors|audit|reports]...\n'; return 0 ;;
            -*) die "bb diag: no such option \`$1'" ;;
            *) sections+=("$1") ;;
        esac
        shift
    done
    local auth
    auth="$(bb_auth_or_die)"
    BB_DIAG_AUTH="$auth" BB_DIAG_JSON="$json" python3 "$BB_LIB/diag.py" "${sections[@]}"
}

# bb report: a problem with BuilderBot itself, from a session on any project
# (reports.py). Filed in the project's own tracker it was lost to BuilderBot:
# the operator read it second hand. It goes to the controller's diagnostics
# instead (bb diag reports), a log a person reads and clears; nothing comes
# back to the session that made it, since only this one install has
# BuilderBot's own tracker beside the sessions reporting to it.
# A person's Windows PC lent to this project by the Windows companion
# (R270 step 6): lib/pc.py says the verbs.
cmd_pc() {
    case "${1:-}" in
        -h|--help)
            printf '%s\n' 'usage: bb pc                        the PCs lending this project and their verbs' \
                '       bb pc VERB [--why "..."]     run one (editor-start, editor-stop, game-start, game-stop, build, shot, log)' \
                '       bb pc editor-call METHOD PATH [--body JSON] [--why "..."]'
            return 0 ;;
    esac
    BB_PC_AUTH="$(bb_auth_or_die)" python3 "$BB_LIB/pc.py" "$@"
}

cmd_report() {
    local auth proj sub="${1:-}"
    auth="$(bb_auth_or_die)"
    proj="${BB_PROJECT:-$(project_here 2>/dev/null || true)}"
    case "$sub" in
        -h|--help)
            printf '%s\n' 'usage: bb report "what happened" [--area A] [--repro "..."]' \
                '       bb report conversation N    the reporter'"'"'s conversation a report carries (the diagnostics'"'"' gate)'
            return 0 ;;
        conversation) ;;
        "") die 'bb report "what happened": say what went wrong; bb diag reports lists what was reported' ;;
        *) sub=add ;;
    esac
    [ "$sub" = add ] || shift || true
    BB_R_AUTH="$auth" BB_R_PROJECT="$proj" BB_R_SUB="$sub" python3 "$BB_LIB/report.py" "$@"
}

cmd_logs() {
    local base logfile follow=0 lines=100 gen="" want_node="" stream=""
    base="$(bb_log_dir)/builderbot.log"
    while [ $# -gt 0 ]; do
        case "$1" in
            --node) want_node="${2:-}"; shift ;;
            --agent|--runner|--terminal|--nginx|--system|--kernel|--crash) stream="${1#--}" ;;
            -f) follow=1 ;;
            -l|--list)
                # Every stream, newest first, so the top of the list is this
                # boot. It used to list only builderbot.log's generations,
                # which made the other three (the dashboard, docker and ttyd,
                # all of which rotate the same way now) look like they did not
                # exist.
                if ! ls -1t "$(bb_log_dir)"/*.log "$(bb_log_dir)"/*.log.[0-9]* 2>/dev/null; then
                    logs_are_the_controllers
                    die "no logs in $(bb_log_dir)"
                fi
                return 0
                ;;
            -p|--prev)
                # The log rotates per container start, so generation N is the
                # Nth boot back. Bare -p means the previous one.
                case "${2:-}" in
                    ''|*[!0-9]*) gen=1 ;;
                    *) gen="$2"; shift ;;
                esac
                ;;
            *[!0-9]*) die "bb logs: no such option \`$1'. Streams are --agent," \
                   "--runner, --terminal, --nginx, --system, --kernel and --crash; see \`bb logs --list'" ;;
            [0-9]*) lines="$1" ;;
            # A flag this does not know used to fall straight through, so
            # `bb logs --node X --nope` quietly read the AGENT's journal and
            # looked like the stream had been honored. A wrong answer that
            # looks like an answer is the worst of the three outcomes.
            *) die "bb logs: no such option \`$1'. Streams are --agent," \
                   "--runner, --terminal, --nginx, --system, --kernel and --crash; see \`bb logs --list'" ;;
        esac
        shift
    done
    # A MACHINE's own log (the agent's journal, the runner's, the terminal
    # server's), which is root's on that box and is not offered to a session
    # by default. The controller decides: its debug switch, then the grant on
    # the asking node's row. Both refusals say what would change them.
    if [ -n "$want_node" ] || [ -n "$stream" ]; then
        [ -n "$want_node" ] || want_node="${BB_NODE:-}"
        [ -n "$want_node" ] || die "which node? bb logs --node NAME [--agent|--runner|--terminal|--nginx|--system|--kernel|--crash]"
        # A node's log is read once through a job, so there is nothing to
        # follow: said, rather than -f quietly printing once.
        [ "$follow" = 0 ] || die "bb logs --node reads the last lines once; -f follows only the controller's own log"
        local auth
        auth="$(bb_auth_or_die)"
        BB_LOG_AUTH="$auth" BB_LOG_NODE="$want_node" \
        BB_LOG_STREAM="${stream:-agent}" BB_LOG_LINES="$lines" python3 "$BB_LIB/node-log.py"
        return
    fi
    if [ -n "$gen" ]; then
        logfile="${base}.${gen}"
    else
        logfile="$base"
    fi
    if [ ! -f "$logfile" ]; then
        logs_are_the_controllers
        die "no log at ${logfile}; see: bb logs --list"
    fi
    if [ "$follow" -eq 1 ]; then
        tail -n "$lines" -f "$logfile"
    else
        tail -n "$lines" "$logfile"
    fi
}

# Reduce a SARIF report to grouped markdown.
#
# This reads scan output and nothing else. The scanner itself lives outside the
# container on purpose (/reports is mounted read-only and no scanner binary is
# installed), so there is no way to start a scan from in here, by design. If the
# findings look stale, the fix is to re-run the scanner on the host.
#
# Raw SARIF is mostly metadata: a few hundred KB of it would fill a session's
# context before it reached the code the findings are about. Grouping by
# severity then rule, and listing bare locations under one message, keeps the
# same information at a fraction of the size.
FINDINGS_JQ='
def parts($p): ($p | ltrimstr("/") | split("/"));

# Everything up to and including the project directory is where the scanner
# saw the code, not where this container mounts it. Dropping that prefix makes
# the path openable from the project root.
def strip_path($p): parts($p) as $ps
  | ($ps | index($proj)) as $i
  | if $i != null then ($ps[($i + 1):] | join("/")) else ($ps | join("/")) end;

def rank: {"error":0, "warning":1, "note":2, "info":2, "none":3}[.] // 4;

[ .runs[]
  | (reduce ((.tool.driver.rules // [])[]) as $x
      ({}; .[$x.id] = { level: ($x.defaultConfiguration.level // "warning"),
                        desc:  ($x.shortDescription.text // $x.fullDescription.text // "") })) as $rules
  | .results[]?
  | (.locations[0].physicalLocation.artifactLocation.uri // "?") as $uri
  | { level: (.level // $rules[.ruleId].level // "warning"),
      rule:  (.ruleId // "unknown"),
      # The rule description beats the result message as a group heading. Some
      # tools (Trivy) put the artifact path on the message first line, so the
      # heading would name one file while the group lists several.
      msg:   ( if ($rules[.ruleId].desc // "") != "" then $rules[.ruleId].desc
               else ((.message.text // "") | split("\n")[0]) end ),
      mine:  ((parts($uri) | index($proj)) != null),
      # First two components identify the tree a finding came from, which is
      # what you need when the answer is "that is a different project".
      tree:  (parts($uri)[0:2] | join("/")),
      loc:   ( strip_path($uri)
               + ":" + ((.locations[0].physicalLocation.region.startLine // 0) | tostring) ) } ]
| . as $all
| (if $scope == "all" then $all else map(select(.mine)) end) as $scoped
# The same three narrowings the dashboard bar offers. note and info are one
# level everywhere here (rank already merges them), so --level note takes both.
| ($scoped
   | (if $level == "" then . else
        map(select(if $level == "note" or $level == "info"
                   then (.level == "note" or .level == "info")
                   else .level == $level end)) end)
   | (if $rule == "" then . else
        ($rule | ascii_downcase) as $r
        | map(select((.rule | ascii_downcase) == $r)) end)
   | (if $find == "" then . else
        ($find | ascii_downcase) as $q
        | map(select((.rule + " " + .loc + " " + .msg)
                     | ascii_downcase | contains($q))) end)) as $rows
| ($rows | length) as $n
| ($level != "" or $rule != "" or $find != "") as $filtered
| if ($all | length) == 0 then "No findings.\n"
  elif $n == 0 and $filtered and ($scoped | length) > 0 then
    "No findings match the filters; \($scoped | length) before filtering.\n"
  elif $n == 0 then
    ( if $relayed != "" then "No findings for \($proj) in this report.\n"
      else "No findings for \($proj). This report covers: "
           + (($all | map(.tree) | unique | join(", ")))
           + "\nRun with --all to see them anyway.\n" end )
  else
  ( "# Findings (\($n)\(if $filtered then " matching, of \($scoped | length)" else "" end))"
  + (if $scope == "all" then ": all projects in this report\n"
     elif $relayed != "" then " in \($proj)\n"
     else " in \($proj), of \($all | length) in the report; --all for the rest\n" end)
  + ( $rows | group_by(.level) | sort_by(.[0].level | rank)
      | map( "\n## \(.[0].level) (\(length))\n"
             + ( group_by(.rule) | sort_by(-length)
                 | map( "\n### \(.[0].rule) (\(length))\n\(.[0].msg)\n"
                        + ( map("- \(.loc)") | unique | join("\n") ) + "\n" )
                 | join("") ) )
      | join("") ) )
  end'

# The shared to-do list, from a session's side. Same file the dashboard writes
# (/config/roadmap.json) and the same module reads it: one implementation, so a
# list edited from a phone and a list edited from a terminal cannot disagree.
#
# The project is the directory this is run in, not an argument: a session is
# already in its project, and asking it to name one is asking it to get one
# wrong.
cmd_roadmap() {
    local py
    # roadmap.py, still: the file is where the roadmap has always been implemented
    # and renaming it would move code the running image serves by absolute
    # path. The command is what the operator reads, and that is `bb roadmap`.
    py="$(dirname "$(readlink -f "$0")")/dashboard/roadmap.py"
    [ -f "$py" ] || die "roadmap.py is missing from this image"
    local proj="${BB_ROADMAP_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/roadmap-verbs.py" "$py" "$proj" "$@"
}

cmd_history() {
    # One search over all three of the notebook's logs (roadmap, bugs, and
    # what the dashboard did to the memories), tagged by source and merged by
    # time. `bb roadmap history` and `bb bug history` scope to one; this is for
    # "when did anything here mention the picker?", which is a question about
    # the notebook and not about a tab of it.
    local dir
    dir="$(dirname "$(readlink -f "$0")")/dashboard"
    local proj="${BB_ROADMAP_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/nb-history.py" "$dir" "$proj" "$@"
}

# bb brief [take]: a new project's brief, through the API as the caller.
# take is bb-tty's, as it starts a new session: the brief the account staged
# with Build it, printed for the launcher to hand claude, or nothing; it
# never fails, because a brief is not a reason for a session not to start.
# `bb design`: the project's design language and pages, as the notebook's
# Design view keeps them. Read only from here: a session applies a design,
# and the words it is handed are the controller's (design.py), so what it
# prints is what the tab shows.
cmd_design() {
    local verb="${1:-list}" auth proj
    case "$verb" in list|show|file|json|schema|save) ;; -h|--help)
        echo "bb design [list | show [ID|NAME] | file | json | schema | save FILE]: what this project looks like, from the notebook's Design view; bb design save -h prints the record's shape"; return 0 ;;
        *) die "bb design [list | show [ID|NAME] | file | json | schema | save FILE]" ;; esac
    proj="$(bb_project)" || die "not inside a project under ${WORKSPACE}; cd into one first"
    auth="$(bb_auth_or_die)"
    BB_DESIGN_AUTH="$auth" BB_DESIGN_PROJECT="$proj" python3 "$BB_LIB/design-verbs.py" "$@"
}

# `bb transcripts`: this account's own conversations with Claude on the
# project, as the Profile tab lists them; `bb -p NAME transcripts` for a
# project this one reads (the operator, 29 Sep). Only the account's own:
# the controller looks under its transcripts and nowhere else.
cmd_wiki() {
    local auth proj
    case "${1:-}" in -h|--help) usage | sed -n '/^bb wiki /,/^bb [^w]/p' | sed '$d'; return 0 ;; esac
    proj="$(bb_project)" || die "not inside a project under ${WORKSPACE}; cd into one first"
    auth="$(bb_auth_or_die)"
    BB_WIKI_AUTH="$auth" BB_WIKI_PROJECT="$proj" python3 "$BB_LIB/wiki-verbs.py" "$@"
}

cmd_transcripts() {
    local verb="${1:-list}" auth proj
    case "$verb" in list|show|fetch) ;; -h|--help)
        echo "bb transcripts [list | show ID [--tz ZONE] [--all] | fetch ID [--into DIR]]: your own conversations with Claude on this project, from the controller"; return 0 ;;
        *) die "bb transcripts [list | show ID [--tz ZONE] [--all] | fetch ID [--into DIR]]" ;; esac
    proj="$(bb_project)" || die "not inside a project under ${WORKSPACE}; cd into one first"
    auth="$(bb_auth_or_die)"
    BB_TRANSCRIPTS_AUTH="$auth" BB_TRANSCRIPTS_PROJECT="$proj" python3 "$BB_LIB/transcripts-verbs.py" "$@"
}

cmd_brief() {
    local verb="${1:-show}" auth proj
    case "$verb" in show|take) ;; -h|--help) echo "bb brief: the brief this project was started from"; return 0 ;;
        *) die "bb brief: the brief this project was started from (take is bb-tty's)" ;; esac
    proj="$(bb_project 2>/dev/null)" \
        || { [ "$verb" = take ] && return 0; die "not inside a project under ${WORKSPACE}; cd into one first"; }
    if [ "$verb" = take ]; then
        auth="$(bb_auth_header 2>/dev/null)" || return 0
        [ -n "$auth" ] || return 0
    else
        auth="$(bb_auth_or_die)"
    fi
    BB_BRIEF_AUTH="$auth" BB_BRIEF_PROJECT="$proj" python3 "$BB_LIB/brief-verbs.py" "$verb" \
        || [ "$verb" = take ]
}

cmd_preamble() {
    # What a session started on this project is handed: the house rules, the
    # open roadmap and the open bugs, in the order it reads them. bb-tty asks
    # for this rather than joining the three itself, and the Briefing tab
    # draws the same string: one assembly, so the tab cannot drift from what
    # a session actually gets.
    local dir py
    dir="$(dirname "$(readlink -f "$0")")/dashboard"
    py="$dir/preamble.py"
    [ -f "$py" ] || die "preamble.py is missing from this image"
    local proj="${BB_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    python3 "$BB_LIB/preamble-verbs.py" "$dir" "$proj" "${1:-}" "${2:-}"
}

# bb help [VERB|TOPIC]: the list; one verb's lines; or one topic of the
# session briefing (R202), which a node relays like the rest of bb preamble.
cmd_help() {
    [ -n "${1:-}" ] || { usage; return 0; }
    verb_help "$1" 2>/dev/null && return 0
    case "$1" in
        topics) bash "$0" preamble --topics ;;
        *) bash "$0" preamble --topic "$1" ;;
    esac
}

cmd_rules() {
    # The house rules: the operator's on the Briefing tab, a session's own
    # through add/edit/rm here. Each carries who wrote it, and a session may
    # change only its own; see rules.py for the ownership and the log.
    # Its help, as every verb's -h is (B411): the lines bb help carries for it.
    case "${1:-}" in
        -h|--help) usage | sed -n '/^bb rules /,/^bb [^r]/p' | sed '$d'; return 0 ;;
    esac
    local proj="${BB_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    # `bb rules check` runs a rule's check command HERE, in this tree, on
    # whichever machine the session is on (roadmap R31): the rules themselves
    # come through `bb rules --json`, which is relayed on a node, so this
    # needs neither /config nor rules.py, only git, the tree and the command.
    if [ "${1:-}" = check ]; then
        shift
        local rules_json
        # Exit 75 (EX_TEMPFAIL) when the rules could not be read, which on a
        # node is the controller not answering: a check that could not run,
        # and the hand-back hook lets that pass rather than calling it a
        # failed check (B412).
        rules_json="$(BB_PROJECT="$proj" bash "$0" rules --json)" \
            || { warn "could not read the rules, so no check ran: the controller may be restarting"; return 75; }
        # The tree is the one the check is run in: a git worktree of the
        # project (a subagent's, under .claude/worktrees) is checked as
        # itself, not as the main checkout's branch (B103). Any other
        # directory is the project's own tree.
        local tree="$WORKSPACE/$proj" top
        top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
        if [ -n "$top" ] && [ "$top" != "$tree" ] \
            && [ "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
                 = "$(git -C "$tree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
            tree="$top"
        fi
        RULES_JSON="$rules_json" python3 "$BB_LIB/rules-check.py" "$tree" "$@"
        return $?
    fi
    # `bb rules audit [DAYS]` (R200): this account's conversations on the
    # project, counted against the rules that refuse, through the
    # controller's API like bb transcripts, which is where they are kept.
    if [ "${1:-}" = audit ]; then
        shift
        BB_TRANSCRIPTS_AUTH="$(bb_auth_or_die)" BB_TRANSCRIPTS_PROJECT="$proj" \
            python3 "$BB_LIB/transcripts-verbs.py" audit "$@"
        return $?
    fi
    # Every verb BELOW here reads and writes the rules themselves, which is
    # the controller's file and the controller's module. Resolved here rather
    # than at the top of this function, because `check` above needs neither:
    # it takes the rules through `bb rules --json`, which a node relays, and
    # runs the command in this tree. Asked for at the top, this killed every
    # `bb rules check` on a node, where the bundle carries bb and no dashboard
    # module by design, so the hand-back hook blocked on the one machine
    # sessions actually run on.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/rules.py"
    [ -f "$py" ] || die "rules.py is missing from this image"
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 "$BB_LIB/rules-verbs.py" "$py" "$proj" "$@"
}

# tests_verdict LOGFILE: what went wrong, from a run's own log.
#
# A suite prints two thousand PASS lines and one thing that matters, and until
# this the answer to "what broke" was a grep. Worse, a grep for FAIL finds
# nothing when a FILE CRASHES: an uncaught exception ends that file with a
# stack trace and no `FAIL` line and no totals line, and the run said only
# "FAILURES above". That cost four nine-minute runs to find one timeout.
#
# So the log is read rather than skimmed. Per file: its failed assertions by
# name, and, when it printed no totals line, the fact that it died and the
# line it died on. Both, for a file that did both: a crash is usually the
# second symptom, a click on something an assertion three lines up has
# already said is missing, and a verdict that printed only the death sent
# the reader to the wrong line. Nothing here re-runs anything; a failure is
# explained from the log the run already wrote, which is what `bb tests last`
# reads too.
tests_verdict() {
    BB_VERDICT_LOG="$1" python3 "$BB_LIB/tests-verdict.py"
}

# BB_REPO from the working tree's top when it is not set, so a test verb run
# from inside the checkout finds the checkout (B778).
bb_repo_top() {
    [ -n "${BB_REPO:-}" ] && return
    local top; top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
    [ -x "$top/scripts/dashboard/test/run.sh" ] && export BB_REPO="$top"
    return 0
}

cmd_tests() {
    # The test registry's CLI half: the side a session drives, and the only
    # side that can ingest, because ingesting means reading what a runner
    # printed and the dashboard runs no suites.
    #
    # Same shape as cmd_bug: the project from the working directory (or
    # BB_TESTS_PROJECT), the module loaded from the file beside this script so
    # the checkout's copy is the one under test.
    # Checked below rather than here: `run` does not touch this module. It
    # runs the suite and relays the ingest, and the node bundle carries bb
    # without the dashboard's python, so the guard up here made `bb tests
    # run` the one verb that cannot work on a node, which is the one machine
    # a suite actually runs on.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/testreg.py"
    # The checkout is the working tree's top, not the working directory:
    # from scripts/dashboard every verb looked for scripts/dashboard/scripts/
    # and said there was no harness (B778).
    bb_repo_top
    # The lab suites (roadmap R54): the ones that need a real service, run
    # against the lab's Gitea and skipped in one line without it. Not
    # recorded in the registry: a lab run is a proof, not a timing.
    # The Gitea is the `gitea` service of BuilderBot's own dev stack, under
    # its compose file's `lab` profile: brought up from the Docker tab like
    # any project's stack, never by a verb of this script's, so testing
    # BuilderBot takes the paths every project takes. Reached on the node
    # the stack runs on, which is where a suite runs too.
    # A probe (roadmap R75 step 2): a scratch Playwright script, from
    # anywhere, run against the dashboard fixture the way a suite is. The
    # harness copies it beside lib.mjs so its `./lib.mjs` resolves, and
    # runs it against a kept fixture when one is up.
    if [ "${1:-}" = probe ]; then
        shift
        [ $# -gt 0 ] || die "bb tests probe FILE.mjs [FILE...]: a script that imports './lib.mjs' and drives the fixture; after bb tests keep it attaches to the fixture that is up"
        local f files=()
        for f in "$@"; do
            [ -f "$f" ] || die "no such file: $f"
            files+=("$(readlink -f "$f")")
        done
        cmd_dashboard test "${files[@]}"
        return
    fi
    # The kept fixture: the harness's whole set-up once, held up until
    # stopped, so a suite or a probe attaches to it, and the world a suite
    # just left is there for a probe to look at. Its state is not put back
    # between runs; `bb tests keep` again for a clean world.
    if [ "${1:-}" = keep ]; then
        shift
        local keepf="${TMPDIR:-/tmp}/bb-suite.keep" here="${BB_REPO:-$PWD}/scripts/dashboard/test/run.sh"
        local keeplog="${TMPDIR:-/tmp}/bb-suite.keep.log"
        case "${1:-}" in
            stop)
                [ -f "$keepf" ] || die "no fixture is kept"
                # shellcheck source=/dev/null
                . "$keepf"
                kill "${KEEP_PID:-0}" 2>/dev/null || true
                local _
                for _ in $(seq 100); do [ -f "$keepf" ] || break; sleep 0.2; done
                [ -f "$keepf" ] && rm -f "$keepf"
                log "the kept fixture is stopped"; return ;;
            log) tail -n "${2:-40}" "$keeplog" 2>/dev/null || die "no kept fixture has logged anything"; return ;;
            "") ;;
            *) die "bb tests keep [stop|log]" ;;
        esac
        if [ -f "$keepf" ]; then
            # shellcheck source=/dev/null
            . "$keepf"
            if kill -0 "${KEEP_PID:-0}" 2>/dev/null; then
                log "a fixture is kept at $KEEP_URL (test:test), up $(( $(date +%s) - ${KEEP_SINCE:-0} ))s; bb tests keep stop ends it"
                return
            fi
            rm -f "$keepf"
        fi
        [ -x "$here" ] || die "no dashboard test harness at $here: run this from the BuilderBot checkout"
        # In a group of its own, so a keep that gives up can end it: one left
        # waiting for another run's lock came up minutes later, and every bb
        # dashboard test after attached to it, a world the suites before had
        # filled (B843).
        BB_TEST_HOLD=1 setsid nohup bash "$here" > "$keeplog" 2>&1 &
        local hold=$! _
        for _ in $(seq 150); do [ -f "$keepf" ] && break; sleep 1; done
        if [ ! -f "$keepf" ]; then
            kill -- -"$hold" 2>/dev/null || kill "$hold" 2>/dev/null || true
            local why="bb tests keep log has what it said"
            grep -q "waiting for the run that holds the lock" "$keeplog" 2>/dev/null \
                && why="it was waiting for another test run's lock; keep again once that run ends"
            die "the fixture did not come up within 150s, and it is ended so it cannot come up later: $why"
        fi
        # shellcheck source=/dev/null
        . "$keepf"
        log "fixture kept at $KEEP_URL (test:test): bb dashboard test SUITE and bb tests probe FILE attach to it; bb tests keep stop ends it"
        return
    fi
    if [ "${1:-}" = preflight ]; then shift; cmd_tests_preflight "$@"; return; fi
    # The unit tier: the pure python modules' rules as plain unittest, no
    # server and no browser, in well under a second. Preflight runs it first
    # so a broken rule fails before twenty minutes of browser suites do.
    if [ "${1:-}" = unit ]; then
        shift
        local u="${BB_REPO:-$PWD}/scripts/dashboard/unit"
        [ -d "$u" ] || die "no unit tests at $u: run this from the BuilderBot checkout"
        python3 -m unittest discover -s "$u" -t "$u" "${@:--q}"
        return
    fi
    # A covered run (roadmap R76): the suite, or the named suites, with the
    # counters in, and the map's account of what they reached after.
    if [ "${1:-}" = coverage ]; then
        shift
        local here="${BB_REPO:-$PWD}/scripts/dashboard/test/run.sh" rc=0
        [ -x "$here" ] || die "no dashboard test harness at $here: run this from the BuilderBot checkout"
        BB_COVERAGE=1 bash "$here" "$@" || rc=$?
        cmd_map coverage
        return "$rc"
    fi
    if [ "${1:-}" = lab ]; then
        # Each lab suite says what it needs and skips itself in one line
        # without it (R54 step 4). This used to die unless a Gitea answered,
        # which meant a suite needing only a node could never run: the tier
        # was one service wide by accident.
        local ok_gitea="" ok_ctl=""
        BB_LAB_GITEA="${BB_LAB_GITEA:-http://127.0.0.1:3000}"
        if curl -fs "$BB_LAB_GITEA/api/healthz" >/dev/null 2>&1; then
            export BB_LAB_GITEA; ok_gitea="$BB_LAB_GITEA"
        else
            unset BB_LAB_GITEA          # absent, so the forge suites skip
        fi
        # ...and the lab's Forgejo, one port along, which the forge suite runs
        # against a second time under its own catalog entry.
        local ok_forgejo=""
        BB_LAB_FORGEJO="${BB_LAB_FORGEJO:-http://127.0.0.1:3001}"
        if curl -fs "$BB_LAB_FORGEJO/api/healthz" >/dev/null 2>&1; then
            ok_forgejo="$BB_LAB_FORGEJO"
        else
            unset BB_LAB_FORGEJO
        fi
        if [ -n "${BB_LAB_CONTROLLER:-}" ] && [ -n "${BB_LAB_NODE:-}" ] \
           && [ -n "${BB_LAB_TOKEN:-}" ]; then
            export BB_LAB_CONTROLLER BB_LAB_NODE BB_LAB_TOKEN
            ok_ctl="$BB_LAB_CONTROLLER ($BB_LAB_NODE)"
        fi
        echo "lab services: gitea=${ok_gitea:-none} forgejo=${ok_forgejo:-none} controller=${ok_ctl:-none}"
        if [ -z "$ok_gitea" ] && [ -z "$ok_ctl" ]; then
            echo "lab: nothing answers, so every suite will skip and that is not a failure."
            echo "     A Gitea comes from the lab's own stack, lab/compose.yml, made with"
            echo "     bb container new beside the dev instance. A node comes from the three"
            echo "     variables BB_LAB_CONTROLLER, BB_LAB_TOKEN and BB_LAB_NODE, naming one"
            echo "     you are willing to have a job run on."
        fi

        local tdir; tdir="$(dirname "$(readlink -f "$0")")/dashboard/test"
        local -a labs=()
        local f
        for f in "$tdir"/lab-*.mjs; do [ -e "$f" ] && labs+=("$(basename "$f" .mjs)"); done
        [ "${#labs[@]}" -gt 0 ] || die "no lab suites (test/lab-*.mjs) in this checkout"
        local rc=0
        bash "$tdir/run.sh" "${labs[@]}" || rc=$?
        if [ -n "$ok_forgejo" ]; then
            echo "lab: the forge suite again, against Forgejo at $ok_forgejo"
            BB_LAB_GITEA="$ok_forgejo" BB_LAB_FORGE=forgejo bash "$tdir/run.sh" lab-forge || rc=$?
        fi
        return "$rc"
    fi
    local proj="${BB_TESTS_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    # `ingest` with no file reads stdin, so the whole thing is one pipe. The
    # log reaches python as a PATH, never as a value: a run log is a couple
    # of hundred kilobytes; passed in the environment it is "Argument list
    # too long", which is how this was found.
    # `run` closes the loop the registry was built for: a suite is run, its
    # real durations are parsed, and the registry stops going stale because
    # somebody forgot the second step. Same command `bb test` runs (the
    # project's own, from its settings) with BB_TEST_TIMING=1 in front of it.
    #
    # On a node that command runs right here in this tree, dirty edits and
    # all (cmd_run's on_node branch), so this is the iterate loop; from the
    # controller it is a job on the project's node, streamed back the same
    # way, and takes a row in the Jobs tab that somebody else can watch.
    # `last`: the same verdict, off the log the last run wrote, without
    # running anything. A red suite should cost one run, not four: what broke
    # is a fact the log already holds, and re-running to find it out again is
    # nine minutes for an answer that was on disk.
    # The run's output itself, which bb tests run tees beside the project.
    # `-f` follows a run that is still going: the Tests view's button sends
    # this into the project's shell, where output belongs (it can be
    # scrolled, paged and left running), rather than into a box on a row
    # that redrew for every line.
    if [ "${1:-}" = log ]; then
        local rl="${WORKSPACE}/${proj}/.bb-test-run.log"
        [ -f "$rl" ] || die "no run log yet; \`bb tests run\` writes one beside the project"
        if [ "${2:-}" = -f ] || [ "${2:-}" = --follow ]; then
            exec tail -n 200 -f "$rl"
        fi
        bb_cat_tail "$rl" "$([ "${2:-}" = --all ] && echo 1 || echo 0)" "bb tests log --all"
        return
    fi
    if [ "${1:-}" = last ]; then
        local prev="${WORKSPACE}/${proj}/.bb-test-run.log"
        [ -f "$prev" ] || die "no run log yet; \`bb tests run\` writes one beside the project"
        printf 'from %s, %s\n' "$(basename "$prev")" \
            "$(date -r "$prev" '+%d %b %H:%M' 2>/dev/null || echo 'unknown time')"
        tests_verdict "$prev"
        return
    fi
    if [ "${1:-}" = run ]; then
        shift
        # Into the project rather than /tmp, and that is not laziness: on a
        # node `bb tests ingest` is relayed, and the controller reads the path
        # it is given on ITS filesystem. /workspace is the one thing both
        # machines see. Gitignored where this is used.
        local log="${WORKSPACE}/${proj}/.bb-test-run.log"
        log="$(cd "$(dirname "$log")" 2>/dev/null && pwd)/$(basename "$log")"             || die "cannot write beside $proj"
        # BB_PROJECT as well as the registry's own variable: the run and the
        # record have to be about the same project, and `bb test` reads a
        # different name for it than `bb tests` does.
        #
        # In an `if` rather than after a `||`: errexit is suppressed inside a
        # condition, and PIPESTATUS still holds the pipeline's own statuses,
        # which is the only way to end up with the SUITE's exit code rather
        # than tee's. Read straight after `|| rc=$?` it is the `||`'s.
        # Say when it will be done before it starts, from the registry's
        # last run, and how the finish compared: the projection is the
        # measurement's whole point, and a run nobody can time is guessed at.
        local rc=0 t0 want took
        # With what is being run, so a narrowed run is projected from those
        # suites rather than from the whole thing.
        BB_TESTS_PROJECT="$proj" "$0" tests projection "$@" 2>/dev/null || true
        want="$(BB_TESTS_PROJECT="$proj" "$0" tests projection --secs "$@" 2>/dev/null || echo 0)"
        t0=$(date +%s)
        if BB_TEST_TIMING=1 BB_PROJECT="$proj" "$0" test "$@" 2>&1 | tee "$log"
        then rc=0
        else rc="${PIPESTATUS[0]:-1}"
        fi
        took=$(( $(date +%s) - t0 ))
        echo
        if [ "${want:-0}" -gt 0 ] 2>/dev/null; then
            echo "took ${took}s against ${want}s projected"
        else
            echo "took ${took}s"
        fi

        # A FAILING run is still worth ingesting: a red suite has real
        # timings in it, and the registry is about where the time goes rather
        # than about whether it passed. What is not worth ingesting is a run
        # that never happened, and the tell is the timing prefix: no line
        # wearing one means BB_TEST_TIMING produced nothing to parse, and the
        # reason was already printed once above.
        if grep -qE '\[\+[0-9]+\.[0-9]+s\]' "$log" 2>/dev/null; then
            BB_TESTS_PROJECT="$proj" "$0" tests ingest "$log" || true
            # LAST, after the drift report: what went wrong is the thing the
            # next command depends on, and a verdict printed before three
            # screens of ingest output is a verdict nobody reads.
            echo
            tests_verdict "$log" || rc="${rc:-1}"
        else
            echo "nothing timed, so nothing recorded. \`bb tests run\` runs this" >&2
            echo "project's own test command with BB_TEST_TIMING=1 in front of it;" >&2
            echo "set that command in the project's settings dialog." >&2
            # No timing prefix is ordinary: another project's runner prints
            # none. No OUTPUT AT ALL with a zero exit is not: twice on 21 Sep
            # a full run did nothing whatever, wrote an empty log, and was
            # reported as a success (B202). A test command that says nothing
            # and passes is possible, so there is a way to say yours is one.
            if [ ! -s "$log" ] && [ "${rc:-0}" = 0 ] && [ -z "${BB_TESTS_SILENT_OK:-}" ]; then
                echo "[builderbot] ERROR: the test command printed nothing at all and exited 0," >&2
                echo "which is a run that did not happen rather than one that passed." >&2
                echo "Run it again; if your tests really are silent, set BB_TESTS_SILENT_OK=1." >&2
                rc=3
            fi
        fi
        # The verdict in words, last. A caller that reads the output rather
        # than the status (a session whose pipeline ends in tail, and whose
        # own tool then reports tail's zero) read a failed npm ci followed
        # by an exit of 0 that was not this command's (B330).
        if [ "$rc" = 0 ]; then log "bb tests run exits 0: the test command passed"
        else log "bb tests run exits $rc: the tests did not pass"
        fi
        return "$rc"
    fi
    [ -f "$py" ] || die "testreg.py is missing from this image"
    local src="" tmp=""
    # From a node this verb is relayed, so the path is opened on the
    # CONTROLLER, which shares /workspace with the node and nothing else. A
    # log written to the node's own /tmp is simply not there, and "no such
    # run log" pointing at a file you can see is a confusing way to say it.
    no_file() {
        [ -z "${BB_RELAYED:-}" ] || die "$1: $2. This ran on the controller," \
            "which shares /workspace with the node and nothing else. Put it" \
            "under the project and try again"
        die "$1: $2"
    }
    if [ "${1:-}" = describe ] && [ "${2:-}" = --from ]; then
        [ -n "${3:-}" ] || die "usage: bb tests describe --from FILE.json"
        [ -f "$3" ] || no_file "no such descriptions file" "$3"
        src="$3"
    fi
    if [ "${1:-}" = ingest ]; then
        if [ -n "${2:-}" ]; then
            [ -f "$2" ] || no_file "no such run log" "$2"
            src="$2"
        else
            [ -t 0 ] && die "usage: bb tests ingest [RUNLOG]  (or pipe the run into it)"
            tmp="$(mktemp)"; cat > "$tmp"; src="$tmp"
        fi
    fi
    BB_TESTS_FILE="$src" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 "$BB_LIB/tests-verbs.py" "$py" "$proj" "$@"
    local rc=$?
    [ -n "$tmp" ] && rm -f "$tmp"
    return "$rc"
}

cmd_bug() {
    # The bug tracker's CLI half: the side a session drives. Same shape as
    # cmd_todo: the project from the working directory (or BB_BUG_PROJECT for
    # callers that are not in one, like bb-tty), the module loaded from the
    # file beside this script so the checkout's copy is the one under test.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/bugs.py"
    [ -f "$py" ] || die "bugs.py is missing from this image"
    local proj="${BB_BUG_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" BB_WORKSPACE="$WORKSPACE" \
        python3 "$BB_LIB/bug-verbs.py" "$py" "$proj" "$@"
}

# The Analysis tab's log, for a session. Its own subcommand rather than a flag,
# because it answers a different question: not what the scanner says now, which
# is what the report is for, but what it has stopped and started saying: a
# finding that is simply absent this week leaves no other trace at all.
# ---- the phone, through the operator ---------------------------------------
# A session does not reach the handset itself. It says what it wants and why,
# the dashboard puts that in front of the operator, and on Allow the DASHBOARD
# runs it and hands back the output. So "did Claude touch my phone" has one
# answer, and it is on the card rather than in a scroll of transcript.
#
# The phone is on an adb server of its own, so a plain `adb devices` in a
# session shows the emulator and nothing else. That is the point: not a rule
# to remember, an address that was never given out.
cmd_phone() {
    local sub="${1:-status}" why="" auth
    auth="$(bb_auth_or_die)"
    shift || true
    case "$sub" in
        status)
            # A file (lib/phone-verbs.py), and before that a quoted heredoc,
            # not `python3 -c` inside single quotes: the escaping that needs
            # is a minefield and this shipped broken once, with a SyntaxError
            # where the phone's model should have been. What the program needs
            # arrives by environment, never by pipe.
            BB_PHONE_AUTH="$auth" python3 "$BB_LIB/phone-verbs.py" status
            ;;
        run)
            # `--why` is required, not polite. The operator is being asked
            # about a command they did not write; without a sentence saying
            # what it is for, Allow is a guess.
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    --) shift; break ;;
                    *) die "usage: bb phone run --why \"what this is for\" -- adb args..." ;;
                esac
            done
            [ -n "$why" ] || die "bb phone run needs --why \"what this is for\""
            [ $# -gt 0 ] || die "nothing to run; put the adb arguments after --"
            BB_PHONE_WHY="$why" BB_PHONE_AUTH="$auth" \
            BB_PHONE_PROJECT="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}" \
                python3 "$BB_LIB/phone-verbs.py" run "$@"
            ;;
        lease|shot|record|install|start|stop|ime|log|ui|touch)
            # The phone lent to this project (R113). Each command but lease
            # asks the phone's owner, who allows it in their bell (R120); an
            # optional --why is the sentence they read.
            local a=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    *) a+=("$1"); shift ;;
                esac
            done
            set -- "${a[@]}"
            BB_PHONE_WHY="$why" BB_PHONE_AUTH="$auth" \
            BB_PHONE_PROJECT="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}" \
                python3 "$BB_LIB/phone-verbs.py" "$sub" "$@"
            ;;
        *) die "usage: bb phone [status | run --why \"...\" -- adb args... | lease | shot | record [S] | install FILE | start|stop|ime|log PKG | ui | touch ...]" ;;
    esac
}

# One command as root on the project's node (roadmap R38): the phone's
# shape (reason and exact command in front of a person, Allow runs it on
# the node, Deny says no) applied to root. Not sudo: there is no second
# command without a second question, and nothing here pretends.
cmd_root() {
    local sub="${1:-status}" why="" node="" auth
    auth="$(bb_auth_or_die)"
    shift || true
    case "$sub" in
        status)
            BB_PHONE_AUTH="$auth" python3 "$BB_LIB/root-verbs.py" status
            ;;
        run)
            # --node NAME: one of the nodes the project hosts its containers
            # on (the operator, 11 Oct), since a hosting-only node runs no
            # session and is reached only by name; without it, this node.
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    --node) [ $# -ge 2 ] || die "--node needs the node's name after it"; node="$2"; shift 2 ;;
                    --) shift; break ;;
                    *) die "usage: bb root run --why \"what this is for\" [--node NAME] -- command..." ;;
                esac
            done
            [ -n "$why" ] || die "bb root run needs --why \"what this is for\""
            [ $# -gt 0 ] || die "nothing to run; put the command after --"
            BB_PHONE_WHY="$why" BB_PHONE_NODE="$node" BB_PHONE_AUTH="$auth" \
            BB_PHONE_PROJECT="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}" \
                python3 "$BB_LIB/root-verbs.py" run "$@"
            ;;
        *) die "usage: bb root [status|run --why \"...\" -- command...]" ;;
    esac
}

# bb container: ask for a container (roadmap R71). The root shape applied to
# docker: the session writes the compose file, hands it over with a reason,
# and an administrator reads it on the bell and allows or denies. Allow gives
# the file to the Docker tab's own New container path and starts the build;
# nothing here runs docker, and nothing runs until somebody has read it.
cmd_container() {
    local sub="${1:-status}" why="" name="" compose="" envf="" node="" forp="" auth
    auth="$(bb_auth_or_die)"
    case "$sub" in
        status)
            BB_PHONE_AUTH="$auth" python3 "$BB_LIB/container-verbs.py" status
            ;;
        new)
            # One verb, and the project's setting decides (the operator, 24
            # Sep, when a session at auto was still asked): refused at deny,
            # asked at ask, done at auto for the project's own container on
            # its own node.
            shift
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why)     [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    --name)    [ $# -ge 2 ] || die "--name needs the name after it"; name="$2"; shift 2 ;;
                    --compose) [ $# -ge 2 ] || die "--compose needs the file after it"; compose="$2"; shift 2 ;;
                    --env)     [ $# -ge 2 ] || die "--env needs the file after it"; envf="$2"; shift 2 ;;
                    --node)    [ $# -ge 2 ] || die "--node needs the node after it"; node="$2"; shift 2 ;;
                    --for)     [ $# -ge 2 ] || die "--for needs the project after it"; forp="$2"; shift 2 ;;
                    *) die "usage: bb container new --why \"what it is for\" --name NAME --compose FILE [--env FILE] [--node NODE] [--for PROJECT]" ;;
                esac
            done
            [ -n "$why" ] || die "bb container new needs --why \"what it is for\""
            [ -n "$name" ] || die "bb container new needs --name"
            [ -n "$compose" ] || die "bb container new needs --compose FILE"
            [ -f "$compose" ] || die "no such file: $compose"
            [ -z "$envf" ] || [ -f "$envf" ] || die "no such file: $envf"
            BB_PHONE_WHY="$why" BB_PHONE_AUTH="$auth" BB_C_NAME="$name" BB_C_COMPOSE="$compose" \
            BB_C_ENV="$envf" BB_C_NODE="$node" BB_C_FOR="$forp" \
            BB_PHONE_PROJECT="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}" \
                python3 "$BB_LIB/container-verbs.py" new
            ;;
        *) die "usage: bb container [status|new --why \"...\" --name NAME --compose FILE [--env FILE] [--node NODE] [--for PROJECT]]" ;;
    esac
}

# bb devapp: this project's dev instance, and what a session may be given
# over it.
#
# Up, Down and a container of any other shape are the operator's. What a
# project can hand over, with one setting in its settings dialog (Claude may:
# Run its container), is sending it to Docker (its own container, or another
# beside it: 24 and 26 Sep), rebuilding its containers, changing their env
# and removing one, because a project whose work IS the container has a loop
# that a session cannot close otherwise: change it, rebuild it, look at what
# it did. Three settings and `deny` is the default: `auto` is the loop, `ask`
# puts the reason in front of a person and starts the build when they allow
# it, `deny` refuses with the sentence that names the dial, so a session that
# tries learns where the decision lives rather than guessing.
#
# The daemon is the controller's connection to the node, so this goes through
# the API like `bb root` and `bb phone` rather than running docker anywhere.
# bb sign (R106): a build in dist/ signed on the project's node with one of
# its keys, which the session never receives. sign-verbs.py asks, follows an
# ask to its answer and the job to its verdict.
cmd_sign() {
    local file="" route="" why="" key="" a
    local auth proj
    proj="${BB_PROJECT:-$(project_here 2>/dev/null || true)}"
    case "${1:-}" in
        keys|key|map|rotate)
            local sub="$1"; shift
            local -a rest=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    --for) [ $# -ge 2 ] || die "--for needs play or sideload after it"; route="$2"; shift 2 ;;
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    *) rest+=("$1"); shift ;;
                esac
            done
            auth="$(bb_auth_or_die)"
            BB_SIGN_AUTH="$auth" BB_SIGN_PROJECT="$proj" \
                python3 "$BB_LIB/sign-verbs.py" --"$sub" "$route" "$why" "${rest[@]}"
            return $? ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sed -n '/^bb sign FILE/,/which is kept for good/p' "$0"; return 0 ;;
            --key) [ $# -ge 2 ] || die "--key needs a key's name after it"; key="$2"; shift 2 ;;
            --key=*) key="${1#--key=}"; shift ;;
            --for) [ $# -ge 2 ] || die "--for needs play or sideload after it"; route="$2"; shift 2 ;;
            --for=*) route="${1#--for=}"; shift ;;
            --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
            -*) die "bb sign FILE [--for play|sideload] [--why \"...\"]: no option $1" ;;
            *) [ -z "$file" ] || die "one build at a time: bb sign FILE"; file="$1"; shift ;;
        esac
    done
    [ -n "$file" ] || die "usage: bb sign FILE [--for play|sideload] [--why \"...\"] (a build in dist/)"
    if [ -z "$route" ]; then
        case "$file" in *.aab) route=play ;; *) route=sideload ;; esac
    fi
    case "$route" in play|sideload) ;; *) die "--for is play or sideload, not $route" ;; esac
    auth="$(bb_auth_or_die)"
    BB_SIGN_AUTH="$auth" BB_SIGN_PROJECT="$proj" BB_SIGN_KEY="$key" \
        python3 "$BB_LIB/sign-verbs.py" "${file#dist/}" "$route" "$why"
}

cmd_devapp() {
    # --instance NAME before or after the verb, for a project with several;
    # with none named the controller answers for the project's only one.
    local -a rest=()
    local inst="" ctr="" a
    while [ $# -gt 0 ]; do
        case "$1" in
            --instance) [ $# -ge 2 ] || die "--instance needs the name after it"; inst="$2"; shift 2 ;;
            --instance=*) inst="${1#--instance=}"; shift ;;
            # One that belongs to this project and is not its own instance: a
            # container written for it, named as bb devapp ls lists it.
            --container) [ $# -ge 2 ] || die "--container needs the name after it"; ctr="$2"; shift 2 ;;
            --container=*) ctr="${1#--container=}"; shift ;;
            *) rest+=("$1"); shift ;;
        esac
    done
    set -- "${rest[@]}"
    export BB_DEV_INSTANCE="$inst" BB_DEV_CONTAINER="$ctr"
    local sub="${1:-status}" auth proj
    auth="$(bb_auth_or_die)"
    proj="${BB_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    case "$sub" in
        status|state)
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" python3 "$BB_LIB/devapp-verbs.py" status
            ;;
        probe)
            # Whether it answers on its node's loopback (R248): a read, with
            # no root ask, from its own published ports only.
            shift || true
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" python3 "$BB_LIB/devapp-verbs.py" probe "$@"
            ;;
        rebuild)
            shift || true
            local why=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"
                           why="$2"; shift 2 ;;
                    -h|--help) cat <<'EOT'
bb devapp rebuild [--why "what it is for"]
  build this project's dev instance from its compose file and bring it up,
  under the project's dial (Claude may: Run its container). The build sees
  BB_BUILD_REV, BB_BUILD_AT and BB_BUILD_VERSION in its environment (the
  commit, when, the version), so a compose whose build.args interpolate them
  (GIT_SHA: ${BB_BUILD_REV}) stamps the image without reading .git, and
  BB_BUILD_TAG, the version with no +, for an image tag, and BB_DOCKER_GID,
  the docker group's id on the node, for a service that talks to the daemon. Its other
  options (args, target, Dockerfile) are the compose file's own to say.
EOT
                        return 0 ;;
                    *) die "usage: bb devapp rebuild [--why \"what it is for\"]" ;;
                esac
            done
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" BB_DEV_WHY="$why" python3 "$BB_LIB/devapp-verbs.py" rebuild
            ;;
        test)
            # The project's test command inside its running dev instance
            # (roadmap R48): the whole log to stdout, so `bb tests run` can
            # read it, and the job's exit code as this one's.
            shift || true
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" python3 "$BB_LIB/devapp-verbs.py" test "$@"
            ;;
        new)
            # This project sent to Docker, as the Artifacts tab's Send does: a
            # container made from its own compose file, named NAME or, unnamed,
            # its own while it has none and one beside it after; pinned to a
            # branch with --branch; then built and started, with this waiting
            # for the verdict. Under the same setting as rebuild (Claude may:
            # Run its container): on `ask` one request carries it all and
            # Allow makes and builds it.
            local why="" file="" ref="" compose="" override="" host="" tmp="" rc=0
            local usage="usage: bb devapp new [NAME] [--branch REF] [--compose FILE] [--override FILE] [--node NODE] [--env FILE|-] [--why \"...\"]"
            shift || true
            if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
                [ -z "$inst" ] || die "name it once: bb devapp new NAME, or --instance NAME"
                BB_DEV_INSTANCE="$1"; shift
            fi
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    --branch) [ $# -ge 2 ] || die "$usage"; ref="$2"; shift 2 ;;
                    --compose) [ $# -ge 2 ] || die "$usage"; compose="$2"; shift 2 ;;
                    --override) [ $# -ge 2 ] || die "$usage"; override="$2"; shift 2 ;;
                    --node) [ $# -ge 2 ] || die "--node needs the hosting node's name after it"; host="$2"; shift 2 ;;
                    --env) [ $# -ge 2 ] || die "$usage"; file="$2"; shift 2 ;;
                    *) die "$usage" ;;
                esac
            done
            if [ "$file" = - ]; then tmp="$(mktemp)"; cat > "$tmp"; file="$tmp"; fi
            [ -z "$file" ] || [ -f "$file" ] || die "no such file: $file"
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" BB_DEV_WHY="$why" BB_DEV_REF="$ref" \
            BB_DEV_COMPOSE="$compose" BB_DEV_OVERRIDE="$override" BB_DEV_HOST="$host" BB_DEV_FILE="$file" python3 "$BB_LIB/devapp-verbs.py" new || rc=$?
            [ -z "$tmp" ] || rm -f "$tmp"
            return "$rc"
            ;;
        env|remove)
            # Its env, and removing it, under the same setting as rebuild
            # (Claude may: Run its container). On `ask` Allow removes it, or
            # writes the env and builds nothing; on `auto` it is done, and bb
            # devapp rebuild applies an env.
            local verb="$sub" why="" file="" setting=0 tmp=""
            shift || true
            if [ "$verb" = env ] && [ "${1:-}" = set ]; then
                setting=1; shift
                [ $# -ge 1 ] || die "usage: bb devapp env set FILE|- [--why \"what it is for\"]"
                file="$1"; shift
            fi
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    *) die "usage: bb devapp env [set FILE|-] [--why \"...\"] | remove [--why \"...\"]" ;;
                esac
            done
            if [ "$file" = - ]; then tmp="$(mktemp)"; cat > "$tmp"; file="$tmp"; fi
            [ -z "$file" ] || [ -f "$file" ] || die "no such file: $file"
            local rc=0
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" BB_DEV_WHY="$why" BB_DEV_VERB="$verb" \
            BB_DEV_SET="$setting" BB_DEV_FILE="$file" python3 "$BB_LIB/devapp-verbs.py" edit || rc=$?
            [ -z "$tmp" ] || rm -f "$tmp"
            return "$rc"
            ;;
        override)
            # The compose file from the tree laid over the instance's own, or
            # none (the operator, 17 Oct); the next rebuild takes it. Under
            # the same setting as rebuild: auto sets it, ask leaves it to a
            # person in the container's settings.
            shift || true
            [ $# -eq 1 ] || die "usage: bb devapp override FILE|none [--instance NAME]"
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" BB_DEV_OVERRIDE="$([ "$1" = none ] || printf %s "$1")" \
                python3 "$BB_LIB/devapp-verbs.py" override
            ;;
        ls|list)
            # What belongs to this project on its node, as its group on the
            # Docker tab lists it (the operator, 24 Sep).
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" python3 "$BB_LIB/devapp-verbs.py" ls
            ;;
        log|logs|start|stop|restart)
            # One container that belongs to this project, by the name bb
            # devapp ls lists: its log, or start, stop and restart under the
            # project's Run its container setting.
            local verb="$sub" name="" why=""
            shift || true
            [ $# -ge 1 ] || die "usage: bb devapp $verb NAME [--why \"...\"]"
            name="$1"; shift
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) [ $# -ge 2 ] || die "--why needs the sentence after it"; why="$2"; shift 2 ;;
                    *) die "usage: bb devapp $verb NAME [--why \"...\"]" ;;
                esac
            done
            [ "$verb" = logs ] && verb=log
            # The project too (B675): a read project's container is
            # answered only when its project is named, so `bb -p X devapp
            # log NAME` fell to this session's own and was refused.
            BB_DEV_AUTH="$auth" BB_DEV_PROJECT="$proj" BB_DEV_VERB="$verb" BB_DEV_NAME="$name" BB_DEV_WHY="$why" \
                python3 "$BB_LIB/devapp-verbs.py" ctl
            ;;
        *) die "usage: bb devapp [--instance NAME|--container NAME] [status|rebuild [--why \"...\"]|new [NAME] [--branch REF] [--compose FILE] [--env FILE] [--why \"...\"]|env [set FILE|-]|test [ARGS]|ls|log NAME|start|stop|restart NAME]" ;;
    esac
}

cmd_findings_history() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/findings.py"
    [ -f "$py" ] || die "findings.py is missing from this image"
    proj="${BB_FINDINGS_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/findings-verbs.py" history "$py" "$proj" "$@"
}

# ago SECONDS: a duration in the shortest form that is still honest. Its own
# helper because two callers below want the same words: how old a report is,
# and how far one has fallen behind its siblings.
ago() {
    local s="${1:-0}"
    if   [ "$s" -lt 90 ];    then printf '%ss' "$s"
    elif [ "$s" -lt 5400 ];  then printf '%sm' "$(( (s + 30) / 60 ))"
    elif [ "$s" -lt 172800 ]; then printf '%sh' "$(( (s + 1800) / 3600 ))"
    else printf '%sd' "$(( (s + 43200) / 86400 ))"
    fi
}

# The node registry, read-only. Phase 1 of the controller design
# (docs/nodes.md): the list exists and nothing else does yet, so this prints
# what the dashboard's store knows and never writes it; the dashboard's boot
# owns seeding and migration, and a look at the list must not race it.
# bb users: the dashboard's accounts, from a shell.
#
# This exists for the case the GUI cannot serve: the owner has forgotten the
# password, or there are no accounts at all yet. Whoever can run this can
# already read everything in the container, so it is not a privilege
# boundary; it is the way back in, and every system needs one.
#
# Deliberately not a full editor. Roles and project lists belong on the Users
# tab, where there is room to say what they mean.
# The credential this bb speaks to the dashboard with, as a finished header.
#
# BB_TOKEN first: a Claude session is given one of those (scoped to its own
# project, `user` rights, an expiry) instead of the operator's password,
# which is what it used to inherit (bug #16). DASHBOARD_AUTH is not a
# container setting (the owner is made on the first-run screen) but it is
# still read here, so an operator in a plain `docker exec` shell can pass one
# for a single command rather than being unable to reach the API at all. It
# reaches the operator's own shell that way and nowhere else: a session has
# no DASHBOARD_AUTH in its environment at all.
# When a session token stops being good, as a unix time, or nothing for
# anything that is not one. The body is base64url of `project|exp|uid|sig`.
bb_token_exp() {
    case "${1:-}" in bbs_*) ;; *) return 0 ;; esac
    local b="${1#bbs_}"
    b="$(printf '%s' "$b" | tr '_-' '/+')"
    while [ $(( ${#b} % 4 )) -ne 0 ]; do b="${b}="; done
    printf '%s' "$b" | base64 -d 2>/dev/null | cut -d'|' -f2 | tr -dc '0-9'
}

# The project a session token was minted for: its first field. The kept
# copy is filed under it, and `bb -p NAME` repoints BB_PROJECT at the
# project being READ, so a lookup by BB_PROJECT under -p found no kept
# copy and sent the environment's, long dead (B497). bbapi.keep_token
# reads the token the same way, for the same reason.
bb_token_project() {
    case "${1:-}" in bbs_*) ;; *) return 0 ;; esac
    local b="${1#bbs_}"
    b="$(printf '%s' "$b" | tr '_-' '/+')"
    while [ $(( ${#b} % 4 )) -ne 0 ]; do b="${b}="; done
    printf '%s' "$b" | base64 -d 2>/dev/null | cut -d'|' -f1 | tr -dc 'A-Za-z0-9._-'
}

bb_token_dead() {
    local e; e="$(bb_token_exp "${1:-}")"
    [ -n "$e" ] || return 1                  # not a session token: not ours to judge
    [ "$e" -le "$(date +%s)" ]
}

# One line for bb status: which copy of the session token is in use, where
# it came from and when it runs out, so a person can see renewal working.
bb_token_line() {
    local t="${BB_TOKEN:-}" now; now="$(bb_token_now)"
    local when=""
    if [ -z "$now" ]; then
        [ -n "${DASHBOARD_AUTH:-}" ] && printf 'none; the operator credential (DASHBOARD_AUTH) reaches the controller'
        return 0
    fi
    bb_token_dead "$now" && {
        printf 'expired%s; open this session'"'"'s tab from the dashboard and the next command works' \
            "$(bb_token_when "$now")"; return 0; }
    if [ "$now" = "$t" ]; then
        printf 'the environment'"'"'s, expires%s (renews on every call past half its life)' "$(bb_token_when "$now")"
    else
        when="$(bb_token_when "$now")"
        if [ -n "$t" ] && bb_token_dead "$t"; then
            printf 'the kept copy, expires%s; the environment'"'"'s ran out%s and is not what bb sends' \
                "$when" "$(bb_token_when "$t")"
        else
            printf 'the kept copy (renewed by calls and the agent), expires%s' "$when"
        fi
    fi
}

# " 23 Sep at 21:12" for a token, or "" when it carries no expiry.
bb_token_when() {
    local e; e="$(bb_token_exp "${1:-}")"
    [ -n "$e" ] && date -d "@$e" '+ %d %b at %H:%M' 2>/dev/null || true
}

# The session token to use now: the one in the environment unless it has
# expired, and then the one bb-tty last wrote beside the launcher.
#
# A conversation outlives its token (twelve hours) and the environment of a
# process already running cannot be changed from outside it, so a long session
# was left holding a token that no longer verified and every verb answered
# "not signed in". bb-tty refreshes that file on every connection, so opening
# the tab is what puts this back in touch.
# `bb token keep` stores the token in BB_TOKEN where this account's sessions
# on this machine read it. The agent runs this for a session that is IDLE
# (R27): a session that is talking slides its own token forward on every
# answer, one that is not has nothing to slide it, and a dead token is never
# renewed. Here rather than in the agent because both halves of the answer
# already live here: which home this account has on this machine (user_home)
# and what the cache file is called (bbapi.keep_token). A second copy of
# either is a second thing to keep in step.
cmd_token() {
    [ "${1:-}" = keep ] || die "usage: bb token keep   (with BB_TOKEN set)"
    [ -n "${BB_TOKEN:-}" ] || die "no BB_TOKEN to keep"
    local home py
    home="$(user_home "${BB_ACCOUNT_UID:-}")"
    [ -n "$home" ] || die "no home for account ${BB_ACCOUNT_UID:-(none)} on this machine"
    py="$(dirname "$(readlink -f "$0")")/lib/bbapi.py"
    [ -f "$py" ] || die "bbapi.py is missing beside bb"
    HOME="$home" python3 "$BB_LIB/token-verbs.py" keep
}

bb_token_now() {
    local t="${BB_TOKEN:-}"
    local dir="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
    # Per account (B159): the cache folder is shared between accounts on a node.
    local own; own="$(bb_token_project "$t")"
    local f="${dir:-/tmp/bb-scope-$(id -u)}/builderbot/u/${BB_ACCOUNT_UID:-_none}/project/${own:-${BB_PROJECT:-}}/token"
    local ft=""
    [ -r "$f" ] && ft="$(cat "$f" 2>/dev/null)"
    # The later-expiring of the two. The file used to be read only once the
    # environment's token had died; now every answer from the controller
    # can renew it (users.renewal, kept by bbapi.keep_token), so the file is
    # usually the NEWER one while the environment still verifies, and a
    # session that keeps sending the older token would be renewed on every
    # call for nothing.
    if [ -n "$ft" ] && ! bb_token_dead "$ft"; then
        if [ -z "$t" ] || bb_token_dead "$t" \
           || [ "$(bb_token_exp "$ft")" -gt "$(bb_token_exp "$t")" ] 2>/dev/null; then
            printf '%s' "$ft"; return 0
        fi
    fi
    if [ -n "$t" ] && ! bb_token_dead "$t"; then printf '%s' "$t"; return 0; fi
    printf '%s' "$t"                          # nothing fresher; the die below says so
}

bb_auth_header() {
    local t; t="$(bb_token_now)"
    if [ -n "$t" ]; then printf 'Bearer %s' "$t"
    elif [ -n "${DASHBOARD_AUTH:-}" ]; then
        printf 'Basic %s' "$(printf '%s' "$DASHBOARD_AUTH" | base64 -w0)"
    fi
}

# ...and the sentence to die with when there is neither.
bb_auth_or_die() {
    local h; h="$(bb_auth_header)"
    # An expired one is not a missing one, and saying "not signed in" for it
    # sent somebody looking for a sign-in that was never the problem. A token
    # lasts twelve hours and a conversation can last longer; re-opening the
    # tab mints a fresh one, which bb-tty writes where bb_token_now reads it.
    if [ -n "${BB_TOKEN:-}" ] && bb_token_dead "$(bb_token_now)"; then
        local e; e="$(bb_token_exp "$BB_TOKEN")"
        die "this session's token expired$([ -n "$e" ] && date -d "@$e" '+ %d %b at %H:%M' 2>/dev/null). A token lasts 12 hours and is renewed by every answer the controller gives, and the node's agent renews an idle one; a session left idle before that fix ran out. Ask the person to reopen this session's tab on the dashboard: that mints a fresh token and leaves it where bb looks, and the next command works."
    fi
    if [ -z "$h" ]; then
        # Which of the two is actually wrong. Everything that reaches a node
        # goes through the dashboard, so "no credential" and "no dashboard"
        # produce the same failure and want different answers.
        if [ -z "$(dashboard_pid)" ]; then
            die "the dashboard is not running, and it is the controller: nodes dial \
into its API, so builds, tests, CI and emulation all go through it. See bb logs."
        fi
        die "no dashboard credential: a session started from the dashboard gets \
BB_TOKEN. From a plain docker exec there is none: run this from a dashboard \
terminal, or pass one for the command with DASHBOARD_AUTH=name:password."
    fi
    printf '%s' "$h"
}

# The controller's own build, for `bb status` on a node (R62). A node runs no
# controller image, so BB_IMAGE_REV and BB_VERSION are empty here and the old
# status lines read "unstamped". The which-build rule sends a session to bb
# status to learn which build the box is on, and a session is always on a node,
# so that check has to work here. It asks the controller over the same channel
# everything else uses: /api/meta carries the running image's version, commit
# and build time. Softly, with a short timeout, because a controller that is
# down, or a session with no token, is a state the line reports rather than
# dies on.
bb_controller_stamp() {
    local auth; auth="$(bb_auth_header)"
    [ -n "$auth" ] || { printf 'unknown: no session token to ask the controller with'; return; }
    BB_META_AUTH="$auth" python3 "$BB_LIB/controller-stamp.py" 2>/dev/null \
        || printf 'unreachable: the controller did not answer'
}

# ---- a session on a node (roadmap #24) --------------------------------------
#
# The notebook, the settings and the registry live on the controller, and a
# node keeps no /config. So on a node the verbs that read them are RELAYED:
# the same words go to the controller's /api/v1/bb with the session's token,
# the controller runs its own bb in this project's tree (the original of the
# node's synced copy, at /workspace on both sides, so a path here is a path
# there; relay.py waits for the two to agree), and what it printed comes
# back. One implementation of every verb, kept where
# the state is; the token decides which project it may be about.
#
# What is NOT relayed is what belongs to the machine the session is on:
# `bb toolchains` answers for this node's store, `bb emu` drives this node's
# emulator, `bb build` is a build (cmd_run). That is the point of being here.
# One list, lib/relay-verbs, read here and by the server: a verb added to
# one side only was either refused on arrival or never sent.
BB_RELAY_VERBS=" $(tr -s '[:space:]' ' ' < "$(dirname "$(readlink -f "$0")")/lib/relay-verbs") "

# bb_project: the project a verb acts on: BB_PROJECT, which is the session's
# own or what `bb -p NAME` named, else the working directory's when it is
# inside a project. The switch and not the directory, because a checkout of
# BuilderBot itself sits under /workspace on the controller and the harness
# runs bb from it with the project in the environment.
bb_project() {
    [ -n "${BB_PROJECT:-}" ] && { printf '%s' "$BB_PROJECT"; return 0; }
    project_here
}

bb_relay() {
    local auth proj rc
    auth="$(bb_auth_or_die)"
    proj="$(bb_project 2>/dev/null || true)"
    [ -n "$proj" ] || proj="${BB_ROADMAP_PROJECT:-${BB_BUG_PROJECT:-${BB_VERSION_PROJECT:-}}}"
    BB_RELAY_PROJECT="$proj" BB_AUTH_HEADER="$auth" python3 "$BB_LIB/relay.py" "" "$@"
    rc=$?
    return $rc
}

# tests_going begin CMD | end ID: tell the controller a test run of this
# project starts or ends (testreg.begin/end). Prints the run's id on begin.
tests_going() {
    local act="$1" arg="${2:-}" proj
    proj="$(bb_project 2>/dev/null || true)"
    [ -n "$proj" ] || return 0
    BB_LIB="$BB_LIB" BB_AUTH_HEADER="$(bb_auth_header 2>/dev/null || true)" BB_PROJ="$proj" \
        python3 - "$act" "$arg" 2>/dev/null <<'EOF' || true
import os
import sys

sys.path.insert(0, os.environ["BB_LIB"])
import bbapi  # noqa: E402

act, arg = sys.argv[1:3]
body = {"project": os.environ["BB_PROJ"], "action": act}
body["cmd" if act == "begin" else "id"] = arg
r = bbapi.call("/api/tests", body, timeout=10)
print((r.get("testing") or {}).get("id", "") if isinstance(r, dict) else "")
EOF
}

# run_here ROLE [GLOB...] -- CMD...: `bb run` on the node the session is on:
# the command in this tree, and each output glob's matches into dist/.
run_here() {
    local role="$1" outs=() g f
    shift
    while [ $# -gt 0 ]; do
        case "$1" in --) shift; break ;; *) outs+=("$1"); shift ;; esac
    done
    # A role's command arrives as sh -c 'CMD "$@"' ROLE ARGS...: shown as
    # the command that was set, with anything appended after it, and not as
    # the wrapper, whose quotes the log drops: "sh -c npm ci && npm test
    # "$@" test" read as a different command from the one that ran (B330).
    local shown="$*"
    if [ "${1:-}" = sh ] && [ "${2:-}" = -c ] && [ $# -ge 4 ]; then
        shown="${3% \"\$@\"}${5:+ ${*:5}}"
    fi
    log "$role: running here, on ${BB_NODE:-this node}: $shown"
    # A test run says to the controller when it starts and ends, so the
    # companion app can hold its "Claude is waiting on you" note until the
    # run is over where the project's During-a-test-run setting says a new
    # ask waits for it (the operator, 30 Sep). Best effort: a controller
    # that does not answer costs one note's timing, never the run.
    local rid=""
    [ "$role" = test ] && rid="$(tests_going begin "$shown")"
    local code=0
    "$@" || code=$?
    [ "$role" = test ] && tests_going end "$rid" >/dev/null
    if [ "$code" -eq 0 ] && [ "${#outs[@]}" -gt 0 ]; then
        mkdir -p dist
        # A build's files are named the way the briefing asks for shipped
        # output: the project and its version before the file's own name
        # (Shebang-DevBoard-0.1.0-dev.9-3bf328e-app-debug.apk), so two builds
        # are two files and the Artifacts tab can say which is which. Named
        # as the file is where the version cannot be read. A session copied
        # every APK by hand to get that name, and never used bb build (R104).
        local pre="" proj ver
        if [ "$role" = build ]; then
            proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
            ver="$(BB_PROJECT="$proj" "$0" version --file 2>/dev/null | tail -1 | tr -cd 'A-Za-z0-9._+-')" || ver=""
            [ -z "$ver" ] || pre="${proj}-${ver}-"
        fi
        for g in "${outs[@]}"; do
            for f in $g; do
                [ -f "$f" ] || continue
                # A glob that names a file already in dist/ (a build that
                # writes there itself) is left where it is: cp onto itself
                # prints "are the same file" and calls the build noisy.
                case "$f" in dist/*|./dist/*) continue ;; esac
                [ "$f" -ef "dist/$(basename "$f")" ] && continue
                cp -f "$f" "dist/${pre}$(basename "$f")" && log "into dist/: ${pre}$(basename "$f")"
            done
        done
    fi
    return "$code"
}

# bb settings [--json]: this project's settings, as the dashboard has them:
# node, model, effort, the build and test commands, whether it is locked.
# On a node it is relayed, and it is what bb-tty and bb build read there.
# bb settings set build|test|outputs VALUE: the one write, and only those
# three fields: a session has read the tree and knows how it builds, and the
# operator often does not. It goes through the project's fourth gate (auto,
# ask, deny), the same shape as a roadmap add; the node, the policy and the
# gates themselves have no verb, since a session that could loosen its own
# gate has no gate.
# bb git VERB [ARGS...]: git's network half, run where the credential is.
#
# Rule 2 of docs/nodes.md §20: PATs and deploy keys are set up on the
# controller and nowhere else. A session on a node edits the same tree (its
# synced copy of the controller's) but has no key and no token, so
# its push, fetch, pull and ls-remote are relayed to the controller; the
# dispatch below sends the verb whole, and the controller runs THIS function
# in the same directory with the keys it already shields. Plain `git push`
# on a node keeps failing, and bb doctor there says to use this.
#
# The arguments are held to a short list on purpose. git takes options that
# run a program (--upload-pack, --receive-pack, -c core.sshCommand, -o)
# and the process they would run in is the controller's, with its keys in
# reach. So: refspecs and remote names by shape, and a handful of flags by
# name; everything else is refused here, before git sees it, whichever side
# this runs on.
cmd_git() {
    local verb="${1:-}" a
    shift || true
    case "$verb" in
        push|fetch|pull|ls-remote) ;;
        policy)
            # What this project lets a session do with git's network half,
            # from the project's settings: the controller enforces it on the
            # relay, so this is the answer to read before pushing.
            BB_SETTINGS_JSON=1 cmd_settings --json | python3 "$BB_LIB/git-policy.py"
            return 0 ;;
        *) die "bb git takes push, fetch, pull, ls-remote or policy; plain git does everything else" ;;
    esac
    for a in "$@"; do
        case "$a" in
            -u|--set-upstream|--tags|--follow-tags|--delete|-d|--dry-run|-n|--prune|-p|--all|\
            --force-with-lease|--ff-only|--rebase|--no-rebase|--heads|--porcelain|-v|--verbose|-q|--quiet) ;;
            -*) die "bb git: '$a' is not accepted; only remote names, refspecs and a few plain flags reach the controller's git" ;;
            ''|*[!A-Za-z0-9._/:+~^@-]*) die "bb git: '$a' is not a remote name or refspec" ;;
        esac
    done
    git "$verb" "$@"
}

# pw_node_path finds where require("playwright") looks: the store's own module,
# installed beside the browsers by the playwright recipe, ahead of the
# image's global one. One rule for both machines: a node has only the store's,
# and the controller prefers it so the two drive the same browser revisions.
pw_node_path() {
    local d rest; d="$(sdk_dir playwright 2>/dev/null)/node_modules"
    rest="${NODE_PATH:-/usr/lib/node_modules}"
    if [ -d "$d" ]; then
        case ":$rest:" in *":$d:"*) printf '%s' "$rest" ;; *) printf '%s:%s' "$d" "$rest" ;; esac
    else printf '%s' "$rest"; fi
}

cmd_settings() {
    local proj json=0
    [ "${1:-}" = --json ] && json=1
    proj="${BB_PROJECT:-${BB_VERSION_PROJECT:-}}"
    if [ -z "$proj" ]; then
        # --json from a shell with no project still answers: the commit
        # identity in it is the account's, and bb-tty asks for a shell too.
        proj="$(project_here 2>/dev/null)" || {
            [ "$json" = 1 ] || die "not inside a project under ${WORKSPACE}; cd into one first"
            proj=""
        }
    fi
    if [ "${1:-}" = node ]; then
        # A project's node from a shell on the controller (R84), for a
        # scripted setup: an administrator's, as on the Settings page.
        [ -z "${BB_TOKEN:-}${BB_ACCOUNT_UID:-}" ] && ! on_node \
            || die "bb settings node is run in a shell on the controller, not from a session: a project's node is its Settings page's"
        [ -n "$proj" ] || die "not inside a project under ${WORKSPACE}; cd into one first, or bb -p NAME settings node NODE"
        [ -n "${2:-}" ] || die "bb settings node NODE: which node? bb nodes lists them"
        BB_SET_VALUE="$2" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
            python3 "$BB_LIB/settings-verbs.py" node "$(dirname "$(readlink -f "$0")")/dashboard" "$proj"
        return
    fi
    if [ "${1:-}" = set ]; then
        [ -n "$proj" ] || die "not inside a project under ${WORKSPACE}; cd into one first"
        local field="${2:-}"; shift 2 2>/dev/null || true
        case "$field" in build|test|outputs) ;; *) die "bb settings set build|test|outputs VALUE" ;; esac
        [ $# -ge 1 ] || die "bb settings set $field VALUE: the command to run, or for outputs the globs, comma-separated"
        BB_SET_FIELD="$field" BB_SET_VALUE="$*" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
            python3 "$BB_LIB/settings-verbs.py" set "$(dirname "$(readlink -f "$0")")/dashboard" "$proj"
        return
    fi
    # The tree this is being asked from, when the caller is standing in the
    # project it is asking about: what says how the project is tested is the
    # directory, and a relayed verb does not always carry the workspace.
    local here_root=""
    here_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$here_root" ] && [ "$(basename "$here_root")" = "$proj" ] || here_root=""
    BB_SETTINGS_JSON="$json" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        BB_WORKSPACE="${WORKSPACE:-/workspace}" BB_PROJECT_ROOT="$here_root" \
        python3 "$BB_LIB/settings-verbs.py" show "$(dirname "$(readlink -f "$0")")/dashboard" "$proj"
}

# bb work: who else is changing this project, and where you overlap.
#
# Two answers, and the first needs nothing to have been recorded: git knows
# what every working tree on this project has uncommitted, and a file changed
# in two of them at once is a collision whatever anybody meant to do. The
# second is the hook's notes, which are finer (a function, where it could
# work one out) and are a guess, and say so.
#
# Read-only and no writing verb: this is somebody asking what they are about
# to walk into, not a place to declare anything.
cmd_work() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/overlap.py"
    [ -f "$py" ] || die "overlap.py is missing from this image"
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    python3 "$BB_LIB/work-verbs.py" "$py" "$proj" "${DASHBOARD_STATE:-/config}" "${WORKSPACE:-/workspace}"
}

cmd_users() {
    local py sub="${1:-list}"
    py="$(dirname "$(readlink -f "$0")")/dashboard/users.py"
    [ -f "$py" ] || die "users.py is missing from this image"
    shift || true
    case "$sub" in
        list|passwd|add|claim) ;;
        token)
            # A session token for one project, the kind bb-tty mints for a
            # session it starts: user rights over that project, an expiry.
            # For the operator proving a node by hand (the node cannot
            # mint one, and BB_TOKEN=… is how bb there reaches the
            # controller) and for the test suite. Never written anywhere.
            #
            # --now prints the token bb would send from here, not a new one:
            # the environment's or the renewed one in the cache, whichever
            # expires later (bb_token_now), which is the question "why is
            # bb refusing" and "did the renewal land" both come down to.
            if [ "${1:-}" = "--now" ]; then
                local now; now="$(bb_token_now)"
                [ -n "$now" ] || die "no session token here; this is not a session bb-tty started"
                printf '%s\n' "$now"; return 0
            fi
            [ -n "${1:-}" ] || die "which project? bb users token PROJECT [ACCOUNT]"
            [ -d "$WORKSPACE/$1" ] || die "no project called $1 under $WORKSPACE"
            # With an account name the token is FOR that account (what a
            # node-bound terminal gets) and can fetch its Claude login.
            DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/users-verbs.py" token "$py" "$1" "${2:-}"
            return ;;
        *) die "usage: bb users [list|claim NAME|passwd NAME|add NAME --role admin|user|token PROJECT]" ;;
    esac
    # The password is READ, never an argument: an argument is in the process
    # table for anyone on this box to see, and in the shell history after.
    local pw="" pw2=""
    if [ "$sub" = passwd ] || [ "$sub" = add ] || [ "$sub" = claim ]; then
        [ -n "${1:-}" ] || die "which account? bb users ${sub} NAME"
        printf 'password for %s: ' "$1" >&2; read -rs pw; printf '\n' >&2
        printf 'again: ' >&2; read -rs pw2; printf '\n' >&2
        [ "$pw" = "$pw2" ] || die "they do not match"
    fi
    BB_USERS_PW="$pw" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 "$BB_LIB/users-verbs.py" "$sub" "$py" "$@"
}

cmd_nodes() {
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    [ -f "$py" ] || die "nodes.py is missing from this image"
    case "${1:-}" in
        "") DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/nodes-verbs.py" list "$py" ;;
        show) [ -n "${2:-}" ] || die "bb nodes show NAME: which node?"
              DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/nodes-verbs.py" show "$py" "$2" ;;
        enroll-token)
            # An administrator's act, from a shell on the controller: a
            # session's bb answers for the machine it is on, and minting a
            # node is nothing a session decides (R84).
            [ -z "${BB_TOKEN:-}${BB_ACCOUNT_UID:-}" ] && ! on_node \
                || die "bb nodes enroll-token is run in a shell on the controller (docker exec BuilderBot bb nodes enroll-token NAME), not from a session"
            shift
            DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/nodes-verbs.py" enroll-token "$py" "$@" ;;
        -h|--help) echo "bb nodes            the enrolled machines, each with the agent it runs"
                   echo "bb nodes show NAME  one of them in full, by name or id"
                   echo "bb nodes enroll-token NAME [--user U]  a new node's enrollment token, from a shell on the controller" ;;
        *) die "bb nodes [show NAME|enroll-token NAME]: '$1' is not one of its forms" ;;
    esac
}

# The queue, read-only: the recent jobs and what became of them, and one
# job's log. Same read-only opening of the store as `bb nodes`; a session
# sees what ran and where, and stops nothing from here; Cancel is the tab's.
#
# THE LOG IS THE POINT OF `bb jobs ID`. A job's output is posted to the
# controller and kept nowhere else, and a failed job with an exit code and
# nothing to read is not something anybody can act on: an apply that came
# back "exit 1" with an empty pane cost an evening. The listing has never
# been scoped to one project (it reads the store, not the API), and the log
# is the same answer one level down: what a session may already see that a
# job HAPPENED, it may now see the reason.
cmd_jobs() {
    local n=30 jid="" node="" type="" whole=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -n) [ $# -ge 2 ] || die "-n needs a value"; n="$2"; shift 2 ;;
            --node) [ $# -ge 2 ] || die "--node needs a value"; node="$2"; shift 2 ;;
            --type) [ $# -ge 2 ] || die "--type needs a value"; type="$2"; shift 2 ;;
            --all) whole=1; shift ;;
            -h|--help)
                echo "bb jobs [-n N] [--node NAME] [--type toolchain|system|compose|exec|image|self-update]"
                echo "bb jobs ID [--all]     one job's log: its last 20000 characters, or all of it"
                echo "A session sees its project's jobs and its reads'; with the diagnostics grant, the"
                echo "nodes' own jobs too (toolchain installs, system changes), redacted."
                return 0 ;;
            j_*) jid="$1"; shift ;;
            *) die "bb jobs [-n N] [--node NAME] [--type T] | ID [--all]: an id looks like j_1a2b3c4d" ;;
        esac
    done
    # Through the API as the caller, which narrows the list the way the Jobs
    # tab is narrowed: a session to its project's jobs (B317), and with the
    # diagnostics grant the nodes' own (system, toolchain) jobs as well. Run
    # here rather than relayed, so the call carries the session's account,
    # which that grant is checked against (the relayed token has none).
    local auth; auth="$(bb_auth_or_die)"
    BB_JOBS_AUTH="$auth" BB_JOBS_NODE="$node" BB_JOBS_TYPE="$type" BB_JOBS_ALL="$whole" \
        python3 "$BB_LIB/jobs-verbs.py" "$n" "$jid"
}

# bb run / build / test: a job on the project's node, watched from here.
#
# The tree is edited here and built there (docs/nodes.md §6): the dashboard
# snapshots this project's working tree, dirty edits included, queues an exec
# on the node the project assigns to the role, and this streams the log back
# and exits with the job's exit code. Outputs are globs relative to the
# workspace on the node; what matches comes back into dist/ with its
# provenance beside it. Through the dashboard's API rather than the store
# directly, because the snapshot is the dashboard's to make.
cmd_run() {
    local role=build node="" timeout=3600 outs=() proj auth
    while [ $# -gt 0 ]; do
        case "$1" in
            --role) role="${2:-}"; shift 2 ;;     # build|test: which command bb build/test are
            --node) node="${2:-}"; shift 2 ;;
            --out) outs+=("${2:-}"); shift 2 ;;
            --timeout) timeout="${2:-3600}"; shift 2 ;;
            --) shift; break ;;
            -h|--help)
                echo "bb run [--node NAME] [--out GLOB]... [--timeout S] -- CMD..."
                echo "  snapshot this tree, run CMD on the project's node (its settings dialog), stream the log;"
                echo "  files matching --out come back into dist/. bb build / bb test use the"
                echo "  commands and outputs in the project's settings dialog."
                return 0 ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || die "bb run needs a command after -- (bb run -h)"
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    # ON A NODE THE SESSION IS WHERE THE TOOLCHAIN IS (roadmap #24), so there
    # is nothing to snapshot and nowhere to send it: the command runs here,
    # in this tree, and what --out names is copied into dist/ the way a job's
    # outputs would have come back. No job row: this is a build, and the
    # queue is for work that has to travel.
    #
    # ...unless --node names ANOTHER machine. That used to be dropped here
    # without a word and the command ran on this one, which is a wrong answer
    # that looks like an answer: asked to check a system package on the Red Hat node,
    # it printed Ubuntu's os-release. Another node goes through the
    # controller as a job, which is what --node means everywhere else.
    if on_node && { [ -z "$node" ] || [ "$node" = "${BB_NODE:-}" ]; }; then
        run_here "$role" "${outs[@]}" -- "$@"
        return
    fi
    auth="$(bb_auth_or_die)"
    BB_RUN_OUTS="$(printf '%s\n' "${outs[@]}")" \
    BB_AUTH_HEADER="$auth" python3 "$BB_LIB/run-job.py" "" "$proj" "$role" "$node" "$timeout" "$@"
}

# The two named shapes: what the project's settings dialog says a build and
# a test are, with the outputs it lists. Read from the same file the
# dashboard writes, so there is nothing to agree about.
cmd_build_or_test() {
    local role="$1" proj
    shift
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    # One value per line: the command first, then each output glob. Read as
    # lines rather than words, because a build command has spaces in it.
    local -a rec
    # From the settings dialog's file here; on a node from `bb settings`,
    # which is the same record relayed from the controller.
    mapfile -t rec < <(BB_PROJECT="$proj" "$0" settings --json 2>/dev/null \
        | BB_ROLE_="$role" python3 "$BB_LIB/build-or-test.py")
    local cmd="${rec[0]:-}" where="${rec[2]:-node}"
    [ -n "$cmd" ] || die "no $role command is set for $proj: bb settings set $role '...' fills it in (the operator approves it where the project asks), or the operator does in the settings dialog (Build and test)"
    # Where the tests run is the project's setting (Tests run, in its settings
    # dialog). On the node unless it says otherwise, and then the dev
    # instance is not even asked about: an image built to ship carries no
    # tests, and a run inside one found none and reported success (B241).
    # "up" runs them inside the instance when it is up (roadmap R48), and
    # "only" makes a down instance a refusal naming it, with nothing run on
    # the node, which is what stops a suite that tests BuilderBot from
    # running on the BuilderBot it is running on.
    if [ "$role" = test ] && [ "$where" = node ]; then
        echo "[builderbot] $proj's tests run on the node, as its settings say (Tests run)" >&2
    elif [ "$role" = test ]; then
        local inst
        # The refusal kept rather than thrown away. This was `2>/dev/null`,
        # and when the controller did not answer (a relay call that timed out,
        # a dashboard mid-restart) the tests quietly ran somewhere else, or
        # nowhere, with the reason discarded: three runs on 21 Sep did nothing
        # at all and said nothing (B202). Whatever the cause turns out to be,
        # a test run that changes where it runs says so.
        local inst_err; inst_err="$(mktemp)"
        inst="$(BB_PROJECT="$proj" "$0" devapp status 2>"$inst_err")" || true
        if [ -z "$inst" ]; then
            warn "could not ask whether $proj's dev instance is up ($(head -c 240 "$inst_err" | tr '\n' ' ')): the tests run on this machine instead of inside it"
        fi
        rm -f "$inst_err"
        if [ "$(printf '%s\n' "$inst" | awk '$1 == "running" {print $2}')" = yes ]; then
            echo "[builderbot] $proj's dev instance is up: the tests run inside it, as its settings say (Tests run)" >&2
            BB_PROJECT="$proj" exec "$0" devapp test "$@"
        elif [ "$where" = only ]; then
            local name; name="$(printf '%s\n' "$inst" | awk '$1 == "instance" {print $2}')"
            die "$proj's tests run only inside its dev instance${name:+ ($name)}, which is not running: Up on the Containers page brings it back, or bb devapp rebuild where the dial allows one. Nothing runs on the node"
        fi
    fi
    # Said before it runs: a command nobody typed should not look like one
    # somebody did.
    local -a args=(--role "$role") g
    for g in "${rec[@]:3}"; do [ -n "$g" ] && args+=(--out "$g"); done
    # Anything else on the line is APPENDED TO THE COMMAND, not read as a flag
    # of this one: `bb test cards auth` runs the project's test command with
    # `cards auth` after it, which for a suite that takes file names is how a
    # session narrows a run to what it just changed. A whole suite is minutes;
    # the two files a change touches are seconds, and a verb that could not
    # say which meant every check cost the whole thing (R33).
    cmd_run "${args[@]}" -- sh -c "$cmd \"\$@\"" "$role" "$@"
}

# bb ci-labels: the runner labels the registry knows (phase 7), for a
# workflow's runs-on: this container's own while it still runs one, plus
# every node runner's, reported or asked for. --write regenerates
# .github/actionlint.yaml from them, so the file is derived and not hand-kept.
cmd_ci_labels() {
    local write=0
    [ "${1:-}" = "--write" ] && write=1
    local py; py="$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    local -a labels=()
    local l
    while IFS= read -r l; do [ -n "$l" ] && labels+=("$l"); done < <(
        { [ -f "$py" ] && DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/nodes-verbs.py" labels "$py" 2>/dev/null
        } | awk 'NF && !seen[$0]++')
    if [ "$write" = 1 ]; then
        mkdir -p .github
        { printf '# Labels the runners in BuilderBot'"'"'s registry carry: every node runner'"'"'s;\n'
          printf '# this container runs none. Generated by `bb ci-labels --write`; regenerate rather\n'
          printf '# than edit, so actionlint checks runs-on against what really exists.\n'
          printf 'self-hosted-runner:\n  labels:\n'
          for l in "${labels[@]}"; do printf '    - %s\n' "$l"; done; } > .github/actionlint.yaml
        log "wrote .github/actionlint.yaml with ${#labels[@]} labels"
    else
        printf '%s\n' "${labels[@]}"
    fi
}

# A report the Analysis tab can be worked on where no scanner runs, which is
# every dev instance and every checkout: the /reports mount is the operator's
# host scanner, deliberately absent from a development stack, so the tab, the
# card's counts, the findings log and `bb findings` had nothing to show and
# could only be exercised by the browser suite's own fixture.
#
# Named and worded so nobody mistakes it for a scan: the tool is
# "builderbot-sample", every message says so, and it refuses to sit beside a
# real report rather than mixing fake rows into true ones.
SAMPLE_REPORT="builderbot-sample.sarif"

cmd_findings_sample() {
    local dir="${FINDINGS_DIR:-/reports}" remove=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --remove) remove=1 ;;
            -*) die "unknown option: $1 (bb findings sample takes --remove)" ;;
            *)  dir="$1" ;;
        esac
        shift
    done
    if [ -n "$remove" ]; then
        [ -f "$dir/$SAMPLE_REPORT" ] || die "there is no sample report in $dir"
        rm -f "$dir/$SAMPLE_REPORT" || die "could not remove $dir/$SAMPLE_REPORT"
        log "removed $dir/$SAMPLE_REPORT"
        return
    fi
    # Never beside a real one. Two fake rows mixed into a true report is worse
    # than no report: the numbers on the card would be wrong and nothing would
    # say why.
    local other
    other="$(find "$dir" -maxdepth 1 -type f \( -name '*.sarif' -o -name '*.sarif.json' \) \
             ! -name "$SAMPLE_REPORT" -print -quit 2>/dev/null || true)"
    [ -z "$other" ] || die "$dir already holds a real report ($(basename "$other")): a sample beside it would make the counts wrong. Point somewhere else with 'bb findings sample DIR', or set FINDINGS_DIR"
    mkdir -p "$dir" 2>/dev/null \
        || die "cannot write $dir: on a box with the scanner mount it is read-only, which is the point. Use 'bb findings sample DIR' with somewhere writable"
    [ -w "$dir" ] || die "$dir is not writable (the scanner mount is read-only by design). Use 'bb findings sample DIR'"
    local made
    made="$(WORKSPACE="${WORKSPACE:-/workspace}" python3 "$BB_LIB/findings-verbs.py" sample "$dir/$SAMPLE_REPORT")" \
        || die "could not write $dir/$SAMPLE_REPORT"
    log "wrote $dir/$SAMPLE_REPORT, tool \"builderbot-sample\": $made"
    if on_node; then
        # Said rather than left to be discovered: the Analysis tab reads the
        # CONTROLLER's reports, so a file written here is one nothing shows.
        log "this is a node, and the dashboard reads the controller's reports: nothing will show this"
        log "run it inside the dev instance you want it in (its terminal, or bb devapp), which is where the tab reads from"
    else
        log "the Analysis tab, the card's counts and 'bb findings' read it now; 'bb findings sample --remove' takes it away"
    fi
}

cmd_findings() {
    local target="" scope=mine proj lvl="" rule="" fnd=""
    # `bb findings history` reads the notebook's fourth log: what the scanner
    # has stopped and started saying here. Handed straight to the same helper
    # the other three use, so the filters are the ones already learned.
    if [ "${1:-}" = history ]; then
        shift; cmd_findings_history "$@"; return
    fi
    if [ "${1:-}" = sample ]; then
        shift; cmd_findings_sample "$@"; return
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) scope=all ;;
            # The three narrowing filters, matching the Analysis tab's bar so a
            # question answered in the browser is askable here in one line.
            -l|--level) [ $# -ge 2 ] || die "--level needs a value: error, warning or note"
                        lvl="$2"; shift
                        case "$lvl" in error|warning|note|info) ;; \
                            *) die "--level takes error, warning or note (got: ${lvl})" ;; esac ;;
            -r|--rule)  [ $# -ge 2 ] || die "--rule needs a rule id (e.g. DL3008)"
                        rule="$2"; shift ;;
            -f|--find)  [ $# -ge 2 ] || die "--find needs text to search for"
                        fnd="$2"; shift ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-${FINDINGS_DIR:-/reports}}"
    command -v jq >/dev/null 2>&1 || die "jq is required for 'bb findings'"

    # SARIF paths are recorded relative to wherever the scanner saw the code,
    # which is not where this container mounts it. Dropping everything up to
    # and including the project directory name makes them repo-relative, so the
    # paths in the digest can be opened directly.
    proj="${FINDINGS_PROJECT:-$(basename "$PWD")}"

    local -a files=()
    if [ -f "$target" ]; then
        files=("$target")
    elif [ -d "$target" ]; then
        mapfile -t files < <(find "$target" -maxdepth 2 -type f \
            \( -name '*.sarif' -o -name '*.sarif.json' \) | sort)
    else
        die "no such file or directory: ${target} (mount your scanner's reports at /reports:ro)"
    fi

    [ "${#files[@]}" -gt 0 ] \
        || die "no .sarif files under ${target}; has the scanner run yet?"

    # When each report was written, and whether it is keeping up with the
    # others. A scanner that dies leaves its PREVIOUS report in place (a host
    # script worth having does not overwrite a good report with nothing) so a
    # dead scanner and a live one look identical here, and the findings in the
    # stale one describe a tree that may since have moved. That is not
    # hypothetical: a trivy that had been crashing for four days was still
    # supplying most of this box's findings, against a directory layout that
    # had been changed in between.
    local newest=0 m
    for f in "${files[@]}"; do
        m="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
        if [ "$m" -gt "$newest" ]; then newest="$m"; fi
    done
    local now lag
    now="$(date +%s)"

    # A day, and the size is the argument. One scan run writes every report
    # within minutes of itself, so anything measured in hours is the same run.
    # Re-running ONE scanner by hand, the obvious thing to do after fixing
    # one, leaves its siblings a few hours behind, and they must not vanish
    # for it. A report left behind by a scanner that failed is behind by a
    # whole cycle, which for any cadence anybody runs is more than this.
    # Matches STALE_AFTER in the dashboard's server.py; the two answer the
    # same question and would be worth nothing if they disagreed.
    local stale_after=86400
    local f
    for f in "${files[@]}"; do
        m="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
        lag=$(( newest - m ))
        if [ "$lag" -ge "$stale_after" ]; then
            # Named on the command line it is still read: one file makes
            # itself the newest, so there is nothing to be behind. That is the
            # way to look at one deliberately.
            printf '<!-- %s (LEFT OUT): %s behind the newest report, its scanner may have failed.\n' \
                "$f" "$(ago "$lag")"
            printf '     Read it anyway with: bb findings %s -->\n' "$f"
            continue
        fi
        printf '<!-- %s, written %s ago -->\n' "$f" "$(ago $(( now - m )))"
        jq -r --arg proj "$proj" --arg scope "$scope" --arg level "$lvl" \
            --arg rule "$rule" --arg find "$fnd" --arg relayed "${BB_RELAYED:-}" \
            "$FINDINGS_JQ" "$f" \
            || warn "could not parse ${f} as SARIF"
    done
}

# Lint the infrastructure files of the repo at PATH (default: here).
#
# This is the environment's lint, not the project's: shell scripts, Dockerfiles,
# workflows, compose files and XML are what every project in this container
# carries regardless of language, and they are exactly the files whose failures
# otherwise surface for the first time in a CI run. A project's own linters
# (eslint, ruff configs, gradle checks) stay the project's business; they have
# their own configuration and this must not second-guess it.
#
# Each check is skipped, visibly, when its tool is missing: an image from
# before these tools shipped should say so rather than pass by omission.
cmd_lint() {
    local root="${1:-$PWD}" rc=0 skipped=0
    [ -d "$root" ] || die "no such directory: ${root}"
    cd "$root"

    section() { printf '== %s ==\n' "$1"; }
    need() { # need TOOL: false (and say so) when it is not installed
        command -v "$1" >/dev/null 2>&1 && return 0
        if on_node; then
            printf '  [skip] %s is not in this node'"'"'s store; the Toolchains page installs lint-tools, with this node picked\n' "$1"
            return 1
        fi
        printf '  [skip] %s is not in this image (predates it? update the container)\n' "$1"
        skipped=1
        return 1
    }
    # Files come from git when this is a repo, so vendored trees a project
    # ignores (node_modules, build output) are not dragged in; otherwise a
    # pruned find covers a directory that never got a .git.
    files() { # files GLOB...
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            git ls-files -z -- "$@" 2>/dev/null
        else
            local -a args=() g
            for g in "$@"; do args+=(-o -path "./$g"); done
            find . \( -name .git -o -name node_modules \) -prune \
                -o -type f \( "${args[@]:1}" \) -print0 2>/dev/null
        fi
    }

    # Shell scripts, by shebang: the same selection CI's lint workflow makes,
    # so passing here means passing there.
    section "shell scripts (shellcheck)"
    if need shellcheck; then
        local -a shells=()
        while IFS= read -r -d '' f; do
            head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*\b(ba)?sh\b' \
                && shells+=("$f")
        done < <(files '*')
        # A script embedded in a QUOTED heredoc is a string to the shell and a
        # string to shellcheck, so it was never checked at all, and one of
        # them is nodes/provision-linux.sh's bb-sandbox, ~280 lines installed to a
        # root-only path on another machine, where four bugs had been sitting.
        # Extracted by the same rule the list above is built on (a shell
        # shebang on its first line) so this stays a property of the content
        # rather than a list of names to keep up to date. A finding names the
        # extracted copy, whose filename carries the source and the tag.
        local tmpd=""
        if [ "${#shells[@]}" -gt 0 ]; then
            tmpd="$(mktemp -d)"
            while IFS= read -r f; do
                [ -n "$f" ] && shells+=("$f")
            done < <(python3 "${BB_LIB_DIR:-$(dirname "$(readlink -f "$0")")/lib}/embedded.py" \
                             shell "$tmpd" "${shells[@]}" 2>/dev/null)
        fi
        if [ "${#shells[@]}" -eq 0 ]; then
            echo "  none found"
        elif shellcheck -x -S warning "${shells[@]}"; then
            printf '  [ok]   %s script(s) clean\n' "${#shells[@]}"
        else
            printf '  [FAIL] shellcheck findings above\n'
            rc=1
        fi
        [ -n "$tmpd" ] && rm -rf "$tmpd"
    fi

    section "dockerfiles (hadolint)"
    if need hadolint; then
        local -a dfs=() f
        while IFS= read -r -d '' f; do dfs+=("$f"); done \
            < <(files 'Dockerfile' '*/Dockerfile' 'Dockerfile.*' '*/Dockerfile.*')
        if [ "${#dfs[@]}" -eq 0 ]; then
            echo "  none found"
        # hadolint reads .hadolint.yaml from the working directory on its own.
        elif hadolint "${dfs[@]}"; then
            printf '  [ok]   %s dockerfile(s) clean\n' "${#dfs[@]}"
        else
            printf '  [FAIL] hadolint findings above\n'
            rc=1
        fi
    fi

    # The python, by extension and by shebang: the dashboard, the agent, the
    # library, and the two hook scripts with no extension. ruff.toml at the
    # repo root says which rules; a project without one gets ruff's defaults.
    #
    # And the python a shell script feeds to python3 from a quoted heredoc,
    # which scripts/bb does dozens of times: extracted with the blank lines
    # above it kept, so a finding's line is the line in the script. Checked
    # in a run of its own because the copies sit outside the repo, where
    # ruff would look for a config and find none; the root's is named.
    section "python (ruff)"
    if need ruff; then
        local -a pys=() others=() embedded=()
        while IFS= read -r -d '' f; do
            case "$f" in *.py) pys+=("$f"); continue ;; esac
            if head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*\bpython3?\b'; then
                pys+=("$f")
            else
                others+=("$f")
            fi
        done < <(files '*')
        local pyd=""
        if [ "${#others[@]}" -gt 0 ]; then
            pyd="$(mktemp -d)"
            while IFS= read -r f; do
                [ -n "$f" ] && embedded+=("$f")
            done < <(python3 "${BB_LIB_DIR:-$(dirname "$(readlink -f "$0")")/lib}/embedded.py" \
                             python "$pyd" "${others[@]}" 2>/dev/null)
        fi
        local -a conf=()
        [ -f ruff.toml ] && conf=(--config ruff.toml)
        if [ "${#pys[@]}" -eq 0 ] && [ "${#embedded[@]}" -eq 0 ]; then
            echo "  none found"
        elif { [ "${#pys[@]}" -eq 0 ] || ruff check --quiet "${pys[@]}"; } \
             && { [ "${#embedded[@]}" -eq 0 ] || ruff check --quiet "${conf[@]}" "${embedded[@]}"; }; then
            printf '  [ok]   %s python file(s) and %s embedded block(s) clean\n' "${#pys[@]}" "${#embedded[@]}"
        else
            printf '  [FAIL] ruff findings above\n'
            rc=1
        fi
        [ -n "$pyd" ] && rm -rf "$pyd"
    fi

    # The JavaScript: the dashboard's tab scripts and the page's inline
    # scripts, parsed by node. Not a linter's rules, a parse: a script that
    # does not parse takes the whole dashboard down, and nothing checked
    # 15,000 lines of it before this (R60).
    section "javascript (node --check)"
    if need node; then
        local -a jss=() jsbad=()
        while IFS= read -r -d '' f; do
            case "$f" in *.js|*.mjs) jss+=("$f") ;; esac
        done < <(files '*.js' '*.mjs')
        for f in "${jss[@]}"; do
            node --check "$f" >/dev/null 2>&1 || jsbad+=("$f")
        done
        while IFS= read -r -d '' f; do
            node -e '
const fs = require("fs"); const s = fs.readFileSync(process.argv[1], "utf8");
const m = [...s.matchAll(/<script(?![^>]*src)[^>]*>([\s\S]*?)<\/script>/g)];
let bad = 0; m.forEach((x, i) => { try { new Function(x[1]); } catch (e) { bad++; console.error(`  ${process.argv[1]} inline script ${i + 1}: ${e.message}`); } });
process.exit(bad ? 1 : 0);' "$f" || jsbad+=("$f (inline)")
        done < <(files '*.html')
        if [ "${#jsbad[@]}" -eq 0 ]; then
            printf '  [ok]   %s script file(s) parse\n' "${#jss[@]}"
        else
            printf '  [FAIL] does not parse: %s\n' "${jsbad[*]}"
            rc=1
        fi
    fi

    section "github workflows (actionlint)"
    if compgen -G '.github/workflows/*.yml' >/dev/null \
        || compgen -G '.github/workflows/*.yaml' >/dev/null; then
        if need actionlint; then
            # A repo declares its runners' labels in .github/actionlint.yaml
            # (`bb ci-labels --write` generates it from the node registry).
            # There is no runner on this container to build a fallback from.
            local -a args=()
            # The workflow files are named explicitly: bare `actionlint` walks
            # up looking for a git repository and refuses a plain directory.
            local -a wfs=()
            local wf
            for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
                [ -e "$wf" ] && wfs+=("$wf")
            done
            if actionlint "${args[@]}" "${wfs[@]}"; then
                echo "  [ok]   workflows clean"
            else
                printf '  [FAIL] actionlint findings above\n'
                rc=1
            fi
            # A committed declaration is checked against the registry (phase
            # 7): a label no runner carries is the "Waiting for a runner"
            # strand, said here. A note, not a failure: the registry is this
            # box's and CI runs the same lint elsewhere.
            if [ -f .github/actionlint.yaml ]; then
                local known declared missing=""
                # Through the dispatch, not the function: on a node the
                # registry is the controller's, and bb ci-labels is relayed
                # there. Called direct, it read an empty registry here and
                # called every label unknown.
                #
                # And guarded: under set -e a failing substitution ends the
                # whole lint with nothing said, which is what happened on a
                # node whose session token had expired: the relay refused,
                # and lint stopped after actionlint with no verdict at all.
                # A registry that cannot be read is a note, not a silent exit.
                if known="$(bash "$0" ci-labels 2>/dev/null | tr '\n' ' ')"; then
                    declared="$(sed -n 's/^    - //p' .github/actionlint.yaml)"
                    for l in $declared; do
                        case " $known " in *" $l "*) ;; *) missing="${missing:+$missing, }$l" ;; esac
                    done
                    [ -z "$missing" ] || echo "  [note] actionlint.yaml declares labels no runner in the registry carries: ${missing}; bb ci-labels --write regenerates it"
                else
                    echo "  [note] the runner registry could not be read (bb ci-labels failed), so runs-on labels were not checked against it"
                fi
            fi
            # ...and the other half of the same failure (roadmap #19). A
            # project's node governs BuilderBot's OWN queue: bb build, test,
            # run, emu, compose. GitHub Actions dispatch is GitHub's and reads
            # runs-on only, so nothing connects the two: with a runner on the
            # controller AND on a node, `runs-on: [self-hosted, builderbot]`
            # matches both and GitHub picks whichever is idle, which can be
            # the machine without the toolchain, silently. The node's own name
            # is already a label on its runner, so pinning is one word. This
            # can only ever be advice: the workflow file is the repo's and
            # GitHub reads it, not us.
            local nid; nid="$(project_node)"
            if [ -n "$nid" ]; then
                DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/lint-checks.py" runner \
                    "$(dirname "$(readlink -f "$0")")/dashboard/nodes.py" "$nid" 2>/dev/null
            fi
            # A hosted job on a moving label (ubuntu-latest) builds on whatever
            # GitHub points it at that day (R116): a note in any project, a
            # failure in this one, whose image build must not move under it.
            local strict=""
            [ -f scripts/bb ] && [ -f docs/reference.md ] && grep -q '^bb status ' docs/reference.md && strict="--strict"
            python3 "$BB_LIB/lint-checks.py" hosted $strict || rc=1
        fi
    else
        echo "  none found"
    fi

    section "compose files (docker compose config)"
    local -a composes=() cf
    while IFS= read -r -d '' cf; do composes+=("$cf"); done \
        < <(files 'docker-compose.yml' 'docker-compose.yaml' 'compose.yml' 'compose.yaml')
    if [ "${#composes[@]}" -eq 0 ]; then
        echo "  none found"
    elif need docker; then
        for cf in "${composes[@]}"; do
            # Validation only, with no daemon involved. An .env.example stands in
            # for the gitignored .env so required variables interpolate: the
            # one beside the compose file first, as a container built from it
            # reads, then the root's. Its empty values (an example carries
            # names, not values) are filled with a stand-in, or a required
            # ${NAME:?} failed lint on every run (20 Oct).
            local -a envarg=()
            local cdir ex="" stand=""
            cdir="$(dirname "$cf")"
            if [ ! -f "$cdir/.env" ] && [ ! -f .env ]; then
                if [ -f "$cdir/.env.example" ]; then ex="$cdir/.env.example"
                elif [ -f .env.example ]; then ex=.env.example; fi
            fi
            if [ -n "$ex" ]; then
                stand="$(mktemp)"
                sed -E 's/^([A-Za-z_][A-Za-z0-9_]*)=[[:space:]]*$/\1=lint-stand-in/' "$ex" > "$stand"
                envarg=(--env-file "$stand")
            fi
            if docker compose "${envarg[@]}" -f "$cf" config -q 2>&1 | sed 's/^/  /'; then
                printf '  [ok]   %s\n' "$cf"
            else
                printf '  [FAIL] %s\n' "$cf"
                rc=1
            fi
            [ -z "$stand" ] || rm -f "$stand"
        done
    fi

    section "xml"
    local -a xmls=() x
    while IFS= read -r -d '' x; do xmls+=("$x"); done < <(files '*.xml')
    if [ "${#xmls[@]}" -eq 0 ]; then
        echo "  none found"
    else
        for x in "${xmls[@]}"; do
            # One line on failure, not a traceback: the line and column are
            # the useful part.
            if python3 "$BB_LIB/lint-checks.py" xml "$x"; then
                printf '  [ok]   %s\n' "$x"
            else
                printf '  [FAIL] %s\n' "$x"
                rc=1
            fi
        done
    fi

    # Only where both halves exist, which is this repo: `bb help` and the
    # reference's command list are two copies of one thing, and the copy nobody
    # runs is the one that goes stale: `bb toolchains migrate` outlived its code in
    # the README because nothing compared them.
    if [ -f scripts/bb ] && [ -f docs/reference.md ] && grep -q '^bb status ' docs/reference.md; then
        # The agent's version is the one number in this tree a person moves
        # by hand, and a node compares the file while the row names the
        # number (B221): tools/agent-version.sh holds the two together, here
        # and in the lint workflow, so the two agree.
        section "agent version (moves with its file)"
        if [ -x tools/agent-version.sh ]; then
            sh tools/agent-version.sh || rc=1
        else
            echo "  [skip] tools/agent-version.sh is not in this tree"
        fi

        section "docs (bb help vs docs/reference.md)"
        # The reference's bb block is written from bb help by
        # tools/bb-ref.sh (R91 step 5): one owner, and the two held
        # equal here rather than by hand.
        if diff -q <(tools/bb-ref.sh --print) <(bash scripts/bb help | sed '1,2d') >/dev/null 2>&1; then
            echo "  [ok]   the reference's bb block is bb help, word for word"
        else
            echo "  [FAIL] the reference's bb block differs from bb help: tools/bb-ref.sh rewrites it"
            diff <(tools/bb-ref.sh --print) <(bash scripts/bb help | sed '1,2d') | head -12 | sed 's/^/         /'
            rc=1
        fi
    fi

    # The container's settings live in five places (.env.example, the
    # compose file, the Unraid template, docs/reference.md, and
    # docs/unraid.md for host setup), and the copies nobody runs drift: on 18
    # Sep ANTHROPIC_API_KEY was still offered in four of them, though nothing
    # on a controller had read it since Claude moved to the nodes (R47). So
    # what compose passes
    # into the container is held against the other three, by name and by
    # default, and every template path against its compose volume.
    if [ -f docker-compose.yml ] && [ -f .env.example ] && [ -f unraid/builderbot.xml ] && [ -f docs/reference.md ]; then
        section "settings (compose, .env.example, Unraid template, reference)"
        python3 "$BB_LIB/lint-checks.py" settings || rc=1
    fi

    # The API page against the routes (R91): a route added and not written
    # up is a row with no words, and a page behind the table is a failure.
    if [ -f docs/api.md ] && [ -f tools/api-doc.py ]; then
        section "api (docs/api.md vs server.py's routes)"
        python3 tools/api-doc.py --check || rc=1
    fi

    # The layout page against the tree (R91): a module the page does not
    # name is a newcomer's dead end, and the page drifted a dozen files
    # behind before this held it.
    if [ -f docs/layout.md ]; then
        section "layout (docs/layout.md vs git ls-files)"
        python3 "$BB_LIB/lint-checks.py" layout || rc=1
    fi

    # What a release has run on an install's /config is never edited (R79):
    # every migration at the newest v* tag, byte-for-byte.
    if [ -d scripts/dashboard/migrations ] && [ -d scripts/dashboard/statemigrations ]; then
        section "shipped migrations (unchanged since the newest release tag)"
        if grep -qF '"shipped": shipped' "$BB_LIB/lint-checks.py"; then
            python3 "$BB_LIB/lint-checks.py" shipped || rc=1
        else
            echo "  [skip] this bb's lint-checks.py predates the check: bash scripts/bb lint runs the tree's"
            skipped=1
        fi
    fi

    # The instruction channels, each saying its own (R202): CLAUDE.md the
    # tree, the briefing the machine, the shipped rules the obligations, and
    # no history in what a session is handed.
    if [ -f CLAUDE.md ] && [ -f config/templates/briefing.md ] && [ -f scripts/dashboard/rules.py ]; then
        section "channels (CLAUDE.md, the briefing, the shipped rules)"
        python3 "$BB_LIB/lint-checks.py" channels || rc=1
    fi

    echo
    if [ "$rc" -ne 0 ]; then
        echo "lint: FAILURES above"
    elif [ "$skipped" -ne 0 ]; then
        echo "lint: clean, but some checks were skipped"
    else
        echo "lint: clean"
    fi
    return "$rc"
}

# ---- developing the container from inside it -----------------------------
# This repo IS the container's source, and the thing every session trips over
# first is that editing a file here changes nothing until an image is built
# and the container updated. These commands shorten that loop where it can be
# shortened (the dashboard is one Python file and one HTML file, nothing to
# compile) and say plainly what is and is not live where it cannot.

# The dashboard server process, by PID. Anchored on the script path so a
# shell whose command line merely mentions the dashboard is never matched:
# an unanchored pkill here once killed the real dashboard and, another time,
# the very shell that ran it.
dashboard_pid() {
    # The flags matter: 15-dashboard.sh starts it as `python3 -u .../server.py`,
    # and a pattern anchored straight from python3 to the path matched nothing,
    # so `bb dashboard dev` said "the dashboard is not running" while it was
    # serving the page you were reading. Anything between python3 and the path
    # is allowed, and the path still has to end at dashboard/server.py.
    pgrep -f '^python3( +-[^ ]+)* +[^ ]*/dashboard/server\.py$' 2>/dev/null | head -1
}

# The directory the running dashboard was started from, read off its command
# line, so "which copy is live" is a fact, not a guess from a marker file.
dashboard_dir() {
    local pid; pid="$(dashboard_pid)" || true
    [ -n "$pid" ] || return 1
    # Same shape as the pattern above: the flags are skipped rather than
    # assumed absent, or the directory comes back with "-u " on the front.
    tr '\0' ' ' < "/proc/$pid/cmdline" \
        | sed -E 's#^python3( +-[^ ]+)* +(.*)/server\.py *$#\2#'
}

cmd_dashboard() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        test)
            # The repo's harness, not the image's: the point is to test the
            # checkout you are editing. Falls back to the installed copy for a
            # bare `bb dashboard test` outside a checkout.
            bb_repo_top
            local here="${BB_REPO:-$PWD}/scripts/dashboard/test/run.sh"
            [ -x "$here" ] || here=/opt/builderbot/scripts/dashboard/test/run.sh
            [ -x "$here" ] || die "no dashboard test harness at $here"
            exec bash "$here" "$@"
            ;;
        dev)
            local dir="${1:-$PWD/scripts/dashboard}" pid env_pid
            if [ "$dir" = "--off" ]; then dir=/opt/builderbot/scripts/dashboard; fi
            dir="$(cd "$dir" 2>/dev/null && pwd)" || die "no such directory: ${1:-$PWD/scripts/dashboard}"
            [ -f "$dir/server.py" ] && [ -f "$dir/index.html" ] \
                || die "$dir does not hold a dashboard (server.py + index.html)"
            pid="$(dashboard_pid)" || true
            [ -n "$pid" ] || die "the dashboard is not running, so there is nothing to swap. It \
is not running; see bb logs."
            env_pid="$pid"
            if [ "$(dashboard_dir)" = "$dir" ]; then
                log "dashboard: already serving from $dir"; return 0
            fi
            # Same environment the running one has (port, terminal port,
            # credential), read from the process, never printed. Only the
            # script changes.
            local envs=()
            while IFS= read -r -d '' kv; do
                case "$kv" in DASHBOARD_*=*|WORKSPACE=*|FINDINGS_DIR=*|BUILDER_HOME=*|BB_LOG_DIR=*) envs+=("$kv") ;; esac
            done < "/proc/$env_pid/environ"
            kill "$pid"
            for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
            # -u CLAUDECODE: this subcommand is usually run *by* a Claude
            # session, and `env` without -i hands the child everything the
            # caller has. The dashboard inheriting that variable makes its own
            # Install button refuse, quoting a message that tells the operator
            # to use the dashboard.
            nohup env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT "${envs[@]}" \
                python3 -u "$dir/server.py" 2>&1 \
                | "$(dirname "$(readlink -f "$0")")/lib/log-split.sh" \
                    "$(bb_log_dir)/dashboard.log" dashboard &
            sleep 1
            [ -n "$(dashboard_pid)" ] || die "the new dashboard did not stay up; see $(bb_log_dir)/dashboard.log"
            log "dashboard: now serving from $dir (pid $(dashboard_pid))"
            log "this lasts until the container restarts; 'bb dashboard dev --off' puts the image's copy back"
            ;;
        status)
            local d; d="$(dashboard_dir)" || { echo "dashboard: not running"; return 0; }
            if [ "$d" = /opt/builderbot/scripts/dashboard ]; then
                echo "dashboard: serving the image's copy ($d)"
            else
                echo "dashboard: serving a DEV copy from $d; 'bb dashboard dev --off' reverts"
            fi
            ;;
        trace)
            # What the server was asked over the last N seconds, by endpoint
            # and by who asked, with how long each took (B245): the one
            # command that shows a poll that should not be there, a tab that
            # asks twice, or the request a slow tab is waiting on.
            local auth; auth="$(bb_auth_or_die)"
            BB_TRACE_AUTH="$auth" python3 "$BB_LIB/trace-verbs.py" "${1:-60}"
            ;;
        *) die "usage: bb dashboard test|dev|status|trace [SECONDS]" ;;
    esac
}

# bb drift: what this checkout has changed that the running container is
# not serving. Compares the image's /opt/builderbot/scripts and the shipped
# templates against the repo's, file by file. Answers the question every
# session asks itself after editing anything here.
# bb map: the code map (lib/codemap.py, roadmap R75). Over the project tree
# a session is in (BB_TREE on a node, else the working directory), rebuilt
# by itself when a source is newer than the index.
cmd_map() {
    # `addresses` with nothing to read reads the roadmap: the plan is where
    # a session writes `file ~line`, and where those go stale (item 7).
    if [ "${1:-}" = addresses ] && [ $# -eq 1 ]; then
        # As a command of its own rather than cmd_roadmap in this process:
        # on a node the roadmap is the controller's, and only the dispatch a
        # command starts with relays it there (B293).
        "$0" roadmap | python3 "$BB_LIB/codemap.py" --root "${BB_TREE:-$PWD}" addresses -
        return
    fi
    python3 "$BB_LIB/codemap.py" --root "${BB_TREE:-$PWD}" "$@"
}

cmd_drift() {
    local repo="${1:-$PWD}" n=0
    [ -d "$repo/scripts" ] || die "$repo does not look like the BuilderBot checkout (no scripts/)"
    local pairs=("$repo/scripts:/opt/builderbot/scripts"
                 "$repo/config/templates:/opt/builderbot/templates")
    for pair in "${pairs[@]}"; do
        local src="${pair%%:*}" live="${pair##*:}"
        [ -d "$live" ] || { echo "  (no $live in this image)"; continue; }
        while IFS= read -r line; do
            n=$((n+1)); echo "  $line"
        done < <(diff -rq --exclude='__pycache__' --exclude='test' "$src" "$live" 2>/dev/null \
                 | sed -E "s#^Files $src/(.*) and $live/.* differ#changed: \1#; \
                           s#^Only in $src/?(.*): (.*)#new here: \1/\2#; \
                           s#^Only in $live/?(.*): (.*)#only in image: \1/\2#; s#: /#: #")
    done
    if [ "$n" = 0 ]; then
        echo "no drift: the running container is serving what this checkout holds"
    else
        echo "$n file(s) differ: the running container is NOT serving these; a change is live"
        echo "only after CI builds a new image and the container updates (or 'bb dashboard dev' for the dashboard)"
    fi
    if d="$(dashboard_dir 2>/dev/null)" && [ "$d" != /opt/builderbot/scripts/dashboard ]; then
        echo "dashboard: serving a dev copy from $d"
    fi
}

# Where Chromium actually is, in the order the answers can be trusted:
# PLAYWRIGHT_BROWSERS_PATH (what the image sets and any project honors), then
# the toolchain store directly, then the historical /opt path. Resolved rather than
# hardcoded because the browsers moved out of the image: the /opt entry is a
# symlink the startup hook makes, and a hook that could not make it (/opt is
# root-owned) used to leave every screenshot command dead with the bytes
# sitting right there on the share.
find_chromium() {
    local base exe
    for base in "${PLAYWRIGHT_BROWSERS_PATH:-}" "$(sdk_root)/playwright" /opt/pw-browsers; do
        [ -n "$base" ] && [ -d "$base" ] || continue
        exe="$base/chromium"
        [ -x "$exe" ] || exe="$(find -L "$base" -path '*/chromium-*/chrome-linux*/chrome' -type f 2>/dev/null | head -1)"
        [ -n "$exe" ] && [ -x "$exe" ] || continue
        # The browser is in the store but its shared libraries are the
        # machine's: the image installs them (playwright install-deps), a
        # node gets them from the provisioner. Without them Chromium dies
        # at launch behind a Playwright stack that says "browser has been
        # closed" (measured on bb-sandbox, libatk-1.0.so.0) so the missing
        # ones are named here, before the launch.
        local missing
        missing="$(ldd "$exe" 2>/dev/null | awk '/not found/{print $1}' | head -5 | tr '\n' ' ')"
        if [ -n "$missing" ]; then
            if on_node; then
                die "Chromium is in the store but ${BB_NODE:-this node} lacks its system libraries (${missing% }).
   Re-run nodes/provision-linux.sh on it; the session half installs them."
            fi
            die "Chromium is in the store but this image lacks its system libraries (${missing% })"
        fi
        printf '%s' "$exe"; return 0
    done
    die "no Playwright chromium found; install the browsers with: bb toolchains install playwright"
}

# bb capture shot: headless screenshots, for showing the operator visual state from
# a box with no display. Playwright's Chromium from the image.
#
# One URL takes an optional file (bb capture shot URL [FILE]). Several URLs share one
# browser and land in a directory, each named from its path (/ -> index.png).
# --full and --scale exist because README screenshots need the whole page at
# 2x, and capabilities MediaReducer's tools/screenshots grew privately before
# this subsumed them; --resize is the downscale that keeps those PNGs
# repo-sized, done by the same Chromium rather than by imagemagick, which is
# not on a node (B103); --wait absorbs pages whose async fetches settle after
# networkidle, because a screenshot of a spinner is not a screenshot of the
# page. The intended split: a project's own script boots its app into a
# photogenic state, then ends with one bb capture shot line.
# bb capture reel: eyes on change over time (R95). One sheet of the frames that
# changed, each stamped with its time, and a JSON of when, from a video, a
# page Playwright records while a script drives it, the emulator's
# screenrecord, or an X display. reel.py does the work; this hands it the
# store's tools and the project's dist/.
# bb capture: what a session looks with (R95). shot is a picture at rest,
# reel the frames that changed, each from any source that draws: a page,
# the running emulator's screen, an X display, or (for a reel) a video.
cmd_capture() {
    case "${1:-}" in
        shot) shift; capture_shot "$@" ;;
        reel) shift; capture_reel "$@" ;;
        # The captures in dist/ and their removal (R96): capture.py reads
        # and applies the one rule the Artifacts tab's sweep also does.
        ls|prune)
            local verb="$1"; shift
            case "${1:-}" in -h|--help) cmd_capture --help; return 0 ;; esac
            local proj; proj="$(project_here 2>/dev/null || true)"
            local dist="${proj:+${WORKSPACE}/${proj}/dist}"
            [ -n "$dist" ] || dist="$PWD/dist"
            python3 "$BB_LIB/capture.py" "$verb" "$dist" "$@"
            ;;
        *) cat <<'EOT'
bb capture shot URL... [FILE|DIR] | --emu [PKG] [FILE] | --display :N [FILE]   [--drive F] [--settle|--now]
bb capture reel --video FILE | --url URL | --emu [PKG] | --display :N   [--seconds N] [--drive F] [--name N]
bb capture ls
bb capture prune [--days N] [NAME...]
  shot:  one picture at rest (shots a quarter second apart until a second of
         them match; --now takes it at once)
  reel:  the frames that changed, stamped with their times, on one sheet in
         dist/reel/NAME/ with frames.json beside it (bb capture reel -h)
  ls:    the captures in this project's dist/, with who asked and when
  prune: remove the captures named, or every one older than --days N; the
         controller sweeps them after the project's "captures kept" days
EOT
           [ -z "${1:-}" ] || [ "$1" = -h ] || [ "$1" = --help ] || die "bb capture shot|reel|ls|prune"
           ;;
    esac
}

# A browser with an extension loaded (R247): Playwright's Chrome for Testing
# and Firefox from the store, driven by browser.mjs on the store's node.
cmd_browser() {
    local root ff node
    root="$(sdk_root 2>/dev/null || true)"
    ff="$(find -L "${PLAYWRIGHT_BROWSERS_PATH:-$root/playwright}" -path '*/firefox-*/firefox/firefox' -type f 2>/dev/null | head -1)"
    node="$(command -v node || true)"; [ -n "$node" ] || { [ -x "$root/node/bin/node" ] && node="$root/node/bin/node"; }
    [ -n "$node" ] || die "bb browser runs on Node, and there is no node toolchain here; installing it is the operator's"
    BB_BROWSER_CHROME="$(find_chromium 2>/dev/null || true)" BB_BROWSER_FIREFOX="$ff" exec "$node" "$BB_LIB/browser.mjs" "$@"
}

# The store's tools for capture.py, which shot and reel share.
capture_env() {
    local root; root="$(sdk_root 2>/dev/null || true)"
    local ff; ff="$(command -v ffmpeg || true)"; [ -n "$ff" ] || { [ -x "$root/ffmpeg/bin/ffmpeg" ] && ff="$root/ffmpeg/bin/ffmpeg"; }
    local adb; adb="$(command -v adb || true)"; [ -n "$adb" ] || { [ -x "$root/platform-tools/adb" ] && adb="$root/platform-tools/adb"; }
    BB_CAPTURE_FFMPEG="$ff" BB_CAPTURE_NODE_PATH="$(pw_node_path)" BB_CAPTURE_CHROME="$(find_chromium 2>/dev/null || true)" \
    BB_CAPTURE_ADB="$adb" BB_CAPTURE_AUTH="${BB_TOKEN:-${DASHBOARD_AUTH:-}}" "$@"
}

capture_reel() {
    case "${1:-}" in
        -h|--help|"")
            cat <<'EOT'
bb capture reel --video FILE | --url URL | --emu [PKG] | --display :N  [--seconds N] [--drive FILE] [--name NAME]
        [--patch N] [--max N] [--from S] [--to S] [--dry] [--threshold T] [--fps N]
  the frames that changed, each stamped with its time, tiled into
  dist/reel/NAME/sheet.png (and sheet-2.png on, twelve frames a page)
  beside frames.json (when, and how much moved): what a screenshot cannot
  show, read at a glance. A frame is kept when any small patch of it changed
  from the last frame kept, so a tap circle, a typed letter and a slow scroll
  are each seen; a run of motion (a scroll, a slide) is thinned to where it
  starts and settles and a few frames between.
  The recording and the full-size frames stay on this machine's disk, at
  the paths frames.json names; dist/ keeps the sheet and the record, listed
  under Captures on the Artifacts view and swept after the project's
  "captures kept" days (bb capture prune NAME lets yours go sooner).
  --video    any recording
  --url      a page, recorded for --seconds while --drive FILE.mjs works it
             (export default async (page, {seconds}) => {...})
  --emu      the running emulator's screenrecord, PKG launched first and its
             gfxinfo framestats beside the reel; --drive FILE is a shell script
             with $ADB in its environment
  --display  an X display grabbed for --seconds while --drive FILE (a shell
             script, DISPLAY set) drives it with xdotool
  --dry      count, draw nothing: how many frames changed, each run of motion
             with its span and frames, and what the sheet would keep on how
             many pages, to choose the settings below before drawing
  --from S --to S  that stretch of the recording alone, at its own times: a
             run the dry run shows thinned, reeled whole
  --patch N  how much one small patch must change from the last frame kept,
             as a pixel's mean difference (1 to 255, 12 by default): lower
             keeps fainter change
  --max N    how many frames the sheet holds (40 by default)
  --threshold T  the old test instead: ffmpeg's scene score against the
             frame before (0..1; a typed letter on a phone is about 0.0004)
  --fps      look at the recording N times a second rather than at every
             frame it has; frames.json says both (fps, recorded_fps). An
             emulator under software rendering records about 10 a second
             and on a card several times that, and the reel says so when a
             recording is too sparse to show a short animation
EOT
            return 0 ;;
    esac
    local proj; proj="$(project_here 2>/dev/null || true)"
    local out="${proj:+${WORKSPACE}/${proj}/dist/reel}"
    [ -n "$out" ] || out="$PWD/dist/reel"
    BB_CAPTURE_OUT="$out" capture_env python3 "$BB_LIB/reel.py" "$@"
}

capture_shot_usage() {
    cat <<'EOT'
usage: bb capture shot URL... [FILE|DIR] | --emu [PKG] [FILE] | --display :N [FILE]   [--drive F] [--settle|--now]
        [--auth user:pass] [--size WxH] [--full] [--scale N] [--wait MS] [--resize W]
URLs need their scheme (http:// or https://); with no FILE a page's shot goes
to dist/shot/ and the emulator's to dist/emu/
EOT
}

capture_shot() {
    # The operator's password, or a session's token, whichever this shell
    # has. --auth overrides both.
    local auth="${BB_TOKEN:-${DASHBOARD_AUTH:-}}" width=1280 height=800 scale=1 wait=0 settle="" src="" pkg="" disp="" drive=""
    local full=0 resize="" out="" mode=file urls=() mark=0
    # A shot nobody named goes to the project's dist/ whatever directory the
    # command is run in (B6), under emu/ or shot/ with a record beside it
    # (--mark): the Artifacts tab lists those as captures and the project's
    # sweep removes them by age (R96).
    local proj dist; proj="$(project_here 2>/dev/null || true)"
    dist="${proj:+${WORKSPACE}/${proj}/dist}"; [ -n "$dist" ] || dist="$PWD/dist"
    # Used by the test harness, which needs the same answer this does and
    # should not re-implement the search to get it.
    if [ "${1:-}" = --print-chromium ]; then find_chromium; printf '\n'; return 0; fi
    if [ "${1:-}" = --print-node-path ]; then pw_node_path; printf '\n'; return 0; fi
    while [ $# -gt 0 ]; do
        case "$1" in
            --auth)   auth="$2"; shift 2 ;;
            --size)   width="${2%x*}"; height="${2#*x}"; shift 2 ;;
            --scale)  scale="$2"; shift 2 ;;
            --wait)   wait="$2"; shift 2 ;;
            --resize) resize="${2%x}"; shift 2 ;;
            --full)   full=1; shift ;;
            # Shot at rest: screenshots a quarter second apart until two
            # match, so a modal still arriving or a list still loading is
            # not what the picture shows. The dashboard's own pages settle
            # by default (a notebook view fetches its list after it draws);
            # --settle asks it of any page, --now takes the one shot at once.
            --settle) settle=1; shift ;;
            --now)    settle=0; shift ;;
            # The other things that draw (R95): the running emulator's screen
            # and an X display, pictured at rest the same way; capture.py takes
            # those, and a URL keeps the browser path below.
            --emu)    src=emu; case "${2:-}" in ""|-*|http://*|https://*) shift ;; *) pkg="$2"; shift 2 ;; esac ;;
            --display) [ -n "${2:-}" ] || die "--display needs the display after it (:9)"; src=display; disp="$2"; shift 2 ;;
            --drive)  [ -n "${2:-}" ] || die "--drive needs the script after it"; drive="$2"; shift 2 ;;
            --url)    shift ;;
            -h|--help) capture_shot_usage; return 0 ;;
            -*) die "unknown option: $1" ;;
            *) case "$1" in
                   # Scheme-tagged, because page.goto needs one anyway: a bare
                   # host:port would produce a blank shot, so it is refused
                   # here where the message can say why.
                   http://*|https://*) urls+=("$1") ;;
                   *) [ -z "$out" ] || die "two outputs given: ${out} and $1"
                      out="$1" ;;
               esac; shift ;;
        esac
    done
    if [ -n "$src" ]; then
        [ "${#urls[@]}" -eq 0 ] || die "one source: --emu or --display, not a URL as well"
        local -a args=()
        if [ -z "$out" ] || [ -d "$out" ]; then
            mkdir -p "${out:-$dist/emu}"; out="${out:-$dist/emu}/shot-$(date +%Y%m%d-%H%M%S).png"
            args+=(--mark)
        fi
        [ "$src" = emu ] && args+=(--emu "$pkg") || args+=(--display "$disp")
        [ -z "$drive" ] || args+=(--drive "$drive")
        [ "$settle" = 0 ] && args+=(--now)
        capture_env python3 "$BB_LIB/capture.py" shot "${args[@]}" "$out"
        return
    fi
    [ "${#urls[@]}" -gt 0 ] || die "$(capture_shot_usage)"
    case "${width}${height}${scale}${wait}${resize}" in
        *[!0-9]*) die "--size WxH, --scale N, --wait MS and --resize W take whole numbers" ;;
    esac

    # One output name only fits one shot; with several URLs (or a trailing
    # slash, or an existing directory) the output is a directory and the
    # names come from the URLs.
    if [ -z "$out" ]; then
        mark=1; mkdir -p "$dist/shot"
        if [ "${#urls[@]}" -gt 1 ]; then mode=dir; out="$dist/shot"
        else out="$dist/shot/shot-$(date +%Y%m%d-%H%M%S).png"; fi
    elif [ "${#urls[@]}" -gt 1 ] || [ -d "$out" ] || [ "${out%/}" != "$out" ]; then
        mode=dir; mkdir -p "$out"
    fi

    local chrome; chrome="$(find_chromium)"
    local files st=0
    files="$(NODE_PATH="$(pw_node_path)" node - \
        "$chrome" "$auth" "$width" "$height" "$scale" "$wait" "$full" \
        "$mode" "$out" "${DASHBOARD_PORT:-7680}" "$resize" "$settle" "${drive:+$(readlink -f "$drive")}" "${urls[@]}" <<'EOF'
const { chromium } = require("playwright");
const fs = require("fs");
const path = require("path");
const [exe, auth, w, h, scale, wait, full, mode, dest, port, resize, settle, drive, ...urls]
  = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  // Either shape of credential. A session holds a bearer token rather than a
  // password now (bug #16), and splitting on ":" produced no credential at
  // all for one, so a session photographing a dashboard page would have got
  // the LOGIN page and no error, which is the worst way for this to fail.
  const bearer = /^bbs_/.test(auth);
  const [username, password] = !bearer && auth.includes(":")
    ? auth.split(/:(.*)/) : [null, null];
  const header = bearer ? "Bearer " + auth
    : username ? "Basic " + Buffer.from(auth).toString("base64") : "";
  // Credentials go both ways: httpCredentials answers a server that
  // challenges, the preemptive Authorization header satisfies one that
  // deliberately never does (the dashboard, whose challenge-free 401s are
  // what keep browsers from popping their own dialog).
  const ctx = await b.newContext({
    viewport: { width: +w, height: +h },
    deviceScaleFactor: +scale,
    ...(username ? { httpCredentials: { username, password } } : {}) });
  // The header goes to the DASHBOARD and nowhere else. On the context it went
  // to every URL in the run, so `bb capture shot <dashboard> https://example.com`
  // handed the credential to example.com as well (bug #49). Per-route, matched
  // on origin, so shooting somebody else's page cannot carry it there.
  const mine = new Set(urls.filter(u => {
    try { return new URL(u).port === String(port); } catch { return false; }
  }).map(u => new URL(u).origin));
  if (header && mine.size) {
    await ctx.route("**/*", async (route) => {
      let same = false;
      try { same = mine.has(new URL(route.request().url()).origin); } catch {}
      await route.continue(same
        ? { headers: { ...route.request().headers(), authorization: header } }
        : {});
    });
  }
  // ...and a real sign-in, for the cookie. A header added by routing does not
  // reach a WEBSOCKET handshake (Playwright does not intercept those) and
  // the terminal is a websocket on the dashboard's own origin now, so a
  // shot of a page with a terminal in it came out holding ttyd's reconnect
  // prompt. A cookie goes on the handshake like any other request.
  // Best-effort: a page that is not a BuilderBot dashboard has no /login,
  // and the header above is still what answers for it.
  if (username) {
    for (const origin of mine) {
      try {
        await ctx.request.post(origin + "/login", {
          form: { username, password }, maxRedirects: 0, timeout: 10000 });
      } catch {}
    }
  }
  // The downscale, in the browser that took the shot. It used to be
  // imagemagick's `convert`, which is in the controller's image and on no
  // node (B103), so the one flag a README script needs died on the machine
  // sessions actually run on. Chromium resamples as well as convert does and
  // is already here, by definition: nothing that can take a screenshot lacks
  // it. On a blank page of its own, because a data: image is exactly what a
  // photographed page's own CSP may refuse.
  let scaler = null;
  const shrink = async (file, width) => {
    scaler = scaler || await b.newPage();
    const b64 = fs.readFileSync(file).toString("base64");
    const done = await scaler.evaluate(async ([data, wide]) => {
      const img = new Image();
      img.src = "data:image/png;base64," + data;
      await img.decode();
      if (img.width <= wide) return null;      // never upscale: that adds nothing
      const c = document.createElement("canvas");
      c.width = wide;
      c.height = Math.max(1, Math.round(img.height * wide / img.width));
      const g = c.getContext("2d");
      g.imageSmoothingEnabled = true;
      g.imageSmoothingQuality = "high";
      g.drawImage(img, 0, 0, c.width, c.height);
      return c.toDataURL("image/png").split(",")[1];
    }, [b64, width]);
    // In place, and metadata-free by construction: a fresh encode carries
    // none. The full-size original is scaffolding, the downscale is the
    // deliverable, and keeping both would double the repo cost the flag
    // exists to avoid.
    if (done) fs.writeFileSync(file, Buffer.from(done, "base64"));
  };
  const p = await ctx.newPage();
  const taken = new Set();
  let unanswered = 0;
  for (const url of urls) {
    // A page that never goes quiet is still a page, and is shot as it is;
    // one that never answered is not (B535): Chromium draws its own error
    // page, and a picture of that with exit 0 read as the site being up.
    let failed = "";
    const res = await p.goto(url, { waitUntil: "networkidle" }).catch(e => {
      if (!/timeout/i.test(`${e.name} ${e.message}`)) failed = String(e.message).split("\n")[0];
      return null;
    });
    if (failed) {
      console.error(`${url}: did not answer (${failed}); no picture taken`);
      unanswered++;
      continue;
    }
    if (res && res.status() >= 400) console.error(`${url}: answered ${res.status()}; shot as it is`);
    if (+wait) await p.waitForTimeout(+wait);
    // --drive works the page first, as it does the emulator and a display
    // (B847: it was taken and never run for a URL, so the shot was of the
    // page as it loaded): its default export gets the page and the context.
    if (drive) {
      const mod = await import(drive);
      await (mod.default || mod.drive)(p, { ctx, browser: b, url });
    }
    let out = dest;
    if (mode === "dir") {
      // Named from the path so reruns overwrite their own shots, with a
      // counter only for two URLs that share a path (e.g. differing query).
      const u = new URL(url);
      // No leading dash or dot: "/?view=x" would otherwise slug to
      // "-view-x.png", which convert then parses as an option. Capped at 80
      // because a long query string made a filename longer than the 255 a
      // filesystem takes, and the whole run died on ENAMETOOLONG.
      const s = ((u.pathname + u.search).replace(/^\/+|\/+$/g, "")
        .replace(/[^A-Za-z0-9._-]+/g, "-").replace(/^[-.]+/, "") || "index")
        .slice(0, 80);
      let name = s, n = 2;
      while (taken.has(name)) name = `${s}-${n++}`;
      taken.add(name);
      out = path.join(dest, name + ".png");
    }
    // At rest, when asked or when it is the dashboard's own page: a shot
    // every quarter second until a whole second of them are the same
    // bytes, and that one is the picture. Two matching frames were not
    // enough: they came in the first half second, before a list that
    // lands a second later. A page that never stops moving (a spinner) is
    // taken as it is after six seconds, and said.
    let atRest = settle === "1" || (settle === "" && (() => {
      try { return mine.has(new URL(url).origin); } catch { return false; } })());
    if (atRest) {
      let last = await p.screenshot({ fullPage: full === "1" }), still = 0;
      const until = Date.now() + 6000;
      while (Date.now() < until && still < 4) {
        await p.waitForTimeout(250);
        const next = await p.screenshot({ fullPage: full === "1" });
        still = next.equals(last) ? still + 1 : 0;
        last = next;
      }
      if (still < 4) console.error(`${url}: still moving after six seconds; shot as it is`);
      fs.writeFileSync(out, last);
    } else {
      await p.screenshot({ path: out, fullPage: full === "1" });
    }
    if (+resize) await shrink(out, +resize);
    console.log(out);
  }
  await b.close();
  if (unanswered) process.exitCode = 3;
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
)" || st=$?
    if [ "$mark" = 1 ] && [ -n "$files" ]; then
        local f
        while IFS= read -r f; do
            [ -f "$f" ] && python3 "$BB_LIB/capture.py" mark "$f" "${urls[*]}"
        done <<< "$files"
    fi
    [ -z "$files" ] || printf '%s\n' "$files"
    return "$st"
}

# bb tool graphics favicon: one SVG mark in, the favicon set a web app actually needs out:
# favicon.ico carrying every small size in one file (the bare /favicon.ico
# request browsers make on their own has no way to ask for a particular one),
# apple-touch-icon.png at 180 for iOS home screens, and the SVG copied
# alongside for browsers that prefer vector.
#
# Rasterized by Playwright's Chromium, packed by ImageMagick: that split
# because the image's ImageMagick writes ICO but carries no SVG delegate,
# and Chromium renders any SVG exactly the way a browser tab will show it.
# The mark itself stays the project's own; this is only the packaging every
# project would otherwise re-learn. (Generalized from the private tool
# MediaReducer grew for this, minus its PIL dependency, which the container
# python does not carry.)
# ---- bb tool: what a toolchain adds to a session, under its own name -----------
# `bb tool TOOL COMMAND...`: a toolchain's commands live under the toolchain's
# name, so two toolchains may both have a `render` or a `shot` and none can
# shadow one of bb's own verbs. The catalog names each recipe's tool
# (`tool` in config/toolchains.json), the Toolchains tab says so on the row,
# and the suite holds the catalog to the case below.
cmd_tool() {
    local tool="${1:-}"; [ $# -gt 0 ] && shift
    case "$tool" in
        graphics)  tool_graphics "$@" ;;
        diagrams)  tool_diagrams "$@" ;;
        docs)      tool_docs "$@" ;;
        office)    tool_office "$@" ;;
        # Sound effects (R107): the generator is bb's own python, nothing to
        # install; the ffmpeg toolchain turns its WAV into OGG and draws the
        # pictures a session checks it by.
        sound)     tool_sound "$@" ;;
        "")
            local t d
            for t in graphics diagrams documents office; do
                if d="$(sdk_find "$t" 2>/dev/null)" && [ -n "$d" ]; then
                    printf '  %-10s installed here\n' "$t"
                else
                    printf '  %-10s not on this node: the Toolchains page installs it\n' "$t"
                fi
            done
            printf '\n  bb tool graphics info|resize|crop|compose|annotate|diff|svg2png|optimize|favicon ...\n'
            printf '  bb tool diagrams render FILE... [--out DIR]\n'
            printf '  bb tool docs read FILE... | pages FILE [--pages N-M] [--dpi N] [--out DIR]\n'
            printf '  bb tool office convert FILE... [--to pdf|docx|xlsx|pptx|odt|txt] [--out DIR]\n'
            printf '  bb tool sound make PRESET [--seed N] | tone HZ [--ms N] [--to HZ] | look FILE | presets\n'
            printf '  bb tool sound say "TEXT" | hear FILE   (the audio toolchain)\n'
            # ...and the tool packs a person added (R77), each by its verbs.
            python3 "$BB_LIB/toolpack-run.py" "" "" --list ;;
        # Any other name is a tool pack's, or nothing: toolpack-run.py reads
        # its verb from the catalog and runs it, no shell between.
        *) local proj; proj="$(project_here 2>/dev/null || true)"
           exec python3 "$BB_LIB/toolpack-run.py" "$(sdk_find "$tool" 2>/dev/null || true)" \
               "${proj:+${WORKSPACE}/${proj}}" "$tool" "$@" ;;
    esac
}

# ---- graphics ------------------------------------------------------------------
# A session cannot see a picture it has not rendered, and these are how it
# renders one it can then read back. Every verb is an argv built here from
# checked arguments and handed to a tool on the store: the graphics toolchain
# (ImageMagick's magick, resvg, oxipng, pngquant, cwebp) and the diagrams one
# (PlantUML on the store's JDK, Mermaid through the store's Chromium).
# Results go under dist/, where the Artifacts tab lists them.

# gfx_tool RECIPE NAME: the store's copy of a tool, else the one on PATH,
# else a refusal that names the recipe to install.
gfx_tool() {
    local recipe="$1" name="$2" d=""
    d="$(sdk_find "$recipe" 2>/dev/null)" || d=""
    if [ -n "$d" ] && [ -x "$d/bin/$name" ]; then printf '%s' "$d/bin/$name"; return 0; fi
    if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return 0; fi
    ! sdk_off "$recipe" || die "${recipe} is switched off for this project: its settings' Toolchains group turns it on"
    die "no ${name} here: install the ${recipe} toolchain on the Toolchains page with this node picked"
}

# img_out IN VERB [OUT] [EXT]: where a result goes. Named, or dist/img/ by
# the input's name and the verb, so two runs do not overwrite each other's
# and the tab can tell them apart.
img_out() {
    local in="$1" verb="$2" out="${3:-}" ext="${4:-}"
    if [ -n "$out" ]; then printf '%s' "$out"; return; fi
    mkdir -p dist/img
    printf 'dist/img/%s-%s.%s' "$(basename "${in%.*}")" "$verb" "${ext:-${in##*.}}"
}

img_file() { [ -f "$1" ] || die "no such file: $1"; }

# A font file for magick to draw text with. The unpacked ImageMagick carries
# no fonts and, given none, draws NOTHING and says nothing: an annotate that
# succeeded with an image identical to its input, measured on bb-sandbox. So
# the file is named on every call: fontconfig's sans, then the usual files
# under the system fonts, then the one the caller passed.
img_font() {
    local f="${1:-}"
    if [ -n "$f" ]; then [ -f "$f" ] || die "no such font file: $f"; printf '%s' "$f"; return; fi
    f="$(fc-match -f '%{file}' sans 2>/dev/null || true)"
    [ -f "$f" ] || f="$(find /usr/share/fonts /usr/local/share/fonts -type f \( -iname 'DejaVuSans.ttf' -o -iname 'LiberationSans-Regular.ttf' -o -iname 'NotoSans-Regular.ttf' -o -iname 'FreeSans.ttf' \) 2>/dev/null | head -1)"
    [ -f "$f" ] || die "no font found on this machine to draw text with: pass --font FILE.ttf, or ask the operator for a fonts package on this node"
    printf '%s' "$f"
}

tool_graphics() {
    local verb="${1:-}"; [ $# -gt 0 ] && shift
    local magick f out
    case "$verb" in
        info)
            img_file "${1:-}"; magick="$(gfx_tool graphics magick)"
            "$magick" identify -format '%f: %m %wx%h, %[colorspace], %b\n' "$1"
            ;;
        resize)
            f="${1:-}"; img_file "$f"; local geom="${2:-}"
            case "$geom" in ''|*[!0-9x%]*) die "bb tool graphics resize FILE WxH|W|N% [OUT]" ;; esac
            out="$(img_out "$f" resize "${3:-}")"; magick="$(gfx_tool graphics magick)"
            "$magick" "$f" -resize "$geom" "$out" || die "resize failed"
            log "wrote ${out}"
            ;;
        crop)
            f="${1:-}"; img_file "$f"; local geom="${2:-}"
            case "$geom" in ''|*[!0-9x+-]*) die "bb tool graphics crop FILE WxH+X+Y [OUT]" ;; esac
            out="$(img_out "$f" crop "${3:-}")"; magick="$(gfx_tool graphics magick)"
            "$magick" "$f" -crop "$geom" +repage "$out" || die "crop failed"
            log "wrote ${out}"
            ;;
        compose)
            # OVER laid on BASE at an offset, +0+0 by default: an icon on a
            # ground, a badge on a screenshot.
            local base="${1:-}" over="${2:-}" off="+0+0"; img_file "$base"; img_file "$over"; shift 2
            case "${1:-}" in +*|-*) off="$1"; shift ;; esac
            case "$off" in *[!0-9+-]*) die "the offset is +X+Y" ;; esac
            out="$(img_out "$base" compose "${1:-}")"; magick="$(gfx_tool graphics magick)"
            "$magick" "$base" "$over" -geometry "$off" -composite "$out" || die "compose failed"
            log "wrote ${out}"
            ;;
        annotate)
            f="${1:-}"; img_file "$f"; local text="${2:-}" at="+12+28" size=22 color="white" font=""
            [ -n "$text" ] || die "bb tool graphics annotate FILE TEXT [OUT] [--at +X+Y] [--size N] [--color C] [--font FILE]"
            shift 2; out=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --at) at="$2"; shift 2 ;;
                    --size) size="$2"; shift 2 ;;
                    --color) color="$2"; shift 2 ;;
                    --font) font="$2"; shift 2 ;;
                    -*) die "unknown option: $1" ;;
                    *) out="$1"; shift ;;
                esac
            done
            case "$at" in *[!0-9+-]*) die "--at takes +X+Y" ;; esac
            case "$size" in ''|*[!0-9]*) die "--size takes a number" ;; esac
            case "$color" in *[!#A-Za-z0-9]*) die "--color takes a CSS color name or #hex" ;; esac
            out="$(img_out "$f" annotate "$out")"; magick="$(gfx_tool graphics magick)"; font="$(img_font "$font")"
            "$magick" "$f" -font "$font" -fill "$color" -pointsize "$size" -annotate "$at" "$text" "$out" || die "annotate failed"
            log "wrote ${out}"
            ;;
        diff)
            # How many pixels differ, and a picture of where: the before and
            # after of a screen, checked by a number rather than by eye.
            local a="${1:-}" b="${2:-}" n; img_file "$a"; img_file "$b"
            out="$(img_out "$a" diff "${3:-}" png)"; magick="$(gfx_tool graphics magick)"
            # The count, then the same normalized in brackets: "1335.63 (0.0005)".
            # The first word is the answer; compare exits non-zero whenever
            # the images differ, which is not a failure here.
            n="$("$magick" compare -metric AE "$a" "$b" "$out" 2>&1 >/dev/null || true)"; n="${n%% *}"
            case "$n" in ''|*[!0-9.e+]*) die "compare failed: ${n}" ;; esac
            printf '%s pixels differ; the difference is drawn in %s\n' "${n%%.*}" "$out"
            ;;
        svg2png)
            # A width is digits; anything else in that place is the output.
            f="${1:-}"; img_file "$f"; local w="" resvg; out=""
            case "${2:-}" in '') ;; *[!0-9]*) out="$2" ;; *) w="$2"; out="${3:-}" ;; esac
            out="$(img_out "$f" png "$out" png)"; resvg="$(gfx_tool graphics resvg)"
            if [ -n "$w" ]; then "$resvg" -w "$w" "$f" "$out"; else "$resvg" "$f" "$out"; fi || die "resvg failed"
            log "wrote ${out}"
            ;;
        optimize)
            # In place, losslessly, unless --lossy is asked for: a PNG through
            # oxipng, a JPEG stripped and requantised, and --webp makes a
            # .webp beside each. What an app ships, made smaller before it
            # does.
            local lossy=0 webp=0 files=() t
            while [ $# -gt 0 ]; do
                case "$1" in --lossy) lossy=1 ;; --webp) webp=1 ;; -*) die "unknown option: $1" ;; *) img_file "$1"; files+=("$1") ;; esac; shift
            done
            [ "${#files[@]}" -gt 0 ] || die "bb tool graphics optimize FILE... [--lossy] [--webp]"
            for f in "${files[@]}"; do
                case "$f" in
                    *.png|*.PNG)
                        if [ "$lossy" = 1 ]; then t="$(gfx_tool graphics pngquant)"; "$t" --force --skip-if-larger --ext .png -- "$f" || true; fi
                        t="$(gfx_tool graphics oxipng)"; "$t" -o 4 --strip safe -q "$f" || die "oxipng failed on ${f}" ;;
                    *.jpg|*.jpeg|*.JPG|*.JPEG)
                        magick="$(gfx_tool graphics magick)"; "$magick" "$f" -strip -quality 85 "$f" || die "magick failed on ${f}" ;;
                    *) log "skipping ${f}: not a PNG or JPEG" ;;
                esac
                if [ "$webp" = 1 ]; then t="$(gfx_tool graphics cwebp)"; "$t" -quiet -q 85 "$f" -o "${f%.*}.webp" || die "cwebp failed on ${f}"; fi
                log "optimized ${f} ($(du -h "$f" | cut -f1))"
            done
            ;;
        favicon) tool_graphics_favicon "$@" ;;
        *) die "bb tool graphics info|resize|crop|compose|annotate|diff|svg2png|optimize|favicon ...; bb help has the shapes" ;;
    esac
}

tool_diagrams() {
    local cmd="${1:-}"; [ $# -gt 0 ] && shift
    case "$cmd" in
        render) tool_diagrams_render "$@" ;;
        *) die "bb tool diagrams render FILE... [--out DIR]" ;;
    esac
}

tool_diagrams_render() {
    local out="dist/diagrams" files=() f name plantuml mmdc java
    while [ $# -gt 0 ]; do
        case "$1" in
            --out) out="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) img_file "$1"; files+=("$1"); shift ;;
        esac
    done
    [ "${#files[@]}" -gt 0 ] || die "bb tool diagrams render FILE... [--out DIR]: .puml or .plantuml (PlantUML), .mmd or .mermaid (Mermaid)"
    mkdir -p "$out"; out="$(cd "$out" && pwd)"
    # A result is named by its source's stem, so two sources with one stem
    # (flow.puml and flow.mmd) would write one flow.png, the second over
    # the first without a word (B212). Refused before anything renders.
    local seen=" " stems=() first
    for f in "${files[@]}"; do
        name="$(basename "${f%.*}")"
        case "$seen" in
            *" $name "*)
                first="$(printf '%s\n' "${stems[@]}" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')"
                die "${first} and ${f} would both write ${out}/${name}.png: rename one, or render them into different --out directories" ;;
        esac
        seen="$seen$name "; stems+=("${name}	${f}")
    done
    for f in "${files[@]}"; do
        name="$(basename "${f%.*}")"
        case "$f" in
            *.puml|*.plantuml)
                plantuml="$(gfx_tool diagrams plantuml)"
                # The store's JDK when it is here; the wrapper falls back to
                # whatever java is on PATH.
                java="$(sdk_find jdk 2>/dev/null)/bin/java"; [ -x "$java" ] || java=""
                JAVA="${java:-java}" "$plantuml" -tpng -o "$out" "$f" || die "plantuml failed on ${f}"
                JAVA="${java:-java}" "$plantuml" -tsvg -o "$out" "$f" || die "plantuml failed on ${f}"
                ;;
            *.mmd|*.mermaid)
                mmdc="$(gfx_tool diagrams mmdc)"
                # Mermaid renders in a browser: the store's Chromium, told
                # where it is and to run without a sandbox, since a node has
                # no user namespaces for one.
                local cfg; cfg="$(mktemp)"
                printf '{"executablePath":"%s","args":["--no-sandbox","--disable-gpu"]}\n' "$(find_chromium)" > "$cfg"
                "$mmdc" -q -p "$cfg" -i "$f" -o "$out/$name.png" || { rm -f "$cfg"; die "mmdc failed on ${f}"; }
                "$mmdc" -q -p "$cfg" -i "$f" -o "$out/$name.svg" || { rm -f "$cfg"; die "mmdc failed on ${f}"; }
                rm -f "$cfg"
                ;;
            *) die "${f}: not a .puml, .plantuml, .mmd or .mermaid file" ;;
        esac
        log "wrote ${out}/${name}.png and ${out}/${name}.svg"
    done
}

# ---- documents ---------------------------------------------------------------
# A document a session can read: its text as Markdown (markitdown, from the
# documents toolchain's own Python), or its pages as pictures (PyMuPDF, with
# LibreOffice from the office toolchain making a PDF of anything else first).
# docs.py in this library does both; this finds the toolchains' copies.
tool_docs() {
    local cmd="${1:-}" d py so
    [ $# -gt 0 ] && shift
    case "$cmd" in
        read|pages) ;;
        *) die "bb tool docs read FILE... | pages FILE [--pages N-M] [--dpi N] [--out DIR]" ;;
    esac
    d="$(sdk_find documents 2>/dev/null)" || d=""
    py="${d:+$d/venv/bin/python}"
    [ -n "$py" ] && [ -x "$py" ] \
        || die "the documents toolchain is not on this node: install it on the Toolchains page with this node picked"
    so="$(sdk_find office 2>/dev/null)/bin/soffice" || so=""
    [ -x "$so" ] || so=""
    BB_DOCS_SOFFICE="$so" "$py" "$BB_LIB/docs.py" "$cmd" "$@"
}

# LibreOffice with no window: a document into another format, into dist/docs/
# by default. A profile of its own per run, since two runs sharing one wait
# on each other's lock and the second converts nothing without a word.
# bb tool sound (R107): sound.py with the store's root, where it finds the
# ffmpeg and audio toolchains.
tool_sound() {
    SDK_ROOT="$(sdk_root 2>/dev/null || true)" python3 "$BB_LIB/sound.py" "$@"
}

tool_office() {
    local cmd="${1:-}"; [ $# -gt 0 ] && shift
    case "$cmd" in
        convert) ;;
        *) die "bb tool office convert FILE... [--to pdf|docx|xlsx|pptx|odt|txt] [--out DIR]" ;;
    esac
    local to=pdf out="dist/docs" files=() f so work
    while [ $# -gt 0 ]; do
        case "$1" in
            --to) to="${2:-}"; shift 2 ;;
            --out) out="${2:-}"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) img_file "$1"; files+=("$1"); shift ;;
        esac
    done
    [ "${#files[@]}" -gt 0 ] || die "bb tool office convert FILE... [--to pdf|docx|xlsx|pptx|odt|txt] [--out DIR]"
    case "$to" in pdf|docx|xlsx|pptx|odt|ods|odp|txt|html|csv) ;; *) die "--to takes pdf, docx, xlsx, pptx, odt, ods, odp, txt, html or csv" ;; esac
    so="$(gfx_tool office soffice)"
    mkdir -p "$out"; out="$(cd "$out" && pwd)"
    work="$(mktemp -d "${TMPDIR:-/tmp}/bb-office.XXXXXX")"
    for f in "${files[@]}"; do
        HOME="$work" "$so" "-env:UserInstallation=file://$work/profile" --headless --norestore \
            --convert-to "$to" --outdir "$out" "$f" >/dev/null 2>"$work/err" \
            || { cat "$work/err" >&2; rm -rf "$work"; die "LibreOffice could not convert ${f}"; }
        [ -f "$out/$(basename "${f%.*}").$to" ] \
            || { cat "$work/err" >&2; rm -rf "$work"; die "LibreOffice wrote nothing for ${f}: it may not read that format"; }
        log "wrote ${out}/$(basename "${f%.*}").${to}"
    done
    rm -rf "$work"
}

tool_graphics_favicon() {
    local svg="" out="" bg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bg) bg="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) if [ -z "$svg" ]; then svg="$1"; else out="$1"; fi; shift ;;
        esac
    done
    [ -n "$svg" ] || die "usage: bb tool graphics favicon LOGO.svg [OUTDIR] [--bg COLOR]"
    [ -f "$svg" ] || die "no such file: $svg"
    # Only ever an argv to convert, but a color is a name or #hex, and saying
    # so beats handing ImageMagick something to be confused by.
    case "$bg" in *[!#A-Za-z0-9]*) die "--bg takes a CSS color name or #hex" ;; esac
    out="${out:-.}"
    mkdir -p "$out"
    local magick chrome; magick="$(gfx_tool graphics magick)"; chrome="$(find_chromium)"

    local tmp
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064 # expand the path now, not at trap time
    trap "rm -rf '$tmp'" RETURN
    # A page that is nothing but the mark, edge to edge: Chromium sizes the
    # SVG to the viewport, so the one file serves every raster size.
    {
        printf '<!doctype html><style>html,body{margin:0;height:100%%}svg{display:block;width:100vw;height:100vh}</style>\n'
        cat "$svg"
    } > "$tmp/mark.html"
    NODE_PATH="$(pw_node_path)" node - "$chrome" "$tmp" <<'EOF'
const { chromium } = require("playwright");
const [exe, tmp] = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  for (const px of [16, 32, 48, 64, 128, 180, 256]) {
    const p = await b.newPage({ viewport: { width: px, height: px } });
    await p.goto(`file://${tmp}/mark.html`);
    await p.screenshot({ path: `${tmp}/${px}.png`, omitBackground: true });
    await p.close();
  }
  await b.close();
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
    "$magick" "$tmp/16.png" "$tmp/32.png" "$tmp/48.png" "$tmp/64.png" \
            "$tmp/128.png" "$tmp/256.png" "$out/favicon.ico"
    if [ -n "$bg" ]; then
        # iOS composites the touch icon onto black when it is transparent;
        # --bg flattens it onto the color the caller actually wants.
        "$magick" "$tmp/180.png" -background "$bg" -flatten "$out/apple-touch-icon.png"
    else
        cp "$tmp/180.png" "$out/apple-touch-icon.png"
    fi
    # Copied unless it already IS the output; regenerating in place is the
    # normal workflow and cp would fail on the self-copy.
    [ "$(readlink -f "$svg")" = "$(readlink -f "$out/favicon.svg")" ] \
        || cp "$svg" "$out/favicon.svg"
    log "wrote ${out}/favicon.ico (16-256), apple-touch-icon.png (180), favicon.svg"
}


cmd_doctor() {
    local ok=0
    # A feature this install switched off (FEATURES_OFF, R81): its check is
    # said as skipped, with why, never as a failure nobody here can fix, and
    # never faked as passing (R88).
    off() { case ",$(printf '%s' "${FEATURES_OFF:-}" | tr -d ' ' | tr 'A-Z' 'a-z')," in *",$1,"*) return 0 ;; esac; return 1; }
    check() { # check DESCRIPTION COMMAND...
        local desc="$1"; shift
        if "$@" >/dev/null 2>&1; then
            printf '  [ok]   %s\n' "$desc"
        else
            printf '  [FAIL] %s\n' "$desc"; ok=1
        fi
    }
    echo "== doctor =="
    # Claude Code is a node's, so a controller has nothing to check for: a
    # failed check nobody can fix is worse than no check (R47).
    if on_node; then check "claude on PATH" command -v claude; fi
    # A session on a node asks about its own project's tree (B168): inside
    # its view /workspace is the view's read-only root by design, and the
    # project, its worktrees and nothing else are bound in under it, so the
    # root's answer was a FAIL about nothing a session could fix.
    if on_node && [ -n "${BB_PROJECT:-}" ]; then
        check "project tree writable"  test -w "${BB_TREE:-$WORKSPACE/$BB_PROJECT}"
    else
        check "workspace writable"    test -w "$WORKSPACE"
    fi
    check "home writable"             test -w "$HOME"
    # An upgrade the controller could not make (stateversion.py writes why,
    # and clears it once nothing is held): said here, where the header's
    # doctor dot shows it, not only in the log (B109).
    if ! on_node && [ -s "${DASHBOARD_STATE:-/config}/state-held" ]; then
        check "$(head -c 400 "${DASHBOARD_STATE:-/config}/state-held" | tr '\n' ' ')" false
    fi
    # git's floor, said out loud because the two machines run different ones:
    # the image is built on one Ubuntu and a node is provisioned on whatever
    # its owner has, so the controller and a node have differed by a whole
    # release without anything noticing. The newest thing anything here asks
    # of git is `merge-tree --write-tree` (2.38, Oct 2022), which the Git
    # view merges into main with; on an older one that is a usage error
    # halfway through a merge instead of a sentence. Checked on BOTH, because
    # the controller does the merging and a session commits in its own tree.
    check "git 2.38 or newer, for merge-tree --write-tree" \
        sh -c 'v=$(git --version | sed -n "s/^git version \([0-9]*\)\.\([0-9]*\).*/\1 \2/p"); \
               set -- $v; [ "${1:-0}" -gt 2 ] || { [ "${1:-0}" -eq 2 ] && [ "${2:-0}" -ge 38 ]; }'
    # A commit identity is an ACCOUNT's (its Profile tab), handed to a
    # session as git's environment. On a node that is what to look for; on
    # the controller, where nobody commits, the question is whether the
    # accounts have one, and a bare `git config` there failed on every fresh
    # deploy for a thing no setting could fix.
    if on_node; then
        check "git identity configured" \
            sh -c '[ -n "${GIT_AUTHOR_EMAIL:-}" ] || git config --get user.email'
    else
        DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/doctor-probes.py" id
    fi
    # No -f here: we only care that the connection and TLS handshake work.
    # These endpoints answer a bare GET with 4xx, which -f would treat as an error.
    #
    # Anthropic's is asked on a NODE and not here: this container carries no
    # Claude Code and calls that API for nothing (R47), so on a controller it
    # was a green tick about a thing that never happens, and the machine
    # whose reachability actually decides whether a session works was not
    # being asked at all. GitHub's stays on both: the controller pushes.
    if on_node; then
        check "anthropic api reachable" curl -sS -m 10 -o /dev/null https://api.anthropic.com/
    fi
    if off internet; then
        printf '  [skip] github api reachable: this install is offline (FEATURES_OFF)\n'
    else
        check "github api reachable"      curl -sS -m 10 -o /dev/null https://api.github.com/
    fi
    # ...and the question this box exists to answer: can a session run at all?
    # A Claude session runs on a node and nowhere else now, so a controller
    # with no node able to take one can start nothing, which is worth saying
    # here rather than leaving somebody to find it when a button refuses.
    if ! on_node; then
        DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 "$BB_LIB/doctor-probes.py" node \
            "$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    fi
    # The daemon the dashboard's dev instances are built and run on: the
    # sandbox VM a node record names. This used to report only a mounted socket,
    # as "docker socket not mounted": true, and misleading, because it reads
    # as "no docker here" on a box with a working daemon one variable away.
    #
    # The probe is devapp.available(), the same call the Artifacts tab makes on
    # its own poll, so doctor cannot drift into disagreeing with the tab about
    # whether the thing is up.
    local docker_line dst dmsg lib note
    lib="$(dirname "$(readlink -f "$0")")/lib/docker-probe.py"
    # `|| true`: a probe that dies is a skip line, not the end of the
    # doctor. Under set -e a failing substitution here ended the function
    # after the session line, and every check below it went unprinted.
    # One line per node with a daemon (there is no primary among them), so
    # every line the probe prints is read, not the first.
    docker_line="$(python3 "$lib" \
        "$(dirname "$(readlink -f "$0")")/dashboard/devapp.py" 2>/dev/null || true)"
    [ -n "$docker_line" ] || docker_line="none"
    while read -r dst dmsg; do
        case "$dst" in
            ok)   printf '  [ok]   %s\n' "$dmsg" ;;
            FAIL) printf '  [FAIL] %s\n' "$dmsg"; ok=1 ;;
            skip) printf '  [skip] %s\n' "$dmsg" ;;
            warn) printf '  [warn] %s\n' "$dmsg" ;;
            *)    printf '  [skip] docker daemon: could not be probed\n' ;;
        esac
    done <<<"$docker_line"
    # The GPU is a NODE's concern (roadmap #24, 10c): a controller renders
    # nothing (no emulator, no X server) so on one the card is not checked
    # and not missed. The block below runs in the node role, where the
    # emulator does, and on this image that is a container enrolled as a node.
    if on_node; then
    # nvidia-smi is injected by the container runtime, never installed in the
    # image, and its absence means no GPU was passed through.
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        printf '  [ok]   nvidia gpu: %s\n' \
            "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        # Compute works with the default capabilities; GL/EGL/Vulkan do not.
        # The vendor ICD only lands when capabilities include graphics, so test
        # for the file rather than trusting the variable.
        if [ ! -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
            printf '  [FAIL] nvidia gpu present but no EGL: set NVIDIA_DRIVER_CAPABILITIES=all\n'
            printf '         (currently %s; compute works, -gpu host does not)\n' \
                "${NVIDIA_DRIVER_CAPABILITIES:-unset, so the default compute,utility applies}"
            ok=1
        # The library being present is not the question anyone is asking. It
        # was reported as [ok] here for months while every attempt at hardware
        # rendering fell back to software, because NVIDIA's EGL also needs an X
        # server carrying its own GLX module and there was none. So ask EGL.
        elif vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
            printf '  [ok]   nvidia graphics stack usable (EGL vendor: %s)\n' "$vendor"
        elif x_display_up; then
            printf '  [warn] nvidia EGL is installed but gave no vendor driver on the X display\n'
            printf '         (Mesa answering means llvmpipe; the emulator will use software)\n'
        else
            printf '  [warn] nvidia EGL is installed but has no display to render on\n'
            note="$(gpu_display_note)"
            [ -n "${note:-}" ] && printf '         the startup hook says: %s\n' "$note"
            printf '         %s; the emulator will use software (bb emu gpu)\n' \
                "$(command -v Xorg >/dev/null 2>&1 \
                   && { [ -S /tmp/.X11-unix/X0 ] \
                        && echo "the X server started and has gone: a stale socket is all that is left, see /var/log/xorg-builderbot.log" \
                        || echo "the X server did not start, see /var/log/xorg-builderbot.log"; } \
                   || echo "this image has no X server")"
        fi
    elif command -v nvidia-smi >/dev/null 2>&1; then
        printf '  [FAIL] nvidia-smi present but no GPU visible: check --runtime=nvidia --gpus all\n'
        ok=1
    else
        printf '  [skip] no nvidia gpu passed through\n'
    fi
    fi
    # Each node's runner token, kept root-only and asked about through the
    # helper. Presence is not validity: GitHub is asked, so a revoked or
    # expired token cannot keep reading [ok] here.
    runner_ids="$(sudo -n /opt/builderbot/scripts/mint-runner-token --list 2>/dev/null || true)"
    if off runner || off internet; then
        printf '  [skip] runner tokens: CI runners are switched off on this install (FEATURES_OFF)\n'
    elif [ -z "$runner_ids" ]; then
        printf '  [skip] no runner token stored for any node (the CI runner page takes one)\n'
    else
        while read -r rid rslot; do
            [ -n "$rid" ] || continue
            if sudo -n /opt/builderbot/scripts/mint-runner-token --validate "$rid" "$rslot" >/dev/null 2>&1; then
                printf '  [ok]   runner token for %s on %s: stored root-only, and its host accepts it\n' "$rslot" "$rid"
            else
                printf '  [FAIL] runner token for %s on %s: its host rejected it (revoked or expired?)\n' "$rslot" "$rid"
                ok=1
            fi
        done <<< "$runner_ids"
    fi
    # `gh auth status`, said as what it is. This line used to read "git over
    # https not authenticated", which is a claim about pushing and this is not
    # a test of pushing: a project with its own token in /config/gitcreds
    # pushes over https perfectly well with gh logged out, and this repo does
    # exactly that. What gh being logged out actually costs is the API: no
    # `gh pr create`, no `gh release create`, and reporting that as broken git
    # sends somebody to fix a credential that is already working.
    # Nothing here signs gh in, so it being signed out is the ordinary state
    # and not a line: a skip nobody can act on is noise on every deploy.
    # Signed in by hand on a node, it is worth a word.
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
        printf '  [ok]   gh (the GitHub API) is authenticated\n'
    fi
    # And whether THIS repo can actually reach its remote, which is the
    # question the line above was being read as. Per-project tokens made the
    # old answer wrong: the credential is per repository now, so it can only be
    # answered about one.
    local origin cred_project
    origin="$(git remote get-url origin 2>/dev/null || true)"
    case "$origin" in
        https://*)
            cred_project="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo .)")"
            if on_node; then
                printf '  [ok]   pushes go through the controller: bb git push|fetch|pull\n'
                printf '         (no credential lives on a node: plain git push fails here by design)\n'
            elif [ -f "${DASHBOARD_STATE:-/config}/gitcreds/${cred_project}" ]; then
                printf '  [ok]   this repo pushes over https with its own stored token\n'
            else
                printf '  [FAIL] this repo has an https remote and no credential for it\n'
                printf '         add one in the dashboard, or switch it to ssh\n'
                ok=1
            fi ;;
    esac
    local ssh_src="" ssh_rc=0
    ssh-add -l >/dev/null 2>&1 || ssh_rc=$?
    if [ "$ssh_rc" = 0 ]; then
        ssh_src="shielded agent key"
    elif compgen -G "$HOME/.ssh/id_*" >/dev/null; then
        ssh_src="key file in ~/.ssh"
    fi
    # Distinguish "no key" from "key loaded but the agent is unreachable from
    # this uid", which is otherwise indistinguishable and very confusing.
    # ssh-add exits 2 when it cannot reach the agent and 1 when the agent
    # holds no key: an empty agent (the entrypoint starts one whether or not
    # a key is ever added) is not a fault (B685).
    if [ -z "$ssh_src" ] && [ "$ssh_rc" = 2 ] && [ -S "${SSH_AUTH_SOCK:-/run/ssh-agent.sock}" ]; then
        printf '  [FAIL] an agent socket exists but this user cannot use it; see: bb logs | grep ssh\n'
        ok=1
    fi
    if on_node; then
        # GitHub is not a question to ask of a key on a node. No git
        # credential lives here by design and pushes relay through the
        # controller, so a key on this machine is for reaching another one,
        # and testing it against github.com reported a stray key as a fault
        # two lines under the line saying pushes relay (B185).
        if [ -n "$ssh_src" ]; then
            printf '  [skip] %s, and not used for git here: a node pushes through the controller\n' "$ssh_src"
        else
            printf '  [skip] no ssh key here, which is the design: a node holds no credential\n'
        fi
    elif [ -n "$ssh_src" ]; then
        # A successful GitHub ssh auth still exits nonzero (no shell access),
        # so judge by the greeting instead of the exit code. On failure report
        # what ssh actually said: host-key verification, a refused key and an
        # unreachable agent all look identical otherwise.
        local ssh_out ssh_why
        ssh_out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 git@github.com 2>&1 || true)"
        if printf '%s' "$ssh_out" | grep -q 'successfully authenticated'; then
            printf '  [ok]   github ssh auth works (%s)\n' "$ssh_src"
        else
            ssh_why="$(printf '%s' "$ssh_out" \
                | grep -iE 'permission denied|host key verification|remote host identification|no such identity|sign_and_send|connection closed|could not resolve|timed out' \
                | head -1)"
            printf '  [FAIL] %s but github auth failed: %s\n' \
                "$ssh_src" "${ssh_why:-$(printf '%s' "$ssh_out" | head -1)}"
            printf '         diagnose with: ssh -vT git@github.com\n'
            ok=1
        fi
    else
        printf '  [skip] no ssh key on the controller: a project pushes with the token or key given when it was cloned or linked\n'
    fi
    # The login, on the machine that holds one. This used to pass on the mere
    # EXISTENCE of ~/.claude, which since R47 is where the controller keeps
    # its record of which Anthropic account an account is bound to, so a
    # container carrying no Claude Code at all reported "Claude Code
    # credentials present in /home/builder", which was three kinds of wrong.
    # The credential is one file, and it lives on a node.
    # On the controller: not a line. A login is a node's, and each node's
    # row on the Nodes tab says who is signed in there.
    if ! on_node; then
        :
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        printf '  [ok]   ANTHROPIC_API_KEY set\n'
    elif [ -f "$HOME/.claude/.credentials.json" ]; then
        printf '  [ok]   signed in to Claude on this machine%s\n' \
            "$(python3 "$BB_LIB/doctor-probes.py" login 2>/dev/null)"
    else
        printf '  [warn] not signed in to Claude on this machine: Sign in on its row on the\n'
        printf '         Nodes page (Claude Code) runs the flow here, or `bb login` in this shell\n'
    fi
    return $ok
}

# Bare `bb` prints what it can do. It used to run `status`, which is the same
# wall of tool versions `bb status` gives you: an answer to a question nobody
# typing `bb` on its own was asking.
# bb version: this project's version identity, in whatever form is asking.
#
# The shell half is deliberately thin: everything that decides what a version
# IS lives in dashboard/version.py, because the notebook needs the same answers
# and two implementations of "what version is this" would drift the week one of
# them was touched. This resolves which project is being asked about and prints
# what the module returns.
# bb version release --edit (R139): the session's notes and files read here,
# the edit asked of the controller over its API (lib/release-edit.py).
cmd_version_edit() {
    local proj
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    export BB_VERSION_AUTH; BB_VERSION_AUTH="$(bb_auth_or_die)"
    BB_WORKSPACE="$WORKSPACE" python3 "$BB_LIB/release-edit.py" "$proj" "$@"
}

cmd_version() {
    case " $* " in *" release "*"--edit "*|*" --edit "*"release "*|*" release "*"--remove "*)
        case " $* " in *" -h "*|*" --help "*) ;; *) cmd_version_edit "$@"; return $? ;; esac ;;
    esac
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    # Asked from one of the project's worktrees, the answer is that tree's:
    # its HEAD, its VERSION file, its ordinal (version.py root()). The relay
    # runs this in the caller's cwd, so a node's session gets the same.
    local top; top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    case "$top" in "$BB_WORKTREES/$proj"/*) export BB_VERSION_TREE="$top" ;; esac
    # A release is the controller's to make (R138): the verb asks it, with
    # this session's credential.
    case " $* " in *" release "*) export BB_VERSION_AUTH; BB_VERSION_AUTH="$(bb_auth_or_die)" ;; esac
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 "$BB_LIB/version-verbs.py" "$py" "$proj" "$@"
}

# bb changelog: the user-facing record beside VERSION, per project or
# component. A session logs what changed for the person using the product;
# the next bump dates the accumulated lines. Writing goes through `add` so
# the shape stays uniform; reading is just the file.
cmd_changelog() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE}; cd into one first"
    fi
    # Asked from one of the project's worktrees, the answer is that tree's:
    # its HEAD, its VERSION file, its ordinal (version.py root()). The relay
    # runs this in the caller's cwd, so a node's session gets the same.
    local top; top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    case "$top" in "$BB_WORKTREES/$proj"/*) export BB_VERSION_TREE="$top" ;; esac
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 "$BB_LIB/changelog-verbs.py" "$py" "$proj" "$@"
}

# On a node, the verbs whose state is the controller's go there whole (see
# bb_relay); BB_RELAYED marks the controller's own run so a relayed verb that
# calls bb again cannot bounce.
# `bb -p NAME VERB`: the verb about another project, one this project reads
# (prefs.reads, read-only from here). It moves every project the verbs read,
# and the tree bb map reads, before the relay decides where the words go:
# the controller's door is what refuses a project this one does not read.
if [ "${1:-}" = -p ] || [ "${1:-}" = --project ]; then
    [ -n "${2:-}" ] || die "bb -p NAME VERB: which project?"
    case "$2" in */*|.*) die "bb -p: '$2' is not a project name" ;; esac
    p_dir="$2" p_name="$2"
    # The name the dashboard shows is taken for its directory (B1), here as
    # well as at the relay, since bb map and bb transcripts read the tree
    # locally: the relayed settings read answers with the directory's name.
    if [ ! -d "$WORKSPACE/$p_dir" ] && on_node; then
        p_res="$(BB_PROJECT="$p_dir" "$0" settings 2>/dev/null | sed -n '1s/:$//p')" || p_res=""
        [ -n "$p_res" ] && [ -d "$WORKSPACE/$p_res" ] && p_dir="$p_res"
    fi
    export BB_PROJECT="$p_dir" BB_ROADMAP_PROJECT="$p_dir" BB_BUG_PROJECT="$p_dir" BB_VERSION_PROJECT="$p_dir"
    # ...and the verbs that read logs (B675): `bb -p X tests log` and
    # `bb -p X ci-log` answered for this session's own project.
    export BB_TESTS_PROJECT="$p_dir" BB_CILOG_PROJECT="$p_dir"
    export BB_TREE="$WORKSPACE/$p_dir"
    shift 2
    # Said rather than answered for this project or for nothing
    # (MediaReducer, 7 Oct): `bb -p X status` printed this session's own
    # status, and `bb -p X map find` said "nothing defines" a function X
    # has, because X was added to the reads after the session started and
    # its tree was not in view.
    case "${1:-}" in
        status|node|gpu|toolchains|emu|phone|tidy|doctor|lint|drift|build|test|run)
            die "bb -p: bb ${1} answers for this machine and this project, not for $p_name" ;;
        map)
            # By the name it was asked by, never its directory (B58).
            [ -d "$BB_TREE" ] || die "$p_name's tree is not in this session's view: a project added to the reads comes into a session's view when it starts, so start a new one (its notebook answers already)" ;;
    esac
fi

# `bb VERB -h`: the verb's own entries in the reference above, answered here
# for every verb alike (B536). Each verb had grown its own answer, and those
# with none fell to their usage error: `bb devapp -h` printed its usage as
# "[builderbot] ERROR:" and exited 1, so asking for help read as a failure.
# Help is the same text on a node as on the controller, so it is never
# relayed. A verb the reference does not name falls through to its own.
case "${2:-}" in
    -h|--help) [ -n "${1:-}" ] && verb_help "$1" && exit 0 ;;
esac
# ...and `bb bug add -h` for a notebook verb, whose words after the
# subcommand are a title: it filed a bug called "-h" (MediaReducer, 7 Oct).
case "${1:-}:${3:-}" in
    bug:-h|bug:--help|roadmap:-h|roadmap:--help|rules:-h|rules:--help|changelog:-h|changelog:--help)
        verb_help "$1" && exit 0 ;;
esac

if on_node && [ -z "${BB_RELAYED:-}" ]; then
    # One verb is relayed except for one of its subcommands. `bb tests` reads
    # and writes the registry, which is the controller's; `bb tests run` RUNS
    # a suite, and a suite belongs where the toolchain and the tree are. It
    # relays its own ingest afterwards, which is the half that is state.
    case "${1:-} ${2:-}" in
        # `run` runs the suite, which belongs where the toolchain and the tree
        # are; `last` and `log` read the log that run wrote, which is beside
        # the project on the share both machines mount. Neither is the
        # controller's to answer, and `log` relayed read the controller's
        # stale view of a file this machine had just rewritten in place:
        # half the lines, starting mid-way (B324).
        # `lab` runs the lab suites against a real service reachable from
        # here, the same reason.
        # `rules check` runs each rule's check command, which belongs where
        # the tree and the toolchain are, and never on the controller: a
        # session may write its own rule's check (B152). It relays its
        # rules --json read, which is the half that is state.
        # `findings sample` writes a file for the dashboard beside it to read,
        # so it belongs on the machine it was typed on: in a dev instance,
        # which is a controller of its own and where there is no scanner. Sent
        # to the real controller it would be a session planting findings in
        # somebody else's report directory.
        # `probe` and `keep` drive the dashboard fixture, which runs here.
        # `rules -h` is help, the bb beside it answers (B411).
        "tests run"|"tests last"|"tests log"|"tests lab"|"tests probe"|"tests keep"|"tests preflight"|"tests unit"|"tests coverage"|"rules check"|"rules audit"|"rules -h"|"rules --help"|"findings sample") : ;;
        *)  # ...and that is the whole run: without the exit the dispatch
            # below ran the verb a second time HERE, against files the bundle
            # does not carry: `bb bug` printed the controller's answer and
            # then died with "bugs.py is missing from this image".
            # `version release --edit` reads its notes and files where the
            # session wrote them and only calls the API (report 60): relayed,
            # a scratchpad file was not there and stdin arrived empty.
            if [ "${1:-}" = version ]; then
                case " $* " in *" -h "*|*" --help "*) ;;
                    *" release "*"--edit "*|*" --edit "*"release "*|*" release "*"--remove "*) cmd_version_edit "${@:2}"; exit $? ;; esac
            fi
            case "$BB_RELAY_VERBS" in
                # The controller's answer IS this command's answer. It used to
                # be `exit 0` whatever came back, so a refused roadmap edit, a
                # denied push and a bug that was never filed all read as
                # success to a script, to a hook, and to a session's `&&`.
                # bb_relay has carried the code the whole time (it ends with
                # `return $rc`); only the dispatch threw it away.
                *" ${1:-help} "*) relay_rc=0; bb_relay "$@" || relay_rc=$?
                                  exit "$relay_rc" ;;
            esac ;;
    esac
fi

# One group, with the exit inside it: bash reads a script as it runs it, by
# byte offset, and after a long verb (a preflight, a suite) it read on from
# where this case used to end. An edit to this file meanwhile had moved the
# text, and the run ended in a syntax error at a line that was fine (B226).
# A group is parsed whole before it runs, and the exit means nothing after
# it is ever read.
{
case "${1:-help}" in
    status)   cmd_status ;;
    settings) shift; cmd_settings "$@" ;;
    version)  shift; cmd_version "$@" ;;
    changelog) shift; cmd_changelog "$@" ;;
    projects) shift; cmd_projects "$@" ;;
    shell)    exec bash -l ;;
    login)    shift; cmd_login "$@" ;;
    emu)      shift; dist_ignored; cmd_emu "$@" ;;
    gpu)      shift; BB_PROJECT="$(bb_project 2>/dev/null || true)" exec python3 "$BB_LIB/gpu.py" "$@" ;;
    tidy)     shift; exec python3 "$BB_LIB/tidy.py" "$@" ;;
    proc)     shift; exec python3 "$BB_LIB/proc-verbs.py" "$@" ;;
    browser)  shift; cmd_browser "$@" ;;
    node)     shift
              case "${1:-busy}" in
                  -h|--help) sed -n '/^bb node busy/,/if it never was/p' "$0"; exit 0 ;;
                  # A node's own log is `bb logs --node`; asked as `bb node
                  # log NAME [--runner] [N]`, it is the same read.
                  log) shift; nd="${1:-${BB_NODE:-}}"; [ $# -gt 0 ] && shift
                       cmd_logs --node "$nd" "$@"; exit $? ;;
              esac
              BB_BUSY_AUTH="$(bb_auth_or_die)" BB_BUSY_PROJECT="$(bb_project 2>/dev/null || true)" \
                  BB_BUSY_NODE="${BB_NODE:-}" exec python3 "$BB_LIB/busy-verbs.py" "$@" ;;
    lint)     shift; cmd_lint "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    token)    shift; cmd_token "$@" ;;
    nodes) shift; cmd_nodes "$@" ;;
    users) shift; cmd_users "$@" ;;
    work)  shift; cmd_work "$@" ;;
    jobs)  shift; cmd_jobs "$@" ;;
    run)   shift; cmd_run "$@" ;;
    git)   shift; cmd_git "$@" ;;
    devapp) shift; cmd_devapp "$@" ;;
    sign)   shift; dist_ignored; cmd_sign "$@" ;;
    ci-labels) shift; cmd_ci_labels "$@" ;;
    build) shift; dist_ignored; cmd_build_or_test build "$@" ;;
    test)  shift; cmd_build_or_test test "$@" ;;
    roadmap)  shift; cmd_roadmap "$@" ;;
    bug) shift; cmd_bug "$@" ;;
    tests)    shift; cmd_tests "$@" ;;
    preamble) shift; cmd_preamble "$@" ;;
    brief) shift; cmd_brief "$@" ;;
    transcripts) shift; cmd_transcripts "$@" ;;
    design) shift; cmd_design "$@" ;;
    wiki) shift; cmd_wiki "$@" ;;
    rules)    shift; cmd_rules "$@" ;;
    history)  shift; cmd_history "$@" ;;
    logs)     shift; cmd_logs "$@" ;;
    diag)     shift; cmd_diag "$@" ;;
    report)   shift; cmd_report "$@" ;;
    pc)       shift; cmd_pc "$@" ;;
    catchup)  shift; cmd_catchup "$@" ;;
    ci-log)   shift; cmd_ci_log "$@" ;;
    phone)    shift; dist_ignored; cmd_phone "$@" ;;
    root)     shift; cmd_root "$@" ;;
    container) shift; cmd_container "$@" ;;
    doctor)   cmd_doctor ;;
    dashboard) shift; cmd_dashboard "$@" ;;
    drift)    shift; cmd_drift "$@" ;;
    map)      shift; cmd_map "$@" ;;
    capture)  shift; dist_ignored; cmd_capture "$@" ;;
    tool)     shift; dist_ignored; cmd_tool "$@" ;;
    toolchains) shift; cmd_toolchains "$@" ;;
    -h|--help|help) cmd_help "${@:2}" ;;
    *) usage; exit 1 ;;
esac
exit
}
