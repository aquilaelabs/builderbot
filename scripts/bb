#!/usr/bin/env bash
#
# `bb` — small convenience CLI inside the container.
#
set -euo pipefail

# The library next to this script, not a fixed /opt path: identical in the
# image (both live in /opt/builderbot/scripts), and it means a dry-run from a
# checkout uses that checkout's library instead of silently mixing new
# commands with the installed image's older helpers.
# shellcheck source=lib/common.sh
. "$(dirname "$(readlink -f "$0")")/lib/common.sh"
# The package manager — `bb sdk` and everything the Tools tab drives — is a
# third of this script's length and none of its subject, so it lives next door.
# shellcheck source=lib/sdk.sh
. "$(dirname "$(readlink -f "$0")")/lib/sdk.sh"
# The API client the network verbs share (lib/bbapi.py), loaded by path from
# the heredocs so a checkout's bb runs with the checkout's client.
BB_LIB="$(dirname "$(readlink -f "$0")")/lib"
export BB_LIB

usage() {
    cat <<'EOF'
bb — BuilderBot helper

  bb status              show tool versions, runner state and mounted projects
  bb version             this project's version, and who is allowed to move it
  bb version --code      one form only: --code (Android versionCode), --quad
                         (= --win: manifest.json and Windows VERSIONINFO),
                         --msi, --pep440, --file, --semver, --json
  bb version bump PART   move the target: major|minor|patch, if policy allows
  bb version init X.Y.Z  give this project (or --for DIR) its first VERSION
  bb version unbump      take an unreleased bump back; its changelog section
                         dissolves into Unreleased, the code stays
  bb version --list      every version this repo carries: its own, and any
                         component — a directory with its own VERSION file
  bb version --for DIR   ask about one component instead of the project
  bb version policy      what a session may move here, and who decides
  bb changelog           this project's user-facing changelog (--for DIR)
  bb changelog add "..." log what a change means for the person using it;
                         the next version bump dates the accumulated lines
  bb projects            list mounted project directories
  bb shell               open a login shell as the builder user
  bb update              update Claude Code (and npm globals) in place
  bb login               run the Claude Code auth flow. On a node it first
                         keeps this account's login in step with the
                         controller's, in whichever direction is newer
  bb login --sync        that half alone, quietly — what every connection does
  bb git push|fetch|pull|ls-remote [ARGS]
                         git's network half, run where the credential is — from a
                         session on a node it goes through the controller
  bb emu start [API]     boot the emulator headless (e.g. `bb emu start 37`)
  bb emu stop            shut the emulator down
  bb emu status          adb devices
  bb emu list            configured API levels and the AVDs that exist
  bb emu log [-p] [N]    this boot's emulator log, or -p for the one before it
  bb emu gpu             which renderer a start would use, and why
  bb emu create API      build the AVD for an API level (images installed if missing)
  bb emu install APK     install an APK on the running emulator
  bb emu shot [FILE]     screenshot the emulator into dist/emu/
  bb emu gfx PKG [FILE]  a package's per-frame timings (gfxinfo framestats) into dist/emu/
                         — every emu verb runs on the project's node when it has one
  bb claude-md           is this project's CLAUDE.md environment block current?
  bb claude-md --update  refresh that block, leaving the project section alone
  bb claude-md --init    create a CLAUDE.md here from the shipped template
  bb claude-md --is-stale  exit 0 when that block exists and has drifted — the
                         gate the ghosted Claude button and bb-tty both ask
  bb ci-labels [--write] the runner labels the registry knows; --write regenerates
                         .github/actionlint.yaml from them
  bb lint [PATH]         lint the infrastructure files a repo carries: shell
                         scripts, Dockerfiles, GitHub workflows, compose, XML
  bb roadmap             this project's roadmap (add/done/rm/shelve/history)
  bb roadmap show N      one item in full: its details, its steps and theirs
  bb roadmap add "..." [--step "..."]   an item, or an ordered group of steps
  bb bug                 this project's bug tracker: open bugs, newest first
  bb bug find TEXT       search the reports themselves — area and repro included
  bb bug add "..."       report one; show N, note N, fix N, wontfix N, reopen N
  bb bug na N ["why"]    it was real and stopped applying — the feature went
  bb bug rm N ["why"]    delete a report that should not have been filed
  bb tests run           run the project's test command, time it, and record the run
  bb rules               the house rules for this project — the operator's and yours
  bb rules show NAME     one of them in full — what a conditional rule says
  bb rules add NAME "..." [--files ...] [--words ...]   leave one of your own
  bb rules edit NAME "..." | rm NAME ["why"]            change or drop yours
  bb rules history       what has changed them, by either of you
  bb tests               the test registry: where the suite's time goes, slowest first
  bb tests show KEY      one test — what it protects, what it exercises, its history
  bb tests note KEY "..." [--how "..."]   what it protects, and what it really runs
  bb tests describe --from FILE.json      fill many at once, in one write
  bb tests ingest [LOG]  record a run's real durations (BB_TEST_TIMING=1 output)
  bb tests drift         what the runner reported that this list does not, and back
  bb tests flagged       the ones sitting on a round timeout rather than working
  bb tests accept KEY "why"   the wait is the work: stop flagging it, saying why (--no undoes)
  bb tests projection    when a run should finish, from what the last one took
  bb history [--find X]  one search over the notebook: roadmap, bugs, memory
                         and the scanner's logs
  bb nodes               the node registry, read-only (docs/nodes.md phase 1)
  bb users               the dashboard's accounts; passwd NAME is the way back in
  bb users token PROJECT [ACCOUNT]  a session token for one project (and one
                         account), for a node proved by hand
  bb settings [--json]   this project's settings as the dashboard has them (read-only)
  bb work                who else is changing this project, and which files
                         two of you have open at once
  bb jobs [-n N]         the recent jobs: state, node, what ran, how it ended
  bb run [opts] -- CMD   snapshot this tree, run CMD on the project's node,
                         stream the log back; --out GLOB brings files into dist/
  bb build               the project's build command, on its node (settings dialog)
  bb test                the project's test command, on its node
  bb findings [PATH]     digest scanner SARIF findings for this project
  bb findings --all      ...including findings in other projects' trees
  bb findings --level L --rule ID --find TEXT   narrow it, same as the tab
  bb findings history    what the scanner stopped and started saying here
                         (-n N, --since 7d, --find TEXT, as the other logs)
  bb phone               what phone is connected, and what is waiting on you
  bb phone run --why "..." -- adb args...    ask to reach it; the operator
                         allows it on the dashboard and this runs it there
  bb catchup             what has happened here lately: commits and the first
                         line of their bodies, what moved in the notebook, the
                         builds, and which image this box is running
  bb ci-log              what CI printed on its last run here — the runner
                         keeps none of it, so the workflow archives it
  bb ci-log --list       the runs kept for this project, newest first
  bb logs [-f] [N]       show this boot's log (default: last 100 lines)
  bb logs -p [N]         show a previous boot's log (the log rotates per start)
  bb logs --list         list the kept boot logs, newest first
  bb doctor              check the things that usually go wrong

  Developing BuilderBot itself (this repo is the container's source):
  bb dashboard test [F]  browser-test the dashboard from this checkout, isolated
  bb dashboard dev [DIR] serve the live dashboard from DIR (default: ./scripts/dashboard)
  bb dashboard dev --off ...and put the image's copy back
  bb dashboard status    which copy of the dashboard is serving right now
  bb drift [REPO]        which files this checkout changed that the running
                         container is not serving yet
  bb shot URL... [FILE|DIR]  headless screenshot(s): --full --scale N --wait MS --resize W, auth via --auth
  bb favicon SVG [DIR]   favicon.ico (16-256) + apple-touch-icon.png + favicon.svg from one mark
  bb sdk                 SDKs kept outside the image: status, install X, remove X
EOF
}

# version LABEL COMMAND... — print a tool's version, or "-" when it is absent
# or answers with nothing.
version() {
    local label="$1"; shift
    local out
    out="$("$@" 2>/dev/null | head -1)" || out=""
    printf '  %-8s %s\n' "$label" "${out:--}"
}

cmd_status() {
    echo "== versions =="
    # First, because it is the identity of everything under it: every version
    # below came out of this image, and which image that is was otherwise
    # guessable only from the uptime. Stamped by CI at the end of the
    # Dockerfile; empty means the image was built some other way.
    # Above the commit, because it is the half a person can order. A sha
    # says which build; only this says which came first.
    printf '  %-8s %s\n' version "${BB_VERSION:-unstamped}"
    printf '  %-8s %s\n' image "$(
        if [ -n "${BB_IMAGE_REV:-}" ]; then
            printf '%.7s%s' "$BB_IMAGE_REV" \
                "${BB_IMAGE_BUILT:+ (built $BB_IMAGE_BUILT)}"
        else
            printf 'unstamped'
        fi)"
    version claude claude --version
    version node   node --version
    version npm    npm --version
    version python python3 --version
    version uv     uv --version
    version git    git --version
    version gh     gh --version
    version docker docker --version
    version mise   mise --version
    version java   java --version
    version adb    adb --version
    version pw     playwright --version
    echo
    # What is installed beyond the image, and where. Here rather than only in
    # `bb sdk` because this is the command a session runs first, and "is
    # flutter on this box" should not need a second guess.
    echo "== sdk =="
    local root have=""
    root="$(sdk_root)"
    for t in $SDK_TOOLCHAINS; do
        [ "$t" = android ] && continue
        sdk_have "$root" "$t" && have="${have:+$have }$t"
    done
    printf '  %-8s %s%s\n' root "$root" \
        "$(is_mountpoint "$root" && printf ' (share)' || printf ' (home volume)')"
    printf '  %-8s %s\n' installed "${have:-none — see: bb sdk}"
    echo
    # CI runs on nodes (docs/nodes.md phase 7); `bb ci-labels` lists their
    # runners' labels and the Nodes tab shows each one's state.
    cmd_projects
}

cmd_projects() {
    echo "== projects (${WORKSPACE}) =="
    local d found=0
    for d in "$WORKSPACE"/*/; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in _work) continue ;; esac
        found=1
        if [ -d "$d/.git" ]; then
            printf '  %-40s git: %s\n' "$(basename "$d")" "$(git_branch "$d")"
        else
            printf '  %-40s (not a git repo)\n' "$(basename "$d")"
        fi
    done
    [ "$found" -eq 1 ] || echo "  none mounted"
}

cmd_update() {
    log "updating Claude Code"
    install_claude_code "$(bb_setting claude_version CLAUDE_CODE_VERSION latest)" \
        || die "update failed — the image's baked-in version is still on PATH"
    claude --version
}

# The account's Claude grant, kept in step between this node and the
# controller (roadmap #24, bug #64).
#
# The grant is an OAuth pair and a refresh ROTATES the refresh token, so two
# machines each keeping a copy sign each other out: the operator ran sessions
# on a node for a day and came back to a controller that had to be signed in
# again, because the node had refreshed and the controller still held a
# refresh token the server had retired. The copies are the design — Claude
# Code reads a file in the home it runs in — so they are kept in step
# instead: whichever machine refreshed has the later `expiresAt`, and that
# one wins. Newer here goes up, newer there comes down, equal does nothing.
#
# Never fatal, and quiet when nothing moved: this runs on every connection
# (bb-tty), where a controller that is down or a token that has expired must
# cost a session nothing.
claude_login_sync() {
    on_node || return 0
    [ -n "${BB_TOKEN:-}" ] || return 0
    BB_LOGIN_AUTH="$(bb_auth_header)" python3 - "${1:-}" <<'PY' || true
import json, os, sys
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402

loud = sys.argv[1] == "--loud"
auth = os.environ["BB_LOGIN_AUTH"]
path = os.path.join(os.environ["HOME"], ".claude", ".credentials.json")


def at(text):
    """When a grant stops being good — the number a refresh moves."""
    try:
        return int((json.loads(text).get("claudeAiOauth") or {}).get("expiresAt") or 0)
    except (ValueError, AttributeError, TypeError):
        return 0


def say(msg):
    print(f"[builderbot] {msg}")          # bb's own convention: log on stdout


def warn(msg):
    print(f"[builderbot] WARN: {msg}", file=sys.stderr)


mine = ""
try:
    with open(path) as f:
        mine = f.read()
except OSError:
    pass
r = bbapi.call("/api/v1/claude-login", auth=auth)
if r.get("error") and not mine:
    if loud:
        warn(f"no login to take from the controller: {r['error']}")
    sys.exit(1)
theirs = r.get("credentials") or ""

if at(mine) > at(theirs):
    # This machine refreshed. Hand it back before the controller's copy is
    # the stale one — that is the whole of bug #64.
    w = bbapi.call("/api/v1/claude-login", {"credentials": mine}, auth=auth)
    if w.get("error"):
        warn(f"could not hand the refreshed login back to the controller: {w['error']}")
    elif w.get("stored") and loud:
        say("the login here was newer — the controller has it now")
    sys.exit(0)

if at(theirs) > at(mine):
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(theirs)
    os.replace(path + ".new", path)
    who = r.get("email") or "the account signed in on the controller"
    say(f"signed in on {os.environ.get('BB_NODE', 'this node')} as {who} — "
        f"the login came from the controller")
    sys.exit(0)

if loud and not mine:
    warn("the controller has no login for this account either")
    sys.exit(1)
sys.exit(0)
PY
}

cmd_login() {
    # `--sync` is the quiet half on its own: bb-tty runs it on every
    # connection, where an interactive flow would be wrong and a message
    # about nothing having moved would be noise.
    if [ "${1:-}" = --sync ]; then
        on_node || return 0
        claude_login_sync
        return 0
    fi
    # ON A NODE, the login is kept in step with the controller first
    # (roadmap #24): this account signed in there — the Doctor card's flow —
    # and the token a node-bound terminal carries is minted for that account,
    # so the controller hands over that account's grant and no other. Both
    # directions, because a refresh rotates the token and the newer copy has
    # to win whichever machine made it (bug #64). Still signed out after
    # that falls through to the interactive flow below, which works on a node
    # exactly as it does here.
    if on_node; then
        claude_login_sync --loud || true
        [ "$(claude auth status --json 2>/dev/null \
             | tr -d ' ' | sed -n 's/.*"loggedIn":\([a-z]*\).*/\1/p')" != true ] || return 0
        log "sign in here instead — the flow runs in this terminal"
    fi
    # `claude auth login` is the flow built for this and does not leave a
    # session behind afterwards. The older path — start a session and use its
    # slash command — is the fallback for an image whose claude predates the
    # subcommand, which is exactly the case a first-time setup can be in.
    if claude auth --help >/dev/null 2>&1; then
        claude auth login
    else
        claude /login || claude
    fi
}


avd_exists() { avdmanager list avd 2>/dev/null | grep -q "Name: ${1}$"; }

# emu_avd [TARGET] — resolve which AVD to act on. A bare API level (37) maps to
# that version's AVD; anything else is taken as a literal name. With no target:
# ANDROID_AVD_NAME wins if set, then the first configured API level, then the
# unsuffixed name AVDs used before this was multi-version.
# The API levels with a system image in the store, one per line, ascending.
emu_apis() {
    sdk_images 2>/dev/null | cut -f2 | sed 's/^android-//' | sort -un
}

emu_avd() {
    local target="${1:-}" prefix="${ANDROID_AVD_PREFIX:-builderbot}" first
    if [ -n "$target" ]; then
        case "$target" in
            *[!0-9]*) printf '%s' "$target" ;;
            *)        printf '%s-%s' "$prefix" "$target" ;;
        esac
        return
    fi
    if [ -n "${ANDROID_AVD_NAME:-}" ]; then
        printf '%s' "$ANDROID_AVD_NAME"
        return
    fi
    # The newest API level the store holds an image for: what the machine
    # actually has, rather than a variable naming what somebody once meant to
    # install (ANDROID_SYSTEM_IMAGES, which went with the baseline hook).
    first="$(emu_apis | tail -1)"
    [ -n "$first" ] || first=36
    if avd_exists "${prefix}-${first}"; then
        printf '%s-%s' "$prefix" "$first"
    else
        printf '%s' "$prefix"
    fi
}

# Does hardware GLES actually work here? Not "is there a GPU" — the card can be
# present, the Vulkan loader can find it, and EGL can still refuse to hand out
# a display, which is exactly the state this box was in for months. So this
# asks EGL itself, and believes the answer.
#
# Prints the vendor string on success and nothing on failure; the caller reads
# the exit status.
#
# x_display_up — "is anything listening on :0" — is in lib/common.sh, because
# the GPU startup hook has to ask it too.
gpu_gles_ok() {
    [ -n "${DISPLAY:-}" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    python3 - <<'PY' 2>/dev/null
import ctypes, sys
try:
    egl = ctypes.CDLL("libEGL.so.1")
except OSError:
    sys.exit(1)
egl.eglQueryString.restype = ctypes.c_char_p
d = egl.eglGetDisplay(0)
if not d:
    sys.exit(1)
maj, mnr = ctypes.c_int(), ctypes.c_int()
if not egl.eglInitialize(d, ctypes.byref(maj), ctypes.byref(mnr)):
    sys.exit(1)
v = egl.eglQueryString(d, 0x3053)
v = v.decode() if v else ""
# Mesa answering means llvmpipe: a display, but software behind it, which is
# the trap this check exists to catch. Only a vendor driver counts.
if not v or "Mesa" in v:
    sys.exit(1)
print(v)
PY
}

# The serial of the running emulator, or empty. Matched by NAME, which is the
# only thing that actually distinguishes one.
#
# Not `adb -e`, which is the obvious answer and is wrong: adb means "the device
# on a local/TCP transport" by that, and a phone attached over wireless adb is
# exactly that. With a Pixel connected, `adb -e shell` reaches the Pixel and
# `adb -d` finds nothing at all. An emulator is emulator-NNNN; a wireless phone
# is IP:PORT; that difference is the test.
#
# `device` and not `offline`: an emulator appears in the list before it will
# answer, and treating the first sighting as ready is how `bb emu start` used
# to return before the thing had booted.
emu_serial() {
    adb devices 2>/dev/null \
        | awk '$1 ~ /^emulator-[0-9]+$/ && $2 == "device" { print $1; exit }'
}

# The project's node, from the same file the settings dialog writes; "" when
# none is set. Read here rather than asked of the dashboard, so `bb emu` can
# decide where it is going before it says anything.
project_node() {
    # ON the node, the answer is "here", which this spells as no node at all:
    # every caller then does the thing locally, which is what being on the
    # project's node means (roadmap #24).
    on_node && return 0
    local proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$proj" <<'PY' 2>/dev/null
import json, os, sys
try:
    d = json.load(open(os.path.join(os.environ["DASHBOARD_STATE"], "claude-prefs.json")))
    print((d.get("projects") or {}).get(sys.argv[1], {}).get("node") or "")
except (OSError, ValueError):
    print("")
PY
}

# bb emu on the project's node (docs/nodes.md phase 9): the same verb becomes
# a job there — the node runs this very bb from the bundle, with its own
# packages store as the SDK — and what it writes (a screenshot, a gfxinfo)
# comes back into dist/. `install FILE` sends the APK along from dist/.
emu_via_node() {
    local -a argv=("emu") files=()
    local a
    for a in "$@"; do argv+=("$a"); done
    if [ "${1:-}" = install ]; then
        local f="${2:-}"
        [ -n "$f" ] || die "bb emu install needs an APK in dist/"
        case "$f" in dist/*) ;; *) f="dist/${f#./}" ;; esac
        [ -f "$f" ] || die "${f} is not in this project's dist/ — the node fetches the APK from there"
        files=("$f"); argv=("emu" "install" "$(basename "$f")")
    fi
    local auth
    auth="$(bb_auth_or_die)"
    local proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    BB_EMU_FILES="$(printf '%s\n' "${files[@]}")" \
    python3 - "$auth" "$proj" "${argv[@]}" <<'PY'
import os, sys, time
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402
auth, proj, *argv = sys.argv[1:]
files = [f for f in os.environ.get("BB_EMU_FILES", "").split("\n") if f]
call = lambda path, body=None: bbapi.call(path, body, auth=auth)   # noqa: E731
r = call("/api/v1/jobs", {"action": "emu", "project": proj, "argv": argv, "files": files,
                          "outputs": ["*.png", "*.txt"],
                          "from": "session" if os.environ.get("CLAUDECODE") else "operator"})
if r.get("error"):
    sys.exit(f"[builderbot] ERROR: {r['error']}")
names = {n["id"]: n["name"] for n in (call("/api/v1/nodes").get("nodes") or [])}
print(f"[builderbot] {r['job']} — bb {' '.join(argv)} on {names.get(r['node'], r['node'])}", flush=True)
shown, state = 0, ""
while True:
    j = call(f"/api/v1/jobs?id={r['job']}")
    if j.get("error"):
        sys.exit(f"[builderbot] ERROR: {j['error']}")
    log = j.get("log") or ""
    if len(log) > shown:
        sys.stdout.write(log[shown:]); sys.stdout.flush(); shown = len(log)
    if j["state"] in ("succeeded", "failed", "canceled"):
        state = j["state"]; break
    time.sleep(1)
arts = [o["path"] for o in (j.get("outputs") or []) if o.get("kind") == "artifact"]
print(f"[builderbot] {r['job']} {state}" + (f" — {j['error']}" if j.get("error") else "")
      + (" — into dist/: " + ", ".join(a[5:] for a in arts) if arts else ""), flush=True)
sys.exit(0 if state == "succeeded" else (j.get("exit_code") or 1))
PY
}

cmd_emu() {
    local avd
    # On the project's node when it has one (docs/nodes.md phase 9) — the
    # emulator, the images and the GPU are that machine's. BB_EMU_LOCAL=1
    # keeps a verb here, for the box that still carries an emulator itself.
    if [ -z "${BB_EMU_LOCAL:-}" ] && [ -z "${BB_NODE_PACKAGES:-}" ] && [ -n "$(project_node)" ]; then
        emu_via_node "$@"
        return
    fi
    # A controller runs no emulator (roadmap #24, 10c): the image carries no
    # SDK, and a project with no node has nowhere to run one. Said plainly,
    # before `emulator: not found` could say it badly. BB_EMU_LOCAL=1 is
    # the escape hatch for a box that still carries one.
    if ! on_node && [ -z "${BB_EMU_LOCAL:-}" ] && [ -z "${BB_NODE_PACKAGES:-}" ]; then
        die "this project has no node, and the controller runs no emulator — bind a node in the project's settings dialog, and bb emu runs there"
    fi
    case "${1:-status}" in
        create)
            # An AVD for an API level: the system image and platform through
            # sdkmanager if they are not here, then avdmanager — on demand,
            # for a node whose store starts empty. The only way an image
            # arrives besides the Tools tab, since the baseline hook went.
            local api="${2:-}" pkg name
            [ -n "$api" ] || die "bb emu create <api> — the API level to build the AVD for"
            command -v sdkmanager >/dev/null 2>&1 || die "no sdkmanager here — install android-tools first"
            pkg="system-images;android-${api};google_apis;x86_64"
            name="$(emu_avd "$api")"
            if [ ! -d "${ANDROID_HOME:-/opt/android-sdk}/system-images/android-${api}/google_apis/x86_64" ]; then
                log "installing ${pkg} — a couple of GB, kept on the store"
                sdkmgr --install "$pkg" || die "could not install ${pkg}"
            fi
            [ -d "${ANDROID_HOME:-/opt/android-sdk}/platforms/android-${api}" ] \
                || sdkmgr --install "platforms;android-${api}" || warn "could not install platforms;android-${api}"
            if avd_exists "$name"; then log "AVD '${name}' already exists"; return 0; fi
            echo no | avdmanager create avd -n "$name" -k "$pkg" --device pixel_7 >/dev/null \
                || die "AVD creation failed for ${name}"
            log "AVD '${name}' ready — bb emu start ${api}"
            ;;
        install)
            local apk="${2:-}" serial
            [ -f "$apk" ] || die "bb emu install <apk> — not a file: ${apk:-?}"
            serial="$(emu_serial)"; [ -n "$serial" ] || die "no emulator is running — bb emu start first"
            adb -s "$serial" install -r "$apk"
            ;;
        shot)
            # A screenshot of the emulator's screen, into dist/ so the
            # Artifacts tab lists it and a node's copy returns the same way.
            local serial out="${2:-}"
            serial="$(emu_serial)"; [ -n "$serial" ] || die "no emulator is running — bb emu start first"
            [ -n "$out" ] || { mkdir -p dist/emu; out="dist/emu/shot-$(date +%Y%m%d-%H%M%S).png"; }
            adb -s "$serial" exec-out screencap -p > "$out" || die "screencap failed"
            log "screenshot: ${out}"
            ;;
        gfx)
            # Real per-frame timings for a package — dumpsys gfxinfo
            # framestats, which works under any renderer, where screenrecord
            # does not (CLAUDE.md's Android section says why).
            local pkg="${2:-}" serial out="${3:-}"
            [ -n "$pkg" ] || die "bb emu gfx <package> [FILE]"
            serial="$(emu_serial)"; [ -n "$serial" ] || die "no emulator is running — bb emu start first"
            [ -n "$out" ] || { mkdir -p dist/emu; out="dist/emu/gfx-${pkg}-$(date +%Y%m%d-%H%M%S).txt"; }
            adb -s "$serial" shell dumpsys gfxinfo "$pkg" framestats > "$out" || die "dumpsys gfxinfo failed"
            log "gfxinfo: ${out} ($(grep -c '^[0-9]' "$out" 2>/dev/null || echo 0) frames)"
            ;;
        start)
            command -v emulator >/dev/null 2>&1 \
                || die "no emulator in this node's packages store — tick android:emulator on the Tools tab with this node picked"
            if adb devices 2>/dev/null | grep -q '^emulator-'; then
                log "an emulator is already running"; adb devices; return 0
            fi
            avd="$(emu_avd "${2:-}")"
            avd_exists "$avd" \
                || die "AVD '${avd}' not found — bb emu create <api> builds one, and bb emu list shows what is here"
            [ -w /dev/kvm ] || warn "/dev/kvm not available — this will be very slow"
            # Software rendering by default. `-gpu host` does not work here
            # even with a GPU passed through and NVIDIA_DRIVER_CAPABILITIES=all:
            # the emulator finds the card for Vulkan and then fails at
            # "Failed to get EGL display", because NVIDIA's EGL wants a display
            # and this container has none. Bridging that needs an X server
            # (Xvfb) in EXTRA_APT_PACKAGES, which is the operator's call — so
            # the default stays software and says why rather than pretending.
            # What to render with. An explicit ANDROID_EMULATOR_GPU is obeyed
            # as given; otherwise the hardware path is *tested* rather than
            # assumed — 48-gpu-display starts an X server for the card at boot,
            # and if EGL answers on it with a vendor driver the emulator can
            # use the GPU. Anything else falls back to software, which is the
            # behaviour this box has always had.
            local gpu vendor
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                gpu="$ANDROID_EMULATOR_GPU"
            elif x_display_up && vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                gpu=host
                export DISPLAY="${DISPLAY:-:0}"
                log "hardware rendering: EGL answers on ${DISPLAY} (${vendor})"
            else
                gpu=swiftshader_indirect
            fi
            # Under a software GPU the guest has no DRM render node, so HWUI's
            # default Vulkan backend cannot initialise: the app draws, the view
            # hierarchy is complete, and every frame comes out blank. The guest
            # says so once in logcat — "E/MESA: Failed to open rendernode" — and
            # is otherwise silent about it, which is why this cost somebody a
            # day of thinking their own screen was broken.
            #
            # setprop from a shell fixes it and does not survive a reboot;
            # -prop sets it at boot, every boot. Only for the software modes:
            # with a real GPU the Vulkan backend is the faster one and should
            # be left alone.
            local hwui="${ANDROID_HWUI_RENDERER-skiagl}"
            local propargs=()
            case "$gpu" in
                swiftshader*|swangle*|guest|off)
                    [ -z "$hwui" ] || propargs=(-prop "debug.hwui.renderer=${hwui}") ;;
            esac
            # The log rotates rather than truncating. The emulator dies
            # silently under load — adb goes quiet, `bb emu stop` says there is
            # nothing to stop — and the only account of why is in the log the
            # *next* start used to overwrite before anybody could read it.
            if [ -s "$HOME/.android/emulator.log" ]; then
                mv -f "$HOME/.android/emulator.log" "$HOME/.android/emulator.log.1"
            fi
            log "starting AVD '${avd}' headless, -gpu ${gpu}${propargs:+, hwui ${hwui}} (log: bb emu log)"
            nohup emulator -avd "$avd" -no-window -no-audio -no-boot-anim \
                -gpu "$gpu" "${propargs[@]}" \
                > "$HOME/.android/emulator.log" 2>&1 &
            log "waiting for the device to come up..."
            # Bounded: a crashed emulator otherwise leaves this waiting forever
            # for a device that is never coming, with the reason sitting unread
            # in the log the timeout message points at.
            #
            # Waiting for THIS emulator, not for any device. A bare
            # wait-for-device is satisfied the instant it is asked when a phone
            # is attached over wireless adb, and this reported the emulator
            # ready before it had booted — a wrong answer rather than a missing
            # one, which is worse.
            local waited=0 serial=""
            while [ "$waited" -lt "${ANDROID_BOOT_TIMEOUT:-180}" ]; do
                serial="$(emu_serial)"
                [ -n "$serial" ] && break
                sleep 1; waited=$((waited + 1))
            done
            [ -n "$serial" ] \
                || die "the emulator did not appear within ${ANDROID_BOOT_TIMEOUT:-180}s — see ~/.android/emulator.log"
            log "emulator is up as ${serial}"
            adb devices
            ;;
        stop)
            # Named, for the same reason: without a serial this is "kill
            # whatever single device is attached", which with a phone connected
            # and no emulator is an emu command aimed at a handset.
            avd="$(emu_serial)"
            if [ -n "$avd" ]; then
                adb -s "$avd" emu kill 2>/dev/null || warn "emulator ${avd} did not stop"
            else
                warn "no emulator to stop"
            fi
            ;;
        status)
            # Everything attached, deliberately — a phone paired over wireless
            # adb shares this adb server, and knowing it is there is the point
            # when a command aimed at "the device" could mean either. The
            # emulator is the one named emulator-NNNN.
            adb devices -l
            ;;
        gpu)
            # "Which renderer would a start use, and why" — one command,
            # because the answer used to take an afternoon of reading logs.
            local v note
            if [ -n "${ANDROID_EMULATOR_GPU:-}" ]; then
                printf 'ANDROID_EMULATOR_GPU is set: %s (used as given)\n' "$ANDROID_EMULATOR_GPU"
            elif ! x_display_up; then
                printf 'software (swiftshader_indirect): no X display for the GPU\n'
                # What the startup hook last said about it. The display dying
                # hours into a boot used to be silent — the emulator went on
                # working, slower, and every timing conclusion after it was
                # wrong. The hook restarts it three times and then stops; this
                # is where it says which of those happened.
                note="$(gpu_display_note)"
                [ -n "${note:-}" ] && printf '  the startup hook says: %s\n' "$note"
                command -v Xorg >/dev/null 2>&1 \
                    || printf '  this image has no X server — the GPU path needs one (see 48-gpu-display)\n'
                command -v nvidia-smi >/dev/null 2>&1 \
                    && printf '  the card is here: %s\n' \
                       "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
            elif v="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
                printf 'hardware (-gpu host): EGL vendor %s on %s\n' "$v" "${DISPLAY:-:0}"
            else
                printf 'software (swiftshader_indirect): X is up but EGL gave no vendor driver\n'
                printf '  Mesa answering here means llvmpipe — software by a slower road\n'
            fi
            ;;
        log|logs)
            # This start's log, or the one before it. `-p` is the interesting
            # one: after a silent death, the previous log is the post-mortem,
            # and it is gone the moment somebody starts the emulator again.
            local f="$HOME/.android/emulator.log"
            [ "${2:-}" = "-p" ] || [ "${2:-}" = "--prev" ] && f="$f.1"
            [ -f "$f" ] || die "no emulator log at ${f}"
            tail -n "${3:-200}" "$f"
            ;;
        list)
            printf 'API levels with a system image here: %s\n' "$(emu_apis | paste -sd, - | sed 's/^$/none — bb emu create <api> installs one/')"
            printf 'default for `bb emu start`: %s\n\n' "$(emu_avd)"
            avdmanager list avd 2>/dev/null \
                | grep -E 'Name:|Based on:' \
                | sed 's/^ */  /' \
                || printf '  (no AVDs)\n'
            ;;
        *) usage; exit 1 ;;
    esac
}

# ---- what CI said, from inside the container -------------------------------
# The self-hosted runner streams a job's console output to GitHub and keeps
# none of it: /workspace/_work/_diag holds the runner's own diagnostics, which
# name the failing step and its exit code and never a line of what it printed.
# With no PAT there is no API to ask either, so "CI is red — why?" had no
# answer in here for a job that ran in this very container. The lint workflow
# tees each check into /config/ci-logs/<repo>/ and this reads it.
# Where CI logs are kept, resolved the same way the workflows resolve it:
# BB_CI_LOG_DIR first — on a node the agent sets it for jobs and sessions
# alike, and writes the same path into the runner's .env, so the archive is
# under the data store where the session account can read it — then /config
# on a controller because it survives an image update, then the home.
ci_log_dir() {
    if [ -n "${BB_CI_LOG_DIR:-}" ]; then printf '%s' "$BB_CI_LOG_DIR"
    elif [ -w /config ]; then printf '/config/ci-logs'
    else printf '%s/ci-logs' "$HOME"; fi
}

cmd_ci_log() {
    local dir; dir="$(ci_log_dir)"
    local proj="" want="" list=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --list|-l) list=1 ;;
            --project) proj="${2:-}"; shift ;;
            -*) die "unknown option: $1" ;;
            *) want="$1" ;;
        esac
        shift
    done
    # The project this is run from, the same way `bb roadmap` decides.
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one, or pass --project NAME"
    fi
    local d="$dir/$proj"
    if [ ! -d "$d" ] || [ -z "$(find "$d" -maxdepth 1 -name '*.log' -print -quit 2>/dev/null)" ]; then
        # Nothing here means the job ran somewhere else, which since the lint
        # and dashboard workflows moved onto a node is the ordinary case. The
        # log is on that machine, under the same two-step path this resolves,
        # and the way to reach a node is the job channel — audited, scoped,
        # already built — rather than a share or a second credential.
        if [ -n "$(project_node 2>/dev/null)" ]; then
            log "nothing kept here — asking ${proj}'s node"
            local remote='d="${BB_CI_LOG_DIR:-}"; [ -n "$d" ] || { [ -w /config ] \
                && d=/config/ci-logs || d="$HOME/ci-logs"; }; d="$d/'"$proj"'"'
            if [ "$list" = 1 ]; then
                cmd_run --timeout 300 -- sh -c "$remote"'
                    [ -d "$d" ] || { echo "no CI logs kept on this node either"; exit 0; }
                    ls -1t "$d"/*.log 2>/dev/null | while read -r f; do
                        printf "%s  %s\n" "$(basename "$f" .log)" \
                          "$(date -r "$f" "+%Y-%m-%d %H:%M")"; done'
            else
                cmd_run --timeout 300 -- sh -c "$remote"'
                    [ -d "$d" ] || { echo "no CI logs kept on this node either"; exit 0; }
                    want="'"$want"'"
                    if [ -n "$want" ]; then f="$(ls -1 "$d"/"$want"*.log 2>/dev/null | head -1)"
                    else f="$(ls -1t "$d"/*.log 2>/dev/null | head -1)"; fi
                    [ -n "$f" ] || { echo "no kept log for that run"; exit 0; }
                    cat "$f"'
            fi
            return 0
        fi
        log "no CI logs kept for ${proj}"
        log "only a job that runs on this box archives one, and only once the"
        log "workflow carrying the archive step has landed on the branch that ran"
        return 0
    fi
    # Newest first by mtime rather than by name: a re-run of an older run has a
    # lower id than a newer first attempt, so the number does not order them.
    local logs; mapfile -t logs < <(
        find "$d" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
    if [ "$list" = 1 ]; then
        echo "kept for ${proj}, newest first:"
        ci_log_rows "$d"
        return 0
    fi
    local pick="${logs[0]}"
    if [ -n "$want" ]; then
        pick=""
        local f
        for f in "${logs[@]}"; do
            case "$(basename "$f" .log)" in "$want"|"$want"-*) pick="$f"; break ;; esac
        done
        [ -n "$pick" ] || die "no kept log for run ${want} — try: bb ci-log --list"
    fi
    cat "$pick"
}

# ---- what has happened here lately -----------------------------------------
# A session's prompt carries the roadmap and the bug tracker — the project's
# STATE — and nothing whatever about its recent past. So a conversation that
# opens with "it finally built" or "is that still broken?" costs four or five
# calls to reconstruct by hand: git log, a git show per commit for the body
# that actually explains it, bb status for the image, a history per notebook
# tab. This is that reconstruction, once, on one screen.
#
# Deliberately a pull and not a ritual: the notebook is already paid for in
# every prompt on this project, and most conversations never ask about last
# week. Reach for it when the first message refers to history.

# project_here — the project directory this was run from, or nothing.
project_here() {
    local here; here="$(pwd -P)"
    case "$here" in
        "$WORKSPACE"/*) here="${here#"$WORKSPACE"/}"; printf '%s' "${here%%/*}" ;;
        *) return 1 ;;
    esac
}

# trim_line TEXT — one line, capped so that a screen stays a screen. Counted in
# characters and not bytes: bash slices by character in this image's UTF-8
# locale, and the text being cut here is full of em dashes.
trim_line() {
    local t="$1" w="${2:-72}"
    if [ "${#t}" -gt "$w" ]; then
        printf '%s…' "${t:0:$((w - 1))}"
    else
        printf '%s' "$t"
    fi
}

# ci_log_rows DIR [LIMIT] — one line per archived CI run, newest first.
#
# Newest by mtime rather than by name: a re-run of an older run carries a lower
# id than a newer first attempt, so the number does not order them. The
# workflow's name comes off the header line because two workflows archive here
# now — the lint job and the image build's outcome — and a list that cannot
# tell them apart is a list of numbers.
ci_log_reason() {
    # The first thing that went wrong in an archived run, and which check it
    # was under. A row that says only "failure" is easy to scroll past — which
    # is how twelve consecutive red lint runs went unnoticed here, taking the
    # deterministic linters' signal down with them.
    awk '
        /^\[builderbot\] == / {
            sec = $0
            sub(/^\[builderbot\] == /, "", sec)
            sub(/ ==[ \t]*$/, "", sec)
            next
        }
        /Timeout [0-9]+ms exceeded/ || /^[ \t]*\[FAIL\]/ \
            || /^\[builderbot\] ERROR:/ || /^[ \t]*throw new Error/ \
            || /: error:/ || /^Error:/ {
            line = $0
            sub(/^[ \t]+/, "", line)
            if (sec != "") printf "%s: ", sec
            print line
            exit
        }
    ' "$1" 2>/dev/null | head -1
}


ci_log_rows() {
    local d="$1" limit="${2:-0}" rows f reason
    [ -d "$d" ] || return 0
    rows="$(find "$d" -maxdepth 1 -name '*.log' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn | cut -d' ' -f2-)"
    [ -n "$rows" ] || return 0
    if [ "$limit" -gt 0 ]; then
        rows="$(printf '%s\n' "$rows" | head -n "$limit")"
    fi
    local result
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        # No result line means the closing step never ran — the job was killed
        # rather than finished, which on this box usually means the container
        # updated underneath it. Say so: a blank column reads like a bug in
        # this listing, and it is the opposite, a job whose end never happened.
        result="$(sed -n 's/^result: //p' "$f" | head -1)"
        printf '  %-20s %s  %-12s %s\n' "$(basename "$f" .log)" \
            "$(date -r "$f" '+%d %b %H:%M')" \
            "$(sed -n '1s/^# \(.*\) — .*/\1/p' "$f")" \
            "${result:-(unfinished)}"
        # ...and why, when it is not a success. Which check failed and what it
        # said is the difference between a row somebody chases and a row
        # somebody scrolls past.
        if [ "${result:-}" != success ]; then
            reason="$(ci_log_reason "$f")"
            if [ -n "$reason" ]; then
                printf '  %-20s %s\n' "" "↳ $(trim_line "$reason" 88)"
            fi
        fi
    done <<< "$rows"
}

cmd_catchup() {
    local since="7d" n=8 gsince
    while [ $# -gt 0 ]; do
        case "$1" in
            --since) since="${2:-7d}"; shift ;;
            -n|--last) n="${2:-8}"; shift ;;
            *) die "usage: bb catchup [--since 7d] [-n COMMITS]" ;;
        esac
        # `|| break` because the option branches above have already consumed
        # their value: `bb catchup --since` with nothing after it would
        # otherwise shift an empty list and die under `set -e`.
        shift || break
    done
    case "$n" in ''|*[!0-9]*) die "-n takes a number" ;; esac
    # git understands "7 days ago" and not "7d"; the notebook's logs take "7d"
    # and a date. Accept the notebook's spelling and translate for git.
    case "$since" in
        [0-9]*d) gsince="${since%d} days ago" ;;
        *) gsince="$since" ;;
    esac

    echo "== this box =="
    printf '  %-9s %s\n' image "$(
        if [ -n "${BB_IMAGE_REV:-}" ]; then
            printf '%.7s%s' "$BB_IMAGE_REV" "${BB_IMAGE_BUILT:+ (built $BB_IMAGE_BUILT)}"
        else
            printf 'unstamped — built outside CI'
        fi)"
    printf '  %-9s %s\n' version "${BB_VERSION:-unstamped}"
    # The ledger the entrypoint keeps. Its last few lines answer "when did this
    # box change image, and what was it on before" — which is most of what
    # "your fix is not working" turns out to be.
    local ledger; ledger="$(bb_image_log)"
    if [ -s "$ledger" ]; then
        while IFS=$'\t' read -r seen rev ver _built; do
            case "$seen" in '#'*|'') continue ;; esac
            printf '  %-9s %.7s  %-24s %s\n' ran "$rev" "$ver" \
                "since $(date -d "$seen" '+%d %b %H:%M' 2>/dev/null || printf '%s' "$seen")"
        done < <(grep -v '^#' "$ledger" | tail -3)
    else
        printf '  %-9s %s\n' ran "no ledger yet — this image predates it, or /config is not mounted"
    fi

    if git rev-parse --git-dir >/dev/null 2>&1; then
        # Remote-tracking refs go stale, and "level with main" read off a
        # week-old fetch is worse than no answer. Bounded and silent: a project
        # with no reachable remote should still get the rest of the screen.
        if git remote get-url origin >/dev/null 2>&1; then
            timeout 10 env GIT_TERMINAL_PROMPT=0 git fetch --quiet --no-tags origin \
                >/dev/null 2>&1 || true
        fi
        # Only meaningful where this checkout IS the image's source: elsewhere
        # the container's commit belongs to another repo entirely, and the
        # question answers itself by the rev being unknown here.
        if [ -n "${BB_IMAGE_REV:-}" ] && git cat-file -e "${BB_IMAGE_REV}^{commit}" 2>/dev/null; then
            local main behind
            main="$(git rev-parse --verify -q origin/main >/dev/null 2>&1 && echo origin/main || echo '')"
            if [ -n "$main" ] && git merge-base --is-ancestor "$BB_IMAGE_REV" "$main" 2>/dev/null; then
                behind="$(git rev-list --count "${BB_IMAGE_REV}..${main}" 2>/dev/null || echo '?')"
                if [ "$behind" = 0 ]; then
                    printf '  %-9s %s\n' serving "origin/main exactly — what is merged is what is running"
                else
                    # Being behind only matters if the missing commits are ones
                    # the image is BUILT from — the paths build-image.yml
                    # triggers on. Three merged doc commits leave the code in
                    # here current, and saying only "3 behind" sends somebody
                    # to `bb drift` to find that out.
                    local moved_inputs
                    moved_inputs="$(git diff --name-only "${BB_IMAGE_REV}..${main}" -- \
                        Dockerfile .dockerignore scripts config \
                        .github/workflows/build-image.yml 2>/dev/null | head -1)"
                    if [ -n "$moved_inputs" ]; then
                        printf '  %-9s %s\n' serving "$behind commit(s) behind origin/main, and they change the image — what is merged is NOT what is running"
                    else
                        printf '  %-9s %s\n' serving "$behind commit(s) behind origin/main, none of them image inputs — the code in here is current"
                    fi
                fi
            else
                printf '  %-9s %s\n' serving "an image built from a commit that is not on origin/main"
            fi
        fi

        local br up ahead behind dirty untracked
        br="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
        up="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
        if [ -n "$up" ]; then
            read -r ahead behind < <(git rev-list --left-right --count "HEAD...${up}" 2>/dev/null || echo "0 0")
            printf '  %-9s %s\n' branch "$br — ${ahead} ahead / ${behind} behind ${up}"
        else
            printf '  %-9s %s\n' branch "$br — no upstream"
        fi
        # And where it stands against MAIN, which is the half that decides
        # whether there is anything here to finish. "0 ahead / 0 behind its own
        # remote" reads as live work when the work is in fact merged and the
        # branch is parked — and a branch name reused across many PRs carries
        # nothing else to tell those apart.
        local mainref nahead
        mainref="$(git rev-parse --verify -q origin/main >/dev/null 2>&1 \
                   && echo origin/main || true)"
        if [ -n "$mainref" ] && [ "$br" != main ] && [ "$br" != '-' ]; then
            nahead="$(git rev-list --count "${mainref}..HEAD" 2>/dev/null || echo '?')"
            if [ "$nahead" = 0 ]; then
                printf '  %-9s %s\n' "vs main" "already in $mainref — nothing here is unmerged"
            else
                printf '  %-9s %s\n' "vs main" "$nahead commit(s) not in $mainref"
            fi
        fi
        dirty="$(git status --porcelain 2>/dev/null | grep -cv '^??' || true)"
        untracked="$(git status --porcelain 2>/dev/null | grep -c '^??' || true)"
        if [ "$dirty" = 0 ] && [ "$untracked" = 0 ]; then
            printf '  %-9s %s\n' tree "clean"
        else
            printf '  %-9s %s\n' tree "${dirty} changed, ${untracked} untracked — uncommitted work is here"
        fi

        echo
        echo "== commits since ${since} (merges omitted) =="
        # The subject says what changed; the first line of the body says why,
        # and in this repo that line is usually the most valuable thing a cold
        # session can read. --oneline throws it away, which is why this does
        # not use it.
        local rec sha day subj body line found=0
        while IFS= read -r -d $'\x1e' rec; do
            # tformat puts a newline after each record, so every record but the
            # first arrives with the previous one's line ending on the front.
            rec="${rec#$'\n'}"
            [ -n "$rec" ] || continue
            found=1
            sha="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            day="${rec%%$'\x1f'*}"; rec="${rec#*$'\x1f'}"
            subj="${rec%%$'\x1f'*}"; body="${rec#*$'\x1f'}"
            printf '  %-6s  %-7s  %s\n' "$day" "$sha" "$(trim_line "$subj")"
            while IFS= read -r line; do
                case "$line" in
                    '') continue ;;
                    # Trailers are not why anything happened, and on a one-line
                    # commit they are the whole of %b.
                    [Cc]o-[Aa]uthored-[Bb]y:*|[Ss]igned-off-by:*|Claude-Session:*|http*) continue ;;
                esac
                printf '  %-6s  %-7s  %s\n' "" "" "$(trim_line "$line")"
                break
            done <<< "$body"
        done < <(git log --no-merges -n "$n" --since="$gsince" \
                     --date=format:'%d %b' \
                     --pretty=tformat:'%h%x1f%ad%x1f%s%x1f%b%x1e' 2>/dev/null)
        [ "$found" = 1 ] || echo "  nothing committed here in that window"
    fi

    local proj; proj="$(project_here || true)"
    if [ -n "$proj" ]; then
        echo
        echo "== the notebook =="
        # Its own log, not the tabs' contents: the open items are already in a
        # session's prompt, and what is missing from there is what MOVED.
        # One line per change, trimmed. `bb history` prints an entry's whole
        # text — which for a roadmap `info` is a page — and three of those is
        # the screen this command exists to be.
        local moved
        # -n is generous because the filter below throws lines away, and a
        # section starved to two rows is worse than one that scrolls.
        moved="$(cmd_history --since "$since" -n 24 2>/dev/null | while IFS= read -r line; do
                     case "$line" in
                         '  '[0-9][0-9]' '[A-Za-z][A-Za-z][A-Za-z]' '*) ;;
                         *) continue ;;
                     esac
                     # A roadmap `add` or `info` is already in the session's
                     # prompt verbatim — the whole open list is — so printing
                     # it here charges for it twice. What is NOT in the prompt
                     # is an item that has LEFT the list, which is exactly what
                     # `done` and `dropped` are, and they are the roadmap moves
                     # a cold session cannot otherwise discover. Bugs and
                     # memories stay whatever they did: neither arrives whole.
                     if [[ "$line" =~ ^\ \ [0-9]{2}\ [A-Za-z]{3}\ [0-9]{2}:[0-9]{2}\ \ roadmap\ \ [^\ ]+\ \ (add|info|edit)\  ]]; then
                         continue
                     fi
                     printf '%s\n' "$(trim_line "$line" 108)"
                 # sed, not head: head closes the pipe as soon as it has its
                 # eight lines and the loop above dies of SIGPIPE, taking the
                 # whole command out with rc=141 under `set -e`.
                 done | sed -n '1,8p')"
        if [ -n "$moved" ]; then
            printf '%s\n' "$moved"
            echo "  ('bb history' for these in full — the text is cut short here)"
        else
            echo "  nothing moved in that window"
        fi

        echo
        echo "== builds this box archived =="
        local dir rows; dir="$(ci_log_dir)/$proj"
        rows="$(ci_log_rows "$dir" 5)"
        if [ -n "$rows" ]; then
            printf '%s\n' "$rows"
            echo "  ('bb ci-log RUN' for one in full)"
        elif [ -n "$(project_node 2>/dev/null)" ]; then
            # CI runs on the project's node now, so the records are there.
            # Not fetched here: catchup is read often and a job per read is
            # the wrong price for a summary. bb ci-log goes and gets them.
            echo "  none kept here — CI runs on this project's node, so its"
            echo "  records are there: 'bb ci-log --list' fetches them"
        else
            echo "  none kept — only a job that runs on this box archives one"
        fi
    fi
}

# On a node there is no container to have booted, so naming the controller's
# /config path here reads as a broken install rather than as the wrong
# machine. Says nothing at all on the controller, where the path is right.
logs_are_the_controllers() {
    on_node || return 0
    die "there is no container log here — this is a node, and that log is the" \
        "controller's. \`bb ci-log\` reads a CI run's output on this machine"
}

cmd_logs() {
    local base logfile follow=0 lines=100 gen=""
    base="$(bb_log_dir)/builderbot.log"
    while [ $# -gt 0 ]; do
        case "$1" in
            -f) follow=1 ;;
            -l|--list)
                # Every stream, newest first, so the top of the list is this
                # boot. It used to list only builderbot.log's generations,
                # which made the other three — the dashboard, docker and ttyd,
                # all of which rotate the same way now — look like they did not
                # exist.
                if ! ls -1t "$(bb_log_dir)"/*.log "$(bb_log_dir)"/*.log.[0-9]* 2>/dev/null; then
                    logs_are_the_controllers
                    die "no logs in $(bb_log_dir)"
                fi
                return 0
                ;;
            -p|--prev)
                # The log rotates per container start, so generation N is the
                # Nth boot back. Bare -p means the previous one.
                case "${2:-}" in
                    ''|*[!0-9]*) gen=1 ;;
                    *) gen="$2"; shift ;;
                esac
                ;;
            *[0-9]*) lines="$1" ;;
        esac
        shift
    done
    if [ -n "$gen" ]; then
        logfile="${base}.${gen}"
    else
        logfile="$base"
    fi
    if [ ! -f "$logfile" ]; then
        logs_are_the_controllers
        die "no log at ${logfile} — see: bb logs --list"
    fi
    if [ "$follow" -eq 1 ]; then
        tail -n "$lines" -f "$logfile"
    else
        tail -n "$lines" "$logfile"
    fi
}

# Overridable for one reason: developing the template itself. `bb claude-md`
# compares a project against the image's copy, which is right everywhere except
# in a checkout of this repo, where the template being edited is the one under
# config/templates. The dashboard's server has had the same override for the
# same reason (its tests point it at a checkout).
TEMPLATE_MD="${TEMPLATE_MD:-/opt/builderbot/templates/project-CLAUDE.md}"
ENV_BEGIN='<!-- BUILDERBOT:ENV:BEGIN -->'
ENV_END='<!-- BUILDERBOT:ENV:END -->'

# Print the marked environment block of a file, markers included.
md_block() { awk -v b="$ENV_BEGIN" -v e="$ENV_END" \
    'index($0,b){f=1} f{print} index($0,e){exit}' "$1"; }

# Keep a project's CLAUDE.md environment section in step with the image.
#
# The block is delimited so refreshing it is a substitution rather than a
# judgment call: everything below the end marker is the project's own and is
# never read, compared or written. That is the whole point — the environment
# notes go stale every time the container gains a feature, and the project
# notes are the expensive part nobody wants to risk.
cmd_claude_md() {
    local mode=check target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --update) mode=update ;;
            --init)   mode=init ;;
            --check)  mode=check ;;
            --is-stale) mode=is-stale ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-$PWD/CLAUDE.md}"

    # `--is-stale` is the question a gate asks, and the only mode that answers
    # with its exit code alone: 0 when this project's block EXISTS and differs
    # from the image's, which is the one state `--update` can fix in a click —
    # so it is the one state worth refusing a session over (bb-tty, and the
    # ghosted button beside it). Everything else exits 1 and says nothing: no
    # template to compare against, no CLAUDE.md at all (that is `--init`, and
    # the operator's decision), and a file predating the markers (`--update`
    # refuses that one, so blocking on it would strand somebody with no fix
    # to press). Silent on purpose — a caller wanting the words runs the
    # plain check, which prints them and a diff.
    if [ "$mode" = is-stale ]; then
        [ -f "$TEMPLATE_MD" ] && [ -f "$target" ] || return 1
        grep -qF "$ENV_BEGIN" "$target" && grep -qF "$ENV_END" "$target" || return 1
        ! cmp -s <(md_block "$TEMPLATE_MD") <(md_block "$target")
        return
    fi

    [ -f "$TEMPLATE_MD" ] || die "no template at ${TEMPLATE_MD} — is this an older image?"

    if [ ! -f "$target" ]; then
        if [ "$mode" = init ]; then
            cp "$TEMPLATE_MD" "$target"
            log "created ${target} — fill in the project section below the end marker"
            return 0
        fi
        die "no ${target}. Create one with: bb claude-md --init"
    fi

    if ! grep -qF "$ENV_BEGIN" "$target" || ! grep -qF "$ENV_END" "$target"; then
        warn "${target} has no BUILDERBOT:ENV markers"
        warn "It predates them, so which part is environment and which is yours"
        warn "cannot be determined safely. Merge once by hand — or ask Claude to —"
        warn "putting the block from ${TEMPLATE_MD} above your project section."
        return 1
    fi

    local tmp_new tmp_cur
    tmp_new="$(mktemp)"; tmp_cur="$(mktemp)"
    # shellcheck disable=SC2064 # expand the paths now, not at trap time
    trap "rm -f '$tmp_new' '$tmp_cur'" RETURN
    md_block "$TEMPLATE_MD" > "$tmp_new"
    md_block "$target"      > "$tmp_cur"

    if cmp -s "$tmp_new" "$tmp_cur"; then
        log "${target}: environment block is current"
        return 0
    fi

    if [ "$mode" != update ]; then
        log "${target}: environment block differs from the image's template"
        diff -u --label "$target" --label "$TEMPLATE_MD" "$tmp_cur" "$tmp_new" || true
        log "refresh just that block with: bb claude-md --update"
        return 0
    fi

    local out; out="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp_new' '$tmp_cur' '$out'" RETURN
    awk -v b="$ENV_BEGIN" -v e="$ENV_END" -v repl="$tmp_new" '
        index($0,b) { while ((getline line < repl) > 0) print line; skip=1; next }
        index($0,e) { skip=0; next }
        !skip       { print }
    ' "$target" > "$out"

    grep -qF "$ENV_END" "$out" || die "refused to write: the result lost its end marker"
    cat "$out" > "$target"
    log "${target}: environment block updated; your project section is untouched"
}

# Reduce a SARIF report to grouped markdown.
#
# This reads scan output and nothing else. The scanner itself lives outside the
# container on purpose — /reports is mounted read-only and no scanner binary is
# installed — so there is no way to start a scan from in here, by design. If the
# findings look stale, the fix is to re-run the scanner on the host.
#
# Raw SARIF is mostly metadata: a few hundred KB of it would fill a session's
# context before it reached the code the findings are about. Grouping by
# severity then rule, and listing bare locations under one message, keeps the
# same information at a fraction of the size.
FINDINGS_JQ='
def parts($p): ($p | ltrimstr("/") | split("/"));

# Everything up to and including the project directory is where the scanner
# saw the code, not where this container mounts it. Dropping that prefix makes
# the path openable from the project root.
def strip_path($p): parts($p) as $ps
  | ($ps | index($proj)) as $i
  | if $i != null then ($ps[($i + 1):] | join("/")) else ($ps | join("/")) end;

def rank: {"error":0, "warning":1, "note":2, "info":2, "none":3}[.] // 4;

[ .runs[]
  | (reduce ((.tool.driver.rules // [])[]) as $x
      ({}; .[$x.id] = { level: ($x.defaultConfiguration.level // "warning"),
                        desc:  ($x.shortDescription.text // $x.fullDescription.text // "") })) as $rules
  | .results[]?
  | (.locations[0].physicalLocation.artifactLocation.uri // "?") as $uri
  | { level: (.level // $rules[.ruleId].level // "warning"),
      rule:  (.ruleId // "unknown"),
      # The rule description beats the result message as a group heading. Some
      # tools (Trivy) put the artifact path on the message first line, so the
      # heading would name one file while the group lists several.
      msg:   ( if ($rules[.ruleId].desc // "") != "" then $rules[.ruleId].desc
               else ((.message.text // "") | split("\n")[0]) end ),
      mine:  ((parts($uri) | index($proj)) != null),
      # First two components identify the tree a finding came from, which is
      # what you need when the answer is "that is a different project".
      tree:  (parts($uri)[0:2] | join("/")),
      loc:   ( strip_path($uri)
               + ":" + ((.locations[0].physicalLocation.region.startLine // 0) | tostring) ) } ]
| . as $all
| (if $scope == "all" then $all else map(select(.mine)) end) as $scoped
# The same three narrowings the dashboard bar offers. note and info are one
# level everywhere here (rank already merges them), so --level note takes both.
| ($scoped
   | (if $level == "" then . else
        map(select(if $level == "note" or $level == "info"
                   then (.level == "note" or .level == "info")
                   else .level == $level end)) end)
   | (if $rule == "" then . else
        ($rule | ascii_downcase) as $r
        | map(select((.rule | ascii_downcase) == $r)) end)
   | (if $find == "" then . else
        ($find | ascii_downcase) as $q
        | map(select((.rule + " " + .loc + " " + .msg)
                     | ascii_downcase | contains($q))) end)) as $rows
| ($rows | length) as $n
| ($level != "" or $rule != "" or $find != "") as $filtered
| if ($all | length) == 0 then "No findings.\n"
  elif $n == 0 and $filtered and ($scoped | length) > 0 then
    "No findings match the filters — \($scoped | length) before filtering.\n"
  elif $n == 0 then
    "No findings for \($proj). This report covers: "
    + (($all | map(.tree) | unique | join(", ")))
    + "\nRun with --all to see them anyway.\n"
  else
  ( "# Findings (\($n)\(if $filtered then " matching, of \($scoped | length)" else "" end))"
  + (if $scope == "all" then " — all projects in this report\n"
     else " in \($proj), of \($all | length) in the report — --all for the rest\n" end)
  + ( $rows | group_by(.level) | sort_by(.[0].level | rank)
      | map( "\n## \(.[0].level) (\(length))\n"
             + ( group_by(.rule) | sort_by(-length)
                 | map( "\n### \(.[0].rule) (\(length))\n\(.[0].msg)\n"
                        + ( map("- \(.loc)") | unique | join("\n") ) + "\n" )
                 | join("") ) )
      | join("") ) )
  end'

# The shared to-do list, from a session's side. Same file the dashboard writes
# (/config/todos.json) and the same module reads it — one implementation, so a
# list edited from a phone and a list edited from a terminal cannot disagree.
#
# The project is the directory this is run in, not an argument: a session is
# already in its project, and asking it to name one is asking it to get one
# wrong.
cmd_roadmap() {
    local py
    # todo.py, still: the file is where the roadmap has always been implemented
    # and renaming it would move code the running image serves by absolute
    # path. The command is what the operator reads, and that is `bb roadmap`.
    py="$(dirname "$(readlink -f "$0")")/dashboard/todo.py"
    [ -f "$py" ] || die "todo.py is missing from this image"
    local proj="${BB_ROADMAP_PROJECT:-${BB_TODO_PROJECT:-}}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, sys, time

spec = importlib.util.spec_from_file_location("todo", sys.argv[1])
todo = importlib.util.module_from_spec(spec)
spec.loader.exec_module(todo)

# The atomic write, from the module beside it rather than a copy per heredoc.
# There were five, all still using a fixed <name>.tmp — the exact collision the
# server's copy was changed away from — and statefile.py carries the file lock
# that stops this process and the dashboard losing each other's writes.
_sfs = importlib.util.spec_from_file_location(
    "statefile", __import__("os").path.join(
        __import__("os").path.dirname(__import__("os").path.abspath(sys.argv[1])),
        "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
write_json = statefile.write_json




import os
_state = os.environ.get("DASHBOARD_STATE", "/config")
todo.configure(write_json=write_json, state=_state)

# The tracker's half of a notebook batch. A batch spans both files, so the
# roadmap's begin/commit/revert have to reach the tracker as well — loaded
# beside todo.py rather than imported, for the same reason todo.py is: this
# has to be the copy sitting next to the script that was actually run.
_here = os.path.dirname(sys.argv[1])
_bugs = importlib.util.module_from_spec(
    importlib.util.spec_from_file_location("bugs", os.path.join(_here, "bugs.py")))
_bugs.__loader__.exec_module(_bugs)
_bugs.configure(write_json=write_json, state=_state)
_nb = importlib.util.module_from_spec(
    importlib.util.spec_from_file_location("notebook", os.path.join(_here, "notebook.py")))
_nb.__loader__.exec_module(_nb)
_nb.configure(todo_mod=todo, bugs_mod=_bugs)

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]

# todo.py put its own directory on sys.path, so the id module beside it is
# importable here the way it is inside the dashboard — and the approval
# queue (roadmap #27), which todo.configure already set up.
import ids  # noqa: E402
import pending  # noqa: E402


def held_line(r, what="it"):
    """What a session is told when its add was held for the operator."""
    h = r["held"]
    tag = R(h["number"]) if h.get("number") is not None else "it"
    return (f"held for approval as {tag} — {what} lands on the roadmap when the "
            "operator approves it on the notebook. `bb roadmap pending` lists "
            "what is waiting; you are told on a later turn what they decided")


def behind(n, verb, args, summary):
    """A follow-up aimed at a number that is still waiting for approval.

    info, step add and edit ride behind the held add and land after it;
    anything else on a held item is refused, because there is nothing to
    tick, drop or move yet. Returns True when the call was dealt with here.
    """
    rec = pending.held(proj, "roadmap", n)
    if rec is None:
        return False
    if verb is None:
        print(f"[builderbot] ERROR: {R(n)} is still waiting for the operator's "
              "approval — there is nothing to change yet. `bb roadmap pending`",
              file=sys.stderr)
        sys.exit(1)
    r = pending.hold(proj, "roadmap", verb, args, summary, number=n, after=rec["id"])
    bail(r)
    print(f"held behind {R(n)} — it lands with that item when the operator "
          "approves it, and goes if they deny it")
    return True


def R(n):
    return ids.label("todo", n) if n is not None else ""


def ident(word):
    """The item a verb was given, checked before anything is looked up.

    `bb roadmap done 12` and `bb roadmap done R12` both work; `bb roadmap
    done B12` stops here with a sentence saying B12 is a bug — the letter is
    a check, not decoration (ids.py). The number goes on as an int so every
    module call and every message below prints it the same way.
    """
    n, err = ids.parse("todo", word)
    if err:
        print(f"[builderbot] ERROR: {err}", file=sys.stderr)
        sys.exit(1)
    if n is None:
        print(f"[builderbot] ERROR: not a roadmap item: {word!r} — they are "
              "numbered R1, R2, ...", file=sys.stderr)
        sys.exit(1)
    return n


def show():
    rows = todo.items(proj)
    # The whole notebook's count, not the roadmap's: one batch covers both,
    # and a banner reporting half of it would read as "nothing much staged"
    # while a dozen tracker changes sat unrecorded.
    b = _nb.state(proj)
    if b:
        print(f"  [batch open — {b['changes']} change"
              f"{'' if b['changes'] == 1 else 's'} unrecorded across this "
              "notebook; bb roadmap commit, or revert]")
    if not rows:
        print(f"nothing on {proj}'s list")
        return
    for r in rows:
        # No done column: everything here is outstanding by construction, and
        # a box that is never ticked is a column of nothing. Shelved is worth
        # a column, because it is the one state that changes whether a line is
        # asking for anything.
        who = " (claude)" if r.get("by") == "claude" else ""
        mark = "~" if r.get("shelved") else " "
        print(f" {mark}{R(r['id']):>4}  {r['text']}{who}"
              + ("  [shelved]" if r.get("shelved") else ""))
        if r.get("info"):
            print("       details: " + r["info"].replace("\n", "\n                "))
        for i, st in enumerate(r.get("steps") or []):
            print(f"          {i + 1}. {st['text']}"
                  + ("  (done)" if st.get("done") else "  (sent)" if st.get("sent") else ""))
            if st.get("info"):
                print("             details: "
                      + st["info"].replace("\n", "\n                      "))


def bail(r):
    if r.get("error"):
        print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr)
        sys.exit(1)


# Which seat this session sits in, for the two questions roadmap #26 and #27
# both need answered: has this list moved since I last looked at it, and was
# it me who moved it. Empty for a bb run from a plain shell, which then gets
# the old behaviour — no check, because there is nothing to check against.
_who = os.environ.get("BB_ACCOUNT_UID", "")


def fresh():
    """Refuse to write over words this session has not read.

    The exposure is not two writes landing at once — those are per field and
    under a lock. It is that a session read the roadmap when it started, the
    operator reworded an item an hour later, and the session then rewrites
    that item from the copy in its context. Nothing tells either of them.

    So: if the list has moved since this session was last told about it,
    say so and stop. There is no --force, deliberately. Re-reading is one
    command and clears the block, which makes the honest path the short one;
    a flag would make the dishonest path shorter.
    """
    if todo.stale(proj, _who):
        print("[builderbot] ERROR: the roadmap has changed since you last read "
              "it — run `bb roadmap` and make this change against what it says "
              "now", file=sys.stderr)
        sys.exit(2)


if op in ("list", "ls"):
    show()
    # Read, so what arrives on the next prompt is what has moved SINCE this —
    # and so the guard above stops holding a session that has just looked.
    todo.mark_seen(proj, _who, "todo")
elif op == "show":
    # One item in full: its details, its steps and theirs. `list` cannot carry
    # this without becoming unreadable, and a session working item N wants
    # exactly N — the same reason `bb bug show` exists.
    if not rest:
        print("usage: bb roadmap show <n>", file=sys.stderr); sys.exit(1)
    n = ident(rest[0])
    r = next((x for x in todo.items(proj) if x.get("id") == n), None)
    if r is None:
        print(f"[builderbot] ERROR: no item {R(n)} here", file=sys.stderr)
        sys.exit(1)
    who = " (claude)" if r.get("by") == "claude" else ""
    print(f"  {R(r['id'])}  {r['text']}{who}"
          + ("  [shelved]" if r.get("shelved") else ""))
    if r.get("info"):
        print("  details: " + r["info"].replace("\n", "\n           "))
    for i, st in enumerate(r.get("steps") or []):
        print(f"    {i + 1}. {st['text']}"
              + ("  (done)" if st.get("done") else "  (sent)" if st.get("sent") else ""))
        if st.get("info"):
            print("       details: " + st["info"].replace("\n", "\n                "))
    todo.mark_seen(proj, _who, "todo")
elif op == "--prompt":
    sys.stdout.write(todo.prompt(proj))
elif op == "add":
    # `bb roadmap add "title" --step "..." --step "..."` — a change that needs
    # things done in an order is one item with steps, not several items that
    # can be handed over backwards.
    words, steps, i = [], [], 0
    while i < len(rest):
        if rest[i] == "--step":
            # A dangling --step used to fall through and become part of the
            # title, so `bb roadmap add "x" --step` quietly made an item called
            # "x --step" instead of saying what was missing.
            if i + 1 >= len(rest):
                print("[builderbot] ERROR: --step needs the step after it",
                      file=sys.stderr)
                sys.exit(1)
            steps.append(rest[i + 1]); i += 2
        else:
            words.append(rest[i]); i += 1
    r = todo.add(proj, " ".join(words).strip(), by="claude", steps=steps,
                 who=_who); bail(r)
    if r.get("held"):
        print(held_line(r)); sys.exit(0)
    n = len(r["item"]["steps"])
    print(f"added {R(r['item']['id'])}: {r['item']['text']}"
          + (f" ({n} steps)" if n else ""))
elif op == "done":
    # Off the list and into the log. There is no undoing it: a list is read to
    # find out what is left, so nothing finished stays on it, and the history
    # is where the words live afterwards.
    if not rest:
        print("usage: bb roadmap done <n>", file=sys.stderr); sys.exit(1)
    n = ident(rest[0]); behind(n, None, None, None); fresh()
    r = todo.tick(proj, n, by="claude", who=_who); bail(r)
    print(f"done {R(n)}: {r['item']['text']}")
elif op in ("rm", "remove"):
    # The reason rides with the deletion. Nothing here can be undone, so the
    # only thing that stops the next reader putting it straight back is a note
    # saying why it went.
    if not rest:
        print("usage: bb roadmap rm <n> [\"why it is going\"]", file=sys.stderr); sys.exit(1)
    n = ident(rest[0]); behind(n, None, None, None); fresh()
    r = todo.remove(proj, n, by="claude", why=" ".join(rest[1:]),
                    who=_who); bail(r)
    print(f"removed {R(n)}")
elif op in ("begin", "commit", "revert"):
    # Working something out is not a series of decisions the operator has to
    # read; it is arriving at one. The work still lands as it happens — hiding
    # it would be worse than a noisy log — but the record is written once, at
    # commit, saying what changed rather than every step of getting there.
    #
    # One batch over the WHOLE notebook: the roadmap and the tracker both.
    # A plan usually moves because of what the tracker now says, and letting
    # one be committed while the other is reverted would leave a roadmap
    # describing work against a tracker that never recorded why.
    if op == "begin":
        bail(_nb.begin(proj))
        print(f"batch open on {proj}'s notebook — the roadmap and the bug "
              "tracker both. Commit or revert it")
    elif op == "commit":
        r = _nb.commit(proj); bail(r)
        print(f"committed: {r['written']} entr{'y' if r['written'] == 1 else 'ies'}"
              + (f", {r['folded']} folded into them" if r["folded"] else ""))
    else:
        r = _nb.revert(proj); bail(r)
        print(f"reverted: the roadmap and the tracker are back as they were, "
              f"{r['dropped']} change{'' if r['dropped'] == 1 else 's'} dropped")
elif op in ("mv", "move"):
    # The list's own order, not a group's. Both halves of restructuring belong
    # to a session: it is the one that knows a plan has to happen before the
    # item under it, and deleting and retyping to express that loses the words
    # and the record both.
    if len(rest) < 2 or rest[1] not in ("up", "down"):
        print("usage: bb roadmap mv <n> up|down", file=sys.stderr); sys.exit(1)
    n = ident(rest[0]); behind(n, None, None, None)
    r = todo.move(proj, n, dir=-1 if rest[1] == "up" else 1, by="claude",
                  who=_who)
    bail(r)
    print(f"moved {R(n)} {rest[1]}")
elif op == "shelve":
    # Parked, not dropped: a reason to keep it, no intention of doing it now.
    # One direction only. Putting something on the shelf is a thing a session
    # knows — it is blocked, or it is waiting on somebody — and it is loud:
    # the row goes dark at the bottom and the log says who did it. Taking one
    # *off* is reversing a decision the operator made for reasons the session
    # was not told, so it is theirs, and one tap in the panel.
    if not rest:
        print("usage: bb roadmap shelve <n>", file=sys.stderr); sys.exit(1)
    n = ident(rest[0]); behind(n, None, None, None)
    r = todo.shelve(proj, n, True, by="claude", who=_who); bail(r)
    print(f"shelved {R(n)} — say in your reply why, the operator unshelves it")
elif op == "edit":
    # A plan written last week can describe a design that has since moved.
    # Correcting it is better than working around it, and the history keeps
    # what it used to say.
    if len(rest) < 2:
        print("usage: bb roadmap edit <n> \"the new wording\"", file=sys.stderr); sys.exit(1)
    n = ident(rest[0])
    if behind(n, "edit", {"item_id": n, "text": " ".join(rest[1:]), "who": _who},
              f"reword {R(n)}: {' '.join(rest[1:])}"):
        sys.exit(0)
    fresh()
    r = todo.edit(proj, n, " ".join(rest[1:]), by="claude", who=_who); bail(r)
    print(f"reworded {R(n)}")
elif op == "info":
    # The technical half, attached where the work is: which files, which
    # functions, the approach. `bb roadmap info N "..."` for an item,
    # `bb roadmap info N M "..."` for step M of it; "" clears.
    if len(rest) < 2:
        print("usage: bb roadmap info <n> [<step>] \"...\"", file=sys.stderr)
        sys.exit(1)
    item = ident(rest[0])
    if len(rest) >= 3 and rest[1].isdigit():
        n = int(rest[1])
        if n < 1:
            print("[builderbot] ERROR: step numbers start at 1", file=sys.stderr)
            sys.exit(1)
        if behind(item, "info", {"item_id": item, "text": " ".join(rest[2:]),
                                 "step": n - 1, "who": _who},
                  f"details on step {n} of {R(item)}: {' '.join(rest[2:])}"):
            sys.exit(0)
        fresh()
        r = todo.set_info(proj, item, " ".join(rest[2:]),
                          step=n - 1, by="claude", who=_who); bail(r)
        print(f"details on step {rest[1]} of {R(item)}")
    else:
        if behind(item, "info", {"item_id": item, "text": " ".join(rest[1:]), "who": _who},
                  f"details on {R(item)}: {' '.join(rest[1:])}"):
            sys.exit(0)
        fresh()
        r = todo.set_info(proj, item, " ".join(rest[1:]), by="claude",
                          who=_who); bail(r)
        print(f"details on {R(item)}")
elif op == "step":
    sub, srest = (rest[0] if rest else ""), rest[1:]

    def step_index(word):
        """A 1-based step number from the command line, as a 0-based index.

        Its own function because the expression it replaces read
        `_int(x) - 1 if _int(x) else None`, and Python's zero is falsy: step 0
        was not "invalid", it was "no step at all", so `step edit N 0 "..."`
        fell through to editing the item and renamed it. Every step verb had
        its own copy of that.
        """
        n = todo._int(word)
        if n is None or n < 1:
            print(f"[builderbot] ERROR: step numbers start at 1 (got {word!r})",
                  file=sys.stderr)
            sys.exit(1)
        return n - 1
    item = ident(srest[0]) if srest else None
    if sub == "add" and len(srest) >= 2:
        if behind(item, "step-add", {"item_id": item, "text": " ".join(srest[1:]), "who": _who},
                  f"a step on {R(item)}: {' '.join(srest[1:])}"):
            sys.exit(0)
        r = todo.add_step(proj, item, " ".join(srest[1:]), by="claude",
                          who=_who); bail(r)
        print(f"added a step to {R(item)}")
    elif sub == "edit" and len(srest) >= 3:
        # 1-based on the way in, because that is how the step is numbered
        # everywhere a human reads it.
        behind(item, None, None, None); fresh()
        r = todo.edit(proj, item, " ".join(srest[2:]),
                      step=step_index(srest[1]),
                      by="claude", who=_who); bail(r)
        print(f"reworded step {srest[1]} of {R(item)}")
    elif sub in ("rm", "remove") and len(srest) >= 2:
        behind(item, None, None, None); fresh()
        r = todo.remove(proj, item,
                        step=step_index(srest[1]),
                        by="claude", why=" ".join(srest[2:]), who=_who); bail(r)
        print(f"removed step {srest[1]} of {R(item)}")
    elif sub == "info" and len(srest) >= 2:
        behind(item, None, None, None); fresh()
        r = todo.set_info(proj, item, " ".join(srest[2:]),
                          step=step_index(srest[1]),
                          by="claude", who=_who); bail(r)
        print(f"details on step {srest[1]} of {R(item)}")
    elif sub == "done" and len(srest) >= 2:
        # A session's own mark, distinct from the dashboard's "sent": this
        # step is finished, whether or not anybody sent it. See todo.step_done.
        behind(item, None, None, None)
        r = todo.step_done(proj, item, step_index(srest[1]),
                           by="claude", note=" ".join(srest[2:]), who=_who); bail(r)
        print(f"step {srest[1]} of {R(item)} done")
    elif sub in ("mv", "move") and len(srest) >= 3 and srest[2] in ("up", "down"):
        # The other half of restructuring a plan. Without it a session that
        # finds two steps in the wrong order can only delete and retype them,
        # which loses both their words and the record of what really changed.
        behind(item, None, None, None)
        r = todo.move(proj, item,
                      step=step_index(srest[1]),
                      dir=-1 if srest[2] == "up" else 1, by="claude",
                      who=_who); bail(r)
        print(f"moved step {srest[1]} of {R(item)} {srest[2]}")
    else:
        print("usage: bb roadmap step add <n> \"...\" | step edit <n> <step> \"...\""
              " | step rm <n> <step> [\"why\"] | step mv <n> <step> up|down"
              " | step done <n> <step> [\"note\"]",
              file=sys.stderr)
        sys.exit(1)
elif op == "pending":
    # What this project has waiting for the operator (roadmap #27) — the
    # roadmap's half. Read-only: approving is theirs, on the notebook.
    rs = pending.listing(proj, "roadmap")
    if not rs:
        print(f"nothing from the roadmap is waiting for approval on {proj}")
    for r in rs:
        when = time.strftime("%d %b %H:%M", time.localtime(r.get("at", 0)))
        tag = R(r["number"]) if r.get("number") is not None else ""
        lead = "  ↳ " if r.get("after") is not None else "  "
        print(f"{lead}{when}  {tag:<5} {r.get('summary', '')}")
    g = pending.mode(proj, "roadmap")
    print(f"  (this project's setting for new roadmap items from a session: {g})")
elif op in ("history", "log"):
    # Narrowed on the way out, not on the way in: this is read by sessions as
    # often as by people, and a whole log pasted into a conversation costs
    # more context than the one line anybody wanted from it.
    limit, since, find, i = 20, None, None, 0
    while i < len(rest):
        a = rest[i]
        if a in ("-n", "--last") and i + 1 < len(rest):
            limit = todo._int(rest[i + 1]); i += 2
        elif a == "--all":
            limit = None; i += 1
        elif a == "--since" and i + 1 < len(rest):
            # A day count, or a date. Both are things somebody types from
            # memory; neither needs a library to read.
            v = rest[i + 1]
            n = todo._int(v.rstrip("d")) if v.rstrip("d").isdigit() else None
            if n is not None:
                since = int(time.time()) - n * 86400
            else:
                try:
                    since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
                except ValueError:
                    print(f"[builderbot] ERROR: not a date or a day count: {v}",
                          file=sys.stderr); sys.exit(1)
            i += 2
        elif a in ("--find", "-f") and i + 1 < len(rest):
            find = rest[i + 1]; i += 2
        else:
            print("usage: bb roadmap history [-n N|--all] [--since 7d|YYYY-MM-DD] "
                  "[--find TEXT]", file=sys.stderr)
            sys.exit(1)
    h = todo.history(proj, limit=limit, since=since, find=find)
    if not h:
        print(f"nothing on {proj}'s list matches that")
    for e in h:
        when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
        where = f" step {e['step'] + 1} of" if e.get("step") is not None else ""
        print(f"  {when}  {e.get('by', ''):>6}  {e.get('act', ''):<11}"
              f"{where} {R(e.get('id'))}  {e.get('text', '')}")
        if e.get("was"):
            print(f"{'':>32}was: {e['was']}")
        if e.get("why"):
            print(f"{'':>32}why: {e['why']}")
        if e.get("approved"):
            print(f"{'':>32}approved by the operator")
else:
    print("usage: bb roadmap [list|show N|add TEXT [--step ...]|edit N TEXT|"
          "info N [M] TEXT|step add|edit|rm|mv|done|info ...|mv N up|down|done N|"
          "rm N [WHY]|shelve N|begin|commit|revert|pending|"
          "history [-n N] [--since D] [--find TEXT]]",
          file=sys.stderr)
    sys.exit(1)
PY
}

cmd_history() {
    # One search over all three of the notebook's logs — roadmap, bugs, and
    # what the dashboard did to the memories — tagged by source and merged by
    # time. `bb roadmap history` and `bb bug history` scope to one; this is for
    # "when did anything here mention the picker?", which is a question about
    # the notebook and not about a tab of it.
    local dir
    dir="$(dirname "$(readlink -f "$0")")/dashboard"
    local proj="${BB_ROADMAP_PROJECT:-${BB_TODO_PROJECT:-}}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$dir" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys, time


def load_mod(dirname, name):
    spec = importlib.util.spec_from_file_location(name, f"{dirname}/{name}.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod




dirname, proj, argv = sys.argv[1], sys.argv[2], sys.argv[3:]
state = os.environ.get("DASHBOARD_STATE", "/config")
# One implementation of the atomic write, from beside the modules it serves.
statefile = load_mod(dirname, "statefile")
sys.modules["statefile"] = statefile
write_json = statefile.write_json
todo = load_mod(dirname, "todo")
todo.configure(write_json=write_json, state=state)
import ids  # noqa: E402 — todo.py put its directory on sys.path
bugs = load_mod(dirname, "bugs")
bugs.configure(write_json=write_json, state=state)
memory = load_mod(dirname, "memory")
memory.configure_log(write_json=write_json, state=state)
findings = load_mod(dirname, "findings")
findings.configure(write_json=write_json, state=state)

limit, since, find, i = 20, None, None, 0
while i < len(argv):
    a = argv[i]
    if a in ("-n", "--last") and i + 1 < len(argv):
        limit = int(argv[i + 1]); i += 2
    elif a == "--all":
        limit = None; i += 1
    elif a == "--since" and i + 1 < len(argv):
        v = argv[i + 1]
        if v.rstrip("d").isdigit():
            since = int(time.time()) - int(v.rstrip("d")) * 86400
        else:
            try:
                since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
            except ValueError:
                print(f"[builderbot] ERROR: not a date or a day count: {v}",
                      file=sys.stderr)
                sys.exit(1)
        i += 2
    elif a in ("--find", "-f") and i + 1 < len(argv):
        find = argv[i + 1]; i += 2
    else:
        print("usage: bb history [-n N|--all] [--since 7d|YYYY-MM-DD] "
              "[--find TEXT]", file=sys.stderr)
        sys.exit(1)

rows = []
# All four views, so "when did anything here mention X" means all of it. The
# findings log is the one nobody wrote: its rows carry no `by`, which reads
# correctly in this column as a blank rather than a name.
# ...and the approval queue's own log (roadmap #27): what was held, and what
# the operator decided — the one place "denied" is written down.
pending = load_mod(dirname, "pending")
pending.configure(write_json=write_json, state=state)
for tag, mod in (("roadmap", todo), ("bugs", bugs), ("memory", memory),
                 ("scanner", findings), ("waiting", pending)):
    for e in mod.history(proj, since=since, find=find):
        rows.append((tag, e))
rows.sort(key=lambda te: -te[1].get("at", 0))
if limit:
    rows = rows[:limit]
if not rows:
    print(f"nothing in {proj}'s notebook matches that")
for tag, e in rows:
    when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
    where = f" step {e['step'] + 1} of" if e.get("step") is not None else ""
    # The tab's own letter on the number — R12, B62 — because a merged log is
    # exactly where a bare number could be read against the wrong list.
    kind = {"roadmap": "todo"}.get(tag, tag)
    if tag == "waiting":
        # The queue's rows carry which tab and that tab's number.
        k2 = {"roadmap": "todo"}.get(e.get("kind"), e.get("kind"))
        ident = (f" {ids.label(k2, e['number'])}" if e.get("number") is not None
                 and k2 in ids.LETTERS else
                 f" rule {e['number']}" if e.get("number") else "")
    else:
        ident = (f" {ids.label(kind, e['id'])}" if e.get("id") is not None
                 and kind in ids.LETTERS else "")
    print(f"  {when}  {tag:>7}  {e.get('by', ''):>6}  {e.get('act', ''):<11}"
          f"{where}{ident}  {e.get('text', '')}")
    if e.get("was"):
        print(f"{'':>41}was: {e['was']}")
    for k in ("why", "note"):
        if e.get(k):
            print(f"{'':>41}{k}: {e[k]}")
    if e.get("approved"):
        print(f"{'':>41}approved by the operator")
PY
}

cmd_rules() {
    # The house rules: the operator's on the Briefing tab, a session's own
    # through add/edit/rm here. Each carries who wrote it, and a session may
    # change only its own — see rules.py for the ownership and the log.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/rules.py"
    [ -f "$py" ] || die "rules.py is missing from this image"
    local proj="${BB_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    # `bb rules check` runs a rule's check command HERE, in this tree, on
    # whichever machine the session is on (roadmap R31): the rules themselves
    # come through `bb rules --json`, which is relayed on a node, so this
    # needs neither /config nor rules.py — only git, the tree and the command.
    if [ "${1:-}" = check ]; then
        shift
        local rules_json
        rules_json="$(BB_PROJECT="$proj" bash "$0" rules --json)" || die "could not read the rules"
        RULES_JSON="$rules_json" python3 - "$WORKSPACE/$proj" "$@" <<'CHECKPY'
import fnmatch, json, os, subprocess, sys
tree, argv = sys.argv[1], sys.argv[2:]
rules = json.loads(os.environ.get("RULES_JSON") or "[]")
want = argv[0] if argv and argv[0] != "--all" else None
everything = "--all" in argv or want is not None


def changed():
    """What this tree has changed: the diff against HEAD plus untracked files."""
    out = set()
    for cmd in (["git", "diff", "--name-only", "HEAD"],
                ["git", "ls-files", "--others", "--exclude-standard"]):
        try:
            r = subprocess.run(cmd, cwd=tree, capture_output=True, text=True, timeout=30)
            out |= {ln.strip() for ln in r.stdout.splitlines() if ln.strip()}
        except (OSError, subprocess.SubprocessError):
            pass
    return sorted(out)


def covers(r, path):
    for pat in r.get("paths") or []:
        pat = pat.strip().rstrip("/")
        if pat and (fnmatch.fnmatch(path, pat) or path == pat or path.startswith(pat + "/")):
            return True
    return False


todo = [r for r in rules if r.get("check") and (want is None or r.get("name") == want)]
if want is not None and not todo:
    sys.exit(f"[builderbot] ERROR: no rule called {want} carries a check")
if not everything:
    files = changed()
    todo = [r for r in todo if not r.get("paths") or any(covers(r, f) for f in files)]
    if not todo:
        print("nothing changed here that a rule's check covers")
        sys.exit(0)
rc = 0
for r in todo:
    print(f"== {r['name']}: {r['check']}")
    sys.stdout.flush()
    try:
        res = subprocess.run(r["check"], shell=True, cwd=tree, timeout=3600)
        code = res.returncode
    except subprocess.TimeoutExpired:
        print("  timed out after an hour"); code = 124
    except OSError as e:
        print(f"  could not run: {e}"); code = 126
    print(f"  {'PASS' if code == 0 else 'FAIL'}  {r['name']} (exit {code})")
    rc = rc or code
sys.exit(rc)
CHECKPY
        return $?
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 - "$py" "$proj" "$@" <<'RULESPY'
import importlib.util, json, os, sys, time

spec = importlib.util.spec_from_file_location("rules", sys.argv[1])
reg = importlib.util.module_from_spec(spec)
spec.loader.exec_module(reg)
_sfs = importlib.util.spec_from_file_location(
    "statefile", os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])),
                              "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
reg.configure(write_json=statefile.write_json,
              state=os.environ.get("DASHBOARD_STATE", "/config"))

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]
import pending  # noqa: E402 — rules.py put its directory on sys.path

# What bb-tty puts in front of a session. Empty output and status 0 when
# there are no rules, so the caller can test it with `[ -z ]`.
if op == "--prompt":
    b = reg.block(proj)
    if b:
        print(b)
elif op == "--json":
    print(json.dumps(reg.rules(proj)))
elif op == "show":
    if not rest:
        sys.exit("usage: bb rules show <name>")
    want = rest[0].strip().lower()
    for r in reg.rules(proj):
        if r["name"] == want:
            print(r["text"])
            if r.get("doc"):
                print(f"\ndefined in full in {r['doc']}")
            if r.get("check"):
                print(f"checked by: {r['check']}   (bb rules check {r['name']})")
            break
    else:
        names = ", ".join(r["name"] for r in reg.rules(proj)) or "none"
        sys.exit(f"no rule called {want} here — this project has: {names}")
elif op == "add":
    if len(rest) < 2:
        sys.exit('usage: bb rules add <name> "the rule" [--files GLOB,...] [--words W,...]')
    name, said, paths_, wds_, doc_, chk_, i = rest[0], [], "", "", "", "", 1
    while i < len(rest):
        if rest[i] == "--files" and i + 1 < len(rest):
            paths_ = rest[i + 1]; i += 2
        elif rest[i] == "--words" and i + 1 < len(rest):
            wds_ = rest[i + 1]; i += 2
        elif rest[i] == "--doc" and i + 1 < len(rest):
            doc_ = rest[i + 1]; i += 2
        elif rest[i] == "--check" and i + 1 < len(rest):
            chk_ = rest[i + 1]; i += 2
        else:
            said.append(rest[i]); i += 1
    r = reg.add(proj, name, " ".join(said), paths=paths_, words=wds_, by="claude",
                doc=doc_, check=chk_)
    if r.get("error"):
        sys.exit(f"[builderbot] ERROR: {r['error']}")
    if r.get("held"):
        print(f"held for approval as the rule {r['held']['number']} — it takes "
              "effect when the operator approves it on the notebook. `bb rules "
              "pending` lists what is waiting; you are told on a later turn what "
              "they decided")
        sys.exit(0)
    print(f"added {r['rule']['name']} — yours, marked as a session's on the "
          "Briefing tab, and in front of every session started here")
elif op == "edit":
    if len(rest) < 2:
        sys.exit('usage: bb rules edit <name> "what it should say now"')
    held = pending.held(proj, "rules", rest[0].strip().lower())
    if held is not None:
        # Reworded before it was even approved: the rewording rides behind
        # the held rule, so the operator reads both and the final wording wins.
        r = pending.hold(proj, "rules", "edit",
                         {"name": held["number"], "text": " ".join(rest[1:])},
                         f"reword {held['number']}: {' '.join(rest[1:])}",
                         number=held["number"], after=held["id"])
        if r.get("error"):
            sys.exit(f"[builderbot] ERROR: {r['error']}")
        print(f"held behind the rule {held['number']} — it lands with it when the "
              "operator approves it, and goes if they deny it")
        sys.exit(0)
    # `edit NAME "text"`, or `edit NAME --doc PATH --check CMD --files ... --words ...`
    # leaving the words alone; "" clears a flag.
    said, flags, i = [], {}, 1
    while i < len(rest):
        if rest[i] in ("--doc", "--check", "--files", "--words") and i + 1 < len(rest):
            flags[{"--files": "paths", "--words": "words"}.get(rest[i], rest[i][2:])] = rest[i + 1]
            i += 2
        else:
            said.append(rest[i]); i += 1
    if not said and not flags:
        sys.exit('usage: bb rules edit <name> "what it should say now" [--doc PATH] [--check CMD]')
    r = reg.edit(proj, rest[0], text=" ".join(said) if said else None, by="claude", **flags)
    if r.get("error"):
        sys.exit(f"[builderbot] ERROR: {r['error']}")
    print(f"reworded {rest[0]}" if said else f"updated {rest[0]}: {', '.join(flags)}")
elif op == "rm":
    if not rest:
        sys.exit('usage: bb rules rm <name> ["why it went"]')
    if pending.held(proj, "rules", rest[0].strip().lower()) is not None:
        sys.exit(f"[builderbot] ERROR: the rule {rest[0]} is still waiting for the "
                 "operator's approval — there is nothing to drop yet. `bb rules pending`")
    r = reg.remove(proj, rest[0], why=" ".join(rest[1:]), by="claude")
    if r.get("error"):
        sys.exit(f"[builderbot] ERROR: {r['error']}")
    print(f"dropped {r['removed']}")
elif op == "pending":
    # The rules' half of what is waiting for the operator (roadmap #27).
    rs = pending.listing(proj, "rules")
    if not rs:
        print(f"no rule is waiting for approval on {proj}")
    for r in rs:
        when = time.strftime("%d %b %H:%M", time.localtime(r.get("at", 0)))
        lead = "  ↳ " if r.get("after") is not None else "  "
        print(f"{lead}{when}  {r.get('summary', '')}")
    print(f"  (this project's setting for new rules from a session: "
          f"{pending.mode(proj, 'rules')})")
elif op == "history":
    rows = reg.history(proj, limit=20)
    if not rows:
        print("nothing has changed the rules here yet")
    for e in rows:
        when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
        print(f"  {when}  {e.get('by', ''):>6}  {e.get('act', ''):<7} "
              f"{e.get('name', '')}  {e.get('text', '')[:60]}")
        for k in ("was", "why"):
            if e.get(k):
                print(f"{'':>32}{k}: {e[k][:60]}")
        if e.get("approved"):
            print(f"{'':>32}approved by the operator")
elif op == "list":
    rs = reg.rules(proj)
    if not rs:
        print("no house rules on this project yet. The operator writes them on "
              "the notebook's Briefing tab; `bb rules add NAME \"...\"` leaves "
              "one of yours there, marked as a session's.")
        sys.exit(0)
    p = reg.payload(proj)
    print(f"{p['standing']} standing, {p['conditional']} conditional — "
          f"{p['chars']} characters in front of every session here")
    for r in rs:
        when = ""
        if reg.conditional(r):
            bits = list(r.get("paths") or []) + list(r.get("words") or [])
            when = "  [" + ", ".join(bits[:4]) + ("…" if len(bits) > 4 else "") + "]"
        first = (r["text"].strip().splitlines() or [""])[0]
        mine = "*" if r.get("by") == "claude" else " "
        frame = (" [doc]" if r.get("doc") else "") + (" [check]" if r.get("check") else "")
        print(f" {mine}{r['name']:<22}{first[:60]}{when}{frame}")
    print("\n`bb rules show <name>` for one in full. A * is one a session "
          "wrote: yours to `edit` or `rm`. The rest are the operator's — read "
          "them, and say in your reply if one looks wrong.")
else:
    print(f"[builderbot] ERROR: unknown: bb rules {op}", file=sys.stderr)
    sys.exit(1)
RULESPY
}

cmd_tests() {
    # The test registry's CLI half — the side a session drives, and the only
    # side that can ingest, because ingesting means reading what a runner
    # printed and the dashboard runs no suites.
    #
    # Same shape as cmd_bug: the project from the working directory (or
    # BB_TESTS_PROJECT), the module loaded from the file beside this script so
    # the checkout's copy is the one under test.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/testreg.py"
    [ -f "$py" ] || die "testreg.py is missing from this image"
    local proj="${BB_TESTS_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    # `ingest` with no file reads stdin, so the whole thing is one pipe. The
    # log reaches python as a PATH, never as a value: the heredoc below owns
    # python's stdin (the collision `bb phone` was fixed for), and a run log
    # is a couple of hundred kilobytes — passed in the environment it is
    # "Argument list too long", which is how this was found.
    # `run` closes the loop the registry was built for: a suite is run, its
    # real durations are parsed, and the registry stops going stale because
    # somebody forgot the second step. Same command `bb test` runs — the
    # project's own, from its settings — with BB_TEST_TIMING=1 in front of it.
    #
    # On a node that command runs right here in this tree, dirty edits and
    # all (cmd_run's on_node branch), so this is the iterate loop; from the
    # controller it is a job on the project's node, streamed back the same
    # way, and takes a row in the Jobs tab that somebody else can watch.
    if [ "${1:-}" = run ]; then
        shift
        # Into the project rather than /tmp, and that is not laziness: on a
        # node `bb tests ingest` is relayed, and the controller reads the path
        # it is given on ITS filesystem. /workspace is the one thing both
        # machines see. Gitignored where this is used.
        local log="${WORKSPACE}/${proj}/.bb-test-run.log"
        log="$(cd "$(dirname "$log")" 2>/dev/null && pwd)/$(basename "$log")"             || die "cannot write beside $proj"
        # BB_PROJECT as well as the registry's own variable: the run and the
        # record have to be about the same project, and `bb test` reads a
        # different name for it than `bb tests` does.
        #
        # In an `if` rather than after a `||`: errexit is suppressed inside a
        # condition, and PIPESTATUS still holds the pipeline's own statuses —
        # which is the only way to end up with the SUITE's exit code rather
        # than tee's. Read straight after `|| rc=$?` it is the `||`'s.
        # Say when it will be done before it starts, from the registry's
        # last run, and how the finish compared: the projection is the
        # measurement's whole point, and a run nobody can time is guessed at.
        local rc=0 t0 want took
        BB_TESTS_PROJECT="$proj" "$0" tests projection 2>/dev/null || true
        want="$(BB_TESTS_PROJECT="$proj" "$0" tests projection --secs 2>/dev/null || echo 0)"
        t0=$(date +%s)
        if BB_TEST_TIMING=1 BB_PROJECT="$proj" "$0" test "$@" 2>&1 | tee "$log"
        then rc=0
        else rc="${PIPESTATUS[0]:-1}"
        fi
        took=$(( $(date +%s) - t0 ))
        echo
        if [ "${want:-0}" -gt 0 ] 2>/dev/null; then
            echo "took ${took}s against ${want}s projected"
        else
            echo "took ${took}s"
        fi
        # A FAILING run is still worth ingesting — a red suite has real
        # timings in it, and the registry is about where the time goes rather
        # than about whether it passed. What is not worth ingesting is a run
        # that never happened, and the tell is the timing prefix: no line
        # wearing one means BB_TEST_TIMING produced nothing to parse, and the
        # reason was already printed once above.
        if grep -qE '\[\+[0-9]+\.[0-9]+s\]' "$log" 2>/dev/null; then
            BB_TESTS_PROJECT="$proj" "$0" tests ingest "$log" || true
        else
            echo "nothing timed, so nothing recorded. \`bb tests run\` runs this" >&2
            echo "project's own test command with BB_TEST_TIMING=1 in front of it;" >&2
            echo "set that command in the project's settings dialog." >&2
        fi
        return "$rc"
    fi
    local src="" tmp=""
    # From a node this verb is relayed, so the path is opened on the
    # CONTROLLER — which shares /workspace with the node and nothing else. A
    # log written to the node's own /tmp is simply not there, and "no such
    # run log" pointing at a file you can see is a confusing way to say it.
    no_file() {
        [ -z "${BB_RELAYED:-}" ] || die "$1: $2 — this ran on the controller," \
            "which shares /workspace with the node and nothing else. Put it" \
            "under the project and try again"
        die "$1: $2"
    }
    if [ "${1:-}" = describe ] && [ "${2:-}" = --from ]; then
        [ -n "${3:-}" ] || die "usage: bb tests describe --from FILE.json"
        [ -f "$3" ] || no_file "no such descriptions file" "$3"
        src="$3"
    fi
    if [ "${1:-}" = ingest ]; then
        if [ -n "${2:-}" ]; then
            [ -f "$2" ] || no_file "no such run log" "$2"
            src="$2"
        else
            [ -t 0 ] && die "usage: bb tests ingest [RUNLOG]  (or pipe the run into it)"
            tmp="$(mktemp)"; cat > "$tmp"; src="$tmp"
        fi
    fi
    BB_TESTS_FILE="$src" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 - "$py" "$proj" "$@" <<'TESTSPY'
import importlib.util, os, sys

spec = importlib.util.spec_from_file_location("testreg", sys.argv[1])
reg = importlib.util.module_from_spec(spec)
spec.loader.exec_module(reg)
_sfs = importlib.util.spec_from_file_location(
    "statefile", os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])),
                              "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
reg.configure(write_json=statefile.write_json,
              state=os.environ.get("DASHBOARD_STATE", "/config"))

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]


def secs(ms):
    return "—" if ms is None else f"{ms / 1000:.1f}s"


def bail(r):
    if r.get("error"):
        print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr)
        sys.exit(1)


if op in ("list", "ls"):
    p = reg.payload(proj)
    if not p["n"]:
        print(f"nothing on {proj}'s test registry — "
              "`bb tests ingest RUNLOG` after a run puts the timings in")
        sys.exit(0)
    print(f"{p['n']} tests · {p['total_ms'] / 1000:.0f}s measured"
          + (f" · last run {p['last_wall_ms'] / 1000:.0f}s of wall"
             if p["last_wall_ms"] else "")
          + (f" · {p['suspect']} flagged ({p['recover_ms'] // 1000}s waiting)"
             if p["suspect"] else "")
          + (f" · {p['undocumented']} undescribed" if p["undocumented"] else ""))
    print("\n  by suite:")
    for s in p["suites"]:
        print(f"   {secs(s['ms']):>8}  {s['suite']:<16} {s['n']:>4} tests"
              + (f"  {s['suspect']} flagged" if s["suspect"] else ""))
    # The slowest, which is what this is opened for. Not the whole roster: a
    # couple of thousand lines is not a thing anybody reads in a terminal.
    n = 20
    if rest and rest[0].lstrip("-").isdigit():
        n = int(rest[0].lstrip("-"))
    print(f"\n  slowest {n}:")
    for t in p["tests"][:n]:
        mark = f"  [{t['suspect']}s wait?]" if t["suspect"] else ""
        print(f"   {secs(t['ms']):>8}  {t['key']:<20} {t['name'][:60]}{mark}")
        if t.get("after"):
            print(f"             follows: {t['after'][:60]}")
elif op == "projection":
    # When a run will finish, from what the last one took — so nobody has
    # to guess, and a run well past it is read as stuck rather than slow.
    # `--secs` is the bare number, for `bb tests run` to hold up against
    # the clock when the run ends.
    p = reg.payload(proj)
    wall = p["last_wall_ms"] / 1000 if p["last_wall_ms"] else p["total_ms"] / 1000
    if rest[:1] == ["--secs"]:
        print(f"{wall:.0f}")
    elif not wall:
        print("no projection yet — nothing measured on this project; this run records the first")
    else:
        print(f"projected {wall:.0f}s, what the last run took over {p['n']} tests in "
              f"{len(p['suites'])} suites; one past {2 * wall:.0f}s is stuck, not slow")

elif op == "show":
    if not rest:
        print("usage: bb tests show <key>", file=sys.stderr); sys.exit(1)
    p = reg.payload(proj)
    t = next((x for x in p["tests"] if x["key"] == rest[0]), None)
    if t is None:
        print(f"[builderbot] ERROR: no test called {rest[0]} here", file=sys.stderr)
        sys.exit(1)
    print(f"  {t['key']}  {secs(t['ms'])}  [{t['status'] or '?'}]")
    print(f"  {t['name']}")
    if t.get("after"):
        print(f"  follows: {t['after']}")
    if len(t.get("history") or []) > 1:
        print("  history: " + ", ".join(f"{h / 1000:.1f}s" for h in t["history"]))
    if t["suspect"]:
        print(f"  FLAGGED: lands on a {t['suspect']}s boundary — a fixed sleep or a "
              "polling timeout rather than work")
    elif t.get("accepted"):
        print(f"  accepted: sits on {t['sits_on']}s, and that is the work — {t['accepted']}")
    print(f"  protects: {t['protects'] or '(nothing written yet)'}")
    print(f"  exercises: {t['notes'] or '(nothing written yet)'}")
elif op == "describe" and rest[:1] == ["--from"]:
    # A bulk fill, from a file of {key: {protects, notes}} — one load and one
    # save. Written for the first fill of a registry that already had two
    # thousand tests in it, where the per-test verb would have been two
    # thousand rewrites of the store.
    import json as _json
    with open(os.environ.get("BB_TESTS_FILE", ""), encoding="utf-8") as fh:
        rows = _json.load(fh)
    r = reg.describe_many(proj, rows)
    bail(r)
    print(f"described {r['wrote']} tests")
    if r["unknown_n"]:
        print(f"  {r['unknown_n']} keys named no test here — the registry and the "
              "file have drifted:")
        for k in r["unknown"][:10]:
            print(f"    {k}")
elif op in ("note", "describe"):
    # `bb tests note KEY "what it protects" [--how "what it exercises"]`
    if len(rest) < 2:
        print('usage: bb tests note <key> "what it protects" [--how "fixtures, stubs"]',
              file=sys.stderr)
        sys.exit(1)
    words, how, i = [], None, 1
    while i < len(rest):
        if rest[i] == "--how" and i + 1 < len(rest):
            how = rest[i + 1]; i += 2
        else:
            words.append(rest[i]); i += 1
    r = reg.describe(proj, rest[0], protects=" ".join(words),
                     **({"notes": how} if how is not None else {}))
    bail(r)
    print(f"described {rest[0]}")
elif op == "ingest":
    src = os.environ.get("BB_TESTS_FILE", "")
    with open(src, encoding="utf-8", errors="replace") as fh:
        r = reg.ingest(proj, fh.read(), by="claude")
    bail(r)
    print(f"ingested {r['n']} results from {len(r['suites'])} suite"
          f"{'' if len(r['suites']) == 1 else 's'}")
    for kind, rows in (("new", r["added"]), ("gone", r["gone"]),
                       ("renamed", r["renamed"])):
        if not rows:
            continue
        print(f"  {kind}: {len(rows)}")
        for x in rows[:10]:
            print("    " + (f"{x['was'][:40]} -> {x['now'][:40]}"
                            if kind == "renamed" else x["name"][:70]))
        if len(rows) > 10:
            print(f"    ...and {len(rows) - 10} more")
    if not (r["added"] or r["gone"] or r["renamed"]):
        print("  the registry and the runner agree")
elif op == "drift":
    p = reg.payload(proj)
    d = p.get("drift") or {}
    if not d.get("at"):
        print("nothing ingested yet")
        sys.exit(0)
    # The stored counts, not the lengths of the lists under them: the lists
    # are capped and a first ingest is every test in the project, so counting
    # rows would report where the list stops rather than what drifted.
    shown = n = 0
    for k in ("added", "gone", "renamed"):
        shown += len(d.get(k) or [])
        n += d.get("n_" + k, len(d.get(k) or []))
    print(f"as of the last ingest: {n} difference{'' if n == 1 else 's'}")
    for x in d.get("added") or []:
        print(f"  new     {x['key']:<20} {x['name'][:60]}")
    for x in d.get("gone") or []:
        print(f"  gone    {x['key']:<20} {x['name'][:60]}")
    for x in d.get("renamed") or []:
        print(f"  renamed {x['key']:<20} {x['was'][:30]} -> {x['now'][:30]}")
    if n > shown:
        print(f"  ...and {n - shown} more")
    if p["undocumented"]:
        print(f"\n{p['undocumented']} of {p['n']} tests have no line saying what "
              "they protect — `bb tests list` shows the slowest first")
elif op == "flagged":
    p = reg.payload(proj)
    print(f"{p['suspect']} tests land on a round timeout — "
          f"{p['recover_ms'] // 1000}s of the suite is waiting, not working"
          + (f" · {p['accepted']} accepted as the work, not listed" if p["accepted"] else ""))
    for t in p["tests"]:
        if t["suspect"]:
            print(f"   {secs(t['ms']):>8}  {t['key']:<20} {t['name'][:56]}"
                  f"  [{t['suspect']}s]")
elif op == "accept":
    # `bb tests accept KEY "why"`: the wait is the work — a real boot, a
    # timeout being proved — so it stops being flagged, with the reason kept
    # beside it. `--no` takes the mark off.
    if len(rest) < 2 or (rest[1] != "--no" and not rest[1].strip()):
        print("usage: bb tests accept <key> \"why the time is the work\"  |  bb tests accept <key> --no",
              file=sys.stderr); sys.exit(1)
    r = reg.accept(proj, rest[0], "" if rest[1] == "--no" else " ".join(rest[1:]))
    bail(r)
    print(f"{rest[0]}: " + ("no longer accepted — flagged again if it sits on a round number"
                            if rest[1] == "--no" else "accepted; it will not be flagged"))
else:
    print(f"[builderbot] ERROR: unknown: bb tests {op}", file=sys.stderr)
    sys.exit(1)
TESTSPY
    local rc=$?
    [ -n "$tmp" ] && rm -f "$tmp"
    return "$rc"
}

cmd_bug() {
    # The bug tracker's CLI half — the side a session drives. Same shape as
    # cmd_todo: the project from the working directory (or BB_BUG_PROJECT for
    # callers that are not in one, like bb-tty), the module loaded from the
    # file beside this script so the checkout's copy is the one under test.
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/bugs.py"
    [ -f "$py" ] || die "bugs.py is missing from this image"
    local proj="${BB_BUG_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" BB_WORKSPACE="$WORKSPACE" \
        python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, sys, time

spec = importlib.util.spec_from_file_location("bugs", sys.argv[1])
bugs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bugs)

# The atomic write, from the module beside it rather than a copy per heredoc.
# There were five, all still using a fixed <name>.tmp — the exact collision the
# server's copy was changed away from — and statefile.py carries the file lock
# that stops this process and the dashboard losing each other's writes.
_sfs = importlib.util.spec_from_file_location(
    "statefile", __import__("os").path.join(
        __import__("os").path.dirname(__import__("os").path.abspath(sys.argv[1])),
        "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
write_json = statefile.write_json




import os
_state = os.environ.get("DASHBOARD_STATE", "/config")
bugs.configure(write_json=write_json, state=_state)

# The roadmap's half of a notebook batch, and the coordinator over the two.
# `bb bug begin` and `bb roadmap begin` are the same command reached from
# either tab's name — one batch covers the notebook, so it would be a lie for
# the tracker to have a private one.
_here = os.path.dirname(sys.argv[1])


def _load(name):
    sp = importlib.util.spec_from_file_location(name, os.path.join(_here, name + ".py"))
    m = importlib.util.module_from_spec(sp)
    sp.loader.exec_module(m)
    return m


_todo = _load("todo")
_todo.configure(write_json=write_json, state=_state)
_nb = _load("notebook")
_nb.configure(todo_mod=_todo, bugs_mod=bugs)

proj, argv = sys.argv[2], sys.argv[3:]
op = argv[0] if argv else "list"
rest = argv[1:]

import ids  # noqa: E402 — bugs.py put its directory on sys.path
import pending  # noqa: E402 — the approval queue (roadmap #27)


def B(n):
    return ids.label("bugs", n) if n is not None else ""


def behind(n, verb, args, summary):
    """A verb aimed at a report that is still waiting for approval: a note
    or a field edit rides behind it, anything else is refused. See the
    roadmap's twin. True when dealt with here."""
    rec = pending.held(proj, "bugs", n)
    if rec is None:
        return False
    if verb is None:
        print(f"[builderbot] ERROR: {B(n)} is still waiting for the operator's "
              "approval — there is nothing to close or drop yet. `bb bug pending`",
              file=sys.stderr)
        sys.exit(1)
    r = pending.hold(proj, "bugs", verb, args, summary, number=n, after=rec["id"])
    bail(r)
    print(f"held behind {B(n)} — it lands with that report when the operator "
          "approves it, and goes if they deny it")
    return True


def ident(word):
    """The bug a verb names, with the letter checked first — `bb bug fix R12`
    stops here saying R12 is a roadmap item. See cmd_roadmap's twin."""
    n, err = ids.parse("bugs", word)
    if err:
        print(f"[builderbot] ERROR: {err}", file=sys.stderr)
        sys.exit(1)
    if n is None:
        print(f"[builderbot] ERROR: not a bug number: {word!r} — they are "
              "B1, B2, ...", file=sys.stderr)
        sys.exit(1)
    return n


def bail(r):
    if r.get("error"):
        print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr)
        sys.exit(1)


def line(b):
    mark = " " if b.get("status") == "open" else "x"
    extra = "" if b.get("status") == "open" else f"  [{b['status']}]"
    return (f"  [{mark}] {B(b['id']):>4}  ({b.get('severity', 'medium')})  "
            f"{b['title']}{extra}")


def show(b):
    print(line(b))
    for k in ("area", "repro", "expected", "actual", "notes"):
        if b.get(k):
            body = b[k].replace("\n", "\n" + " " * 12)
            print(f"  {k:>8}: {body}")
    when = time.strftime("%d %b %H:%M", time.localtime(b.get("at", 0)))
    print(f"  {'by':>8}: {b.get('by', '?')} · {when}"
          + (f" · {b['status']}: {b.get('status_note', '')}"
             if b.get("status") != "open" else ""))
    # The versions (roadmap #6): blank where the report predates the stamp
    # or the tree had nothing honest to say — never a guess.
    if b.get("seen_in") or b.get("seen_on"):
        print(f"  {'seen in':>8}: {b.get('seen_in') or '?'}"
              + (f" · on image {b['seen_on']}" if b.get("seen_on") else ""))
    if b.get("fixed_in"):
        print(f"  {'closed in':>8}: {b['fixed_in']}")


def rows():
    return bugs.payload(proj)["bugs"]


def pull_flags(args):
    """--sev/--area/--repro/--expected/--actual/--notes out of an argv,
    leaving the words that make the title."""
    words, out, i = [], {}, 0
    names = {"--sev": "severity", "--severity": "severity", "--area": "area",
             "--repro": "repro", "--expected": "expected",
             "--actual": "actual", "--notes": "notes"}
    while i < len(args):
        if args[i] in names:
            if i + 1 >= len(args):
                print(f"[builderbot] ERROR: {args[i]} needs a value after it",
                      file=sys.stderr)
                sys.exit(1)
            out[names[args[i]]] = args[i + 1]; i += 2
        else:
            words.append(args[i]); i += 1
    return " ".join(words).strip(), out


if op in ("list", "ls"):
    # Same banner the roadmap's listing carries, for the same batch. A session
    # that opened one on the roadmap and then came here to file something
    # should not have to remember that its notes are unrecorded.
    _b = _nb.state(proj)
    if _b:
        print(f"  [batch open — {_b['changes']} change"
              f"{'' if _b['changes'] == 1 else 's'} unrecorded across this "
              "notebook; bb bug commit, or revert]")
    open_rows = [b for b in rows() if b.get("status") == "open"]
    if not open_rows:
        print(f"no open bugs on {proj} — `bb bug all` includes the closed ones")
    for b in open_rows:
        print(line(b))
elif op == "all":
    if not rows():
        print(f"nothing in {proj}'s bug tracker")
    for b in rows():
        print(line(b))
elif op in ("begin", "commit", "revert"):
    # The same batch `bb roadmap begin` opens — one over the whole notebook,
    # reached from whichever tab's name you happened to be thinking in.
    if op == "begin":
        bail(_nb.begin(proj))
        print(f"batch open on {proj}'s notebook — the bug tracker and the "
              "roadmap both. Commit or revert it")
    elif op == "commit":
        r = _nb.commit(proj); bail(r)
        print(f"committed: {r['written']} entr{'y' if r['written'] == 1 else 'ies'}"
              + (f", {r['folded']} folded into them" if r["folded"] else ""))
    else:
        r = _nb.revert(proj); bail(r)
        print(f"reverted: the tracker and the roadmap are back as they were, "
              f"{r['dropped']} change{'' if r['dropped'] == 1 else 's'} dropped")
elif op in ("find", "search"):
    # Over the bugs themselves, not over the log. `history --find` searches
    # what happened; this searches what is *on file* — the area and the repro
    # above all, which is how you find out whether the thing you just tripped
    # over is already known.
    if not rest:
        print("usage: bb bug find <text>", file=sys.stderr); sys.exit(1)
    needle = " ".join(rest).lower()
    hits = [b for b in rows()
            if any(needle in str(b.get(k, "")).lower()
                   for k in ("title", "area", "repro", "expected", "actual",
                             "notes", "status_note"))]
    if not hits:
        print(f"nothing in {proj}'s tracker mentions that")
    for b in hits:
        print(line(b))
elif op == "show":
    if not rest:
        print("usage: bb bug show <n>", file=sys.stderr); sys.exit(1)
    n = ident(rest[0])
    b = next((x for x in rows() if x.get("id") == n), None)
    if b is None:
        print(f"[builderbot] ERROR: no bug {B(n)} here", file=sys.stderr)
        sys.exit(1)
    show(b)
elif op == "add":
    title, flags = pull_flags(rest)
    r = bugs.add(proj, title, by="claude",
                 severity=flags.pop("severity", "medium"), **flags)
    bail(r)
    if r.get("held"):
        h = r["held"]
        print(f"held for approval as {B(h['number'])} — it lands in the tracker "
              "when the operator approves it on the notebook. `bb bug pending` "
              "lists what is waiting; you are told on a later turn what they decided")
        sys.exit(0)
    print(f"filed {B(r['bug']['id'])}: {r['bug']['title']}")
elif op == "note":
    # The everyday update: what a session learned about a bug it did not fix.
    # Appended rather than replacing, because the last analysis is not made
    # wrong by the next one — it is how the next one starts.
    if len(rest) < 2:
        print("usage: bb bug note <n> \"what you learned\"", file=sys.stderr)
        sys.exit(1)
    n = ident(rest[0])
    b = next((x for x in rows() if x.get("id") == n), None)
    stamp = time.strftime("%d %b", time.localtime())
    if b is None:
        # A note on a report that is itself waiting: held behind it, with
        # the note stamped now — that is when it was learned.
        held_notes = (pending.held(proj, "bugs", n) or {}).get("args", {}).get("notes", "")
        body = (held_notes + f"\n\n[{stamp}] " + " ".join(rest[1:])).strip()
        if behind(n, "edit", {"bug_id": n, "act": "noted", "notes": body},
                  f"note on {B(n)}: {' '.join(rest[1:])}"):
            sys.exit(0)
        print(f"[builderbot] ERROR: no bug {B(n)} here", file=sys.stderr)
        sys.exit(1)
    body = (b.get("notes", "") + f"\n\n[{stamp}] " + " ".join(rest[1:])).strip()
    r = bugs.edit(proj, n, by="claude", act="noted", notes=body); bail(r)
    print(f"noted on {B(n)}")
elif op == "edit":
    if len(rest) < 3 or rest[1] not in ("title", "sev", "severity", "area",
                                        "repro", "expected", "actual", "notes"):
        print("usage: bb bug edit <n> title|sev|area|repro|expected|actual|notes"
              " \"...\"", file=sys.stderr)
        sys.exit(1)
    k = "severity" if rest[1] in ("sev", "severity") else rest[1]
    n = ident(rest[0])
    if behind(n, "edit", {"bug_id": n, k: " ".join(rest[2:])},
              f"{k} on {B(n)}: {' '.join(rest[2:])}"):
        sys.exit(0)
    r = bugs.edit(proj, n, by="claude", **{k: " ".join(rest[2:])})
    bail(r)
    print(f"updated {k} on {B(n)}")
elif op in ("rm", "remove"):
    # For a report that should not exist — mis-filed, a duplicate, the wrong
    # project. A bug that was real and is dealt with gets `fix` or `wontfix`,
    # which keeps it; this does not, and says why in the log.
    if not rest:
        print("usage: bb bug rm <n> [\"why it should not have been filed\"]",
              file=sys.stderr)
        sys.exit(1)
    n = ident(rest[0]); behind(n, None, None, None)
    r = bugs.remove(proj, n, why=" ".join(rest[1:]), by="claude"); bail(r)
    print(f"removed {B(n)} — closing keeps a bug, this does not")
elif op in ("fix", "wontfix", "na", "reopen"):
    if not rest:
        print(f"usage: bb bug {op} <n> [\"note\"]", file=sys.stderr); sys.exit(1)
    status = {"fix": "fixed", "wontfix": "wontfix", "na": "na",
              "reopen": "open"}[op]
    n = ident(rest[0]); behind(n, None, None, None)
    r = bugs.set_status(proj, n, status,
                        note=" ".join(rest[1:]), by="claude")
    bail(r)
    print(f"{B(n)} {status}")
elif op == "pending":
    # The tracker's half of what is waiting for the operator (roadmap #27).
    rs = pending.listing(proj, "bugs")
    if not rs:
        print(f"nothing from the tracker is waiting for approval on {proj}")
    for r in rs:
        when = time.strftime("%d %b %H:%M", time.localtime(r.get("at", 0)))
        tag = B(r["number"]) if r.get("number") is not None else ""
        lead = "  ↳ " if r.get("after") is not None else "  "
        print(f"{lead}{when}  {tag:<5} {r.get('summary', '')}")
    print(f"  (this project's setting for new bug reports from a session: "
          f"{pending.mode(proj, 'bugs')})")
elif op in ("history", "log"):
    # The same filters `bb roadmap history` takes, because whoever learned one
    # should not have to learn the other. `bb history` merges all four.
    limit, since, find, i = 20, None, None, 0
    while i < len(rest):
        a = rest[i]
        if a in ("-n", "--last") and i + 1 < len(rest):
            limit = int(rest[i + 1]); i += 2
        elif a == "--all":
            limit = None; i += 1
        elif a == "--since" and i + 1 < len(rest):
            v = rest[i + 1]
            if v.rstrip("d").isdigit():
                since = int(time.time()) - int(v.rstrip("d")) * 86400
            else:
                try:
                    since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
                except ValueError:
                    print(f"[builderbot] ERROR: not a date or a day count: {v}",
                          file=sys.stderr)
                    sys.exit(1)
            i += 2
        elif a in ("--find", "-f") and i + 1 < len(rest):
            find = rest[i + 1]; i += 2
        else:
            print("usage: bb bug history [-n N|--all] [--since 7d|YYYY-MM-DD] "
                  "[--find TEXT]", file=sys.stderr)
            sys.exit(1)
    h = bugs.history(proj, limit=limit, since=since, find=find)
    if not h:
        print(f"nothing in {proj}'s tracker matches that")
    for e in h:
        when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
        print(f"  {when}  {e.get('by', ''):>6}  {e.get('act', ''):<9}"
              f"  {B(e.get('id'))}  {e.get('text', '')}")
        if e.get("note"):
            print(f"{'':>30}note: {e['note']}")
        if e.get("approved"):
            print(f"{'':>30}approved by the operator")
elif op == "--prompt":
    sys.stdout.write(bugs.prompt(proj))
else:
    print("usage: bb bug [list|all|show N|find TEXT|begin|commit|revert|add TITLE [--sev S] [--area ..] "
          "[--repro ..]|note N TEXT|edit N FIELD TEXT|fix N [NOTE]|"
          "wontfix N [WHY]|na N [WHY]|reopen N|rm N [WHY]|pending|"
          "history [-n N] [--since D] [--find TEXT]]", file=sys.stderr)
    sys.exit(1)
PY
}

# The Analysis tab's log, for a session. Its own subcommand rather than a flag,
# because it answers a different question: not what the scanner says now, which
# is what the report is for, but what it has stopped and started saying — a
# finding that is simply absent this week leaves no other trace at all.
# ---- the phone, through the operator ---------------------------------------
# A session does not reach the handset itself. It says what it wants and why,
# the dashboard puts that in front of the operator, and on Allow the DASHBOARD
# runs it and hands back the output. So "did Claude touch my phone" has one
# answer, and it is on the card rather than in a scroll of transcript.
#
# The phone is on an adb server of its own, so a plain `adb devices` in a
# session shows the emulator and nothing else. That is the point: not a rule
# to remember, an address that was never given out.
cmd_phone() {
    local sub="${1:-status}" why="" auth
    auth="$(bb_auth_or_die)"
    shift || true
    case "$sub" in
        status)
            # A quoted heredoc, not `python3 -c` inside single quotes: the
            # escaping that needs is a minefield and this shipped broken once,
            # with a SyntaxError where the phone's model should have been.
            # The JSON arrives by environment, not by pipe: `python3 -` takes
            # its PROGRAM from stdin, so a heredoc and a pipe are competing for
            # the same channel and the heredoc wins — which is how this came to
            # be parsing an empty stdin as JSON.
            BB_PHONE_AUTH="$auth" python3 - <<'PY'
import os, sys
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402

d = bbapi.call("/api/phone", auth=os.environ["BB_PHONE_AUTH"])
if d.get("error"):
    sys.exit(f"[builderbot] ERROR: could not reach the dashboard at {bbapi.url()}: {d['error']}")
rows = d.get("nodes") or []
if not rows:
    print("phone:   no node carries adb — a phone is driven from a node")
for n in rows:
    p = n.get("phone")
    who = (n.get("owner") or {}).get("name")
    print("{:<16} {}".format(n.get("name", "?") + ":",
          "{} ({}){}".format(p.get("model") or "phone", p.get("serial"), f" — connected by {who}" if who else "")
          if p else ("not dialing in" if not n.get("live") else "no phone connected")))
for a in d.get("asks") or []:
    print("waiting: #{} {} — {} on {}".format(a.get("id"), a.get("why"), a.get("project") or "a session", a.get("node_name")))
PY
            ;;
        run)
            # `--why` is required, not polite. The operator is being asked
            # about a command they did not write; without a sentence saying
            # what it is for, Allow is a guess.
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) why="${2:-}"; shift 2 ;;
                    --) shift; break ;;
                    *) die "usage: bb phone run --why \"what this is for\" -- adb args..." ;;
                esac
            done
            [ -n "$why" ] || die "bb phone run needs --why \"what this is for\""
            [ $# -gt 0 ] || die "nothing to run — put the adb arguments after --"
            BB_PHONE_WHY="$why" BB_PHONE_AUTH="$auth" \
            BB_PHONE_PROJECT="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}" \
                python3 - "$@" <<'PY'
import os, sys, time
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402

post = lambda body: bbapi.call("/api/phone", body, auth=os.environ["BB_PHONE_AUTH"])  # noqa: E731


# The project names the node, and the node's phone names who is asked: a
# session's token carries its project; a person running this names theirs.
r = post({"action": "ask", "why": os.environ["BB_PHONE_WHY"], "cmd": sys.argv[1:],
          "project": os.environ.get("BB_PHONE_PROJECT", "")})
if r.get("error"):
    print(f"[builderbot] ERROR: {r['error']}", file=sys.stderr); sys.exit(1)
rid = r["id"]
print(f"[builderbot] asked {r.get('to') or 'the operator'} (#{rid}) — waiting up to 15 minutes "
      "for Allow on the dashboard's Phone tab", file=sys.stderr)
# Polled rather than pushed: this is a shell command waiting on a person, and
# a person is slow in a way no callback improves.
for _ in range(900):
    time.sleep(1)
    o = post({"action": "outcome", "id": rid})
    if o.get("error"):
        print(f"[builderbot] ERROR: {o['error']}", file=sys.stderr); sys.exit(1)
    if o["state"] == "denied":
        print("[builderbot] the operator said no", file=sys.stderr); sys.exit(1)
    if o["state"] == "done":
        sys.stdout.write(o.get("out") or "")
        sys.exit(o.get("code") or 0)
print("[builderbot] nobody answered within fifteen minutes", file=sys.stderr)
sys.exit(1)
PY
            ;;
        *) die "usage: bb phone [status|run --why \"...\" -- adb args...]" ;;
    esac
}

cmd_findings_history() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/findings.py"
    [ -f "$py" ] || die "findings.py is missing from this image"
    proj="${BB_FINDINGS_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys, time

spec = importlib.util.spec_from_file_location("findings", sys.argv[1])
fx = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fx)

# The atomic write, from the module beside it rather than a copy per heredoc.
# There were five, all still using a fixed <name>.tmp — the exact collision the
# server's copy was changed away from — and statefile.py carries the file lock
# that stops this process and the dashboard losing each other's writes.
_sfs = importlib.util.spec_from_file_location(
    "statefile", __import__("os").path.join(
        __import__("os").path.dirname(__import__("os").path.abspath(sys.argv[1])),
        "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
write_json = statefile.write_json




fx.configure(write_json=write_json,
             state=os.environ.get("DASHBOARD_STATE", "/config"))
proj, argv = sys.argv[2], sys.argv[3:]

# The same three filters the other logs take, parsed the same way — a day
# count or a date, because both are things somebody types from memory.
limit, since, find, i = 20, None, None, 0
while i < len(argv):
    a = argv[i]
    if a in ("-n", "--last") and i + 1 < len(argv):
        limit = fx._int(argv[i + 1]); i += 2
    elif a == "--all":
        limit = None; i += 1
    elif a == "--since" and i + 1 < len(argv):
        v = argv[i + 1]
        n = fx._int(v.rstrip("d")) if v.rstrip("d").isdigit() else None
        if n is not None:
            since = int(time.time()) - n * 86400
        else:
            try:
                since = int(time.mktime(time.strptime(v, "%Y-%m-%d")))
            except ValueError:
                print(f"[builderbot] ERROR: not a date or a day count: {v}",
                      file=sys.stderr); sys.exit(1)
        i += 2
    elif a in ("--find", "-f") and i + 1 < len(argv):
        find = argv[i + 1]; i += 2
    else:
        print("usage: bb findings history [-n N|--all] [--since 7d|YYYY-MM-DD] "
              "[--find TEXT]", file=sys.stderr)
        sys.exit(1)

h = fx.history(proj, limit=limit, since=since, find=find)
if not h:
    print(f"nothing in {proj}'s findings log matches that")
    print("the first scan of a project is its starting point rather than an "
          "entry, so this fills in from the second one onwards")
for e in h:
    when = time.strftime("%d %b %H:%M", time.localtime(e.get("at", 0)))
    print(f"  {when}  {e.get('act', ''):<8}  {e.get('text', '')}")
    if e.get("note"):
        print(f"{'':>24}{e['note']}")
PY
}

# ago SECONDS — a duration in the shortest form that is still honest. Its own
# helper because two callers below want the same words: how old a report is,
# and how far one has fallen behind its siblings.
ago() {
    local s="${1:-0}"
    if   [ "$s" -lt 90 ];    then printf '%ss' "$s"
    elif [ "$s" -lt 5400 ];  then printf '%sm' "$(( (s + 30) / 60 ))"
    elif [ "$s" -lt 172800 ]; then printf '%sh' "$(( (s + 1800) / 3600 ))"
    else printf '%sd' "$(( (s + 43200) / 86400 ))"
    fi
}

# The node registry, read-only. Phase 1 of the controller design
# (docs/nodes.md): the list exists and nothing else does yet, so this prints
# what the dashboard's store knows and never writes it — the dashboard's boot
# owns seeding and migration, and a look at the list must not race it.
# bb users — the dashboard's accounts, from a shell.
#
# This exists for the case the GUI cannot serve: the owner has forgotten the
# password, or there are no accounts at all yet. Whoever can run this can
# already read everything in the container, so it is not a privilege boundary
# — it is the way back in, and every system needs one.
#
# Deliberately not a full editor. Roles and project lists belong on the Users
# tab, where there is room to say what they mean.
# The credential this bb speaks to the dashboard with, as a finished header.
#
# BB_TOKEN first: a Claude session is given one of those — scoped to its own
# project, `user` rights, an expiry — instead of the operator's password,
# which is what it used to inherit (bug #16). DASHBOARD_AUTH is no longer a
# container setting — the owner is made on the first-run screen — but it is
# still read here, so an operator in a plain `docker exec` shell can pass one
# for a single command rather than being unable to reach the API at all. The
# operator's
# own shell, and a session no longer has it in its environment at all.
# When a session token stops being good, as a unix time — or nothing for
# anything that is not one. The body is base64url of `project|exp|uid|sig`.
bb_token_exp() {
    case "${1:-}" in bbs_*) ;; *) return 0 ;; esac
    local b="${1#bbs_}"
    b="$(printf '%s' "$b" | tr '_-' '/+')"
    while [ $(( ${#b} % 4 )) -ne 0 ]; do b="${b}="; done
    printf '%s' "$b" | base64 -d 2>/dev/null | cut -d'|' -f2 | tr -dc '0-9'
}

bb_token_dead() {
    local e; e="$(bb_token_exp "${1:-}")"
    [ -n "$e" ] || return 1                  # not a session token: not ours to judge
    [ "$e" -le "$(date +%s)" ]
}

# The session token to use now: the one in the environment unless it has
# expired, and then the one bb-tty last wrote beside the launcher.
#
# A conversation outlives its token — twelve hours — and the environment of a
# process already running cannot be changed from outside it, so a long session
# was left holding a token that no longer verified and every verb answered
# "not signed in". bb-tty refreshes that file on every connection, so opening
# the tab is what puts this back in touch.
bb_token_now() {
    local t="${BB_TOKEN:-}"
    local dir="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
    local f="${dir:-/tmp/bb-scope-$(id -u)}/builderbot/token-${BB_PROJECT:-}"
    local ft=""
    [ -r "$f" ] && ft="$(cat "$f" 2>/dev/null)"
    # The later-expiring of the two. The file used to be read only once the
    # environment's token had died; now every answer from the controller
    # can renew it (users.renewal, kept by bbapi.keep_token), so the file is
    # usually the NEWER one while the environment still verifies — and a
    # session that keeps sending the older token would be renewed on every
    # call for nothing.
    if [ -n "$ft" ] && ! bb_token_dead "$ft"; then
        if [ -z "$t" ] || bb_token_dead "$t" \
           || [ "$(bb_token_exp "$ft")" -gt "$(bb_token_exp "$t")" ] 2>/dev/null; then
            printf '%s' "$ft"; return 0
        fi
    fi
    if [ -n "$t" ] && ! bb_token_dead "$t"; then printf '%s' "$t"; return 0; fi
    printf '%s' "$t"                          # nothing fresher; the die below says so
}

bb_auth_header() {
    local t; t="$(bb_token_now)"
    if [ -n "$t" ]; then printf 'Bearer %s' "$t"
    elif [ -n "${DASHBOARD_AUTH:-}" ]; then
        printf 'Basic %s' "$(printf '%s' "$DASHBOARD_AUTH" | base64 -w0)"
    fi
}

# ...and the sentence to die with when there is neither.
bb_auth_or_die() {
    local h; h="$(bb_auth_header)"
    # An expired one is not a missing one, and saying "not signed in" for it
    # sent somebody looking for a sign-in that was never the problem. A token
    # lasts twelve hours and a conversation can last longer; re-opening the
    # tab mints a fresh one, which bb-tty writes where bb_token_now reads it.
    if [ -n "${BB_TOKEN:-}" ] && bb_token_dead "$(bb_token_now)"; then
        local e; e="$(bb_token_exp "$BB_TOKEN")"
        die "this session's token expired$([ -n "$e" ] && date -d "@$e" '+ %d %b at %H:%M' 2>/dev/null) — they last 12 hours and a conversation can outlast one. Open this session's tab from the dashboard again and the next command works: that mints a fresh token and leaves it where bb looks."
    fi
    if [ -z "$h" ]; then
        # Which of the two is actually wrong. Everything that reaches a node
        # goes through the dashboard, so "no credential" and "no dashboard"
        # produce the same failure and want different answers.
        if [ -z "$(dashboard_pid)" ]; then
            die "the dashboard is not running, and it is the controller: nodes dial \
into its API, so builds, tests, CI and emulation all go through it. See bb logs."
        fi
        die "no dashboard credential — a session started from the dashboard gets \
BB_TOKEN. From a plain docker exec there is none: run this from a dashboard \
terminal, or pass one for the command with DASHBOARD_AUTH=name:password."
    fi
    printf '%s' "$h"
}

# ---- a session on a node (roadmap #24) --------------------------------------
#
# The notebook, the settings and the registry live on the controller, and a
# node keeps no /config. So on a node the verbs that read them are RELAYED:
# the same words go to the controller's /api/v1/bb with the session's token,
# the controller runs its own bb in this project's tree (the projects share is
# mounted at /workspace on both sides, so a path here is a path there), and
# what it printed comes back. One implementation of every verb, kept where
# the state is; the token decides which project it may be about.
#
# What is NOT relayed is what belongs to the machine the session is on:
# `bb sdk` answers for this node's store, `bb emu` drives this node's
# emulator, `bb build` is a build (cmd_run). That is the point of being here.
BB_RELAY_VERBS=" roadmap todo bug bugs tests rules history version changelog work findings findings-history catchup claude-md claudemd settings nodes jobs ci-labels git "

bb_relay() {
    local auth proj
    auth="$(bb_auth_or_die)"
    proj="${BB_PROJECT:-${BB_ROADMAP_PROJECT:-${BB_BUG_PROJECT:-${BB_VERSION_PROJECT:-$(project_here || true)}}}}"
    BB_RELAY_PROJECT="$proj" python3 - "$auth" "$@" <<'PY'
import os, sys
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402
auth, *argv = sys.argv[1:]
r = bbapi.call("/api/v1/bb", {"argv": argv, "project": os.environ.get("BB_RELAY_PROJECT", ""),
                              "cwd": os.getcwd(),
                              "from": "session" if os.environ.get("CLAUDECODE") else "operator"},
               auth=auth, timeout=200)
if r.get("error") and "code" not in r:
    sys.exit(f"[builderbot] ERROR: {r['error']} (relayed to {bbapi.url()})")
sys.stdout.write(r.get("out") or "")
sys.stderr.write(r.get("err") or "")
sys.stdout.flush()
sys.exit(int(r.get("code") or 0))
PY
}

# run_here ROLE [GLOB...] -- CMD... — `bb run` on the node the session is on:
# the command in this tree, and each output glob's matches into dist/.
run_here() {
    local role="$1" outs=() g f
    shift
    while [ $# -gt 0 ]; do
        case "$1" in --) shift; break ;; *) outs+=("$1"); shift ;; esac
    done
    log "$role: running here, on ${BB_NODE:-this node} — $*"
    local code=0
    "$@" || code=$?
    if [ "$code" -eq 0 ] && [ "${#outs[@]}" -gt 0 ]; then
        mkdir -p dist
        for g in "${outs[@]}"; do
            for f in $g; do
                [ -f "$f" ] || continue
                cp -f "$f" "dist/$(basename "$f")" && log "into dist/: $(basename "$f")"
            done
        done
    fi
    return "$code"
}

# bb settings [--json] — this project's settings, as the dashboard has them:
# node, model, effort, the build and test commands, whether it is locked.
# Read-only, and no verb writes any of it: those are the settings dialog's.
# On a node it is relayed, and it is what bb-tty and bb build read there.
# bb git VERB [ARGS...] — git's network half, run where the credential is.
#
# Rule 2 of docs/nodes.md §20: PATs and deploy keys are set up on the
# controller and nowhere else. A session on a node edits the same tree (the
# projects share, mounted by both machines) but has no key and no token, so
# its push, fetch, pull and ls-remote are relayed to the controller — the
# dispatch below sends the verb whole, and the controller runs THIS function
# in the same directory with the keys it already shields. Plain `git push`
# on a node keeps failing, and bb doctor there says to use this.
#
# The arguments are held to a short list on purpose. git takes options that
# run a program — --upload-pack, --receive-pack, -c core.sshCommand, -o —
# and the process they would run in is the controller's, with its keys in
# reach. So: refspecs and remote names by shape, and a handful of flags by
# name; everything else is refused here, before git sees it, whichever side
# this runs on.
cmd_git() {
    local verb="${1:-}" a
    shift || true
    case "$verb" in
        push|fetch|pull|ls-remote) ;;
        *) die "bb git takes push, fetch, pull or ls-remote — plain git does everything else" ;;
    esac
    for a in "$@"; do
        case "$a" in
            -u|--set-upstream|--tags|--follow-tags|--delete|-d|--dry-run|-n|--prune|-p|--all|\
            --force-with-lease|--ff-only|--rebase|--no-rebase|--heads|--porcelain|-v|--verbose|-q|--quiet) ;;
            -*) die "bb git: '$a' is not accepted — only remote names, refspecs and a few plain flags reach the controller's git" ;;
            ''|*[!A-Za-z0-9._/:+~^@-]*) die "bb git: '$a' is not a remote name or refspec" ;;
        esac
    done
    git "$verb" "$@"
}

# pw_node_path — where require("playwright") looks: the store's own module,
# installed beside the browsers by the playwright recipe, ahead of the
# image's global one. One rule for both machines: a node has only the store's,
# and the controller prefers it so the two drive the same browser revisions.
pw_node_path() {
    local d rest; d="$(sdk_dir playwright 2>/dev/null)/node_modules"
    rest="${NODE_PATH:-/usr/lib/node_modules}"
    if [ -d "$d" ]; then
        case ":$rest:" in *":$d:"*) printf '%s' "$rest" ;; *) printf '%s:%s' "$d" "$rest" ;; esac
    else printf '%s' "$rest"; fi
}

cmd_settings() {
    local proj json=0
    [ "${1:-}" = --json ] && json=1
    proj="${BB_PROJECT:-${BB_VERSION_PROJECT:-}}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    BB_SETTINGS_JSON="$json" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 - "$(dirname "$(readlink -f "$0")")/dashboard" "$proj" <<'PY'
import importlib.util, json, os, sys
here, proj = sys.argv[1], sys.argv[2]
state = os.environ["DASHBOARD_STATE"]
spec = importlib.util.spec_from_file_location("prefs", os.path.join(here, "prefs.py"))
prefs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(prefs)
prefs.configure(state=state, write_json=lambda *a: None)
rec = dict(prefs.get(proj) or {})
try:
    locks = json.load(open(os.path.join(state, "locked-projects.json")))
except (OSError, ValueError):
    locks = []
rec["locked"] = proj in (locks if isinstance(locks, list) else [])
rec["project"] = proj
# The commit identity is the project's own setting (prefs.py), for a session
# on a node to write into the tree it works in (bb-tty's git_identity).
rec["git_name"] = rec.get("git_name") or ""
rec["git_email"] = rec.get("git_email") or ""
if os.environ.get("BB_SETTINGS_JSON") == "1":
    print(json.dumps(rec))
    raise SystemExit(0)
print(f"{proj}:")
for k in ("node", "model", "effort", "build", "test", "outputs", "policy", "locked"):
    v = rec.get(k)
    if v in (None, "", [], False):
        continue
    print(f"  {k:<8} {', '.join(v) if isinstance(v, list) else v}")
PY
}

# bb work — who else is changing this project, and where you overlap.
#
# Two answers, and the first needs nothing to have been recorded: git knows
# what every working tree on this project has uncommitted, and a file changed
# in two of them at once is a collision whatever anybody meant to do. The
# second is the hook's notes, which are finer (a function, where it could
# work one out) and are a guess, and say so.
#
# Read-only and no writing verb: this is somebody asking what they are about
# to walk into, not a place to declare anything.
cmd_work() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/overlap.py"
    [ -f "$py" ] || die "overlap.py is missing from this image"
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    python3 - "$py" "$proj" "${DASHBOARD_STATE:-/config}" "${WORKSPACE:-/workspace}" <<'PY'
import importlib.util, json, sys
mod, proj, state, ws = sys.argv[1:5]
spec = importlib.util.spec_from_file_location("overlap", mod)
o = importlib.util.module_from_spec(spec); spec.loader.exec_module(o)
o.configure(state=state, workspace=ws,
            write_json=lambda p, d: open(p, "w").write(json.dumps(d, indent=2)))
# The account each worktree belongs to, so the answer names people rather than
# ids. Missing users.json is not fatal — the ids are still an answer.
names = {}
try:
    with open(f"{state}/users.json") as f:
        names = {u.get("uid"): n for n, u in (json.load(f).get("users") or {}).items()}
except Exception:
    pass
wt = f"{ws}/.worktrees"
trees = o.trees(proj, wt)
if len(trees) < 2:
    print(f"{proj}: one working tree — nobody else is in it")
else:
    print(f"{proj}: {len(trees)} working trees")
    for label, path in trees.items():
        n = len(o.changed(path))
        print(f"  {names.get(label, label or 'owner'):<20} {n} file(s) uncommitted  {path}")
hits = o.collisions(proj, wt, names)
if hits:
    print("\nthe same file, open in more than one:")
    for h in hits:
        print(f"  {h['file']}  —  {', '.join(h['trees'])}")
elif len(trees) > 1:
    print("\nno file is open in two of them")
notes = o.notes(proj)
if notes:
    print("\nwhat each session last touched (a guess at the symbol, from the edit):")
    for sess, rec in sorted(notes.items()):
        for f, syms in sorted((rec.get("files") or {}).items()):
            print(f"  {names.get(sess, sess):<20} {f}" + (f"  [{', '.join(syms)}]" if syms else ""))
PY
}

cmd_users() {
    local py sub="${1:-list}"
    py="$(dirname "$(readlink -f "$0")")/dashboard/users.py"
    [ -f "$py" ] || die "users.py is missing from this image"
    shift || true
    case "$sub" in
        list|passwd|add) ;;
        token)
            # A session token for one project, the kind bb-tty mints for a
            # session it starts: user rights over that project, an expiry.
            # For the operator proving a node by hand — the node cannot
            # mint one, and BB_TOKEN=… is how bb there reaches the
            # controller — and for the test suite. Never written anywhere.
            #
            # --now prints the token bb would send from here, not a new one:
            # the environment's or the renewed one in the cache, whichever
            # expires later (bb_token_now) — which is the question "why is
            # bb refusing" and "did the renewal land" both come down to.
            if [ "${1:-}" = "--now" ]; then
                local now; now="$(bb_token_now)"
                [ -n "$now" ] || die "no session token here — this is not a session bb-tty started"
                printf '%s\n' "$now"; return 0
            fi
            [ -n "${1:-}" ] || die "which project? bb users token PROJECT [ACCOUNT]"
            [ -d "$WORKSPACE/$1" ] || die "no project called $1 under $WORKSPACE"
            # With an account name the token is FOR that account — what a
            # node-bound terminal gets — and can fetch its Claude login.
            DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$1" "${2:-}" <<'PY'
import importlib.util, json, os, sys
spec = importlib.util.spec_from_file_location("users", sys.argv[1])
users = importlib.util.module_from_spec(spec)
spec.loader.exec_module(users)


# A real write, not a no-op: the signing key is made on first use and kept
# in the store, and a token signed with a key that was never written is one
# the dashboard cannot verify.
def write_json(path, data):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


users.configure(state=os.environ["DASHBOARD_STATE"], write_json=write_json)
uid = ""
if sys.argv[3]:
    uid = (users.load()["users"].get(sys.argv[3]) or {}).get("uid") or ""
    if not uid:
        sys.exit(f"[builderbot] ERROR: no account called {sys.argv[3]}")
print(users.mint_session(sys.argv[2], uid=uid))
PY
            return ;;
        *) die "usage: bb users [list|passwd NAME|add NAME --role admin|user|token PROJECT]" ;;
    esac
    # The password is READ, never an argument: an argument is in the process
    # table for anyone on this box to see, and in the shell history after.
    local pw="" pw2=""
    if [ "$sub" = passwd ] || [ "$sub" = add ]; then
        [ -n "${1:-}" ] || die "which account? bb users ${sub} NAME"
        printf 'password for %s: ' "$1" >&2; read -rs pw; printf '\n' >&2
        printf 'again: ' >&2; read -rs pw2; printf '\n' >&2
        [ "$pw" = "$pw2" ] || die "they do not match"
    fi
    BB_USERS_PW="$pw" DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
        python3 - "$py" "$sub" "$@" <<'PY'
import importlib.util, json, os, sys
spec = importlib.util.spec_from_file_location("users", sys.argv[1])
users = importlib.util.module_from_spec(spec)
spec.loader.exec_module(users)


def write_json(path, data):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


users.configure(state=os.environ["DASHBOARD_STATE"], write_json=write_json)
sub, rest = sys.argv[2], sys.argv[3:]
pw = os.environ.get("BB_USERS_PW", "")
if sub == "list":
    rows = users.all_users()
    if not rows:
        print("no accounts yet — open the dashboard and it will ask you to "
              "make the owner")
    for u in rows:
        seen = "never" if not u["seen"] else f"{(int(__import__('time').time()) - u['seen']) // 86400}d ago"
        projects = ", ".join(u["projects"]) or "-"
        print(f'{u["name"]:<24} {u["role"]:<8} seen {seen:<10} {projects}')
    raise SystemExit(0)
name = rest[0]
if sub == "passwd":
    r = users.set_password(name, pw)
else:
    role = "user"
    if "--role" in rest:
        role = rest[rest.index("--role") + 1]
    # No accounts at all means this is the first one, and the first one is the
    # owner whatever was asked for — a store whose only account cannot
    # administer it is a store nobody can use.
    if not users.all_users():
        with users._lock:
            d = users.load()
            d["users"][name] = {"role": "owner", "projects": ["*"],
                                "password": users.hash_password(pw),
                                "created": int(__import__("time").time()), "seen": 0}
            users._save(d)
        print(f"{name}: created as the owner, since it is the first account")
        raise SystemExit(0)
    r = users.add(name, pw, role=role)
if r.get("error"):
    print(r["error"], file=sys.stderr)
    raise SystemExit(1)
print(f'{name}: {"password changed" if sub == "passwd" else "created"}')
PY
}

cmd_nodes() {
    local py
    py="$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    [ -f "$py" ] || die "nodes.py is missing from this image"
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" <<'PY'
import importlib.util, os, sys, time
spec = importlib.util.spec_from_file_location("nodes", sys.argv[1])
nodes = importlib.util.module_from_spec(spec)
spec.loader.exec_module(nodes)
try:
    nodes.open_readonly(os.environ["DASHBOARD_STATE"])
    rows = nodes.node_list()
except Exception as e:
    print(f"no node store yet — the dashboard creates it on boot ({e})")
    raise SystemExit(0)
# Enrolled machines only. The controller's own record is registry plumbing —
# it is how a share it mounts is recognized as a node's store — and never a
# machine anybody lists: it runs no work and takes no packages.
rows = [n for n in rows if n["kind"] != "local"]
if not rows:
    print("no node is enrolled — the dashboard's Nodes tab mints a token for one")
    print("a project with no node can be read and edited here, and cannot be built")
    raise SystemExit(0)
for n in rows:
    caps = ",".join(n["capabilities"]) or "-"
    ag = n.get("agent") or {}
    where = ag.get("addr") or "-"
    # An agent node is live or quiet by whether it has dialed in lately —
    # derived, never stored, and the one column the row cannot lie about.
    state = n["state"]
    if n["kind"] == "agent" and state != "pending":
        state += (" ✗" if ag.get("revoked") else " ●" if n.get("live") else " ○")
    s = (n.get("reported") or {}).get("sample") or {}
    nums = (f' · cpu {s.get("cpu_pct", 0):.0f}% · {s.get("mem_used_mb", 0) / 1024:.1f}'
            f'/{s.get("mem_mb", 0) / 1024:.0f}GB') if s and n.get("live") else ""
    print(f'{n["id"]:>12}  {state:<10} {n["kind"]:<6} {caps:<24} '
          f'{n["name"]} · {where}{nums}')
PY
}

# The queue, read-only: the recent jobs and what became of them. Same
# read-only opening of the store as `bb nodes`; a session sees what ran and
# where, and stops nothing from here — Cancel is the tab's.
cmd_jobs() {
    local py n=30
    case "${1:-}" in
        -n) n="${2:-30}" ;;
        -h|--help) echo "bb jobs [-n N]   the recent jobs: state, node, what, how it ended"; return 0 ;;
    esac
    py="$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    [ -f "$py" ] || die "nodes.py is missing from this image"
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$n" <<'PY'
import importlib.util, os, sys, time
spec = importlib.util.spec_from_file_location("nodes", sys.argv[1])
nodes = importlib.util.module_from_spec(spec)
spec.loader.exec_module(nodes)
try:
    nodes.open_readonly(os.environ["DASHBOARD_STATE"])
    rows = nodes.jobs_for(n=int(sys.argv[2]))
    names = {x["id"]: x["name"] for x in nodes.node_list(all=True)}
except Exception as e:
    print(f"no node store yet — the dashboard creates it on boot ({e})")
    raise SystemExit(0)
if not rows:
    print("no jobs yet — a compose action, an exec on a node or an agent update makes one")
    raise SystemExit(0)
for j in rows:
    s = j.get("spec") or {}
    what = (f'{s.get("action", "compose")} {j["project"]}'
            + (f'/{s["instance"]}' if s.get("instance") not in (None, "", "main") else "")
            if j["type"] == "compose" else
            "agent self-update" if j["type"] == "self-update" else
            "exec " + " ".join(s.get("argv") or [])[:60])
    state = j["state"] + (" (stopping)" if j["cancel"] and j["state"] == "running" else "")
    if j["state"] == "running" and j.get("step"):
        state += f' · {j["step"]}'
    when = time.strftime("%d %b %H:%M", time.localtime(j["queued"]))
    took = (f' · {max(1, j["ended"] - j["started"])}s'
            if j.get("started") and j.get("ended") else "")
    err = f' — {j["error"]}' if j.get("error") else ""
    print(f'{j["id"]:>12}  {when}  {state:<22} {names.get(j["node"], j["node"] or "any"):<12} '
          f'{what}{took}{err}')
PY
}

# bb run / build / test — a job on the project's node, watched from here.
#
# The tree is edited here and built there (docs/nodes.md §6): the dashboard
# snapshots this project's working tree, dirty edits included, queues an exec
# on the node the project assigns to the role, and this streams the log back
# and exits with the job's exit code. Outputs are globs relative to the
# workspace on the node; what matches comes back into dist/ with its
# provenance beside it. Through the dashboard's API rather than the store
# directly, because the snapshot is the dashboard's to make.
cmd_run() {
    local role=build node="" timeout=3600 outs=() proj auth
    while [ $# -gt 0 ]; do
        case "$1" in
            --role) role="${2:-}"; shift 2 ;;     # build|test: which command bb build/test are
            --node) node="${2:-}"; shift 2 ;;
            --out) outs+=("${2:-}"); shift 2 ;;
            --timeout) timeout="${2:-3600}"; shift 2 ;;
            --) shift; break ;;
            -h|--help)
                echo "bb run [--node NAME] [--out GLOB]... [--timeout S] -- CMD..."
                echo "  snapshot this tree, run CMD on the project's node (its settings dialog), stream the log;"
                echo "  files matching --out come back into dist/. bb build / bb test use the"
                echo "  commands and outputs in the project's settings dialog."
                return 0 ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || die "bb run needs a command after -- (bb run -h)"
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    # ON A NODE THE SESSION IS WHERE THE TOOLCHAIN IS (roadmap #24), so there
    # is nothing to snapshot and nowhere to send it: the command runs here,
    # in this tree, and what --out names is copied into dist/ the way a job's
    # outputs would have come back. No job row — this is a build, and the
    # queue is for work that has to travel.
    if on_node; then
        run_here "$role" "${outs[@]}" -- "$@"
        return
    fi
    auth="$(bb_auth_or_die)"
    BB_RUN_OUTS="$(printf '%s\n' "${outs[@]}")" \
    python3 - "$auth" "$proj" "$role" "$node" "$timeout" "$@" <<'PY'
import os, sys, time
sys.path.insert(0, os.environ["BB_LIB"])
import bbapi                                                    # noqa: E402
auth, proj, role, node, timeout, *argv = sys.argv[1:]
outs = [o for o in os.environ.get("BB_RUN_OUTS", "").split("\n") if o]
call = lambda path, body=None: bbapi.call(path, body, auth=auth)   # noqa: E731
nid = node
if node:
    # A node by name is what a person types; the API takes the id.
    got = call("/api/v1/nodes").get("nodes") or []
    hit = [n for n in got if n["id"] == node or n["name"] == node]
    if not hit:
        sys.exit(f"[builderbot] ERROR: no node called {node} (bb nodes lists them)")
    nid = hit[0]["id"]
r = call("/api/v1/jobs", {"action": "run", "project": proj, "role": role, "node": nid,
                          "argv": argv, "outputs": outs, "timeout": int(timeout),
                          "from": "session" if os.environ.get("CLAUDECODE") else "operator"})
if r.get("error"):
    sys.exit(f"[builderbot] ERROR: {r['error']}")
names = {n["id"]: n["name"] for n in (call("/api/v1/nodes").get("nodes") or [])}
print(f"[builderbot] {r['job']} queued on {names.get(r['node'], r['node'])} — "
      f"snapshot {r['snapshot'][7:19]}, {r['files']} files", flush=True)
shown = 0
state = ""
while True:
    j = call(f"/api/v1/jobs?id={r['job']}")
    if j.get("error"):
        sys.exit(f"[builderbot] ERROR: {j['error']}")
    log = j.get("log") or ""
    if len(log) > shown:
        sys.stdout.write(log[shown:])
        sys.stdout.flush()
        shown = len(log)
    if j["state"] in ("succeeded", "failed", "canceled"):
        state = j["state"]
        break
    time.sleep(1)
arts = [o for o in (j.get("outputs") or []) if o.get("kind") == "artifact"]
kept = [o for o in (j.get("outputs") or []) if o.get("kind") == "workspace"]
line = f"[builderbot] {r['job']} {state}"
if j.get("error"):
    line += f" — {j['error']}"
if arts:
    line += " — into dist/: " + ", ".join(a["path"][5:] for a in arts)
if kept:
    line += f" — workspace kept on the node at {kept[0]['path']}"
print(line, flush=True)
sys.exit(0 if state == "succeeded" else (j.get("exit_code") or 1))
PY
}

# The two named shapes: what the project's settings dialog says a build and
# a test are, with the outputs it lists. Read from the same file the
# dashboard writes, so there is nothing to agree about.
cmd_build_or_test() {
    local role="$1" proj
    shift
    proj="${BB_PROJECT:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    # One value per line: the command first, then each output glob. Read as
    # lines rather than words, because a build command has spaces in it.
    local -a rec
    # From the settings dialog's file here; on a node from `bb settings`,
    # which is the same record relayed from the controller.
    mapfile -t rec < <(BB_PROJECT="$proj" "$0" settings --json 2>/dev/null \
        | BB_ROLE_="$role" python3 -c '
import json, os, sys
try:
    rec = json.load(sys.stdin)
except ValueError:
    rec = {}
print(rec.get(os.environ["BB_ROLE_"]) or "")
for g in rec.get("outputs") or []:
    print(g)
')
    local cmd="${rec[0]:-}"
    [ -n "$cmd" ] || die "no $role command is set for $proj — the operator sets it in the project's settings dialog (Build and test)"
    local -a args=(--role "$role") g
    for g in "${rec[@]:1}"; do [ -n "$g" ] && args+=(--out "$g"); done
    cmd_run "${args[@]}" "$@" -- sh -c "$cmd"
}

# bb ci-labels — the runner labels the registry knows (phase 7), for a
# workflow's runs-on: this container's own while it still runs one, plus
# every node runner's, reported or asked for. --write regenerates
# .github/actionlint.yaml from them, so the file is derived and not hand-kept.
cmd_ci_labels() {
    local write=0
    [ "${1:-}" = "--write" ] && write=1
    local py; py="$(dirname "$(readlink -f "$0")")/dashboard/nodes.py"
    local -a labels=()
    local l
    while IFS= read -r l; do [ -n "$l" ] && labels+=("$l"); done < <(
        { [ -f "$py" ] && DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" <<'PY' 2>/dev/null
import importlib.util, os, sys
spec = importlib.util.spec_from_file_location("nodes", sys.argv[1])
nodes = importlib.util.module_from_spec(spec); spec.loader.exec_module(nodes)
try:
    nodes.open_readonly(os.environ["DASHBOARD_STATE"])
    print("\n".join(nodes.runner_labels_known()))
except Exception:
    pass
PY
        } | awk 'NF && !seen[$0]++')
    if [ "$write" = 1 ]; then
        mkdir -p .github
        { printf '# Labels the runners in BuilderBot'"'"'s registry carry — every node runner'"'"'s;\n'
          printf '# this container runs none. Generated by `bb ci-labels --write`; regenerate rather\n'
          printf '# than edit, so actionlint checks runs-on against what really exists.\n'
          printf 'self-hosted-runner:\n  labels:\n'
          for l in "${labels[@]}"; do printf '    - %s\n' "$l"; done; } > .github/actionlint.yaml
        log "wrote .github/actionlint.yaml with ${#labels[@]} labels"
    else
        printf '%s\n' "${labels[@]}"
    fi
}

cmd_findings() {
    local target="" scope=mine proj lvl="" rule="" fnd=""
    # `bb findings history` reads the notebook's fourth log — what the scanner
    # has stopped and started saying here. Handed straight to the same helper
    # the other three use, so the filters are the ones already learned.
    if [ "${1:-}" = history ]; then
        shift; cmd_findings_history "$@"; return
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
            -a|--all) scope=all ;;
            # The three narrowing filters, matching the Analysis tab's bar so a
            # question answered in the browser is askable here in one line.
            -l|--level) [ $# -ge 2 ] || die "--level needs a value: error, warning or note"
                        lvl="$2"; shift
                        case "$lvl" in error|warning|note|info) ;; \
                            *) die "--level takes error, warning or note (got: ${lvl})" ;; esac ;;
            -r|--rule)  [ $# -ge 2 ] || die "--rule needs a rule id (e.g. DL3008)"
                        rule="$2"; shift ;;
            -f|--find)  [ $# -ge 2 ] || die "--find needs text to search for"
                        fnd="$2"; shift ;;
            -*) die "unknown option: $1" ;;
            *)  target="$1" ;;
        esac
        shift
    done
    target="${target:-${FINDINGS_DIR:-/reports}}"
    command -v jq >/dev/null 2>&1 || die "jq is required for 'bb findings'"

    # SARIF paths are recorded relative to wherever the scanner saw the code,
    # which is not where this container mounts it. Dropping everything up to
    # and including the project directory name makes them repo-relative, so the
    # paths in the digest can be opened directly.
    proj="${FINDINGS_PROJECT:-$(basename "$PWD")}"

    local -a files=()
    if [ -f "$target" ]; then
        files=("$target")
    elif [ -d "$target" ]; then
        mapfile -t files < <(find "$target" -maxdepth 2 -type f \
            \( -name '*.sarif' -o -name '*.sarif.json' \) | sort)
    else
        die "no such file or directory: ${target} (mount your scanner's reports at /reports:ro)"
    fi

    [ "${#files[@]}" -gt 0 ] \
        || die "no .sarif files under ${target} — has the scanner run yet?"

    # When each report was written, and whether it is keeping up with the
    # others. A scanner that dies leaves its PREVIOUS report in place — a host
    # script worth having does not overwrite a good report with nothing — so a
    # dead scanner and a live one look identical here, and the findings in the
    # stale one describe a tree that may since have moved. That is not
    # hypothetical: a trivy that had been crashing for four days was still
    # supplying most of this box's findings, against a directory layout that
    # had been changed in between.
    local newest=0 m
    for f in "${files[@]}"; do
        m="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
        if [ "$m" -gt "$newest" ]; then newest="$m"; fi
    done
    local now lag
    now="$(date +%s)"

    # A day, and the size is the argument. One scan run writes every report
    # within minutes of itself, so anything measured in hours is the same run.
    # Re-running ONE scanner by hand — the obvious thing to do after fixing
    # one — leaves its siblings a few hours behind, and they must not vanish
    # for it. A report left behind by a scanner that failed is behind by a
    # whole cycle, which for any cadence anybody runs is more than this.
    # Matches STALE_AFTER in the dashboard's server.py; the two answer the
    # same question and would be worth nothing if they disagreed.
    local stale_after=86400
    local f
    for f in "${files[@]}"; do
        m="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
        lag=$(( newest - m ))
        if [ "$lag" -ge "$stale_after" ]; then
            # Named on the command line it is still read — one file makes
            # itself the newest, so there is nothing to be behind. That is the
            # way to look at one deliberately.
            printf '<!-- %s — LEFT OUT: %s behind the newest report, its scanner may have failed.\n' \
                "$f" "$(ago "$lag")"
            printf '     Read it anyway with: bb findings %s -->\n' "$f"
            continue
        fi
        printf '<!-- %s — written %s ago -->\n' "$f" "$(ago $(( now - m )))"
        jq -r --arg proj "$proj" --arg scope "$scope" --arg level "$lvl" \
            --arg rule "$rule" --arg find "$fnd" "$FINDINGS_JQ" "$f" \
            || warn "could not parse ${f} as SARIF"
    done
}

# Lint the infrastructure files of the repo at PATH (default: here).
#
# This is the environment's lint, not the project's: shell scripts, Dockerfiles,
# workflows, compose files and XML are what every project in this container
# carries regardless of language, and they are exactly the files whose failures
# otherwise surface for the first time in a CI run. A project's own linters
# (eslint, ruff configs, gradle checks) stay the project's business — they have
# their own configuration and this must not second-guess it.
#
# Each check is skipped, visibly, when its tool is missing — an image from
# before these tools shipped should say so rather than pass by omission.
cmd_lint() {
    local root="${1:-$PWD}" rc=0 skipped=0
    [ -d "$root" ] || die "no such directory: ${root}"
    cd "$root"

    section() { printf '== %s ==\n' "$1"; }
    need() { # need TOOL — false (and say so) when it is not installed
        command -v "$1" >/dev/null 2>&1 && return 0
        if on_node; then
            printf '  [skip] %s is not in this node'"'"'s store — the Tools tab installs lint-tools, with this node picked\n' "$1"
            return 1
        fi
        printf '  [skip] %s is not in this image (predates it? update the container)\n' "$1"
        skipped=1
        return 1
    }
    # Files come from git when this is a repo, so vendored trees a project
    # ignores (node_modules, build output) are not dragged in; otherwise a
    # pruned find covers a directory that never got a .git.
    files() { # files GLOB...
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            git ls-files -z -- "$@" 2>/dev/null
        else
            local -a args=() g
            for g in "$@"; do args+=(-o -path "./$g"); done
            find . \( -name .git -o -name node_modules -o -name _work \) -prune \
                -o -type f \( "${args[@]:1}" \) -print0 2>/dev/null
        fi
    }

    # Shell scripts, by shebang — the same selection CI's lint workflow makes,
    # so passing here means passing there.
    section "shell scripts (shellcheck)"
    if need shellcheck; then
        local -a shells=()
        while IFS= read -r -d '' f; do
            head -c 64 "$f" 2>/dev/null | head -1 | grep -qE '^#!.*\b(ba)?sh\b' \
                && shells+=("$f")
        done < <(files '*')
        # A script embedded in a QUOTED heredoc is a string to the shell and a
        # string to shellcheck, so it was never checked at all — and one of
        # them is vm/provision.sh's bb-sandbox, ~280 lines installed to a
        # root-only path on another machine, where four bugs had been sitting.
        # Extracted by the same rule the list above is built on — a shell
        # shebang on its first line — so this stays a property of the content
        # rather than a list of names to keep up to date. A finding names the
        # extracted copy, whose filename carries the source and the tag.
        local tmpd=""
        if [ "${#shells[@]}" -gt 0 ]; then
            tmpd="$(mktemp -d)"
            while IFS= read -r f; do
                [ -n "$f" ] && shells+=("$f")
            done < <(python3 "${BB_LIB_DIR:-$(dirname "$(readlink -f "$0")")/lib}/embedded-shell.py" \
                             "$tmpd" "${shells[@]}" 2>/dev/null)
        fi
        if [ "${#shells[@]}" -eq 0 ]; then
            echo "  none found"
        elif shellcheck -x -S warning "${shells[@]}"; then
            printf '  [ok]   %s script(s) clean\n' "${#shells[@]}"
        else
            printf '  [FAIL] shellcheck findings above\n'
            rc=1
        fi
        [ -n "$tmpd" ] && rm -rf "$tmpd"
    fi

    section "dockerfiles (hadolint)"
    if need hadolint; then
        local -a dfs=() f
        while IFS= read -r -d '' f; do dfs+=("$f"); done \
            < <(files 'Dockerfile' '*/Dockerfile' 'Dockerfile.*' '*/Dockerfile.*')
        if [ "${#dfs[@]}" -eq 0 ]; then
            echo "  none found"
        # hadolint reads .hadolint.yaml from the working directory on its own.
        elif hadolint "${dfs[@]}"; then
            printf '  [ok]   %s dockerfile(s) clean\n' "${#dfs[@]}"
        else
            printf '  [FAIL] hadolint findings above\n'
            rc=1
        fi
    fi

    section "github workflows (actionlint)"
    if compgen -G '.github/workflows/*.yml' >/dev/null \
        || compgen -G '.github/workflows/*.yaml' >/dev/null; then
        if need actionlint; then
            # A repo declares its runners' labels in .github/actionlint.yaml
            # (`bb ci-labels --write` generates it from the node registry).
            # There is no runner on this container to build a fallback from.
            local -a args=()
            # The workflow files are named explicitly: bare `actionlint` walks
            # up looking for a git repository and refuses a plain directory.
            local -a wfs=()
            local wf
            for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
                [ -e "$wf" ] && wfs+=("$wf")
            done
            if actionlint "${args[@]}" "${wfs[@]}"; then
                echo "  [ok]   workflows clean"
            else
                printf '  [FAIL] actionlint findings above\n'
                rc=1
            fi
            # A committed declaration is checked against the registry (phase
            # 7): a label no runner carries is the "Waiting for a runner"
            # strand, said here. A note, not a failure — the registry is this
            # box's and CI runs the same lint elsewhere.
            if [ -f .github/actionlint.yaml ]; then
                local known declared missing=""
                # Through the dispatch, not the function: on a node the
                # registry is the controller's, and bb ci-labels is relayed
                # there — called direct, it read an empty registry here and
                # called every label unknown.
                #
                # And guarded: under set -e a failing substitution ends the
                # whole lint with nothing said, which is what happened on a
                # node whose session token had expired — the relay refused,
                # and lint stopped after actionlint with no verdict at all.
                # A registry that cannot be read is a note, not a silent exit.
                if known="$(bash "$0" ci-labels 2>/dev/null | tr '\n' ' ')"; then
                    declared="$(sed -n 's/^    - //p' .github/actionlint.yaml)"
                    for l in $declared; do
                        case " $known " in *" $l "*) ;; *) missing="${missing:+$missing, }$l" ;; esac
                    done
                    [ -z "$missing" ] || echo "  [note] actionlint.yaml declares labels no runner in the registry carries: ${missing} — bb ci-labels --write regenerates it"
                else
                    echo "  [note] the runner registry could not be read (bb ci-labels failed), so runs-on labels were not checked against it"
                fi
            fi
            # ...and the other half of the same failure (roadmap #19). A
            # project's node governs BuilderBot's OWN queue — bb build, test,
            # run, emu, compose. GitHub Actions dispatch is GitHub's and reads
            # runs-on only, so nothing connects the two: with a runner on the
            # controller AND on a node, `runs-on: [self-hosted, builderbot]`
            # matches both and GitHub picks whichever is idle — which can be
            # the machine without the toolchain, silently. The node's own name
            # is already a label on its runner, so pinning is one word. This
            # can only ever be advice: the workflow file is the repo's and
            # GitHub reads it, not us.
            local nid; nid="$(project_node)"
            if [ -n "$nid" ]; then
                DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - \
                    "$(dirname "$(readlink -f "$0")")/dashboard/nodes.py" "$nid" <<'PY' 2>/dev/null
import importlib.util, os, pathlib, re, sys
spec = importlib.util.spec_from_file_location("nodes", sys.argv[1])
nodes = importlib.util.module_from_spec(spec); spec.loader.exec_module(nodes)
try:
    nodes.open_readonly(os.environ["DASHBOARD_STATE"])
    label = nodes.node_runner_label(sys.argv[2])
except Exception:
    label = ""
if label:
    # runs-on lines that name self-hosted and NOT this node. A hosted runner
    # (ubuntu-latest) is a deliberate choice and none of this applies to it.
    loose = []
    for f in sorted(pathlib.Path(".github/workflows").glob("*.y*ml")):
        for i, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
            m = re.match(r"\s*runs-on:\s*(.+?)\s*$", line)
            if not m:
                continue
            v = m.group(1)
            # An expression is a deliberate choice of runner made at
            # dispatch (the smoke test does exactly this), so it is not a
            # workflow that forgot to pin.
            if "self-hosted" in v and label not in v and "${{" not in v:
                loose.append(f"{f.name}:{i}")
    if loose:
        print(f"  [note] this project's node is {label}, and "
              f"{len(loose)} workflow job{'s' if len(loose) > 1 else ''} "
              f"do{'' if len(loose) > 1 else 'es'} not pin it "
              f"({', '.join(loose[:6])}{', …' if len(loose) > 6 else ''})")
        print(f"         their runs-on matches every BuilderBot runner, so GitHub sends the")
        print(f"         job to whichever is idle — which may be a machine without the")
        print(f"         toolchain. To land on this project's node:")
        print(f"           runs-on: [self-hosted, {label}]")
PY
            fi
        fi
    else
        echo "  none found"
    fi

    section "compose files (docker compose config)"
    local -a composes=() cf
    while IFS= read -r -d '' cf; do composes+=("$cf"); done \
        < <(files 'docker-compose.yml' 'docker-compose.yaml' 'compose.yml' 'compose.yaml')
    if [ "${#composes[@]}" -eq 0 ]; then
        echo "  none found"
    elif need docker; then
        for cf in "${composes[@]}"; do
            # Validation only — no daemon involved. An .env.example stands in
            # for the gitignored .env so required variables interpolate.
            local -a envarg=()
            [ -f .env ] || { [ -f .env.example ] && envarg=(--env-file .env.example); }
            if docker compose "${envarg[@]}" -f "$cf" config -q 2>&1 | sed 's/^/  /'; then
                printf '  [ok]   %s\n' "$cf"
            else
                printf '  [FAIL] %s\n' "$cf"
                rc=1
            fi
        done
    fi

    section "xml"
    local -a xmls=() x
    while IFS= read -r -d '' x; do xmls+=("$x"); done < <(files '*.xml')
    if [ "${#xmls[@]}" -eq 0 ]; then
        echo "  none found"
    else
        for x in "${xmls[@]}"; do
            # One line on failure, not a traceback — the line and column are
            # the useful part.
            if python3 -c "
import sys, xml.dom.minidom, xml.parsers.expat
try:
    xml.dom.minidom.parse(sys.argv[1])
except xml.parsers.expat.ExpatError as e:
    raise SystemExit(f'  {e}')
" "$x"; then
                printf '  [ok]   %s\n' "$x"
            else
                printf '  [FAIL] %s\n' "$x"
                rc=1
            fi
        done
    fi

    # Only where both halves exist, which is this repo: `bb help` and the
    # README's command list are two copies of one thing, and the copy nobody
    # runs is the one that goes stale — `bb sdk migrate` outlived its code in
    # the README because nothing compared them.
    if [ -f scripts/bb ] && [ -f README.md ] && grep -q '^bb status ' README.md; then
        section "docs (bb help vs README)"
        local missing extra
        missing="$(comm -23 \
            <(sed -n 's/^  bb \([a-z-]*\).*/\1/p' scripts/bb | sort -u) \
            <(sed -n 's/^bb \([a-z-]*\).*/\1/p' README.md | sort -u))"
        extra="$(comm -13 \
            <(sed -n 's/^  bb \([a-z-]*\).*/\1/p' scripts/bb | sort -u) \
            <(sed -n 's/^bb \([a-z-]*\).*/\1/p' README.md | sort -u))"
        if [ -z "$missing" ] && [ -z "$extra" ]; then
            echo "  [ok]   every command in bb help is in the README, and back"
        else
            [ -n "$missing" ] && printf '  [FAIL] in bb help, missing from README: %s\n' "$(echo "$missing" | tr '\n' ' ')"
            [ -n "$extra" ] && printf '  [FAIL] in README, not a bb command: %s\n' "$(echo "$extra" | tr '\n' ' ')"
            rc=1
        fi
    fi

    echo
    if [ "$rc" -ne 0 ]; then
        echo "lint: FAILURES above"
    elif [ "$skipped" -ne 0 ]; then
        echo "lint: clean, but some checks were skipped"
    else
        echo "lint: clean"
    fi
    return "$rc"
}

# ---- developing the container from inside it -----------------------------
# This repo IS the container's source, and the thing every session trips over
# first is that editing a file here changes nothing until an image is built
# and the container updated. These commands shorten that loop where it can be
# shortened — the dashboard is one Python file and one HTML file, nothing to
# compile — and say plainly what is and is not live where it cannot.

# The dashboard server process, by PID. Anchored on the script path so a
# shell whose command line merely mentions the dashboard is never matched —
# an unanchored pkill here once killed the real dashboard and, another time,
# the very shell that ran it.
dashboard_pid() {
    # The flags matter: 15-dashboard.sh starts it as `python3 -u .../server.py`,
    # and a pattern anchored straight from python3 to the path matched nothing —
    # so `bb dashboard dev` said "the dashboard is not running" while it was
    # serving the page you were reading. Anything between python3 and the path
    # is allowed, and the path still has to end at dashboard/server.py.
    pgrep -f '^python3( +-[^ ]+)* +[^ ]*/dashboard/server\.py$' 2>/dev/null | head -1
}

# The directory the running dashboard was started from, read off its command
# line — so "which copy is live" is a fact, not a guess from a marker file.
dashboard_dir() {
    local pid; pid="$(dashboard_pid)" || true
    [ -n "$pid" ] || return 1
    # Same shape as the pattern above: the flags are skipped rather than
    # assumed absent, or the directory comes back with "-u " on the front.
    tr '\0' ' ' < "/proc/$pid/cmdline" \
        | sed -E 's#^python3( +-[^ ]+)* +(.*)/server\.py *$#\2#'
}

cmd_dashboard() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        test)
            # The repo's harness, not the image's: the point is to test the
            # checkout you are editing. Falls back to the installed copy for a
            # bare `bb dashboard test` outside a checkout.
            local here="${BB_REPO:-$PWD}/scripts/dashboard/test/run.sh"
            [ -x "$here" ] || here=/opt/builderbot/scripts/dashboard/test/run.sh
            [ -x "$here" ] || die "no dashboard test harness at $here"
            exec bash "$here" "$@"
            ;;
        dev)
            local dir="${1:-$PWD/scripts/dashboard}" pid env_pid
            if [ "$dir" = "--off" ]; then dir=/opt/builderbot/scripts/dashboard; fi
            dir="$(cd "$dir" 2>/dev/null && pwd)" || die "no such directory: ${1:-$PWD/scripts/dashboard}"
            [ -f "$dir/server.py" ] && [ -f "$dir/index.html" ] \
                || die "$dir does not hold a dashboard (server.py + index.html)"
            pid="$(dashboard_pid)" || true
            [ -n "$pid" ] || die "the dashboard is not running — nothing to swap. It \
is not running; see bb logs."
            env_pid="$pid"
            if [ "$(dashboard_dir)" = "$dir" ]; then
                log "dashboard: already serving from $dir"; return 0
            fi
            # Same environment the running one has — port, terminal port,
            # credential — read from the process, never printed. Only the
            # script changes.
            local envs=()
            while IFS= read -r -d '' kv; do
                case "$kv" in DASHBOARD_*=*|WORKSPACE=*|FINDINGS_DIR=*|BUILDER_HOME=*|BB_LOG_DIR=*) envs+=("$kv") ;; esac
            done < "/proc/$env_pid/environ"
            kill "$pid"
            for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
            # -u CLAUDECODE: this subcommand is usually run *by* a Claude
            # session, and `env` without -i hands the child everything the
            # caller has. The dashboard inheriting that variable makes its own
            # Install button refuse, quoting a message that tells the operator
            # to use the dashboard.
            nohup env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT "${envs[@]}" \
                python3 -u "$dir/server.py" 2>&1 \
                | "$(dirname "$(readlink -f "$0")")/lib/log-split.sh" \
                    "$(bb_log_dir)/dashboard.log" dashboard &
            sleep 1
            [ -n "$(dashboard_pid)" ] || die "the new dashboard did not stay up — see $(bb_log_dir)/dashboard.log"
            log "dashboard: now serving from $dir (pid $(dashboard_pid))"
            log "this lasts until the container restarts; 'bb dashboard dev --off' puts the image's copy back"
            ;;
        status)
            local d; d="$(dashboard_dir)" || { echo "dashboard: not running"; return 0; }
            if [ "$d" = /opt/builderbot/scripts/dashboard ]; then
                echo "dashboard: serving the image's copy ($d)"
            else
                echo "dashboard: serving a DEV copy from $d — 'bb dashboard dev --off' reverts"
            fi
            ;;
        *) die "usage: bb dashboard test|dev|status" ;;
    esac
}

# bb drift — what this checkout has changed that the running container is
# not serving. Compares the image's /opt/builderbot/scripts and the shipped
# templates against the repo's, file by file. Answers the question every
# session asks itself after editing anything here.
cmd_drift() {
    local repo="${1:-$PWD}" n=0
    [ -d "$repo/scripts" ] || die "$repo does not look like the BuilderBot checkout (no scripts/)"
    local pairs=("$repo/scripts:/opt/builderbot/scripts"
                 "$repo/config/templates:/opt/builderbot/templates")
    for pair in "${pairs[@]}"; do
        local src="${pair%%:*}" live="${pair##*:}"
        [ -d "$live" ] || { echo "  (no $live in this image)"; continue; }
        while IFS= read -r line; do
            n=$((n+1)); echo "  $line"
        done < <(diff -rq --exclude='__pycache__' --exclude='test' "$src" "$live" 2>/dev/null \
                 | sed -E "s#^Files $src/(.*) and $live/.* differ#changed: \1#; \
                           s#^Only in $src/?(.*): (.*)#new here: \1/\2#; \
                           s#^Only in $live/?(.*): (.*)#only in image: \1/\2#; s#: /#: #")
    done
    if [ "$n" = 0 ]; then
        echo "no drift: the running container is serving what this checkout holds"
    else
        echo "$n file(s) differ — the running container is NOT serving these; a change is live"
        echo "only after CI builds a new image and the container updates (or 'bb dashboard dev' for the dashboard)"
    fi
    if d="$(dashboard_dir 2>/dev/null)" && [ "$d" != /opt/builderbot/scripts/dashboard ]; then
        echo "dashboard: serving a dev copy from $d"
    fi
}

# Where Chromium actually is, in the order the answers can be trusted:
# PLAYWRIGHT_BROWSERS_PATH (what the image sets and any project honors), then
# the SDK share directly, then the historical /opt path. Resolved rather than
# hardcoded because the browsers moved out of the image: the /opt entry is a
# symlink the startup hook makes, and a hook that could not make it — /opt is
# root-owned — used to leave every screenshot command dead with the bytes
# sitting right there on the share.
find_chromium() {
    local base exe
    for base in "${PLAYWRIGHT_BROWSERS_PATH:-}" "$(sdk_root)/playwright" /opt/pw-browsers; do
        [ -n "$base" ] && [ -d "$base" ] || continue
        exe="$base/chromium"
        [ -x "$exe" ] || exe="$(find -L "$base" -path '*/chromium-*/chrome-linux*/chrome' -type f 2>/dev/null | head -1)"
        [ -n "$exe" ] && [ -x "$exe" ] || continue
        # The browser is in the store but its shared libraries are the
        # machine's: the image installs them (playwright install-deps), a
        # node gets them from the provisioner. Without them Chromium dies
        # at launch behind a Playwright stack that says "browser has been
        # closed" — measured on bb-sandbox, libatk-1.0.so.0 — so the missing
        # ones are named here, before the launch.
        local missing
        missing="$(ldd "$exe" 2>/dev/null | awk '/not found/{print $1}' | head -5 | tr '\n' ' ')"
        if [ -n "$missing" ]; then
            if on_node; then
                die "Chromium is in the store but ${BB_NODE:-this node} lacks its system libraries (${missing% }).
   Re-run vm/provision.sh on it — the session half installs them."
            fi
            die "Chromium is in the store but this image lacks its system libraries (${missing% })"
        fi
        printf '%s' "$exe"; return 0
    done
    die "no Playwright chromium found — install the browsers with: bb sdk install playwright"
}

# bb shot — headless screenshots, for showing the operator visual state from
# a box with no display. Playwright's Chromium from the image.
#
# One URL keeps the old shape (bb shot URL [FILE]). Several URLs share one
# browser and land in a directory, each named from its path (/ -> index.png).
# --full and --scale exist because README screenshots need the whole page at
# 2x — capabilities MediaReducer's tools/screenshots grew privately before
# this subsumed them; --resize is the imagemagick downscale that keeps those
# PNGs repo-sized; --wait absorbs pages whose async fetches settle after
# networkidle, because a screenshot of a spinner is not a screenshot of the
# page. The intended split: a project's own script boots its app into a
# photogenic state, then ends with one bb shot line.
cmd_shot() {
    # The operator's password, or a session's token — whichever this shell
    # has. --auth overrides both.
    local auth="${BB_TOKEN:-${DASHBOARD_AUTH:-}}" width=1280 height=800 scale=1 wait=0
    local full=0 resize="" out="" mode=file urls=()
    # Used by the test harness, which needs the same answer this does and
    # should not re-implement the search to get it.
    if [ "${1:-}" = --print-chromium ]; then find_chromium; printf '\n'; return 0; fi
    if [ "${1:-}" = --print-node-path ]; then pw_node_path; printf '\n'; return 0; fi
    while [ $# -gt 0 ]; do
        case "$1" in
            --auth)   auth="$2"; shift 2 ;;
            --size)   width="${2%x*}"; height="${2#*x}"; shift 2 ;;
            --scale)  scale="$2"; shift 2 ;;
            --wait)   wait="$2"; shift 2 ;;
            --resize) resize="${2%x}"; shift 2 ;;
            --full)   full=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) case "$1" in
                   # Scheme-tagged, because page.goto needs one anyway: a bare
                   # host:port would produce a blank shot, so it is refused
                   # here where the message can say why.
                   http://*|https://*) urls+=("$1") ;;
                   *) [ -z "$out" ] || die "two outputs given: ${out} and $1"
                      out="$1" ;;
               esac; shift ;;
        esac
    done
    [ "${#urls[@]}" -gt 0 ] || die \
        "usage: bb shot URL... [FILE|DIR] [--auth user:pass] [--size WxH] [--full] [--scale N] [--wait MS] [--resize W]
URLs need their scheme (http:// or https://)"
    case "${width}${height}${scale}${wait}${resize}" in
        *[!0-9]*) die "--size WxH, --scale N, --wait MS and --resize W take whole numbers" ;;
    esac
    if [ -n "$resize" ] && ! command -v convert >/dev/null 2>&1; then
        die "--resize needs imagemagick's convert"
    fi

    # One output name only fits one shot; with several URLs (or a trailing
    # slash, or an existing directory) the output is a directory and the
    # names come from the URLs.
    if [ "${#urls[@]}" -gt 1 ]; then
        mode=dir; out="${out:-.}"; mkdir -p "$out"
    elif [ -n "$out" ] && { [ -d "$out" ] || [ "${out%/}" != "$out" ]; }; then
        mode=dir; mkdir -p "$out"
    else
        out="${out:-shot-$(date +%H%M%S).png}"
    fi

    local chrome; chrome="$(find_chromium)"
    local files
    files="$(NODE_PATH="$(pw_node_path)" node - \
        "$chrome" "$auth" "$width" "$height" "$scale" "$wait" "$full" \
        "$mode" "$out" "${DASHBOARD_PORT:-7680}" "${urls[@]}" <<'EOF'
const { chromium } = require("playwright");
const path = require("path");
const [exe, auth, w, h, scale, wait, full, mode, dest, port, ...urls] = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  // Either shape of credential. A session holds a bearer token rather than a
  // password now (bug #16), and splitting on ":" produced no credential at
  // all for one — so a session photographing a dashboard page would have got
  // the LOGIN page and no error, which is the worst way for this to fail.
  const bearer = /^bbs_/.test(auth);
  const [username, password] = !bearer && auth.includes(":")
    ? auth.split(/:(.*)/) : [null, null];
  const header = bearer ? "Bearer " + auth
    : username ? "Basic " + Buffer.from(auth).toString("base64") : "";
  // Credentials go both ways: httpCredentials answers a server that
  // challenges, the preemptive Authorization header satisfies one that
  // deliberately never does (the dashboard, whose challenge-free 401s are
  // what keep browsers from popping their own dialog).
  const ctx = await b.newContext({
    viewport: { width: +w, height: +h },
    deviceScaleFactor: +scale,
    ...(username ? { httpCredentials: { username, password } } : {}) });
  // The header goes to the DASHBOARD and nowhere else. On the context it went
  // to every URL in the run, so `bb shot <dashboard> https://example.com`
  // handed the credential to example.com as well (bug #49). Per-route, matched
  // on origin, so shooting somebody else's page cannot carry it there.
  if (header) {
    const mine = new Set(urls.filter(u => {
      try { return new URL(u).port === String(port); } catch { return false; }
    }).map(u => new URL(u).origin));
    if (mine.size) {
      await ctx.route("**/*", async (route) => {
        let same = false;
        try { same = mine.has(new URL(route.request().url()).origin); } catch {}
        await route.continue(same
          ? { headers: { ...route.request().headers(), authorization: header } }
          : {});
      });
    }
  }
  const p = await ctx.newPage();
  const taken = new Set();
  for (const url of urls) {
    await p.goto(url, { waitUntil: "networkidle" }).catch(() => {});
    if (+wait) await p.waitForTimeout(+wait);
    let out = dest;
    if (mode === "dir") {
      // Named from the path so reruns overwrite their own shots — with a
      // counter only for two URLs that share a path (e.g. differing query).
      const u = new URL(url);
      // No leading dash or dot: "/?view=x" would otherwise slug to
      // "-view-x.png", which convert then parses as an option. Capped at 80
      // because a long query string made a filename longer than the 255 a
      // filesystem takes, and the whole run died on ENAMETOOLONG.
      const s = ((u.pathname + u.search).replace(/^\/+|\/+$/g, "")
        .replace(/[^A-Za-z0-9._-]+/g, "-").replace(/^[-.]+/, "") || "index")
        .slice(0, 80);
      let name = s, n = 2;
      while (taken.has(name)) name = `${s}-${n++}`;
      taken.add(name);
      out = path.join(dest, name + ".png");
    }
    await p.screenshot({ path: out, fullPage: full === "1" });
    console.log(out);
  }
  await b.close();
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
)"
    if [ -n "$resize" ]; then
        # In place: the full-size original is scaffolding, the downscale is
        # the deliverable — keeping both would double the repo cost the flag
        # exists to avoid. -strip drops metadata for the same reason.
        while IFS= read -r f; do
            [ -n "$f" ] && convert "$f" -resize "${resize}x" -strip "$f"
        done <<< "$files"
    fi
    printf '%s\n' "$files"
}

# bb favicon — one SVG mark in, the favicon set a web app actually needs out:
# favicon.ico carrying every small size in one file (the bare /favicon.ico
# request browsers make on their own has no way to ask for a particular one),
# apple-touch-icon.png at 180 for iOS home screens, and the SVG copied
# alongside for browsers that prefer vector.
#
# Rasterized by Playwright's Chromium, packed by ImageMagick — that split
# because the image's ImageMagick writes ICO but carries no SVG delegate,
# and Chromium renders any SVG exactly the way a browser tab will show it.
# The mark itself stays the project's own; this is only the packaging every
# project would otherwise re-learn. (Generalized from the private tool
# MediaReducer grew for this, minus its PIL dependency, which the container
# python does not carry.)
cmd_favicon() {
    local svg="" out="" bg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bg) bg="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) if [ -z "$svg" ]; then svg="$1"; else out="$1"; fi; shift ;;
        esac
    done
    [ -n "$svg" ] || die "usage: bb favicon LOGO.svg [OUTDIR] [--bg COLOR]"
    [ -f "$svg" ] || die "no such file: $svg"
    # Only ever an argv to convert, but a color is a name or #hex, and saying
    # so beats handing ImageMagick something to be confused by.
    case "$bg" in *[!#A-Za-z0-9]*) die "--bg takes a CSS color name or #hex" ;; esac
    out="${out:-.}"
    mkdir -p "$out"
    command -v convert >/dev/null 2>&1 || die "imagemagick's convert is required"
    local chrome; chrome="$(find_chromium)"

    local tmp
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064 # expand the path now, not at trap time
    trap "rm -rf '$tmp'" RETURN
    # A page that is nothing but the mark, edge to edge: Chromium sizes the
    # SVG to the viewport, so the one file serves every raster size.
    {
        printf '<!doctype html><style>html,body{margin:0;height:100%%}svg{display:block;width:100vw;height:100vh}</style>\n'
        cat "$svg"
    } > "$tmp/mark.html"
    NODE_PATH="$(pw_node_path)" node - "$chrome" "$tmp" <<'EOF'
const { chromium } = require("playwright");
const [exe, tmp] = process.argv.slice(2);
(async () => {
  const b = await chromium.launch({ executablePath: exe });
  for (const px of [16, 32, 48, 64, 128, 180, 256]) {
    const p = await b.newPage({ viewport: { width: px, height: px } });
    await p.goto(`file://${tmp}/mark.html`);
    await p.screenshot({ path: `${tmp}/${px}.png`, omitBackground: true });
    await p.close();
  }
  await b.close();
})().catch(e => { console.error(String(e)); process.exit(1); });
EOF
    convert "$tmp/16.png" "$tmp/32.png" "$tmp/48.png" "$tmp/64.png" \
            "$tmp/128.png" "$tmp/256.png" "$out/favicon.ico"
    if [ -n "$bg" ]; then
        # iOS composites the touch icon onto black when it is transparent;
        # --bg flattens it onto the color the caller actually wants.
        convert "$tmp/180.png" -background "$bg" -flatten "$out/apple-touch-icon.png"
    else
        cp "$tmp/180.png" "$out/apple-touch-icon.png"
    fi
    # Copied unless it already IS the output — regenerating in place is the
    # normal workflow and cp would fail on the self-copy.
    [ "$(readlink -f "$svg")" = "$(readlink -f "$out/favicon.svg")" ] \
        || cp "$svg" "$out/favicon.svg"
    log "wrote ${out}/favicon.ico (16-256), apple-touch-icon.png (180), favicon.svg"
}


cmd_doctor() {
    local ok=0
    check() { # check DESCRIPTION COMMAND...
        local desc="$1"; shift
        if "$@" >/dev/null 2>&1; then
            printf '  [ok]   %s\n' "$desc"
        else
            printf '  [FAIL] %s\n' "$desc"; ok=1
        fi
    }
    echo "== doctor =="
    check "claude on PATH"            command -v claude
    check "workspace writable"        test -w "$WORKSPACE"
    check "home writable"             test -w "$HOME"
    check "git identity configured"   git config --get user.email
    # No -f here: we only care that the connection and TLS handshake work.
    # These endpoints answer a bare GET with 4xx, which -f would treat as an error.
    check "anthropic api reachable"   curl -sS -m 10 -o /dev/null https://api.anthropic.com/
    check "github api reachable"      curl -sS -m 10 -o /dev/null https://api.github.com/
    # The daemon the dashboard's dev instances are built and run on: the
    # sandbox VM a node record names. This used to report only a mounted socket,
    # as "docker socket not mounted" — true, and misleading, because it reads
    # as "no docker here" on a box with a working daemon one variable away.
    #
    # The probe is devapp.available(), the same call the Artifacts tab makes on
    # its own poll, so doctor cannot drift into disagreeing with the tab about
    # whether the thing is up.
    local docker_line dst dmsg lib note
    lib="$(dirname "$(readlink -f "$0")")/lib/docker-probe.py"
    docker_line="$(python3 "$lib" \
        "$(dirname "$(readlink -f "$0")")/dashboard/devapp.py" 2>/dev/null \
        | head -1)"
    read -r dst dmsg <<<"$docker_line"
    case "$dst" in
        ok)   printf '  [ok]   %s\n' "$dmsg" ;;
        FAIL) printf '  [FAIL] %s\n' "$dmsg"; ok=1 ;;
        skip) printf '  [skip] %s\n' "$dmsg" ;;
        *)    printf '  [skip] docker daemon: could not be probed\n' ;;
    esac
    # The GPU is a NODE's concern (roadmap #24, 10c): a controller renders
    # nothing — no emulator, no X server — so on one the card is not checked
    # and not missed. The block below runs in the node role, where the
    # emulator does, and on this image that is a container enrolled as a node.
    if on_node; then
    # nvidia-smi is injected by the container runtime, never installed in the
    # image — its absence means no GPU was passed through.
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        printf '  [ok]   nvidia gpu: %s\n' \
            "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        # Compute works with the default capabilities; GL/EGL/Vulkan do not.
        # The vendor ICD only lands when capabilities include graphics, so test
        # for the file rather than trusting the variable.
        if [ ! -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]; then
            printf '  [FAIL] nvidia gpu present but no EGL — set NVIDIA_DRIVER_CAPABILITIES=all\n'
            printf '         (currently %s; compute works, -gpu host does not)\n' \
                "${NVIDIA_DRIVER_CAPABILITIES:-unset, so the default compute,utility applies}"
            ok=1
        # The library being present is not the question anyone is asking. It
        # was reported as [ok] here for months while every attempt at hardware
        # rendering fell back to software, because NVIDIA's EGL also needs an X
        # server carrying its own GLX module and there was none. So ask EGL.
        elif vendor="$(DISPLAY="${DISPLAY:-:0}" gpu_gles_ok)"; then
            printf '  [ok]   nvidia graphics stack usable (EGL vendor: %s)\n' "$vendor"
        elif x_display_up; then
            printf '  [warn] nvidia EGL is installed but gave no vendor driver on the X display\n'
            printf '         — Mesa answering means llvmpipe; the emulator will use software\n'
        else
            printf '  [warn] nvidia EGL is installed but has no display to render on\n'
            note="$(gpu_display_note)"
            [ -n "${note:-}" ] && printf '         the startup hook says: %s\n' "$note"
            printf '         — %s; the emulator will use software (bb emu gpu)\n' \
                "$(command -v Xorg >/dev/null 2>&1 \
                   && { [ -S /tmp/.X11-unix/X0 ] \
                        && echo "the X server started and has gone — a stale socket is all that is left, see /var/log/xorg-builderbot.log" \
                        || echo "the X server did not start, see /var/log/xorg-builderbot.log"; } \
                   || echo "this image has no X server")"
        fi
    elif command -v nvidia-smi >/dev/null 2>&1; then
        printf '  [FAIL] nvidia-smi present but no GPU visible — check --runtime=nvidia --gpus all\n'
        ok=1
    else
        printf '  [skip] no nvidia gpu passed through\n'
    fi
    fi
    if [ -n "${GITHUB_PAT:-}" ]; then
        printf '  [ok]   runner credential: GITHUB_PAT in environment (visible to sessions)\n'
    elif sudo -n /opt/builderbot/scripts/mint-runner-token --check >/dev/null 2>&1; then
        # Presence is not validity — ask GitHub, so a revoked or expired token
        # cannot keep reporting [ok] here.
        if sudo -n /opt/builderbot/scripts/mint-runner-token --validate >/dev/null 2>&1; then
            printf '  [ok]   runner credential: shielded, and GitHub accepts the token\n'
        else
            printf '  [FAIL] runner credential: shielded but GitHub rejected it (revoked/expired?) — see: bb logs\n'
            ok=1
        fi
    else
        printf '  [skip] no runner credential (only needed to install a runner on a node)\n'
    fi
    # `gh auth status`, said as what it is. This line used to read "git over
    # https not authenticated", which is a claim about pushing and this is not
    # a test of pushing: a project with its own token in /config/gitcreds
    # pushes over https perfectly well with gh logged out, and this repo does
    # exactly that. What gh being logged out actually costs is the API — no
    # `gh pr create`, no `gh release create` — and reporting that as broken git
    # sends somebody to fix a credential that is already working.
    if gh auth status >/dev/null 2>&1; then
        printf '  [ok]   gh (the GitHub API) is authenticated\n'
    else
        printf '  [skip] gh (the GitHub API) is not authenticated — no gh pr/release.\n'
        printf '         Git itself is unaffected: it uses an ssh key, or a\n'
        printf '         per-project token from the clone dialog.\n'
    fi
    # And whether THIS repo can actually reach its remote, which is the
    # question the line above was being read as. Per-project tokens made the
    # old answer wrong: the credential is per repository now, so it can only be
    # answered about one.
    local origin cred_project
    origin="$(git remote get-url origin 2>/dev/null || true)"
    case "$origin" in
        https://*)
            cred_project="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo .)")"
            if on_node; then
                printf '  [ok]   pushes go through the controller: bb git push|fetch|pull\n'
                printf '         (no credential lives on a node — plain git push fails here by design)\n'
            elif [ -f "${DASHBOARD_STATE:-/config}/gitcreds/${cred_project}" ]; then
                printf '  [ok]   this repo pushes over https with its own stored token\n'
            else
                printf '  [FAIL] this repo has an https remote and no credential for it\n'
                printf '         — add one in the dashboard, or switch it to ssh\n'
                ok=1
            fi ;;
    esac
    local ssh_src=""
    if ssh-add -l >/dev/null 2>&1; then
        ssh_src="shielded agent key"
    elif compgen -G "$HOME/.ssh/id_*" >/dev/null; then
        ssh_src="key file in ~/.ssh"
    fi
    # Distinguish "no key" from "key loaded but the agent is unreachable from
    # this uid", which is otherwise indistinguishable and very confusing.
    if [ -z "$ssh_src" ] && [ -S "${SSH_AUTH_SOCK:-/run/ssh-agent.sock}" ]; then
        printf '  [FAIL] an agent socket exists but this user cannot use it — see: bb logs | grep ssh\n'
        ok=1
    fi
    if [ -n "$ssh_src" ]; then
        # A successful GitHub ssh auth still exits nonzero (no shell access),
        # so judge by the greeting instead of the exit code. On failure report
        # what ssh actually said — host-key verification, a refused key and an
        # unreachable agent all look identical otherwise.
        local ssh_out ssh_why
        ssh_out="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 git@github.com 2>&1 || true)"
        if printf '%s' "$ssh_out" | grep -q 'successfully authenticated'; then
            printf '  [ok]   github ssh auth works (%s)\n' "$ssh_src"
        else
            ssh_why="$(printf '%s' "$ssh_out" \
                | grep -iE 'permission denied|host key verification|remote host identification|no such identity|sign_and_send|connection closed|could not resolve|timed out' \
                | head -1)"
            printf '  [FAIL] %s but github auth failed: %s\n' \
                "$ssh_src" "${ssh_why:-$(printf '%s' "$ssh_out" | head -1)}"
            printf '         diagnose with: ssh -vT git@github.com\n'
            ok=1
        fi
    else
        printf '  [skip] no ssh key (agent empty, nothing in ~/.ssh)\n'
    fi
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        printf '  [ok]   ANTHROPIC_API_KEY set\n'
    elif [ -f "$HOME/.claude.json" ] || [ -d "$HOME/.claude" ]; then
        printf '  [ok]   Claude Code credentials present in %s\n' "$HOME"
    else
        printf '  [warn] no ANTHROPIC_API_KEY and no saved login — run `bb login`\n'
    fi
    return $ok
}

# Bare `bb` prints what it can do. It used to run `status`, which is the same
# wall of tool versions `bb status` gives you — an answer to a question nobody
# typing `bb` on its own was asking.
# bb version — this project's version identity, in whatever form is asking.
#
# The shell half is deliberately thin: everything that decides what a version
# IS lives in dashboard/version.py, because the notebook needs the same answers
# and two implementations of "what version is this" would drift the week one of
# them was touched. This resolves which project is being asked about and prints
# what the module returns.
cmd_version() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, json, os, sys

spec = importlib.util.spec_from_file_location("version", sys.argv[1])
version = importlib.util.module_from_spec(spec)
spec.loader.exec_module(version)

# The atomic write, from the module beside it rather than a copy per heredoc.
# There were five, all still using a fixed <name>.tmp — the exact collision the
# server's copy was changed away from — and statefile.py carries the file lock
# that stops this process and the dashboard losing each other's writes.
_sfs = importlib.util.spec_from_file_location(
    "statefile", __import__("os").path.join(
        __import__("os").path.dirname(__import__("os").path.abspath(sys.argv[1])),
        "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
write_json = statefile.write_json

# The changelog rides with the version: a bump dates its Unreleased section
# in the same commit, so the module that bumps needs the module that rolls.
_clpath = os.path.join(os.path.dirname(sys.argv[1]), "changelog.py")
_clspec = importlib.util.spec_from_file_location("changelog", _clpath)
changelog = importlib.util.module_from_spec(_clspec)
_clspec.loader.exec_module(changelog)




version.configure(workspace=os.environ.get("BB_WORKSPACE", "/workspace"),
                  state=os.environ.get("DASHBOARD_STATE", "/config"),
                  write_json=write_json, changelog_mod=changelog)

proj, argv = sys.argv[2], sys.argv[3:]

# --for NAME asks about a component: a directory with its own VERSION file.
# Pulled out of argv first so it can sit anywhere, which is what anybody
# typing `bb version --for extension --code` expects.
comp = ""
if "--for" in argv:
    i = argv.index("--for")
    if i + 1 >= len(argv):
        print("--for needs a component directory", file=sys.stderr)
        raise SystemExit(1)
    comp = argv[i + 1]
    argv = argv[:i] + argv[i + 2:]

USAGE = ("bb version [--for DIR] "
         "[--semver|--code|--quad|--win|--msi|--pep440|--file|--json]\n"
         "bb version --list                 every version this repo carries\n"
         "bb version [--for DIR] bump major|minor|patch\n"
         "bb version [--for DIR] init X.Y.Z    give one its first VERSION\n"
         "bb version policy")


def fail(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def policy_line():
    pol = version.policy(proj)
    allowed = version.allows(pol)
    return (f"{pol}" + (f" — a session may move {', '.join(allowed)}"
                        if allowed else " — the operator only"))


if argv and argv[0] == "bump":
    if len(argv) < 2:
        fail("bb version bump major|minor|patch")
    # `by` is not a flag: this runs AS the session, so the only honest value
    # is the one the policy is about. The operator's bumps come from the
    # dashboard, which calls bump() directly.
    r = version.bump(proj, argv[1], by="claude", comp=comp)
    if r.get("error"):
        fail(r["error"])
    print(f"{proj}{'/' + comp if comp else ''} {r['was']} -> {r['target']}  "
          f"({r['part']}, committed {r['commit']}, not pushed)")
    if r.get("note"):
        print(f"note: {r['note']}")
    raise SystemExit(0)

if argv and argv[0] == "unbump":
    r = version.unbump(proj, by="claude", comp=comp)
    if r.get("error"):
        fail(r["error"])
    print(f"{proj}{'/' + comp if comp else ''} {r['was']} -> {r['target']}  "
          f"(returned, committed {r['commit']}, not pushed) — its changelog "
          "section is back in Unreleased")
    raise SystemExit(0)

if argv and argv[0] == "init":
    if len(argv) < 2:
        fail("bb version init X.Y.Z [--for DIR]")
    r = version.init(proj, argv[1], by="claude", comp=comp)
    if r.get("error"):
        fail(r["error"])
    print(f"{proj}{'/' + comp if comp else ''} is now {r['target']}  "
          f"(committed {r['commit']}, not pushed)")
    raise SystemExit(0)

if argv and argv[0] == "policy":
    # Read-only on purpose: a session should be able to see the limit it is
    # held to and never to move it.
    print(f"{proj}: {policy_line()}")
    print("the operator changes this on the project's Artifacts tab")
    raise SystemExit(0)

if argv and argv[0] == "--list":
    # What this repo actually carries. One line for a normal project; more
    # only where somebody put a VERSION file in a subdirectory.
    rows = [("", version.render(proj))] + [
        (c, version.render(proj, c)) for c in version.components(proj)]
    for name, rv in rows:
        label = f"{proj}/{name}" if name else proj
        print(f"  {label:<28} {rv['forms']['semver'] or '(none)'}")
    if len(rows) == 1:
        print("\n  one version for the whole repo. A directory with its own "
              "VERSION\n  file becomes a component with its own — see "
              "`bb version --for DIR`.")
    raise SystemExit(0)

v = version.render(proj, comp)
forms = v["forms"]

if argv and argv[0] == "--json":
    print(json.dumps(v, indent=1))
    raise SystemExit(0)

# --win is an alias rather than its own form: a Windows VERSIONINFO resource
# and a Firefox manifest want the identical four-integer string, and shipping
# two names for one value is cheaper than making somebody work that out.
FLAGS = {"--semver": "semver", "--code": "code", "--quad": "quad",
         "--win": "quad", "--moz": "quad", "--msi": "msi",
         "--pep440": "pep440", "--file": "file"}
if argv:
    key = FLAGS.get(argv[0])
    if key is None:
        fail(USAGE)
    if v.get("error"):
        fail(v["error"])
    if forms[key] is None:
        fail(
             f"no {argv[0]} form here: {proj} has no VERSION file, and that "
             "format cannot be produced without one")
    print(forms[key])
    raise SystemExit(0)

# The human summary.
if v.get("error"):
    print(f"{proj}: {v['error']}")
if forms["semver"]:
    # Not "[released]" beside "+dirty": HEAD being tagged does not make an
    # uncommitted tree the release, and the two claims side by side read as a
    # contradiction because they are one.
    print(f"{proj}{'/' + comp if comp else ''} {forms['semver']}"
          + ("   [released]" if v["released"] and not v["dirty"] else ""))
else:
    print(f"{proj}: no version could be determined")
print("  building towards  " + (
    v["target"] or ("(VERSION is there but unreadable — see above)"
                    if v.get("error") else "(no VERSION file — add one to opt in)")))
if v["ordinal"] is not None:
    print(f"  ordinal           {v['ordinal']}")
if v["sha"]:
    print(f"  commit            {v['sha']}"
          + ("  (working tree dirty)" if v["dirty"] else ""))

# What this container is running, but only where that is a comparison rather
# than a coincidence: BB_VERSION is the image's, and the image is built from
# THIS repo. Beside any other project's version it would be noise.
own = not comp and (version.root(proj) / "config/templates/project-CLAUDE.md").is_file()
running = os.environ.get("BB_VERSION", "").strip()
if own and running:
    print(f"  running here      {running}")
    if forms["semver"] and running != forms["semver"]:
        print("                    differs from this checkout — the box serves"
              " whatever image it last pulled")

print(f"  who may bump      {policy_line()}")

comps = version.components(proj)
if comps and not comp:
    print(f"  components        {', '.join(comps)}"
          f"   (bb version --for {comps[0]})")
since = version.since_bump(proj, comp)
if since.get("commits"):
    print(f"  since that target {since['commits']} commit"
          + ("" if since["commits"] == 1 else "s"))
if v.get("warn"):
    print(f"  warning           {v['warn']}")

other = [(f, forms[k]) for f, k in (("--code", "code"), ("--quad/--win", "quad"),
                                    ("--msi", "msi"), ("--pep440", "pep440"),
                                    ("--file", "file")) if forms[k]]
if other:
    print()
    for flag, val in other:
        print(f"  {flag:<12} {val}")
PY
}

# bb changelog — the user-facing record beside VERSION, per project or
# component. A session logs what changed for the person using the product;
# the next bump dates the accumulated lines. Writing goes through `add` so
# the shape stays uniform; reading is just the file.
cmd_changelog() {
    local py proj
    py="$(dirname "$(readlink -f "$0")")/dashboard/version.py"
    [ -f "$py" ] || die "version.py is missing from this image"
    proj="${BB_VERSION_PROJECT:-}"
    if [ -z "$proj" ]; then
        proj="$(project_here)" \
            || die "not inside a project under ${WORKSPACE} — cd into one first"
    fi
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" \
    BB_WORKSPACE="$WORKSPACE" python3 - "$py" "$proj" "$@" <<'PY'
import importlib.util, os, sys

spec = importlib.util.spec_from_file_location("version", sys.argv[1])
version = importlib.util.module_from_spec(spec)
spec.loader.exec_module(version)

# The atomic write, from the module beside it rather than a copy per heredoc.
# There were five, all still using a fixed <name>.tmp — the exact collision the
# server's copy was changed away from — and statefile.py carries the file lock
# that stops this process and the dashboard losing each other's writes.
_sfs = importlib.util.spec_from_file_location(
    "statefile", __import__("os").path.join(
        __import__("os").path.dirname(__import__("os").path.abspath(sys.argv[1])),
        "statefile.py"))
statefile = importlib.util.module_from_spec(_sfs)
_sfs.loader.exec_module(statefile)
sys.modules["statefile"] = statefile
write_json = statefile.write_json
_clspec = importlib.util.spec_from_file_location(
    "changelog", os.path.join(os.path.dirname(sys.argv[1]), "changelog.py"))
changelog = importlib.util.module_from_spec(_clspec)
_clspec.loader.exec_module(changelog)
version.configure(workspace=os.environ.get("BB_WORKSPACE", "/workspace"),
                  state=os.environ.get("DASHBOARD_STATE", "/config"),
                  write_json=lambda *a: None)

proj, argv = sys.argv[2], sys.argv[3:]
comp = ""
if "--for" in argv:
    i = argv.index("--for")
    if i + 1 >= len(argv):
        print("--for needs a component directory", file=sys.stderr)
        raise SystemExit(1)
    comp = argv[i + 1]
    argv = argv[:i] + argv[i + 2:]

d = version._sub(proj, comp)
if d is None:
    print(f"no such component here: {comp}", file=sys.stderr)
    raise SystemExit(1)

if argv and argv[0] == "add":
    if len(argv) < 2 or not argv[1].strip():
        print('bb changelog add "what changed, for the person using it" '
              '[--for DIR]', file=sys.stderr)
        raise SystemExit(1)
    # Stamped with HEAD: the instruction in the template is to log after
    # committing, so the sha names the commit the entry describes.
    sha = version._git(proj, "rev-parse", "--short=7", "HEAD") or ""
    r = changelog.add(d, argv[1], sha=sha)
    if r.get("error"):
        print(r["error"], file=sys.stderr)
        raise SystemExit(1)
    n = len(changelog.unreleased(d))
    print(f"logged{' (new ' + changelog.FILE + ')' if r.get('created') else ''} — "
          f"{n} unreleased entr{'y' if n == 1 else 'ies'} now waiting for a bump")
    raise SystemExit(0)

if argv:
    print("bb changelog [--for DIR]         read it\n"
          'bb changelog add "..." [--for DIR]   log a user-facing change',
          file=sys.stderr)
    raise SystemExit(1)

text = changelog.read(d)
if text is None:
    print(f"no {changelog.FILE} here yet — the first "
          f"`bb changelog add` creates it")
    raise SystemExit(0)
print(text, end="")
PY
}

# On a node, the verbs whose state is the controller's go there whole (see
# bb_relay); BB_RELAYED marks the controller's own run so a relayed verb that
# calls bb again cannot bounce.
if on_node && [ -z "${BB_RELAYED:-}" ]; then
    # One verb is relayed except for one of its subcommands. `bb tests` reads
    # and writes the registry, which is the controller's; `bb tests run` RUNS
    # a suite, and a suite belongs where the toolchain and the tree are. It
    # relays its own ingest afterwards, which is the half that is state.
    case "${1:-} ${2:-}" in
        "tests run") : ;;
        *)  # ...and that is the whole run: without the exit the dispatch
            # below ran the verb a second time HERE, against files the bundle
            # does not carry — `bb bug` printed the controller's answer and
            # then died with "bugs.py is missing from this image".
            case "$BB_RELAY_VERBS" in
                *" ${1:-help} "*) bb_relay "$@"; exit 0 ;;
            esac ;;
    esac
fi

case "${1:-help}" in
    status)   cmd_status ;;
    settings) shift; cmd_settings "$@" ;;
    version)  shift; cmd_version "$@" ;;
    changelog) shift; cmd_changelog "$@" ;;
    projects) cmd_projects ;;
    shell)    exec bash -l ;;
    update)   cmd_update ;;
    login)    shift; cmd_login "$@" ;;
    emu)      shift; cmd_emu "$@" ;;
    claude-md|claudemd) shift; cmd_claude_md "$@" ;;
    lint)     shift; cmd_lint "$@" ;;
    findings) shift; cmd_findings "$@" ;;
    nodes) shift; cmd_nodes "$@" ;;
    users) shift; cmd_users "$@" ;;
    work)  shift; cmd_work "$@" ;;
    jobs)  shift; cmd_jobs "$@" ;;
    run)   shift; cmd_run "$@" ;;
    git)   shift; cmd_git "$@" ;;
    ci-labels) shift; cmd_ci_labels "$@" ;;
    build) shift; cmd_build_or_test build "$@" ;;
    test)  shift; cmd_build_or_test test "$@" ;;
    # `todo` still works: sessions started before the rename carry it in their
    # prompt, and a live conversation should not break on a word change.
    roadmap|todo) shift; cmd_roadmap "$@" ;;
    bug|bugs) shift; cmd_bug "$@" ;;
    tests)    shift; cmd_tests "$@" ;;
    rules)    shift; cmd_rules "$@" ;;
    history)  shift; cmd_history "$@" ;;
    logs)     shift; cmd_logs "$@" ;;
    catchup)  shift; cmd_catchup "$@" ;;
    ci-log)   shift; cmd_ci_log "$@" ;;
    phone)    shift; cmd_phone "$@" ;;
    doctor)   cmd_doctor ;;
    dashboard) shift; cmd_dashboard "$@" ;;
    drift)    shift; cmd_drift "$@" ;;
    shot)     shift; cmd_shot "$@" ;;
    favicon)  shift; cmd_favicon "$@" ;;
    sdk)      shift; cmd_sdk "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
