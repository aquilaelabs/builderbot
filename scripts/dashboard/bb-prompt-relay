#!/usr/bin/env python3
"""UserPromptSubmit hook: put what was asked into the project's feed, and
bring the session up to date with the notebook on the way past.

On a shared project, what somebody is asking Claude to do is the thing the
others need to know and the thing they otherwise find out at the merge. Three
people on one project, each starting the same refactor, is the failure this
prevents, and it is cheap, because the prompt has already been typed.

THIS IS NOT PRIVATE, and the dashboard says so where the feed is drawn rather
than leaving it to be discovered. A project shared with other accounts is not
a private place to think out loud: your prompts go to the people you share it
with. Nobody else: the feed is readable by whoever may see the project, which
is the same rule as the project itself.

It changes nothing about the prompt itself. A UserPromptSubmit hook can
rewrite or refuse one; this reads it and gets out of the way, and any failure
is swallowed, because a chat line is never worth losing somebody's turn.

WHAT IT DOES PRINT is the other half (roadmap #27). A hook's stdout is added
to the turn as context, which makes this the one place a running session can
be told something for free, with no line typed into its input box, no turn
spent and no interruption mid-task. So when the roadmap or the memories have
moved since this session last heard, one sentence saying so rides along with the
prompt the operator was already sending. That is why the panel does not need
a button for the ordinary case; "Save & tell" is left for the other one,
where somebody wants the session to stop what it is doing and read now.

Which means stdout matters here in a way it did not before: everything
printed reaches the model. Nothing else may be written to it, because a
traceback on stdout would arrive as instructions, which is what the bare
`except` at the bottom is for.
"""
import contextlib
import json
import os
import re
import sys

# Long prompts are trimmed rather than dropped: the first part is what says
# what somebody is doing, and the feed is a glance rather than a transcript.
MAX = 800

# What the HARNESS puts in a turn, which is not what a person asked.
#
# UserPromptSubmit fires for every prompt a session receives, and only some of
# them were typed by somebody. A background command finishing, a file changing
# under an open session, a slash command expanding: each arrives as a turn
# wrapped in one of these, and relaying them filled a project's channel with
# task ids and output paths. That is what it looked like on a phone, and the
# operator's guess was the notebook they happened to be clicking at the time;
# it was this.
#
# Named rather than matched by shape. A pattern for "anything in angle
# brackets" would eat a prompt that quotes XML, which is a normal thing to ask
# about, so a wrapper this does not know leaks once and gets added here,
# which is the failure worth having.
WRAPPERS = ("task-notification", "system-reminder", "command-name",
            "command-message", "command-args", "local-command-stdout",
            "local-command-stderr", "function_results", "function_calls",
            "user-prompt-submit-hook")


def human_part(text):
    """What a person actually typed, or "" when the turn is all machinery.

    The blocks are removed rather than the whole prompt dropped: a real
    message often arrives with a system-reminder stapled to it, and throwing
    that turn away would lose the half worth relaying.
    """
    for tag in WRAPPERS:
        text = re.sub(rf"<{tag}>.*?</{tag}>", " ", text, flags=re.S)
        text = re.sub(rf"<{tag}\b[^>]*/?>", " ", text)
    return text.strip()


def on_node():
    return os.environ.get("BUILDERBOT_ROLE", "").lower() in ("node", "worker", "agent")


def post_hook(body):
    """The controller's hook endpoint, with the session's own token: how a
    session on a node reaches the feed it cannot write (roadmap #24)."""
    here = os.path.dirname(os.path.abspath(__file__))
    sys.path.insert(0, os.path.join(here, "..", "lib"))
    import bbapi                                             # noqa: E402
    return bbapi.call("/api/v1/hook", body,
                      auth="Bearer " + os.environ.get("BB_TOKEN", ""), timeout=10) or {}


def catchup(project, session, prompt="", told=()):
    """(one sentence about what has moved in the notebook since this session
    was last told, or "", and told, so the next prompt does not repeat it;
    on a node, the rules the prompt raises and their names, which ride on
    the same trip).

    Never raises: the caller prints what comes back, and this is on the path
    of every prompt in every session.
    """
    try:
        if on_node():
            r = post_hook({"kind": "seen", "prompt": prompt[:20000], "told": list(told)[:200]})
            return (str(r.get("line") or ""),
                    "\n\n".join(x for x in (str(r.get("rules") or ""), str(r.get("related") or "")) if x),
                    [str(n) for n in r.get("names") or []])
        here = os.path.dirname(os.path.abspath(__file__))
        sys.path.insert(0, here)
        import roadmap                                          # noqa: E402
        import pending                                       # noqa: E402
        roadmap.configure(state=os.environ.get("DASHBOARD_STATE", "/config"),
                       write_json=_write_json)
        # ...and what the operator decided about anything this session had
        # waiting for approval (roadmap #27), told once.
        line = " ".join(x for x in (str(roadmap.catchup(project, session) or ""),
                                    str(pending.settled_line(project) or ""))
                        if x)
        said, names = rules_firing(project, prompt=prompt, told=told)
        # ...and the open items and bugs the prompt names (R202).
        import bugs                                          # noqa: E402
        import preamble                                      # noqa: E402
        import rules                                         # noqa: E402
        bugs.configure(state=os.environ.get("DASHBOARD_STATE", "/config"), write_json=_write_json)
        rules.configure(state=os.environ.get("DASHBOARD_STATE", "/config"), write_json=_write_json)
        preamble.configure(rules_mod=rules, roadmap_mod=roadmap, bugs_mod=bugs)
        related, rnames = preamble.mentioned(project, prompt, told)
        return line, "\n\n".join(x for x in (said, related) if x), names + rnames
    except Exception:                     # noqa: BLE001  (never cost a turn)
        return "", "", []


def _write_json(p, d):
    tmp = f"{p}.new"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, p)


def rules_firing(project, *, prompt="", path="", told=()):
    """(what to say, the names) for the conditional rules this prompt or
    path fires, read from the store here, on the controller. A node asks
    the controller on the `seen` trip every prompt already makes (B686: it
    did not, and since every session runs on a node, a named rule arrived
    on no turn at all).

    Silent on any failure: a hook that cannot read a rule must not cost
    somebody a turn.
    """
    try:
        here = os.path.dirname(os.path.abspath(__file__))
        if here not in sys.path:
            sys.path.insert(0, here)
        import rules                                          # noqa: E402
        rules.configure(state=os.environ.get("DASHBOARD_STATE", "/config"),
                        write_json=_write_json)
        hit = [r for r in rules.matching(project, prompt=prompt, path=path) if r["name"] not in set(told)]
        return rules.said(hit), [r["name"] for r in hit]
    except Exception:                     # noqa: BLE001  (never cost a turn)
        return "", []


def main():
    # `--started PROJECT SESSION`: not a prompt. bb-tty on a node says the
    # session began, which the controller's proxy announces for a local one
    # and cannot see for one on a node. Nothing to read from stdin.
    if sys.argv[1:2] == ["--started"]:
        project = (sys.argv[2:3] or [""])[0]
        if project and on_node():
            post_hook({"kind": "started", "node": os.environ.get("BB_NODE", "")})
        return
    project, session = (sys.argv[1:3] + ["", ""])[:2]
    try:
        req = json.load(sys.stdin)
    except (ValueError, OSError):
        return
    text = human_part(str(req.get("prompt") or ""))
    # The catch-up rides on EVERY prompt, including the ones a person did not
    # type: a turn that arrives as a task notification is still a turn this
    # session is about to spend, and telling it the roadmap moved is worth
    # exactly as much there. Only the relaying below needs a human part.
    if project:
        # ...with any house rule this prompt fires (roadmap #7). A conditional
        # rule is named in the standing block and not quoted there, so this is
        # where its text actually arrives: on the turn somebody asks about the
        # thing it is about. What a person typed (human_part), not the
        # machinery around it: a task notification's "output-file" sent the
        # files rule whole on every background run's end (the operator, 12 Oct,
        # cutting tokens). And once a conversation: the rules it was told are
        # not said again until a summary drops them (bb-rule-hook recall).
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
        import rulehook                                       # noqa: E402
        told = rulehook.fired(project, req.get("session_id"))
        say, fired, names = catchup(project, session, text, told)
        if fired:
            # Remembered for this conversation, so a summary does not drop
            # it (bb-rule-hook recall).
            rulehook.remember(project, req.get("session_id"), names)
        told = "\n\n".join(x for x in (say, fired) if x)
        if told:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                                     "additionalContext": told}}))
    if not text or not project:
        return
    if len(text) > MAX:
        text = text[:MAX].rstrip() + " …"

    if on_node():
        # The feed is the controller's; the token says whose session this
        # is, so the line is filed under the right name there.
        post_hook({"kind": "asked", "text": text})
        return

    here = os.path.dirname(os.path.abspath(__file__))
    sys.path.insert(0, here)
    import chat                                              # noqa: E402
    import users                                             # noqa: E402

    state = os.environ.get("DASHBOARD_STATE", "/config")
    chat.configure(state=state, write_json=_write_json)
    users.configure(state=state, write_json=_write_json)
    who = next((n for n, u in users.load()["users"].items()
                if u.get("uid") == session), session or "somebody")
    chat.post(project, session, f"{who} asked: {text}", kind="asked")


if __name__ == "__main__":
    with contextlib.suppress(Exception):   # never cost a turn
        main()
    sys.exit(0)
