#!/usr/bin/env python3
"""Claude Code hook: nothing runs while BuilderBot is away.

    bb-gate PROJECT SESSION            # PreToolUse: JSON on stdin, refuses with exit 2
    bb-gate --prompt PROJECT SESSION   # UserPromptSubmit: a no-op, kept callable
    bb-gate --turn PROJECT SESSION [--wait SECONDS]
                                       # UserPromptSubmit: wait for a turn on the node
    bb-gate --turn-done PROJECT SESSION
                                       # Stop: the turn is over
    bb-gate --asking PROJECT SESSION   # Notification (permission_prompt): it waits on a person

A session keeps running through a container update: it lives in tmux on the
controller, or on a node that never restarted at all. So the environment it
was briefed with can be a version old by the time its next tool call runs,
and nothing in the session itself would notice. This hook does, and applies
one rule:

- The controller does not answer: it is restarting after an update, or
  down. Every tool is refused until it answers again. There is nothing to
  do but wait, and working blind against a machine that is changing is
  worse than waiting.

There used to be two more, about an environment block from another
compatibility window and one merely behind inside it. Both went with the
block (R63 step 3): what a session is told is assembled per session now, from
the controller, so there is no copy of it anywhere to be stale or from another
window.

The other thing it holds is a node's limit on sessions working at once
(turns.py on the controller, set on the Nodes tab). Before a prompt starts,
--turn asks for a turn; over the limit it waits, asking again every few
seconds, and the prompt goes the moment one is free. It never waits past
--wait, which bb-tty sets under the timeout it gives the hook: a hook killed
by its own timeout would let the prompt through uncounted. Past that, the
prompt is refused with a sentence saying who is working. --turn-done, on
Stop, hands the turn back. Anything that goes wrong asking lets the prompt
through: a limit is worth less than a turn somebody typed.

Cheap on purpose: the controller is asked at most every twenty seconds while
things are fine, and the answer is kept beside the token file. While REFUSING,
every call re-checks, so the first tool call after the fix goes through.
Refuses with exit 2 and the sentence on stderr, which Claude Code hands to the
model; allows with exit 0. Silent on any failure of its own, except the
controller not answering, which is the point.
"""
import http.client
import json
import os
import socket
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
try:
    # A hook runs under a timeout of its own: a call here never waits out a
    # restarting controller (bbapi.request, R251), it says so at once.
    os.environ["BB_CONTROLLER_WAIT"] = "0"
    import bbapi                                                    # noqa: E402
except ImportError:
    bbapi = None

CHECK_EVERY = 20

def _uid():
    """This account's id, which is what separates one account's cache from
    another's: on a node every account's ~/.cache is a symlink to the base
    home's, so the uid in the path is the whole separation (B159)."""
    return os.environ.get("BB_ACCOUNT_UID") or "_none"

def token(project):
    t = os.environ.get("BB_TOKEN", "")
    home = os.environ.get("HOME", "")
    d = os.environ.get("XDG_CACHE_HOME") or (home and os.path.join(home, ".cache")) \
        or f"/tmp/bb-scope-{os.getuid()}"
    try:
        with open(os.path.join(d, "builderbot", "u", _uid(), "project", project, "token")) as f:
            t = f.read().strip() or t
    except OSError:
        pass
    return t


def stamp_file(project):
    home = os.environ.get("HOME", "")
    d = os.environ.get("XDG_CACHE_HOME") or (home and os.path.join(home, ".cache")) \
        or f"/tmp/bb-scope-{os.getuid()}"
    return os.path.join(d, "builderbot", "u", _uid(), "project", project, "gate")


def controller_answers(project):
    """True when the controller is there to answer a status request now.

    Any HTTP answer counts, a refusal included: a session whose token has
    expired is talking to a controller that is up, and telling it BuilderBot
    is restarting sends everybody to look at an update that did nothing. The
    status decides it, never the wording, because the server's refusals are
    sentences ("not signed in") with nothing in them to test for.

    And a slow answer counts too: the connection is made first, on its own,
    and a request that then runs out of time is a controller that is busy,
    not one that is restarting (B719: four calls in a row refused while it
    was up the whole time, the operator watching). Only a connection nobody
    accepts is down."""
    if bbapi is None:
        return True                     # nothing to ask with; never refuse blind
    try:
        c, base = bbapi._conn(8)
        if c.sock is None:              # https is connected in _conn, for the pin
            c.connect()
    except (OSError, http.client.HTTPException):
        return False                    # nothing listening: down or restarting
    try:
        c.request("GET", base + "/api/status", None,
                  {"Authorization": "Bearer " + token(project)})
        c.getresponse().read()
    except socket.timeout:
        return True                     # listening, and slow: busy, not down
    except (OSError, http.client.HTTPException):
        return False
    finally:
        c.close()
    return True


# How often a waiting prompt asks again. The controller drops a waiter that
# has not asked for twenty seconds, so this stays well under that.
ASK_EVERY = 4


def turn(project, wait):
    """0 when this session's prompt may start, 2 with the sentence on stderr
    when it waited `wait` seconds and still may not."""
    if bbapi is None:
        return 0
    deadline = time.time() + max(0, wait)
    auth = "Bearer " + token(project)
    last = {}
    while True:
        status, r = bbapi.request("/api/v1/hook", {"kind": "turn", "agent": AGENT}, auth=auth, timeout=10)
        if status != 200 or not isinstance(r, dict) or r.get("go", True):
            return 0                    # gone, refused, or a turn: the prompt goes
        last = r
        if time.time() + ASK_EVERY > deadline:
            break
        time.sleep(ASK_EVERY)
    bbapi.request("/api/v1/hook", {"kind": "turn-done", "agent": AGENT}, auth=auth, timeout=10)
    if last.get("why"):
        # Something on the node holds every turn (a store moving, R120):
        # said in its own words rather than as a limit.
        sys.stderr.write(f"{last['why']} It waited {int(wait)} seconds; send it again in a while.\n")
        return 2
    n = len(last.get("working") or [])
    sys.stderr.write(
        f"{last.get('node') or 'This node'} lets {last.get('limit')} agent session"
        f"{'' if last.get('limit') == 1 else 's'} work at once, {n} "
        f"{'is' if n == 1 else 'are'} working, and this prompt waited {int(wait)} seconds "
        "for a turn without getting one. Send it again in a while, or ask an "
        "administrator to raise the limit on the Nodes tab.\n")
    return 2


# Which coding agent's session this hook is for (R95 step 7): the launcher's
# BB_AGENT, Claude's when there is none, as a session from before it had.
AGENT = os.environ.get("BB_AGENT") or "claude"


def main():
    args = sys.argv[1:]
    if args[:1] == ["--turn"]:
        wait = 600
        if "--wait" in args:
            try:
                wait = int(args[args.index("--wait") + 1])
            except (IndexError, ValueError):
                pass
        return turn((args[1:2] or [""])[0], wait) if args[1:2] else 0
    if args[:1] == ["--turn-done"]:
        if args[1:2] and bbapi is not None:
            bbapi.request("/api/v1/hook", {"kind": "turn-done", "agent": AGENT},
                          auth="Bearer " + token(args[1]), timeout=10)
        return 0
    if args[:1] == ["--asking"]:
        # Claude Code is waiting on its own permission prompt (B52): said to
        # the controller, so the dock and the bell show the session needs
        # somebody, which its pane title cannot. Claude Code's own words ride
        # along, read from the hook's JSON on stdin.
        if args[1:2] and bbapi is not None:
            try:
                said = str((json.load(sys.stdin) or {}).get("message") or "")[:300]
            except (ValueError, OSError, AttributeError):
                said = ""
            bbapi.request("/api/v1/hook", {"kind": "asking", "text": said, "agent": AGENT},
                          auth="Bearer " + token(args[1]), timeout=10)
        return 0
    if args[:1] == ["--prompt"]:
        # Nothing to say on a prompt any more: the block that could be behind
        # went with R63 step 3, and what a session is told is assembled per
        # session. Kept as a no-op verb because the hook that calls it is
        # written into settings files that outlive this change.
        return 0
    project = (args[:1] or [""])[0]
    if not project:
        return 0
    sf = stamp_file(project)
    now = time.time()
    # Held by the node itself before anything else (R120 step 7): a store
    # moving there, said in the file its agent keeps beside this bundle.
    # Read every call, no network: it holds at once and lifts at once.
    hold = node_hold(now)
    if hold:
        if own_notes():
            return 0
        held_mark(sf, (args[1:2] or [""])[0], True, now)
        sys.stderr.write(
            f"{hold.get('node') or 'This node'} is {hold.get('said') or 'moving its storage'}, "
            f"started {max(1, int(now - float(hold.get('since') or now)) // 60)} min ago. Your "
            "session is kept: nothing that works on the node runs until that is done. Wait and try "
            "again, or write where you are and what is next to your notes (that is allowed) and "
            "end the turn.\n")
        return 2
    last = {}
    try:
        with open(sf) as f:
            last = json.load(f)
    except (OSError, ValueError):
        pass
    # Fine last time, and recently: let it through without asking anybody.
    if last.get("ok") and now - float(last.get("at") or 0) < CHECK_EVERY:
        return 0
    why = ""
    if not controller_answers(project):
        why = ("BuilderBot is not answering: it is restarting after an update, or down. "
               "Nothing that needs it runs until it is back: wait a minute, then try again. "
               "If it stays down, write where you are and what is next to your memory or "
               "your notes (that is allowed), then end the turn: the operator checks the "
               "container, and you pick up from your note.")
    try:
        os.makedirs(os.path.dirname(sf), mode=0o700, exist_ok=True)
        with open(sf, "w") as f:
            json.dump({**last, "ok": not why, "at": now}, f)
    except OSError:
        pass
    if why and own_notes():
        return 0
    held_mark(sf, (args[1:2] or [""])[0], bool(why), now)
    if why:
        sys.stderr.write(why + "\n")
        return 2
    return 0


# Where this node's agent says it holds the node (R120 step 7): beside the
# bundle this gate runs from, <store>/.bb/hold.json, which every session on
# the node reads. A gate run from anywhere else finds none.
HOLD = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "hold.json")
# A hold its agent has not said again in this long was left by one that
# died: it holds nobody.
HOLD_STALE_S = 900


def node_hold(now):
    """The node's hold as its agent wrote it ({node, said, since, updated}),
    or None when there is none or it is stale."""
    try:
        with open(HOLD) as f:
            h = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(h, dict) or now - float(h.get("updated") or 0) > HOLD_STALE_S:
        return None
    return h


def held_mark(sf, session, held, now):
    """Beside the stamp, the mark that this session was held by an outage
    (R251): its node's agent reports it, so once the controller answers again
    the bell lists the sessions an update stopped, with a Resume each. Kept
    from the first refusal; gone with the first call let through after."""
    hf = os.path.join(os.path.dirname(sf), "held")
    try:
        if held:
            if not os.path.exists(hf) and session:
                with open(hf, "w") as f:
                    json.dump({"session": session, "since": int(now)}, f)
        elif os.path.exists(hf):
            os.remove(hf)
    except OSError:
        pass


# What a held session may still do (R251): keep its own notes. Its memory and
# its scratchpad are files on the machine it runs on, nothing the controller
# serves, and refusing them left a session told to wait with nowhere to say
# where it was.
NOTE_TOOLS = {"Write", "Edit", "MultiEdit", "Read", "NotebookEdit"}
# ...each agent's own list of what it is doing (Claude's TodoWrite, Codex's
# update_plan), and each agent's own folder in the home (R95 step 18): an
# edit from Codex or Copilot reaches here as Edit, through bb-agent-hook.
PLAN_TOOLS = {"TodoWrite", "update_plan"}
NOTE_DIRS = (".claude", ".codex", ".copilot")


def own_notes():
    try:
        call = json.load(sys.stdin)
    except (ValueError, OSError):
        return False
    tool = str(call.get("tool_name") or "")
    if tool in PLAN_TOOLS:
        return True
    if tool not in NOTE_TOOLS:
        return False
    path = os.path.realpath(str((call.get("tool_input") or {}).get("file_path")
                                or (call.get("tool_input") or {}).get("notebook_path") or ""))
    home = os.path.realpath(os.environ.get("HOME", "/nonexistent"))
    return bool(path) and (any(path.startswith(os.path.join(home, d) + os.sep) for d in NOTE_DIRS)
                           or path.startswith("/tmp/claude-"))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:                                               # noqa: BLE001
        sys.exit(0)                     # a hook that cannot run is never worth a turn
