#!/usr/bin/env python3
"""Claude's hooks, held for Codex CLI and Copilot CLI (R95 step 6).

    bb-agent-hook AGENT EVENT [PROJECT SESSION]

Codex CLI and Copilot CLI each carry hooks of their own now (Codex's
PreToolUse, UserPromptSubmit, Stop, PermissionRequest and PostCompact;
Copilot's preToolUse, userPromptSubmitted, agentStop and permissionRequest,
checked against 0.163.0 and 1.0.102 on 22 Oct). bb-tty writes them into the
session's own home for the agent (agent_scope), each calling this with the
agent and the event. This reads the agent's payload, says it again in the
shape Claude Code's hooks are written for (tool_name Bash and its command,
Edit and its file_path, the prompt, stop_hook_active), runs the same hooks a
Claude session runs for that event, in the same order, and answers in the
agent's own way: Codex as Claude (exit 2 and the sentence on stderr
refuses), Copilot with its permissionDecision on stdout before a tool.

  pre     before a tool: bb-gate, then bb-rule-hook guard on a command,
          bb-work-note on an edit
  prompt  a prompt sent: bb-prompt-relay, bb-rule-hook prompt, bb-gate --turn
  stop    the turn ends: bb-check-relay, bb-gate --turn-done
  asking  its own permission prompt is up: bb-gate --asking
  recall  after it summarized the conversation: bb-rule-hook recall

Every failure of its own lets the call through, as each hook does: a guard
is never worth an agent that cannot work.
"""
import json
import os
import re
import shlex
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
GATE, NOTE = os.path.join(HERE, "bb-gate"), os.path.join(HERE, "bb-work-note")
RELAY, CHECK = os.path.join(HERE, "bb-prompt-relay"), os.path.join(HERE, "bb-check-relay")
RULE = os.path.join(HERE, "bb-rule-hook")

# The tools each agent runs a command or edits a file with, by the names
# its hooks hand over.
SHELL = {"shell", "exec_command", "local_shell", "bash", "run_shell_command", "Bash"}
EDIT = {"apply_patch", "edit", "create", "write", "str_replace_editor", "write_file", "Edit", "Write"}
PATCH_FILE = re.compile(r"^\*\*\* (?:Update|Add|Delete) File: (.+)$", re.M)


def as_claude(agent, raw):
    """The payload in Claude Code's shape: the fields BuilderBot's hooks read."""
    d = raw if isinstance(raw, dict) else {}
    if agent == "copilot":
        args = d.get("toolArgs")
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = {"command": args}
        out = {"session_id": d.get("sessionId") or "", "cwd": d.get("cwd") or "",
               "tool_name": d.get("toolName") or "", "tool_input": args if isinstance(args, dict) else {},
               "prompt": d.get("prompt") or "", "stop_hook_active": bool(d.get("stopHookActive"))}
    else:
        out = dict(d)
        out.setdefault("tool_input", d.get("tool_input") or {})
    name, spec = str(out.get("tool_name") or ""), out.get("tool_input") or {}
    if name in SHELL:
        cmd = spec.get("command") if isinstance(spec, dict) else spec
        if isinstance(cmd, list):
            # Codex hands a command as its argv, with `bash -lc SCRIPT` the
            # usual shape: the script is what a rule reads.
            cmd = cmd[2] if len(cmd) == 3 and cmd[1] in ("-lc", "-c") else shlex.join(str(x) for x in cmd)
        out["tool_name"], out["tool_input"] = "Bash", {"command": str(cmd or "")}
    elif name in EDIT:
        path = ""
        if isinstance(spec, dict):
            path = spec.get("file_path") or spec.get("path") or spec.get("filePath") or ""
            if not path:
                m = PATCH_FILE.search(str(spec.get("input") or spec.get("patch") or ""))
                path = m.group(1).strip() if m else ""
        elif isinstance(spec, str):
            m = PATCH_FILE.search(spec)
            path = m.group(1).strip() if m else ""
        out["tool_name"], out["tool_input"] = "Edit", {"file_path": path}
    return out


def run(argv, payload, timeout):
    try:
        p = subprocess.run(argv, input=json.dumps(payload), capture_output=True, text=True,
                           timeout=timeout, check=False)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.SubprocessError):
        return 0, "", ""


def plan(event, call, proj, who):
    """The hooks a Claude session runs for this event, in its order: (argv,
    timeout) each."""
    if event == "pre":
        steps = [([GATE, proj, who], 60)]
        if call.get("tool_name") == "Bash":
            steps.append(([RULE, "guard", proj, who], 30))
        if call.get("tool_name") == "Edit" and (call.get("tool_input") or {}).get("file_path"):
            steps.append(([NOTE, proj, who], 30))
        return steps
    if event == "prompt":
        return [([RELAY, proj, who], 30), ([RULE, "prompt", proj, who], 10),
                ([GATE, "--turn", proj, who, "--wait", "840"], 900)]
    if event == "stop":
        return [([CHECK, proj, who], 3600), ([GATE, "--turn-done", proj, who], 30)]
    if event == "asking":
        return [([GATE, "--asking", proj, who], 15)]
    if event == "recall":
        return [([RULE, "recall", proj, who], 30)]
    return []


def main(argv):
    if len(argv) < 2:
        return 0
    agent, event = argv[:2]
    # The project and the account from the session's environment, which
    # bb-tty's launcher sets; a session BuilderBot did not start has none,
    # and its hooks do nothing.
    proj = argv[2] if len(argv) > 2 else os.environ.get("BB_PROJECT", "")
    who = argv[3] if len(argv) > 3 else os.environ.get("BB_AGENT_WHO", "")
    if not proj or not who:
        return 0
    try:
        raw = json.load(sys.stdin)
    except ValueError:
        raw = {}
    call = as_claude(agent, raw)
    said = []
    for cmd, timeout in plan(event, call, proj, who):
        code, out, err = run(cmd, call, timeout)
        if out.strip():
            said.append(out.strip())
        if code == 2:
            reason = err.strip() or "refused by a BuilderBot guard"
            if agent == "copilot" and event == "pre":
                print(json.dumps({"permissionDecision": "deny", "permissionDecisionReason": reason}))
                return 0
            print(reason, file=sys.stderr)
            return 2
    # What a hook had to say to the model (a rule's text, a note), passed on
    # where the agent reads a hook's output; Copilot's before a tool reads
    # only a decision, so nothing goes there.
    if said and not (agent == "copilot" and event == "pre"):
        print(json.dumps({"hookSpecificOutput": {"hookEventName": EVENTS.get(event, event),
                                                 "additionalContext": context(said)}}))
    return 0


# Claude's event names, which a merged answer is given under.
EVENTS = {"pre": "PreToolUse", "prompt": "UserPromptSubmit", "stop": "Stop",
          "asking": "PermissionRequest", "recall": "PostCompact"}


def context(said):
    """What the hooks run for one event said to the model, as one text: each
    hook's additionalContext when it answered in JSON, its words otherwise.
    One answer, since an agent reads one JSON object from a hook."""
    out = []
    for s in said:
        try:
            d = json.loads(s)
            c = ((d.get("hookSpecificOutput") or {}).get("additionalContext")
                 or d.get("additionalContext") or d.get("systemMessage") or "")
            if c:
                out.append(str(c))
        except (ValueError, AttributeError):
            out.append(s)
    return "\n\n".join(out)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
