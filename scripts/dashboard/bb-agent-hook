#!/usr/bin/env python3
"""Claude's hooks, held for Codex CLI, Copilot CLI and Grok Build (R95 steps 6, 21).

    bb-agent-hook AGENT EVENT [PROJECT SESSION]
    bb-agent-hook --claude-settings PROJECT ACCOUNT DIR
    bb-agent-hook --agent-events AGENT
    bb-agent-hook --pack-agent AGENT             a pack agent's adapter, as JSON
    bb-agent-hook --pack-hooks AGENT             its hooks file written in its shape
    bb-agent-hook --pack-launch AGENT            its launcher's lines, for bb-tty

Codex CLI and Copilot CLI each carry hooks of their own now (Codex's
PreToolUse, UserPromptSubmit, Stop, PermissionRequest and PostCompact;
Copilot's preToolUse, userPromptSubmitted, agentStop and permissionRequest,
checked against 0.163.0 and 1.0.102 on 22 Oct; Grok Build's PreToolUse,
UserPromptSubmit, Stop and PostCompact, Claude's own names, read in its user
guide on 25 Oct). bb-tty writes them into the
session's own home for the agent (agent_scope), each calling this with the
agent and the event. This reads the agent's payload, says it again in the
shape Claude Code's hooks are written for (tool_name Bash and its command,
Edit and its file_path, the prompt, stop_hook_active), runs the same hooks a
Claude session runs for that event, in the same order, and answers in the
agent's own way: Codex and Grok as Claude (exit 2 and the sentence on stderr
refuses), Copilot with its permissionDecision on stdout before a tool.

  pre     before a tool: bb-gate, then bb-rule-hook guard on a command,
          bb-work-note on an edit
  prompt  a prompt sent: bb-prompt-relay, bb-rule-hook prompt, bb-gate --turn
  stop    the turn ends: bb-check-relay, bb-gate --turn-done
  asking  its own permission prompt is up: bb-gate --asking
  recall  after it summarized the conversation: bb-rule-hook recall

Every failure of its own lets the call through, as each hook does: a guard
is never worth an agent that cannot work.

A coding agent a vetted pack brings (R169 step 10) is held the same way from
its adapter, which the bundle carries in the pack's row of
config/toolpacks.json: its event names, its payload's shape (snake as
Claude's and Codex's, camel as Grok's and Copilot's) and tool names, and its
hooks file's shape, grouped answering as Claude does and flat as Copilot
does.
"""
import contextlib
import json
import os
import re
import shlex
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))

# The tools each agent runs a command or edits a file with, by the names
# its hooks hand over.
SHELL = {"shell", "exec_command", "local_shell", "bash", "run_shell_command", "run_terminal_command", "Bash"}
EDIT = {"apply_patch", "edit", "create", "write", "str_replace_editor", "write_file", "search_replace", "patch", "Edit", "Write"}
# ...and searches a file's contents with (Codex has none: it runs rg in its
# shell, which the rule guard reads).
GREP = {"grep", "Grep", "search_file_content"}
PATCH_FILE = re.compile(r"^\*\*\* (?:Update|Add|Delete) File: (.+)$", re.M)


SHIPPED = ("claude", "codex", "copilot", "grok", "open")


def packs_file():
    return os.environ.get("BB_TOOLPACKS_JSON") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "config", "toolpacks.json")


def pack_adapter(agent):
    """The adapter of the coding agent a pack in this bundle brings, or None
    (a shipped agent's name is never a pack's)."""
    if agent in SHIPPED or not re.fullmatch(r"[a-z][a-z0-9]{1,15}", str(agent or "")):
        return None
    try:
        with open(packs_file(), encoding="utf-8") as f:
            rows = json.load(f).get("toolchains") or []
    except (OSError, ValueError, AttributeError):
        return None
    for r in rows if isinstance(rows, list) else []:
        if isinstance(r, dict) and r.get("name") == agent and isinstance(r.get("agent"), dict):
            return r["agent"]
    return None


def protocol(agent):
    """How the agent reads a hook's answer: "copilot" (a permissionDecision
    on stdout before a tool) or "claude" (exit 2 and the reason on stderr)."""
    if agent == "copilot":
        return "copilot"
    a = pack_adapter(agent) if agent not in SHIPPED else None
    return "copilot" if a and (a.get("hooks") or {}).get("shape") == "flat" else "claude"


def as_claude(agent, raw):
    """The payload in Claude Code's shape: the fields BuilderBot's hooks read."""
    d = raw if isinstance(raw, dict) else {}
    pack = pack_adapter(agent) if agent not in SHIPPED else None
    tools = (pack.get("hooks") or {}).get("tools") or {} if pack else {}
    if pack and (pack.get("hooks") or {}).get("payload") == "camel":
        agent = "grok"
    if agent == "grok":
        # Grok Build's camelCase, its tool's input an object.
        args = d.get("toolInput")
        d = {"session_id": d.get("sessionId") or "", "cwd": d.get("cwd") or "",
             "tool_name": d.get("toolName") or "", "tool_input": args if isinstance(args, dict) else {},
             "prompt": d.get("prompt") or d.get("userPrompt") or "",
             "stop_hook_active": bool(d.get("stopHookActive"))}
    if agent == "open":
        # OpenCode's plugin (bb-tty writes it): the tool by its name and its
        # arguments as the plugin was handed them.
        args = d.get("args")
        d = {"session_id": d.get("session_id") or "", "cwd": d.get("cwd") or "",
             "tool_name": d.get("tool") or "", "tool_input": args if isinstance(args, dict) else {},
             "prompt": d.get("prompt") or "", "stop_hook_active": False}
    if agent == "copilot":
        args = d.get("toolArgs")
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = {"command": args}
        out = {"session_id": d.get("sessionId") or "", "cwd": d.get("cwd") or "",
               "tool_name": d.get("toolName") or "", "tool_input": args if isinstance(args, dict) else {},
               "prompt": d.get("prompt") or "", "stop_hook_active": bool(d.get("stopHookActive"))}
    else:
        out = dict(d)
        out.setdefault("tool_input", d.get("tool_input") or {})
    name, spec = str(out.get("tool_name") or ""), out.get("tool_input") or {}
    # A pack agent's own tool names, beside the usual ones.
    shell, edit, grep = SHELL | set(tools.get("shell") or ()), EDIT | set(tools.get("edit") or ()), GREP | set(tools.get("grep") or ())
    if name in shell:
        cmd = spec.get("command") if isinstance(spec, dict) else spec
        if isinstance(cmd, list):
            # Codex hands a command as its argv, with `bash -lc SCRIPT` the
            # usual shape: the script is what a rule reads.
            cmd = cmd[2] if len(cmd) == 3 and cmd[1] in ("-lc", "-c") else shlex.join(str(x) for x in cmd)
        out["tool_name"], out["tool_input"] = "Bash", {"command": str(cmd or "")}
    elif name in edit:
        path = ""
        if isinstance(spec, dict):
            path = spec.get("file_path") or spec.get("path") or spec.get("filePath") or ""
            if not path:
                m = PATCH_FILE.search(str(spec.get("input") or spec.get("patch") or ""))
                path = m.group(1).strip() if m else ""
        elif isinstance(spec, str):
            m = PATCH_FILE.search(spec)
            path = m.group(1).strip() if m else ""
        out["tool_name"], out["tool_input"] = "Edit", {"file_path": path}
    elif name in grep:
        pat = spec.get("pattern") or spec.get("query") or "" if isinstance(spec, dict) else str(spec or "")
        out["tool_name"], out["tool_input"] = "Grep", {"pattern": str(pat)}
    return out


SID = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,99}")
UUID_TAIL = re.compile(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$")


def keep(agent, raw):
    """The conversation's log, copied where Claude Code's are (R95 step 8):
    ~/.claude/projects/<the session's tree, slashes as dashes>/<agent>/<id>.jsonl,
    which the projects share or claudesync carries to the controller, where
    bb transcripts and the Sessions view read it. At the end of every turn,
    so the copy is never more than a turn behind. The path the agent named
    when it names one, else where it keeps it; nothing when neither is there."""
    d = raw if isinstance(raw, dict) else {}
    tree, home = os.environ.get("BB_TREE", ""), os.environ.get("HOME", "")
    if not tree or not home or agent == "open":
        # Any model's plugin keeps its own export (opencode export) in the
        # same folder; nothing to copy here.
        return
    pack = pack_adapter(agent)
    if pack:
        # Where its adapter says it keeps a conversation, by the id its
        # payload carries, inside that folder and nowhere else.
        tr = pack.get("transcripts") or {}
        key = tr.get("session_key") or ("sessionId" if (pack.get("hooks") or {}).get("payload") == "camel" else "session_id")
        sid = str(d.get(key) or "")
        base = os.path.realpath(os.path.join(home, tr.get("dir") or ""))
        src = os.path.realpath(os.path.join(base, (tr.get("file") or "").replace("{session}", sid))) if tr.get("dir") and tr.get("file") else ""
        if not src.startswith(base + os.sep):
            return
    elif agent == "copilot":
        sid = str(d.get("sessionId") or "")
        src = str(d.get("transcriptPath") or "") or os.path.join(
            os.environ.get("COPILOT_HOME") or os.path.join(home, ".copilot"), "session-state", sid, "events.jsonl")
    elif agent == "grok":
        # ~/.grok/sessions/<its encoding of the folder>/<id>/updates.jsonl,
        # found by the id rather than by repeating its encoding.
        sid = str(d.get("sessionId") or "")
        base = os.path.join(os.environ.get("GROK_HOME") or os.path.join(home, ".grok"), "sessions")
        src = ""
        if SID.fullmatch(sid):
            with contextlib.suppress(OSError):
                for sub in os.listdir(base):
                    cand = os.path.join(base, sub, sid, "updates.jsonl")
                    if os.path.isfile(cand):
                        src = cand
                        break
    else:
        src = str(d.get("transcript_path") or "")
        m = UUID_TAIL.search(src)
        sid = str(d.get("session_id") or (m.group(1) if m else ""))
    if not SID.fullmatch(sid) or not os.path.isfile(src):
        return
    # Named as Claude Code names a tree's folder (every character not a
    # letter or a digit a dash), which claudesync knows a project's by.
    dest_dir = os.path.join(home, ".claude", "projects", re.sub(r"[^A-Za-z0-9]", "-", tree), agent)
    try:
        os.makedirs(dest_dir, mode=0o700, exist_ok=True)
        tmp = os.path.join(dest_dir, f".bbsync-{sid}")  # claudesync passes these over
        with open(src, "rb") as a, open(tmp, "wb") as b:
            while chunk := a.read(1 << 20):
                b.write(chunk)
        os.chmod(tmp, 0o600)
        os.replace(tmp, os.path.join(dest_dir, f"{sid}.jsonl"))
    except OSError:
        pass


def settle(agent, raw):
    """The copy again a few seconds after the turn's end, and once more
    later, from a child the agent does not wait on: Copilot CLI writes the
    turn's reply after its hook at the end of the turn returns, and Grok
    Build can write a turn's first words after the rest, so a copy taken
    only at the hook missed them until the next turn ended."""
    try:
        if os.fork():
            return
    except OSError:
        return
    try:
        os.setsid()
        fd = os.open(os.devnull, os.O_RDWR)
        for n in (0, 1, 2):
            os.dup2(fd, n)
        for wait in (4, 20):
            time.sleep(wait)
            keep(agent, raw)
    finally:
        os._exit(0)


def wall(path, cwd=""):
    """Why an edit to this path is refused, or "": the lines Claude's deny
    list draws (bb-tty's claude_scope) for an agent whose edits come
    through here (R95 step 17). The session's view already holds no other
    project; what is left is another tree of this one (another person's or
    another agent's worktree, or the owner's checkout seen from a worktree)
    and VERSION, which moves with bb version alone."""
    tree = os.environ.get("BB_TREE", "")
    if not path or not tree:
        return ""
    ws = os.path.normpath(os.environ.get("WORKSPACE") or "/workspace")
    share = os.path.normpath(os.environ.get("BB_CLAUDE_SHARE") or os.path.join(ws, ".claude"))
    p = os.path.normpath(os.path.join(cwd or tree, os.path.expanduser(path)))
    under = lambda d: p == d or p.startswith(d.rstrip("/") + "/")  # noqa: E731
    # A project of several repositories (R136): the others and this
    # session's worktrees of them are its trees as well, as Claude's walls
    # open to them (bb-tty's claude_scope).
    trees = [tree] + [os.path.join(ws, w) for w in os.environ.get("BB_WORKS", "").split()] \
        + os.environ.get("BB_WORK_DIRS", "").split()
    if os.path.basename(p) == "VERSION" and any(under(t) for t in trees):
        return f"{path}: the version moves with bb version, never by an edit (bb version policy says how)"
    if under(ws) and not any(under(t) for t in trees) and not under(share):
        return f"{path} is outside this session's tree ({tree}): another tree is another person's or another session's"
    return ""


def run(argv, payload, timeout):
    try:
        p = subprocess.run(argv, input=json.dumps(payload), capture_output=True, text=True,
                           timeout=timeout, check=False)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.SubprocessError):
        return 0, "", ""


# THE ONE LIST of BuilderBot's hooks: for each event, the scripts a session
# runs, in order, with their arguments, their timeout and the tools they are
# for (none: every call). Claude Code's settings are written from it
# (claude_settings, which bb-tty asks for) and the other agents' calls run
# from it (plan), so a guard added here holds every agent's sessions and one
# cannot be added to only some of them. Each event also says where each
# agent raises it: Claude Code's event name and the matcher that picks it
# out, and Codex's, Copilot's and Grok's event names with the time their call
# here is given (Copilot CLI 1.0.102 has no hook after a summary, so no
# recall; Grok Build none for its permission prompt alone, so no asking).
P, W = "{proj}", "{who}"
HOOKS = {
    "pre": {"claude": ("PreToolUse", None), "codex": ("PreToolUse", 120), "copilot": ("preToolUse", 120),
            "grok": ("PreToolUse", 120), "open": ("tool.execute.before", 120), "steps": [
        ("bb-gate", [P, W], 60, None, None),
        ("bb-work-note", [P, W], 30, ("Edit", "Write", "NotebookEdit"), None),
        ("bb-rule-hook", ["guard", P, W], 30, ("Bash",), None),
        ("bb-rule-hook", ["map", P, W], 30, ("Grep",), None)]},
    # Claude Code waiting on its own permission prompt (B52): said to the
    # controller, so the dock and the bell show it.
    "asking": {"claude": ("Notification", "permission_prompt"), "codex": ("PermissionRequest", 15),
               "copilot": ("permissionRequest", 15), "open": ("permission.ask", 15), "steps": [
        ("bb-gate", ["--asking", P, W], 15, None, None)]},
    "recall": {"claude": ("SessionStart", "compact"), "codex": ("PostCompact", 30), "grok": ("PostCompact", 30),
               "open": ("session.compacted", 30), "steps": [
        ("bb-rule-hook", ["recall", P, W], 30, None, None)]},
    "prompt": {"claude": ("UserPromptSubmit", None), "codex": ("UserPromptSubmit", 900),
               "copilot": ("userPromptSubmitted", 900), "grok": ("UserPromptSubmit", 900), "open": ("chat.message", 900), "steps": [
        ("bb-prompt-relay", [P, W], 30, None, None),
        ("bb-rule-hook", ["prompt", P, W], 10, None, None),
        ("bb-gate", ["--turn", P, W, "--wait", "840"], 900, None, "Waiting for a turn on this node")]},
    "stop": {"claude": ("Stop", None), "codex": ("Stop", 3600), "copilot": ("agentStop", 3600),
             "grok": ("Stop", 3600), "open": ("session.idle", 3600), "steps": [
        ("bb-check-relay", [P, W], 3600, None, None),
        ("bb-gate", ["--turn-done", P, W], 30, None, None)]},
}


def _argv(script, args, proj, who, where=None):
    return [os.path.join(where or HERE, script)] + [proj if a == P else who if a == W else a for a in args]


def plan(event, call, proj, who):
    """The hooks a Claude session runs for this event, in its order: (argv,
    timeout) each. An edit's note needs the file it is about."""
    tool = call.get("tool_name")
    steps = []
    for script, args, timeout, tools, _status in (HOOKS.get(event) or {}).get("steps", []):
        if tools and tool not in tools:
            continue
        if script == "bb-work-note" and not (call.get("tool_input") or {}).get("file_path"):
            continue
        steps.append((_argv(script, args, proj, who), timeout))
    return steps


def claude_settings(proj, who, where):
    """Claude Code's `hooks` settings from the same list, each command under
    `where` (bb-tty's directory by the name that outlives a bundle): one
    group per event and matcher, a step for some tools in a group of its own
    matched on them, as Claude Code runs them."""
    out = {}
    for spec in HOOKS.values():
        name, matcher = spec["claude"]
        groups = out.setdefault(name, [])
        every = {"hooks": []} if matcher is None else {"matcher": matcher, "hooks": []}
        for script, args, timeout, tools, status in spec["steps"]:
            hook = {"type": "command", "command": shlex.join(_argv(script, args, proj, who, where)), "timeout": timeout}
            if status:
                hook["statusMessage"] = status
            if tools:
                groups.append({"matcher": "|".join(tools), "hooks": [hook]})
            else:
                every["hooks"].append(hook)
        if every["hooks"]:
            groups.insert(0, every)
    return out


# How long each event's call is given, for an agent whose hooks file names
# one (a pack agent's): the other agents' own.
TIMEOUTS = {"pre": 120, "prompt": 900, "stop": 3600, "recall": 30, "asking": 15}


def agent_events(agent):
    """[[the agent's event name, this script's event, its timeout]], for
    bb-tty to write into that agent's hooks file."""
    pack = pack_adapter(agent)
    if pack:
        evs = (pack.get("hooks") or {}).get("events") or {}
        return [[evs[ev], ev, TIMEOUTS[ev]] for ev in HOOKS if ev in evs and ev in TIMEOUTS]
    return [[spec[agent][0], ev, spec[agent][1]] for ev, spec in HOOKS.items() if agent in spec]


def pack_hooks(agent, home, cmd):
    """A pack agent's hooks file, written in its shape under `home`: BuilderBot's
    own, so it is replaced whole at each start. The path it wrote, or ""."""
    pack = pack_adapter(agent)
    if not pack:
        return ""
    h = pack.get("hooks") or {}
    base = os.path.realpath(home)
    path = os.path.realpath(os.path.join(base, h.get("file") or ""))
    if not h.get("file") or not path.startswith(base + os.sep):
        return ""
    evs = agent_events(agent)
    if h.get("shape") == "flat":
        doc = {"version": 1, "hooks": {n: [{"type": "command", "bash": f"{cmd} {ev}", "timeoutSec": t}] for n, ev, t in evs}}
    else:
        doc = {"hooks": {n: [{"hooks": [{"type": "command", "command": f"{cmd} {ev}", "timeout": t}]}] for n, ev, t in evs}}
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".new"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        json.dump(doc, f, indent=1)
    os.replace(tmp, path)
    return path


def pack_launch(agent):
    """The lines bb-tty's launcher takes for a pack agent, quoted here: its
    environment words, the briefing its way (from $bf, the briefing's file
    when there is one), the model picked ($am) after its flag, and its
    resume arguments on a respawn. The exec line itself is bb-tty's."""
    pack = pack_adapter(agent)
    if not pack:
        return ""
    q = shlex.quote
    out = [f"export {k}={q(v)}" for k, v in sorted((pack.get("env") or {}).items())
           if re.fullmatch(r"[A-Z][A-Z0-9_]{0,40}", k) and not k.startswith("BB_") and k not in ("PATH", "HOME")]
    b = pack.get("briefing") or {}
    if b.get("how") == "flag-text" and b.get("flag"):
        out.append(f'if [ -n "${{bf:-}}" ] && [ -s "$bf" ]; then extra+=({q(b["flag"])} "$(cat "$bf")"); fi')
    elif b.get("how") == "flag-file" and b.get("flag"):
        out.append(f'if [ -n "${{bf:-}}" ] && [ -s "$bf" ]; then extra+=({q(b["flag"])} "$bf"); fi')
    elif b.get("how") == "env-file" and b.get("env"):
        out.append(f'if [ -n "${{bf:-}}" ] && [ -s "$bf" ]; then export {b["env"]}="$bf"; fi')
    if pack.get("models") and pack.get("model_flag"):
        out.append(f'case " {" ".join(q(m) for m in pack["models"])} " in *" ${{am:-}} "*) ;; *) am="" ;; esac')
        out.append(f'[ -z "${{am:-}}" ] || extra+=({q(pack["model_flag"])} "$am")')
    if pack.get("respawn"):
        out.append(f'if [ "${{1:-}}" = --respawn ]; then extra+=({" ".join(q(w) for w in pack["respawn"])}); fi')
    return "\n".join(out) + "\n"


def main(argv):
    if argv[:1] == ["--claude-settings"] and len(argv) == 4:
        print(json.dumps(claude_settings(*argv[1:])))
        return 0
    if argv[:1] == ["--agent-events"] and len(argv) == 2:
        print(json.dumps(agent_events(argv[1])))
        return 0
    if argv[:1] == ["--pack-agent"] and len(argv) == 2:
        a = pack_adapter(argv[1])
        if not a:
            return 1
        print(json.dumps(a))
        return 0
    if argv[:1] == ["--pack-hooks"] and len(argv) == 2:
        here = os.path.dirname(os.path.abspath(__file__))
        return 0 if pack_hooks(argv[1], os.environ.get("HOME", ""), f"{os.path.join(os.environ.get('BB_HOOKS_DIR') or here, 'bb-agent-hook')} {argv[1]}") else 1
    if argv[:1] == ["--pack-launch"] and len(argv) == 2:
        got = pack_launch(argv[1])
        if not got:
            return 1
        sys.stdout.write(got)
        return 0
    if len(argv) < 2:
        return 0
    agent, event = argv[:2]
    # The project and the account from the session's environment, which
    # bb-tty's launcher sets; a session BuilderBot did not start has none,
    # and its hooks do nothing.
    proj = argv[2] if len(argv) > 2 else os.environ.get("BB_PROJECT", "")
    who = argv[3] if len(argv) > 3 else os.environ.get("BB_AGENT_WHO", "")
    if not proj or not who:
        return 0
    try:
        raw = json.load(sys.stdin)
    except ValueError:
        raw = {}
    call = as_claude(agent, raw)
    if event == "stop":
        keep(agent, raw)
        settle(agent, raw)
    said = []
    why = wall((call.get("tool_input") or {}).get("file_path", ""), call.get("cwd") or "") \
        if event == "pre" and call.get("tool_name") == "Edit" else ""
    proto = protocol(agent)
    if why:
        if proto == "copilot":
            print(json.dumps({"permissionDecision": "deny", "permissionDecisionReason": why}))
            return 0
        print(why, file=sys.stderr)
        return 2
    for cmd, timeout in plan(event, call, proj, who):
        code, out, err = run(cmd, call, timeout)
        if out.strip():
            said.append(out.strip())
        if code == 2:
            reason = err.strip() or "refused by a BuilderBot guard"
            if proto == "copilot" and event == "pre":
                print(json.dumps({"permissionDecision": "deny", "permissionDecisionReason": reason}))
                return 0
            print(reason, file=sys.stderr)
            return 2
    # What a hook had to say to the model (a rule's text, a note), passed on
    # where the agent reads a hook's output; Copilot's before a tool reads
    # only a decision, so nothing goes there.
    if said and not (proto == "copilot" and event == "pre"):
        print(json.dumps({"hookSpecificOutput": {"hookEventName": EVENTS.get(event, event),
                                                 "additionalContext": context(said)}}))
    return 0


# Claude's event names, which a merged answer is given under.
EVENTS = {"pre": "PreToolUse", "prompt": "UserPromptSubmit", "stop": "Stop",
          "asking": "PermissionRequest", "recall": "PostCompact"}


def context(said):
    """What the hooks run for one event said to the model, as one text: each
    hook's additionalContext when it answered in JSON, its words otherwise.
    One answer, since an agent reads one JSON object from a hook."""
    out = []
    for s in said:
        try:
            d = json.loads(s)
            c = ((d.get("hookSpecificOutput") or {}).get("additionalContext")
                 or d.get("additionalContext") or d.get("systemMessage") or "")
            if c:
                out.append(str(c))
        except (ValueError, AttributeError):
            out.append(s)
    return "\n\n".join(out)


