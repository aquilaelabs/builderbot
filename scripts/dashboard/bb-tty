#!/usr/bin/env bash
#
# The command ttyd runs for every browser connection.
#
# ttyd is started with --url-arg, so the browser controls this script's only
# argument via ?arg=... That argument is attacker-controlled in the sense that
# matters: it never reaches a shell (ttyd execs directly), and a project name
# is checked against the directories that actually exist rather than trusted as
# a path. Anyone reaching this is already authenticated and already entitled to
# a shell, so the goal is not privilege containment — it is making a mistyped
# URL fail cleanly instead of starting something surprising.
#
# Everything runs inside tmux so a closed browser tab detaches rather than
# kills. A Claude session surviving a dropped connection is the entire reason
# this is not a bare shell.
#
set -euo pipefail
# Beside this script rather than by absolute path. In the image the two are the
# same file — this lives at /opt/builderbot/scripts/dashboard/bb-tty — and out
# of it, the checkout's copy runs from the checkout, which is what lets the
# dashboard suite drive this script at all.
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

target="${1:-shell}"

# Projects the operator has excluded. Shared with the dashboard, which writes
# it; enforced here, because a rule only the UI honors is a suggestion — the
# ttyd URL is reachable directly.
EXCLUDES_FILE="${DASHBOARD_STATE:-/config}/excluded-projects.json"

is_excluded() {
    [ -f "$EXCLUDES_FILE" ] || return 1
    jq -e --arg n "$1" 'index($n) != null' "$EXCLUDES_FILE" >/dev/null 2>&1
}

# Every project directory except this one. Excluded by exact path rather than
# `-not -name "$1"`, because find treats that as a glob: a project called
# `app[1]` or `web*` would silently exclude its neighbors from the deny list,
# which is the one direction this must not fail in.
siblings_of() {
    find "$WORKSPACE" -maxdepth 1 -mindepth 1 -type d \
        -not -name '_work' -printf '%p\n' 2>/dev/null \
        | { grep -vxF "$WORKSPACE/$1" || true; }   # sole project: no siblings
}

# claude_scope PROJECT — write a settings file that walls this session into its
# own directory, and echo the path.
#
# Passed with --settings, which ranks as a command-line argument: above the
# project's own .claude/settings.json and .claude/settings.local.json, so a
# session cannot widen its own boundary by editing files in the repo it is
# working on. Only the managed policy file outranks it, and that is root-owned.
#
# This binds the file tools. It is a guardrail against a session wandering into
# the wrong tree by mistake, not a sandbox: Bash still reaches the filesystem,
# and the only hard boundary is not mounting the other projects at all.
claude_scope() {
    local proj="$1" dir out tmp
    # One file per project, rewritten each time rather than a fresh temp file:
    # ttyd runs this script on every browser connection, including a reattach,
    # so mktemp here would drop a file per page load. Under the cache dir
    # because it is this user's, not world-writable /tmp.
    # A per-uid directory rather than a shared /tmp path when HOME is unset,
    # so this never writes somewhere another user could have prepared.
    dir="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
    dir="${dir:-/tmp/bb-scope-$(id -u)}/builderbot"
    mkdir -p "$dir" 2>/dev/null || { dir="/tmp/bb-scope-$(id -u)"; mkdir -p "$dir"; }
    out="$dir/claude-scope-${proj}.json"

    # Read for reading, Edit for every tool that writes. Two eras of Claude
    # Code semantics meet here, and both left a mark. Originally a rule named
    # one tool — Read and Edit did not cover Write — so the first version of
    # this left a session able to CREATE a file in a sibling project, and the
    # fix was four rules per path (Write, and NotebookEdit, the same tool
    # wearing a different name for .ipynb). Claude Code has since inverted
    # that: an Edit(path) rule now covers ALL file-editing tools, and a
    # Write() or NotebookEdit() rule is IGNORED with a startup warning — a
    # wall of yellow at the top of every session, one line per dead rule.
    # So: Edit carries the whole write-side deny, and the two dead spellings
    # are gone. If the semantics ever move again, the warning wall is the
    # tell, and this comment is the map.
    #
    # Build beside the target and move into place. Writing straight to $out
    # would leave a truncated file if jq failed, and claude would then be
    # handed a settings file that is not JSON.
    tmp="$out.new"
    # The project's own VERSION file is denied too, and it is the one entry
    # here that points INSIDE the project rather than outside it. The version
    # is the operator's claim about their own work: they move it from the
    # dashboard, and a session that may move it does so through
    # `bb version bump`, which checks the per-project policy first. Editing the
    # file directly would walk straight past that check.
    #
    # Both forms, because a repo that ships two products has a VERSION per
    # component: denying only the root one would leave `extension/VERSION`
    # editable and the policy walked straight past.
    #
    # Read is deliberately not denied — a session should be able to see the
    # version it is working against, and `bb version` prints it anyway.
    #
    # Same caveat as every rule in this file: it binds the file tools, not
    # Bash. `echo 0.5.0 > VERSION` still works. This makes the sanctioned path
    # the easy one; the record that makes a bad bump recoverable is that
    # VERSION is committed and `git log` says who moved it.
    if siblings_of "$proj" | jq -R . | jq -s --arg ws "$WORKSPACE" --arg proj "$proj" '
           {permissions: {
              additionalDirectories: [],
              deny: (map("Read(\(.)/**)", "Edit(\(.)/**)")
                     + ["Read(\($ws)/_work/**)", "Edit(\($ws)/_work/**)",
                        "Edit(\($ws)/\($proj)/VERSION)",
                        "Edit(\($ws)/\($proj)/**/VERSION)"])
           }}' > "$tmp" && [ -s "$tmp" ]; then
        mv -f "$tmp" "$out"
        printf '%s' "$out"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# claude_launcher PROJECT COMMAND... — write COMMAND as a script and echo its
# path, so tmux is handed one short argument instead of the whole command line.
#
# tmux's client sends `new-session`'s arguments to the server in a single
# message capped at 16KB, and answers a longer one with `command too long` and
# nothing else. The system prompt this appends carries the project's roadmap
# and open bugs — every item, its details, and every step's details — so it
# grows with the project, and a big enough notebook silently made every Claude
# session on that project unstartable: bb-tty exited on the failed
# new-session, ttyd reconnected five seconds later, and the pane filled with
# `command too long` over and over. Measured on tmux 3.4: 16000 bytes of
# argument starts, 20000 does not.
#
# One file per project, rewritten on every connection, in the same cache dir
# and for the same reason as claude_scope's settings: this runs on every
# browser connection, and mktemp here would leave a file per page load. The
# name begins with `claude-` deliberately — the session-is-really-claude check
# below reads pane_start_command, which is now this path.
claude_launcher() {
    local proj="$1"; shift
    local dir out tmp
    dir="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
    dir="${dir:-/tmp/bb-scope-$(id -u)}/builderbot"
    mkdir -p "$dir" 2>/dev/null || { dir="/tmp/bb-scope-$(id -u)"; mkdir -p "$dir"; }
    out="$dir/claude-run-${proj}.sh"
    tmp="$out.new"
    # %q so the command survives being written down and read back as shell —
    # the system prompt is somebody's prose, with quotes and newlines in it.
    # exec, so nothing sits between tmux and claude: the pane's process is the
    # conversation, which is what the shutdown's TERM and the pane's pid mean.
    {
        printf '#!/usr/bin/env bash\n'
        printf '# Written by bb-tty each time a session for %s is opened.\n' "$proj"
        printf '# tmux takes a command in one 16KB message; this is how a long\n'
        printf '# system prompt gets past that. Not edited by hand — it is\n'
        printf '# overwritten on the next connection.\n'
        printf 'exec'
        printf ' %q' "$@"
        printf '\n'
    } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    chmod +x "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$out" 2>/dev/null || { rm -f "$tmp"; return 1; }
    printf '%s' "$out"
}

# bad MESSAGE... — fail visibly. ttyd closes the connection the moment this
# exits, so without the pause the browser shows an empty terminal and no reason.
bad() {
    for line in "$@"; do echo "$line" >&2; done
    sleep 10
    exit 1
}

# start SESSION DIR [COMMAND...] — attach to a session, creating it if needed,
# with the settings this dashboard depends on applied to it.
#
# Applied here rather than left to ~/.tmux.conf because that file lives on a
# persistent volume: an install upgraded from an older image still has the one
# BuilderBot used to write directly, which sets `mouse on` and never sources the
# file we own now. Set on the session itself, this holds whatever the config
# said, which is what a behavior the page promises has to do.
# Which run of the container this is, by the same rule server.py uses: pid 1's
# start time paired with the host's boot time, so it changes when the container
# is recreated and not when the dashboard is merely restarted.
boot_id() {
    local start btime
    start="$(sed 's/^.*) //' /proc/1/stat 2>/dev/null | awk '{print $20}')"
    btime="$(awk '/^btime /{print $2}' /proc/stat 2>/dev/null)"
    [ -n "$start" ] && [ -n "$btime" ] && printf '%s.%s' "$btime" "$start"
}

start() {
    local s="$1" dir="$2"; shift 2
    # tmux rewrites `.` and `:` in a session name to `_` (they are its target
    # syntax) without saying so, so a project called `example.com` would run
    # as `claude-example_com` while everything addressing it by the name it
    # asked for — the page's kill/keys/macros, the server's exclude — missed.
    # The substitution is made here, on purpose, and mirrored by tmux_name()
    # in server.py and tmuxName() in index.html: three places, one rule.
    s="${s//[.:]/_}"
    # -A -d creates it if it is missing and attaches to it if it is not, without
    # attaching yet — race-free where has-session followed by new-session is not.
    tmux new-session -A -d -s "$s" -c "$dir" "$@"

    # Mouse mode decides who owns a drag. Off, the browser makes an ordinary
    # selection and the terminal copies it as the button comes up. On, tmux
    # takes the drag and the text reaches a tmux buffer the browser cannot see.
    # Shells want the clipboard; Claude's interface wants the mouse.
    # Plain name, not tmux's `=exact` prefix: set-option rejects that form
    # ("no such session: =shell"), and the session was just created here, so an
    # exact match is the one it resolves to anyway.
    case "$s" in
        claude-*) tmux set-option -t "$s" mouse on ;;
        *)        tmux set-option -t "$s" mouse off ;;
    esac

    # tmux's own right-click menu is drawn in the terminal, underneath the
    # browser's context menu, which covers it — two menus for one click, and
    # only one of them dismissable. The browser's cannot be suppressed from
    # here (the terminal is served from its own port and is a cross-origin
    # frame), so the one we control is the one that goes.
    tmux unbind-key -n MouseDown3Pane 2>/dev/null || true
    tmux unbind-key -n MouseDown3Status 2>/dev/null || true
    tmux unbind-key -n MouseDown3StatusLeft 2>/dev/null || true
    tmux unbind-key -n MouseDown3StatusRight 2>/dev/null || true

    exec tmux attach-session -t "$s"
}

case "$target" in
    shell)
        start shell "$WORKSPACE"
        ;;

    # sh:N:PROJECT — an additional numbered terminal, so the Shell button can
    # open several at once instead of returning to the same one. An empty
    # PROJECT means the workspace root.
    sh:*)
        rest="${target#sh:}"
        num="${rest%%:*}"
        proj="${rest#*:}"
        case "$num" in
            ''|*[!0-9]*) bad "Invalid terminal number: ${num}" ;;
        esac
        if [ -z "$proj" ]; then
            start "shell-${num}" "$WORKSPACE"
        fi
        dir="$WORKSPACE/$proj"
        [ "$proj" = "$(basename -- "$proj")" ] && [ -d "$dir" ] \
            || bad "No such project: ${proj}"
        start "shell-${proj}-${num}" "$dir"
        ;;

    claude:*)
        rest="${target#claude:}"
        # claude:PROJECT                — a fresh conversation
        # claude:PROJECT:r:UUID         — resume that transcript
        # ...:b:BOOT                    — and which run of the container asked
        resume="" want_boot=""
        case "$rest" in
            *:b:*) want_boot="${rest##*:b:}"; rest="${rest%:b:*}" ;;
        esac
        case "$rest" in
            *:r:*) resume="${rest##*:r:}"; proj="${rest%%:r:*}" ;;
            *)     proj="$rest" ;;
        esac
        dir="$WORKSPACE/$proj"
        # Reject anything that is not a directory sitting directly in the
        # workspace: no traversal, no absolute paths, no invented names.
        if [ "$proj" != "$(basename -- "$proj")" ] || [ ! -d "$dir" ]; then
            echo "No such project: ${proj}" >&2
            echo "Available:" >&2
            # Same rule the dashboard lists by: a directory holding
            # .bbignore is not a project, so offering it here as one would
            # only send someone back to a name that will be refused again.
            find "$WORKSPACE" -maxdepth 1 -mindepth 1 -type d -not -name '_work' \
                -not -exec test -e '{}/.bbignore' ';' -printf '  %f\n' >&2
            bad ""
        fi
        # Signed out, a session starts and dies on claude's own error, which
        # reads like the container is broken. Refused positively only: an
        # older claude with no `auth` subcommand, or one that cannot answer,
        # gets the benefit of the doubt, because a wrong refusal here is worse
        # than a confusing message.
        if [ "$(claude auth status --json 2>/dev/null \
                | tr -d ' ' | sed -n 's/.*"loggedIn":\([a-z]*\).*/\1/p')" = false ]; then
            bad "This container is not signed in to Claude." \
                "Sign in from the dashboard's Doctor card, or run: bb login"
        fi
        if is_excluded "$proj"; then
            bad "'${proj}' is excluded: no Claude session can be started here." \
                "Clear it from the dashboard's Projects card to allow one again."
        fi
        # Attaching to a session that is already running is always fine — the
        # conversation is there, and this is how a tab comes back to it.
        # *Starting* one is a decision, and it has to be a decision made now.
        #
        # A browser left open across a container restart still holds its Claude
        # tabs, and a phone waking up reloads the terminal iframe — which
        # spawns whatever its URL names, silently, minutes after a restart
        # nobody connected it to. Pruning the stored layout at boot cannot stop
        # that; the page never re-read it. So the URL carries the boot it was
        # opened in, and one from a previous run is refused here, where the
        # session would otherwise be created.
        if ! tmux has-session -t "=claude-${proj//[.:]/_}" 2>/dev/null \
           && [ "$want_boot" != "$(boot_id)" ]; then
            bad "This tab is from before the container restarted." \
                "Its conversation is still on disk. Open Claude on ${proj} from" \
                "the dashboard's Projects card to pick it up again — starting a" \
                "session is a decision, and a reconnecting tab is not one."
        fi
        cmd=(claude --remote-control "$proj")
        if [ -n "$resume" ]; then
            # Checked against a transcript that actually exists, so a mistyped
            # URL cannot turn into an argument claude tries to interpret.
            case "$resume" in
                *[!0-9a-fA-F-]*|"") bad "Not a session id: ${resume}" ;;
            esac
            if [ ! -f "$HOME/.claude/projects/${dir//\//-}/${resume}.jsonl" ]; then
                bad "No transcript ${resume} for ${proj}." \
                    "It may have been cleaned up; start a new conversation instead."
            fi
            cmd+=(--resume "$resume")
        fi
        # The project's shared to-do list, in front of the session that is
        # about to start. This is the whole reason the list is worth keeping:
        # a note left in a conversation dies with it, and one left here is
        # read by the next session without anybody remembering to mention it.
        # Only the open items, and nothing at all when there are none.
        # Named rather than inferred: `bb roadmap` takes the project from the
        # working directory, and this is not run from one. An older image
        # whose bb has no `todo` prints usage and fails, which is caught here
        # and simply means no block.
        todo_block="$(BB_ROADMAP_PROJECT="$proj" bb roadmap --prompt 2>/dev/null || true)"
        # The bug tracker rides in the same block: open bugs by number and
        # severity, with the fields on disk behind `bb bug show`. An older
        # image whose bb has no `bug` prints usage and fails, which is caught
        # here and simply means no bugs block.
        bug_block="$(BB_BUG_PROJECT="$proj" bb bug --prompt 2>/dev/null || true)"
        [ -z "$bug_block" ] || todo_block="${todo_block:+$todo_block

}$bug_block"
        # One ceiling up from tmux's there is the kernel's: a single argument
        # cannot exceed MAX_ARG_STRLEN — 131072 bytes, measured here — and past
        # it exec answers "Argument list too long" and the pane dies without
        # saying why, which is the same silent death the launcher exists to
        # end. So the block is cut to fit and says that it was cut, rather than
        # taking the session down with it. Bytes, not characters: prose in the
        # roadmap is UTF-8, and the kernel counts bytes.
        PROMPT_MAX=100000
        if [ "$(printf '%s' "$todo_block" | wc -c)" -gt "$PROMPT_MAX" ]; then
            echo "WARNING: this project's roadmap and bugs are too long to fit in a" >&2
            echo "session's prompt; only the first ${PROMPT_MAX} bytes are in this one." >&2
            echo "Trim the list with \`bb roadmap\`, or the rest of it is invisible" >&2
            echo "to every session started here." >&2
            # Back to a line boundary, so the cut cannot land inside a word —
            # or inside a UTF-8 character, which head -c is happy to do.
            todo_block="$(printf '%s' "$todo_block" | head -c "$PROMPT_MAX" || true)"
            todo_block="${todo_block%$'\n'*}"$'\n'
            todo_block+="[the rest of this list did not fit in the prompt — \`bb roadmap\`"
            todo_block+=" and \`bb bug\` show all of it]"
        fi
        # Kept beside the command rather than in it: the fallback below starts
        # the session without this block, and cannot if the two are one array.
        prompt=()
        [ -z "$todo_block" ] || prompt=(--append-system-prompt "$todo_block")
        if scope="$(claude_scope "$proj")"; then
            cmd+=(--settings "$scope")
        else
            # Say so rather than starting an unconfined session that looks
            # identical to a confined one.
            echo "WARNING: could not build the project scope for '${proj}'." >&2
            echo "This session is NOT restricted to its own directory." >&2
        fi
        # An existing session is attached to rather than replaced, so clicking
        # a project twice returns to the same conversation instead of starting a
        # second one alongside it.
        # A session under a claude name must be running claude. tmux takes a
        # session with the command it was given, so a conversation that ends
        # leaves nothing behind — but if one ever does survive as a bare
        # shell, this tab is not the way into it: the name is claimed for
        # claude, and anything else wearing it is replaced rather than
        # attached to.
        # pane_start_command, not pane_current_command: the current one is
        # whatever is in the foreground this second, and claude runs its tools
        # as subprocesses — so a session busy running a build reports `bash`
        # and would have been killed here, mid-conversation. The start command
        # is what the pane was created with and does not move.
        if tmux has-session -t "=claude-${proj//[.:]/_}" 2>/dev/null \
           && ! tmux list-panes -t "=claude-${proj//[.:]/_}" -F '#{pane_start_command}' 2>/dev/null \
                | grep -qi claude; then
            log "claude-${proj}: session is not running claude — replacing it"
            tmux kill-session -t "=claude-${proj//[.:]/_}" 2>/dev/null || true
        fi
        # Through a launcher, always — not only when the prompt happens to be
        # long today. A path that is exercised on every session is one that
        # works; a fallback taken only past 16KB is one nobody finds out about
        # until a notebook grows. If the file cannot be written, the command
        # goes to tmux directly, which is what used to happen and is still
        # right for a short one.
        if launcher="$(claude_launcher "$proj" "${cmd[@]}" "${prompt[@]}")"; then
            start "claude-${proj}" "$dir" "$launcher"
        else
            # Nowhere to write it. The command without the block still fits on
            # tmux's command line, and a session that starts knowing less is
            # worth more than one that refuses to start at all — which is what
            # passing the block here would produce for any real roadmap.
            echo "WARNING: could not write the launcher for '${proj}'," >&2
            echo "so this session starts without the project's roadmap and bugs." >&2
            echo "Everything else about it is the same. Check that ${HOME:-\$HOME}/.cache" >&2
            echo "is writable." >&2
            start "claude-${proj}" "$dir" "${cmd[@]}"
        fi
        ;;
    shell:*)
        proj="${target#shell:}"
        dir="$WORKSPACE/$proj"
        [ "$proj" = "$(basename -- "$proj")" ] && [ -d "$dir" ] \
            || bad "No such project: ${proj}"
        start "shell-${proj}" "$dir"
        ;;
    *)
        # A named scratch session. Restricted to characters tmux is happy with
        # so a stray URL cannot produce a session nobody can address again.
        case "$target" in
            *[!A-Za-z0-9._-]*) bad "Invalid session name: ${target}" ;;
        esac
        start "$target" "$WORKSPACE"
        ;;
esac
