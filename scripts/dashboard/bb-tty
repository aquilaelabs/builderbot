#!/usr/bin/env bash
#
# The command ttyd runs for every browser connection.
#
# ttyd is started with --url-arg, so the browser controls this script's only
# argument via ?arg=... That argument is attacker-controlled in the sense that
# matters: it never reaches a shell (ttyd execs directly), and a project name
# is checked against the directories that actually exist rather than trusted as
# a path. Anyone reaching this is already authenticated and already entitled to
# a shell, so the goal is not privilege containment; it is making a mistyped
# URL fail cleanly instead of starting something surprising.
#
# Everything runs inside tmux so a closed browser tab detaches rather than
# kills. A Claude session surviving a dropped connection is the entire reason
# this is not a bare shell.
#
set -euo pipefail
# Beside this script rather than by absolute path. In the image the two are the
# same file (this lives at /opt/builderbot/scripts/dashboard/bb-tty), and out
# of it, the checkout's copy runs from the checkout, which is what lets the
# dashboard suite drive this script at all.
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

target="${1:-shell}"

# ---- whose terminal this is (roadmap #26) ----------------------------------
#
# The dashboard's /term proxy stamps the argument with the account it
# authenticated, as `u:<uid>:<target>`, and OVERWRITES anything the browser
# put there, so this is the account asking, not the account claimed. That is
# the same reasoning as the lock check below: a rule only the UI honors is a
# suggestion, because the ttyd URL is reachable directly.
#
# Empty is a real answer and the common one: a terminal opened before accounts
# existed, or by something that is not a browser. It gets the box's own home
# and the unprefixed session names, which is exactly what it used to get.
account=""
case "$target" in
    u:*)
        rest="${target#u:}"
        account="${rest%%:*}"
        target="${rest#*:}"
        case "$account" in
            u_[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
            *) account="" ;;              # not an id: nobody, not somebody else
        esac
        ;;
esac

# ---- what else rode in on the URL (roadmap #24, the session on a node) ------
#
# ttyd's --url-arg passes EVERY ?arg= as one more argument, so beside the
# target the proxy can hand this script the two things a node does not have
# and cannot make: the account's name (its users.json is on the controller)
# and a session token for the project (minted there, by the key only it
# holds). On the controller neither arrives (the name is looked up and the
# token minted right here), so both are optional, and one that does arrive
# is taken only in the shape it should have. The token is a credential for
# one project with user rights and an expiry, which is exactly what the
# launcher below would have minted; it is not the operator's password.
url_tok=""
for extra in "${@:2}"; do
    case "$extra" in
        tok:bbs_*)
            case "${extra#tok:}" in
                *[!A-Za-z0-9_-]*) ;;
                *) url_tok="${extra#tok:}"; export BB_TOKEN="$url_tok" ;;
            esac ;;
        name:*)
            case "${extra#name:}" in
                ''|*[!A-Za-z0-9._@+-]*) ;;
                *) export BB_ACCOUNT_NAME="${extra#name:}" BB_ACCOUNT_UID="$account" ;;
            esac ;;
        # The owner works in the project directory on a node too (see
        # session_dir); the node cannot tell who the owner is, so the
        # controller says so.
        owner:1) [ -n "$account" ] && export BB_TREE_OWNER=1 BB_ACCOUNT_UID="$account" ;;
    esac
done

# ---- on a node, the controller says whose this is (B166) --------------------
#
# Everything above is what the URL claimed. On the controller that is the
# account /term proved, because ttyd there is loopback-only and the proxy is
# the one way in. A node's ttyd is on the node, and a session there reaches it
# over loopback like any other process on the machine, so on a node the URL
# proves nothing: u:<uid>, name: and owner:1 would open another account's home
# and Claude login for whoever typed them. So the token that rode in is shown
# to the controller, which alone can check its signature, and the account,
# the name and ownership come from its answer. No answer, no terminal: a node
# that cannot reach the controller cannot start a session anyway.
if on_node; then
    grant="$(BB_TTY_TARGET="$target" BB_URL_TOKEN="$url_tok" python3 - "$(dirname "$(readlink -f "$0")")/../lib" 2>&1 <<'GRANT'
import json, os, sys
sys.path.insert(0, sys.argv[1])
import bbapi
# Nothing is kept from this answer: the account in the environment is still
# the URL's claim, and a renewed token must not be written under it.
bbapi.keep_token = lambda _tok: None
tok = os.environ.get("BB_URL_TOKEN", "")
if not tok:
    print("this terminal came without a session token, which only the controller's "
          "proxy adds, so it was not opened through the dashboard", end="")
    raise SystemExit(1)
st, got = bbapi.request("/api/v1/tty-grant",
                        {"arg": os.environ["BB_TTY_TARGET"], "ro": os.environ.get("BB_TTY_RO") == "1"},
                        auth="Bearer " + tok, timeout=20)
if st != 200 or not isinstance(got, dict) or not got.get("uid"):
    why = (got or {}).get("error") if isinstance(got, dict) else ""
    print(why or "the controller did not answer", end="")
    raise SystemExit(1)
print(json.dumps(got))
GRANT
)" || {
        echo "BuilderBot: this terminal was refused: $grant" >&2
        if [ -t 2 ]; then sleep 10; fi
        exit 1
    }
    account="$(printf '%s' "$grant" | jq -r '.uid // empty')"
    BB_ACCOUNT_NAME="$(printf '%s' "$grant" | jq -r '.name // empty')"
    BB_ACCOUNT_UID="$account"
    export BB_ACCOUNT_NAME BB_ACCOUNT_UID
    # The projects this one reads, from the same answer: their trees go
    # into the view read-only, and Claude's walls let it read them.
    BB_READS="$(printf '%s' "$grant" | jq -r '(.reads // []) | join(" ")')"
    export BB_READS
    # ...and the places on this node it is shown besides (prefs.sees): a
    # share the view would otherwise leave out with every other.
    BB_SEES="$(printf '%s' "$grant" | jq -r '(.sees // []) | join(" ")')"
    export BB_SEES
    # Whether this session may compute on the node's NVIDIA card (R102):
    # off on the node's row, or in the project's settings. CUDA is told
    # there is no device, so a program falls back to its CPU path with a
    # plain answer, and the view covers the device CUDA cannot start
    # without. BB_GPU says why to bb gpu and bb status.
    BB_GPU="$(printf '%s' "$grant" | jq -r '.gpu // "on"')"
    export BB_GPU
    case "$BB_GPU" in on) ;; *) export CUDA_VISIBLE_DEVICES="" ;; esac
    # Which node this is, by the controller's id for it: what bb login
    # --check names when it says who is signed in to Claude here.
    BB_NODE_ID="$(printf '%s' "$grant" | jq -r '.node // ""')"
    export BB_NODE_ID
    if [ "$(printf '%s' "$grant" | jq -r '.owner // false')" = true ]; then
        export BB_TREE_OWNER=1
    else
        unset BB_TREE_OWNER
    fi
fi

# The account's own home: own shell history, own Claude login, own memories.
# Exported before anything runs, because tmux hands its environment to the
# shell it starts and there is no second chance once the session exists.
if [ -n "$account" ]; then
    HOME="$(user_home "$account")"
    export HOME
fi

# On a node the toolchain store is read-only in a session's view (B163), and
# two things a session does were writes into it. Rust's crate cache is
# CARGO_HOME, which the store's layout puts at rust/cargo: it is the
# account's own now, and the store's cargo/bin stays on PATH for the proxies,
# which read the toolchains through RUSTUP_HOME. And Claude Code's own
# updater, which could only ever fail in a view (the launcher and its
# versions are the base home's, read-only there) and would otherwise fetch a
# copy into every account's home that nothing runs: updating claude is the
# provisioner's.
#
# Java's home is not $HOME. It is the passwd entry's, and every account's
# session runs as the one session user, so Gradle, the Android tools and the
# Kotlin compile daemon all wrote under the base home, which the view makes
# read-only: an Android build in a session died on Gradle's wrapper lock
# (B182). Each is pointed at the account's own home by the variable it
# honors: GRADLE_USER_HOME for Gradle's caches and wrapper, ANDROID_USER_HOME
# for the debug keystore and the SDK tools' settings, and XDG_DATA_HOME,
# which is where the Kotlin daemon keeps its run files on Linux. Per account,
# as the crate cache is: the operator's call for B157.
if on_node && [ -n "$account" ]; then
    [ -z "${CARGO_HOME:-}" ] || export CARGO_HOME="$HOME/.cargo"
    export GRADLE_USER_HOME="$HOME/.gradle" ANDROID_USER_HOME="$HOME/.android" \
           XDG_DATA_HOME="$HOME/.local/share"
    export DISABLE_AUTOUPDATER=1
fi

# sess NAME: the session name for this account.
#
# A SHELL is per account: two people opening a terminal on the same project
# must not land in one another's, which is what one name would do: tmux
# attaches to an existing session rather than making a second. A CLAUDE
# session is deliberately NOT per account: one conversation per project is the
# rule (two in one working tree fight over the same files), and who holds it
# is a record the dashboard keeps rather than a name.
#
# The OWNER keeps the bare names, which is why this asks tmux_prefix rather
# than building one: same rule as their home, in one place. `~` is the
# separator because tmux rewrites `.` and `:` in a name and leaves this
# alone; measured, not assumed.
sess() {
    printf '%s%s' "$(tmux_prefix "$account")" "$1"
}

# Projects the operator keeps but runs themselves. Shared with the dashboard,
# which writes it; enforced here, because a rule only the UI honors is a
# suggestion: the ttyd URL is reachable directly.
LOCKS_FILE="${DASHBOARD_STATE:-/config}/locked-projects.json"

is_locked() {
    if [ -f "$LOCKS_FILE" ]; then
        jq -e --arg n "$1" 'index($n) != null' "$LOCKS_FILE" >/dev/null 2>&1
        return
    fi
    # On a node the list is the controller's, and `bb settings` asks it,
    # over the API, with the session token that rode in above. No token, or
    # no answer, reads as not locked: the proxy on the controller refuses a
    # locked project before the connection ever reaches here, so this is the
    # second check, not the only one.
    on_node || return 1
    [ "$(BB_PROJECT="$1" bb settings --json 2>/dev/null | jq -r '.locked // false')" = true ]
}

# Where the dashboard keeps each project's model and effort. Read by the
# launcher this writes rather than here, so a respawn re-reads it; see
# claude_launcher.
PREFS_FILE="${DASHBOARD_STATE:-/config}/claude-prefs.json"

# Every project directory except this one. Excluded by exact path rather than
# `-not -name "$1"`, because find treats that as a glob: a project called
# `app[1]` or `web*` would silently exclude its neighbors from the deny list,
# which is the one direction this must not fail in.
siblings_of() {
    find "$WORKSPACE" -maxdepth 1 -mindepth 1 -type d -printf '%p\n' 2>/dev/null \
        | { grep -vxF "$WORKSPACE/$1" || true; }   # sole project: no siblings
}

# walls_around PROJECT HERE: every tree this session must not reach into.
#
# Every project but its own, and every WORKTREE but its own, including the
# other worktrees of this same project, which is the case that matters: two
# people working one project are the reason worktrees exist, and a deny list
# that stopped at the project boundary would let each of them edit the other's
# checkout, which is exactly what the separate trees are for.
#
# siblings_of lists dot directories too, so .worktrees would otherwise be
# denied WHOLESALE, including the tree this session is sitting in. It is
# excluded here and its contents enumerated instead.
walls_around() {
    local proj="$1" here="$2"
    # ...and the same for the transcripts tree (roadmap #24): the whole of it
    # would deny this account's own memories, which Claude writes through the
    # file tools; so it is excluded and every OTHER account's directory in it
    # is listed instead.
    siblings_of "$proj" | { grep -vxF -e "$BB_WORKTREES" -e "$BB_CLAUDE_SHARE" || true; }
    [ "$here" = "$WORKSPACE/$proj" ] || printf '%s\n' "$WORKSPACE/$proj"
    if [ -d "$BB_CLAUDE_SHARE" ]; then
        find "$BB_CLAUDE_SHARE" -mindepth 1 -maxdepth 1 -type d -printf '%p\n' 2>/dev/null \
            | { grep -vxF "$BB_CLAUDE_SHARE/${account:-owner}" || true; }
    fi
    [ -d "$BB_WORKTREES" ] || return 0
    find "$BB_WORKTREES" -mindepth 2 -maxdepth 2 -type d -printf '%p\n' 2>/dev/null \
        | { grep -vxF "$here" || true; }
}

# cache_project_dir PROJECT - this account's BuilderBot cache folder for one
# project, made if it is missing: its launcher, its scope, its token and its
# session's environment. A folder per project, so that a session's view can
# keep its own and leave every other project's out (R35).
# THE ACCOUNT IN THE PATH IS NOT DECORATION (B159). On a node every account's
# ~/.cache is a symlink to the base home's (common.sh shares the tool folders),
# so without the uid this is ONE folder for everybody: two accounts with a
# session on one project shared a token file and the last to start owned it,
# which is another account's identity for anything that reads it back.
cache_project_dir() {
    local dir="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
    dir="${dir:-/tmp/bb-scope-$(id -u)}/builderbot/u/${account:-_none}/project/$1"
    mkdir -p "$dir" 2>/dev/null || { dir="/tmp/bb-scope-$(id -u)/u/${account:-_none}/project/$1"; mkdir -p "$dir"; }
    chmod 700 "$dir" 2>/dev/null || true
    printf '%s' "$dir"
}

# THE SESSION'S VIEW (R35). Every session on a node runs as one account and
# the projects share is mounted whole, so the scope file below is all that
# stands between a session and another project, and Bash is not under it.
# Where the node can build one, a project's session runs inside a view of the
# machine that holds only that project: bb-session, root, and the one command
# the session account may run through sudo. The agent installs both.
SESSION_BIN="${BB_SESSION_BIN:-/usr/local/sbin/bb-session}"

# isolating - whether this node builds a session's view. Asked of the helper
# through sudo, so it answers from what root set up and from nothing a
# session can write. A node without it (a Mac, a guest, a container node)
# runs sessions as it always has, and its row on the Nodes tab says so.
isolating() {
    on_node && [ -x "$SESSION_BIN" ] && sudo -n "$SESSION_BIN" check >/dev/null 2>&1
}

# in_view PROJECT DIR [CMD...] - set RUN to what the pane runs: CMD as it is,
# or inside the project's view when this node builds one (a login shell when
# CMD is empty). The session's environment goes into a file in the project's
# own cache folder, which the helper reads only after dropping to the session
# account. A view that cannot be planned for this session is a refusal, never
# a session that quietly sees every project.
in_view() {
    local proj="$1" dir="$2" envf why
    shift 2
    RUN=("$@")
    isolating || return 0
    [ $# -gt 0 ] || set -- "${SHELL:-/bin/bash}" -l
    envf="$(cache_project_dir "$proj")/session.env"
    ( umask 077; env -0 > "$envf.new" && mv -f "$envf.new" "$envf" ) \
        || bad "Could not write this session's environment to $envf, so its view cannot start."
    # Where what Claude Code keeps in /tmp between the turns of a
    # conversation lives, so a session started again on the same
    # conversation finds it (B376): the view binds this over
    # /tmp/claude-<uid>. Made here, as the session account. A conversation's
    # folder nothing has written to in two weeks goes, so it does not grow
    # for good; one still in use is written to on every turn.
    local scratch
    scratch="$(cache_project_dir "$proj")/scratch"
    if ( umask 077; mkdir -p "$scratch" ) 2>/dev/null; then
        find "$scratch" -mindepth 2 -maxdepth 2 -type d -mtime +14 -exec rm -rf {} + 2>/dev/null || true
    fi
    # The projects this one reads, one --reads each: the helper binds their
    # trees read-only, and repeated words keep the launcher line respawnable.
    local reads=() r
    for r in ${BB_READS:-}; do reads+=(--reads "$r"); done
    # ...and the places it is shown, one --sees each, for a helper that
    # takes them: one from before the setting would refuse the word and
    # start no session at all, so it is asked first.
    if [ -n "${BB_SEES:-}" ] && "$SESSION_BIN" plan --project "$proj" --account "${account:-}" \
            --home "$HOME" --cwd "$dir" --sees /nowhere-a-node-has >/dev/null 2>&1; then
        for r in ${BB_SEES:-}; do reads+=(--sees "$r"); done
    fi
    # ...and the card's compute device covered where it is not this
    # session's, for a helper that takes the word (asked first, as above).
    if [ "${BB_GPU:-on}" != on ] && "$SESSION_BIN" plan --project "$proj" --account "${account:-}" \
            --home "$HOME" --cwd "$dir" --cuda off >/dev/null 2>&1; then
        reads+=(--cuda off)
    fi
    why="$("$SESSION_BIN" plan --project "$proj" --account "${account:-}" --home "$HOME" \
               --cwd "$dir" "${reads[@]}" 2>&1 >/dev/null)" \
        || bad "This node keeps each session to its own project, and could not for this one:" "$why"
    RUN=(sudo -n "$SESSION_BIN" enter --project "$proj" --account "${account:-}" --home "$HOME"
         --cwd "$dir" "${reads[@]}" --env "$envf" -- "$@")
}

# claude_scope PROJECT - write a settings file that walls this session into its
# own directory, and echo the path.
#
# Passed with --settings, which ranks as a command-line argument: above the
# project's own .claude/settings.json and .claude/settings.local.json, so a
# session cannot widen its own boundary by editing files in the repo it is
# working on. Only the managed policy file outranks it, and that is root-owned.
#
# This binds the file tools. It is a guardrail against a session wandering into
# the wrong tree by mistake, not a sandbox: Bash still reaches the filesystem,
# and the only hard boundary is not mounting the other projects at all.
claude_scope() {
    local proj="$1" here="${2:-}" dir out tmp hooks bundle
    # One file per project, rewritten each time rather than a fresh temp file:
    # ttyd runs this script on every browser connection, including a reattach,
    # so mktemp here would drop a file per page load. Under the cache dir
    # because it is this user's, not world-writable /tmp.
    # A per-uid directory rather than a shared /tmp path when HOME is unset,
    # so this never writes somewhere another user could have prepared.
    dir="$(cache_project_dir "$proj")"
    out="$dir/claude-scope.json"

    # Read for reading, Edit for every tool that writes. Two eras of Claude
    # Code semantics meet here, and both left a mark. Originally a rule named
    # one tool (Read and Edit did not cover Write), so the first version of
    # this left a session able to CREATE a file in a sibling project, and the
    # fix was four rules per path (Write, and NotebookEdit, the same tool
    # wearing a different name for .ipynb). Claude Code has since inverted
    # that: an Edit(path) rule now covers ALL file-editing tools, and a
    # Write() or NotebookEdit() rule is IGNORED with a startup warning: a
    # wall of yellow at the top of every session, one line per dead rule.
    # So: Edit carries the whole write-side deny, and the two dead spellings
    # are gone. If the semantics ever move again, the warning wall is the
    # tell, and this comment is the map.
    #
    # Build beside the target and move into place. Writing straight to $out
    # would leave a truncated file if jq failed, and claude would then be
    # handed a settings file that is not JSON.
    tmp="$out.new"
    # The project's own VERSION file is denied too, and it is the one entry
    # here that points INSIDE the project rather than outside it. The version
    # is the operator's claim about their own work: they move it from the
    # dashboard, and a session that may move it does so through
    # `bb version bump`, which checks the per-project policy first. Editing the
    # file directly would walk straight past that check.
    #
    # Both forms, because a repo that ships two products has a VERSION per
    # component: denying only the root one would leave `extension/VERSION`
    # editable and the policy walked straight past.
    #
    # Read is deliberately not denied: a session should be able to see the
    # version it is working against, and `bb version` prints it anyway.
    #
    # Same caveat as every rule in this file: it binds the file tools, not
    # Bash. `echo 0.5.0 > VERSION` still works. This makes the sanctioned path
    # the easy one; the record that makes a bad bump recoverable is that
    # VERSION is committed and `git log` says who moved it.
    # `here` is where the session actually works, which is the project
    # directory for the owner and a worktree for anybody else (roadmap #24).
    # It matters twice. A worktree session is OUTSIDE $WORKSPACE/$proj, so the
    # project directory itself becomes a sibling to deny; the whole point is
    # that the two are separate trees and one session must not reach into the
    # other. And the VERSION rule has to name the tree the session is in, or
    # it denies a file that session was never going to touch and leaves its
    # own editable.
    here="${here:-$WORKSPACE/$proj}"
    # Four hooks ride in the same file. bb-gate refuses EVERY tool call
    # while the controller is not answering, which is what a restart after an
    # update looks like: there is nothing to do but wait, and working blind
    # against a machine that is changing is worse than waiting.
    # bb-work-note records what this session
    # touches and says when another has the same file open; it does NOT
    # refuse, because each session is in a worktree of its own and two people
    # editing one function are making two commits, not corrupting one tree.
    # bb-prompt-relay puts what was asked into the project's chat feed, so the
    # others sharing it know what is being worked on before they start the
    # same thing. bb-check-relay runs, when the session is about to stop, the
    # checks of the house rules whose files it changed, and refuses the stop
    # while one fails (roadmap R31). bb-gate --turn holds a prompt until the
    # node's limit on sessions working at once has a turn free (turns.py),
    # and --turn-done on Stop hands it back. Its timeout is its own: a
    # UserPromptSubmit hook gets thirty seconds otherwise, and one that runs
    # out lets the prompt through uncounted. All of them swallow every failure
    # of their own: a note is never worth an edit and a line is never worth a
    # turn. Their headers have the arguments.
    # The hooks by a name that outlives this bundle (B120). On a node bb-tty
    # runs from .bb/<digest>, and the settings file is read once, when claude
    # starts, so a path resolved there kept a session on the hooks it began
    # with for as long as it stayed open, however many deliveries followed.
    # Through .bb/current each hook call runs whatever was delivered last, the
    # way B66 put bb on PATH. A checkout has no current link and keeps the
    # path it always had.
    hooks="$(dirname "$(readlink -f "$0")")"
    case "$hooks" in
        */.bb/*/scripts/dashboard)
            bundle="${hooks%/scripts/dashboard}"
            [ "$(readlink -f "${bundle%/*}/current" 2>/dev/null)" = "$bundle" ] \
                && hooks="${bundle%/*}/current/scripts/dashboard" ;;
    esac
    # A project this one reads is a wall to Edit and not to Read: its tree
    # is in the view read-only, and the deny list says the same.
    local readsq
    readsq="$(for r in ${BB_READS:-}; do printf '%s\n' "$WORKSPACE/$r"; done | jq -R . | jq -s .)"
    if walls_around "$proj" "$here" | jq -R . \
         | jq -s --arg ws "$WORKSPACE" --arg here "$here" --argjson reads "${readsq:-[]}" \
               --arg state "${DASHBOARD_STATE:-/config}" \
               --arg gate "$hooks/bb-gate" \
               --arg note "$hooks/bb-work-note" \
               --arg relay "$hooks/bb-prompt-relay" \
               --arg check "$hooks/bb-check-relay" \
               --arg proj "$proj" --arg who "${account:-owner}" '
           {permissions: {
              additionalDirectories: [],
              deny: (map(select(. as $d | $reads | index($d) | not) | "Read(\(.)/**)", "Edit(\(.)/**)")
                     + map(select(. as $d | $reads | index($d)) | "Edit(\(.)/**)")
                     + ["Edit(\($here)/VERSION)",
                        "Edit(\($here)/**/VERSION)",
                        "Edit(\($state)/rules.json)",
                        "Write(\($state)/rules.json)",
                        "NotebookEdit(\($state)/rules.json)"])
           },
            hooks: {PreToolUse: [
              {hooks: [{type: "command",
                        command: "\($gate) \($proj) \($who)", timeout: 60}]},
              {matcher: "Edit|Write|NotebookEdit",
               hooks: [{type: "command",
                        command: "\($note) \($proj) \($who)"}]}],
              UserPromptSubmit: [
              {hooks: [{type: "command",
                        command: "\($relay) \($proj) \($who)"},
                       {type: "command",
                        command: "\($gate) --turn \($proj) \($who) --wait 840",
                        timeout: 900, statusMessage: "Waiting for a turn on this node"}]}],
              Stop: [
              {hooks: [{type: "command",
                        command: "\($check) \($proj) \($who)", timeout: 3600},
                       {type: "command",
                        command: "\($gate) --turn-done \($proj) \($who)"}]}]}}' > "$tmp" && [ -s "$tmp" ]; then
        mv -f "$tmp" "$out"
        printf '%s' "$out"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# claude_launcher PROJECT TRANSCRIPT_DIR COMMAND...: write COMMAND as a script
# and echo its path.
#
# name begins with `claude-` deliberately: the session-is-really-claude check
# below reads pane_start_command, which is now this path.
#
# The script resolves the project's model and effort ITSELF, at exec time,
# rather than having them baked in by the caller. That is what lets the
# dashboard restart a session onto a changed setting: it runs this same file
# through `tmux respawn-pane`, and the file reads the preference again. With
# --respawn it also resumes the newest transcript, so changing the setting
# continues the conversation instead of replacing it.
claude_launcher() {
    local proj="$1" tdir="$2"; shift 2
# session_token PROJECT: a scoped credential for the session about to start,
# or empty. Read from users.py so there is one implementation of what a token
# is; a shell that reimplemented the signing would be a second one to keep in
# step with the server.
session_token() {
    # A node never mints: the store and its key are the controller's, and
    # the token is the one that rode in on the URL, or nothing. Nothing is
    # the safe direction: bb then says it has no credential rather than
    # reaching for anybody else's.
    if on_node; then printf '%s' "${BB_TOKEN:-}"; return 0; fi
    local py="/opt/builderbot/scripts/dashboard/users.py"
    [ -f "$py" ] || py="$(dirname "$(readlink -f "$0")")/users.py"
    [ -f "$py" ] || return 0
    # Minted for the ACCOUNT as well as the project, the shape the controller
    # mints for a node-bound terminal. Without it two people who opened a
    # session on one project in the same second were handed the same token,
    # byte for byte, and nothing it did said whose it was.
    DASHBOARD_STATE="${DASHBOARD_STATE:-/config}" python3 - "$py" "$1" "${account:-}" <<'PY' 2>/dev/null || true
import importlib.util, json, os, sys
spec = importlib.util.spec_from_file_location("users", sys.argv[1])
u = importlib.util.module_from_spec(spec)
spec.loader.exec_module(u)


def write_json(path, data):
    tmp = str(path) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


u.configure(state=os.environ["DASHBOARD_STATE"], write_json=write_json)
print(u.mint_session(sys.argv[2], uid=sys.argv[3]))
PY
}

    local dir out tmp base_resumes=0 a
    for a in "$@"; do [ "$a" = "--resume" ] && base_resumes=1; done
    dir="$(cache_project_dir "$proj")"
    out="$dir/claude-run.sh"
    tmp="$out.new"
    # %q so the command survives being written down and read back as shell:
    # the system prompt is somebody's prose, with quotes and newlines in it.
    # exec, so nothing sits between tmux and claude: the pane's process is the
    # conversation, which is what the shutdown's TERM and the pane's pid mean.
    {
        printf '#!/usr/bin/env bash\n'
        printf '# Written by bb-tty each time a session for %s is opened.\n' "$proj"
        printf '# tmux takes a command in one 16KB message; this is how a long\n'
        printf '# system prompt gets past that. Not edited by hand; it is\n'
        printf '# overwritten on the next connection.\n'
        printf '# The model and effort are read here rather than baked in, so a\n'
        printf '# respawn through this file picks up a setting just changed.\n'
        printf 'set -uo pipefail\n'
        # What the session may do, and what it may no longer do.
        #
        # It used to inherit DASHBOARD_AUTH (the operator's own password)
        # from the container environment, which made "only the operator can
        # install a toolchain" a rule the code asked nicely about (bug #16). It
        # gets a token scoped to THIS project with `user` rights instead, and
        # the password is removed from the environment it runs in.
        #
        # Minted per connection rather than kept: they expire, they are cheap,
        # and rotating the store's key invalidates every one of them at once.
        # A failure to mint leaves the session with neither, which is the safe
        # direction: bb then says it has no credential rather than falling
        # back to the operator's.
        printf 'unset DASHBOARD_AUTH\n'
        local tok; tok="$(session_token "$proj")"
        [ -z "$tok" ] || printf 'export BB_TOKEN=%q\n' "$tok"
        # ...and beside the launcher, where `bb` can read it at the moment it
        # is run rather than only at the moment the session started.
        #
        # A session outlives its token. The token is twelve hours; a
        # conversation that has been going longer than that had one in its
        # environment that no longer verifies, and every bb verb answered
        # "not signed in" (the notebook, `bb git push` on a node, all of it),
        # with no way back except ending the session. The launcher above is
        # already rewritten on every connection, but a claude that is ALREADY
        # RUNNING keeps the environment it started with, so refreshing the
        # launcher refreshes nothing for it. This file is what a running one
        # can pick up: bb prefers it the moment its own BB_TOKEN has expired,
        # so re-opening the tab is enough to put a long session back in
        # touch. Same directory and same account as the launcher, which holds
        # the token too, so it is no wider a secret than it already was.
        if [ -n "$tok" ]; then
            ( umask 077; printf '%s\n' "$tok" > "$dir/token.new" ) 2>/dev/null \
                && mv -f "$dir/token.new" "$dir/token" 2>/dev/null || true
        fi
        printf 'extra=()\n'
        # The file where the dashboard keeps them, when it is here; on a node
        # it is not, and `bb settings` asks the controller for the same two
        # fields, still at exec time, so a respawn still picks up a change.
        printf 'if [ -r %q ]; then\n' "$PREFS_FILE"
        # Under the ACCOUNT, not the project: the pair is whoever is at the
        # keyboard's, so two people on one project launch on their own (17
        # Sep). No account is a terminal opened before accounts existed, and
        # it gets nothing set, which is claude's own default.
        printf '  m="$(jq -r --arg u %q --arg n %q %q %q 2>/dev/null)"\n' \
            "$account" "$proj" '.users[$u][$n].model // empty' "$PREFS_FILE"
        printf '  e="$(jq -r --arg u %q --arg n %q %q %q 2>/dev/null)"\n' \
            "$account" "$proj" '.users[$u][$n].effort // empty' "$PREFS_FILE"
        printf 'else\n'
        printf '  s="$(BB_PROJECT=%q bb settings --json 2>/dev/null)"\n' "$proj"
        printf '  m="$(jq -r %q <<<"$s" 2>/dev/null)"\n' '.model // empty'
        printf '  e="$(jq -r %q <<<"$s" 2>/dev/null)"\n' '.effort // empty'
        printf 'fi\n'
        printf 'case "$m" in opus|sonnet|haiku|fable) extra+=(--model "$m") ;; esac\n'
        printf 'case "$e" in low|medium|high|xhigh|max) extra+=(--effort "$e") ;; esac\n'
        # A new project's brief, handed over once: bb-tty took it as this
        # session was made and left it beside this file, and the first exec
        # that is not a respawn gives it to claude as the first prompt and
        # removes it, so a respawn onto a changed model never sends it again.
        # After `--` because a brief can open with a dash.
        printf 'first=""\n'
        printf 'fp=%q\n' "$dir/first-prompt.txt"
        printf 'if [ "${1:-}" != --respawn ] && [ -s "$fp" ]; then first="$(cat "$fp")"; rm -f "$fp"; fi\n'
        # Only when the base command does not already name one: a session
        # opened from the resume chooser carries its own --resume, and claude
        # would be handed the flag twice.
        if [ "$base_resumes" -eq 0 ]; then
            printf 'if [ "${1:-}" = --respawn ]; then\n'
            printf '  n="$(ls -1t %q/*.jsonl 2>/dev/null | head -1)"\n' "$tdir"
            printf '  if [ -n "$n" ]; then n="${n##*/}"; extra+=(--resume "${n%%.jsonl}"); fi\n'
            printf 'fi\n'
        fi
        printf 'exec'
        printf ' %q' "$@"
        printf ' "${extra[@]}" ${first:+--} ${first:+"$first"}\n'
    } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    chmod +x "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$out" 2>/dev/null || { rm -f "$tmp"; return 1; }
    printf '%s' "$out"
}

# claude_first_run DIR: answer Claude Code's first-run questions for this home
# and this directory, where they are not answered already. See the call site.
# Sets CLAUDE_TRUST_ADDED=1 when this tree was NOT trusted before this call
# and is now, so the caller can say so where it knows whether a session is
# already running on the old answer.
CLAUDE_TRUST_ADDED=0
claude_first_run() {
    local f="$HOME/.claude.json" tmp was now
    CLAUDE_TRUST_ADDED=0
    [ -d "$HOME" ] || return 0
    tmp="$f.new"
    # What the file said before anything is written to it.
    was="$(jq -r --arg d "$1" '.projects[$d].hasTrustDialogAccepted // false' \
               "$f" 2>/dev/null)"
    if jq --arg d "$1" '
          (if type == "object" then . else {} end)
          | .hasCompletedOnboarding = (.hasCompletedOnboarding // true)
          | .theme = (.theme // "dark")
          | .projects = (.projects // {})
          | .projects[$d] = ((.projects[$d] // {}) | .hasTrustDialogAccepted = (.hasTrustDialogAccepted // true))
        ' "$f" 2>/dev/null > "$tmp" && [ -s "$tmp" ]; then
        mv -f "$tmp" "$f"
    elif jq -n --arg d "$1" '{hasCompletedOnboarding: true, theme: "dark",
                             projects: {($d): {hasTrustDialogAccepted: true}}}' > "$tmp" \
         && [ -s "$tmp" ]; then
        # No file, or one that is not JSON: the answers alone.
        mv -f "$tmp" "$f"
    fi
    rm -f "$tmp"
    # Read it back rather than trusting the write, because THIS flag is the
    # one that matters and it has gone missing in the wild.
    #
    # hasTrustDialogAccepted is what makes Claude Code apply a workspace's own
    # permission rules at all. Without it every allowance a person grants is
    # thrown away, and it says so out loud: "Ignoring N permissions.allow entry
    # from .claude/settings.json: this workspace has not been trusted", so
    # the session asks about every command and remembers none of the answers.
    # From the outside that reads as the permission setting being ignored,
    # which is where a morning went.
    #
    # `/login` rewrites this same file, which is one way the flag leaves after
    # having been set. Until this, every failure here was swallowed.
    now="$(jq -r --arg d "$1" '.projects[$d].hasTrustDialogAccepted // false' \
               "$f" 2>/dev/null)"
    [ "$now" = true ] || return 1
    [ "$was" = true ] || CLAUDE_TRUST_ADDED=1
    return 0
}

# bad MESSAGE...: fail visibly. ttyd closes the connection the moment this
# exits, so without the pause the browser shows an empty terminal and no reason.
bad() {
    for line in "$@"; do echo "$line" >&2; done
    # ...but only when something is holding a terminal open to read it. Under
    # ttyd every fd is the pty. Called from a script with stderr on a pipe
    # there is nobody to show it to, and the pause was ten seconds of nothing
    # each time; five tests in the dashboard suite spent it proving that a
    # refusal is a refusal.
    if [ -t 2 ]; then sleep 10; fi
    exit 1
}

# git_identity PROJECT: the ACCOUNT's commit identity, into this session's
# environment. GIT_AUTHOR_* and GIT_COMMITTER_* outrank any user.name a
# repository or a home carries, which is the point: two people on one
# project are two authors, and a repo-level identity would make them one.
# The values come from `bb settings --json`, which answers for the seat
# BB_ACCOUNT_UID names, right here on the controller, and over the relay
# from a node, whose controller knows the account behind the token. A shell
# gets them too, so a commit typed by hand is the same person's. Never
# fatal: a session with no identity is one git asks about, not one refused.
git_ready=""            # "false" once bb settings has said the account has no author

# need_author WHAT: no author, no terminal. Every project is a repository,
# and a commit with no name and email behind it is one git refuses halfway
# through the work, or, worse, one made under whatever a repository or the
# box happens to have configured. A shell is refused as well as a session,
# because a shell is where git is typed. Only when the controller SAID so:
# a controller that is not answering at all must not read as a refusal, and a
# terminal with no seat behind it has nobody to ask.
need_author() {
    [ "$git_ready" = false ] || return 0
    bad "You have no name and email for commits yet, so $1 does not start." \
        "Set them on your Profile (the gear in the dashboard's header) and" \
        "open this again. Every project here is a repository, and a commit" \
        "needs an author."
}
# no_credential_here: what a session's own git says when it reaches the
# network. There is no credential on a node, by design, and git's answer to
# that is "could not read Username for https://...", which names neither the
# reason nor the way out. This is the same wall with this project's words on
# it, said before git says its own.
#
# Through the environment rather than any repository's config: nothing is
# written into somebody's tree, it cannot outlive the session, and it reaches
# a worktree and a fresh clone alike. GIT_TERMINAL_PROMPT is already how the
# controller runs git; here it stops a terminal being asked for what nobody
# can type.
no_credential_here() {
    [ -z "${GIT_CONFIG_COUNT:-}" ] || return 0      # somebody else owns these; leave them alone
    export GIT_TERMINAL_PROMPT=0
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0=credential.helper
    export GIT_CONFIG_VALUE_0='!f() { echo "[builderbot] no git credential is on this machine, by design: the controller holds the keys. Use bb git push, fetch, pull or ls-remote, which relay through it" >&2; exit 1; }; f'
}

git_identity() {
    local s name email
    # Beside the identity, because these are the two things a session's git
    # needs from us and the same six places set them up.
    no_credential_here
    s="$(BB_PROJECT="${1:-}" BB_ACCOUNT_UID="${BB_ACCOUNT_UID:-$account}" bb settings --json 2>/dev/null)" || return 0
    email="$(printf '%s' "$s" | jq -r '.git_email // empty' 2>/dev/null)"
    name="$(printf '%s' "$s" | jq -r '.git_name // empty' 2>/dev/null)"
    git_ready="$(printf '%s' "$s" | jq -r 'if has("git_ready") then (.git_ready | tostring) else empty end' 2>/dev/null)"
    [ -n "$name" ] || return 0
    export GIT_AUTHOR_NAME="$name" GIT_COMMITTER_NAME="$name"
    [ -z "$email" ] || export GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
}

# start SESSION DIR [COMMAND...]: attach to a session, creating it if needed,
# with the settings this dashboard depends on applied to it.
#
# Applied here rather than left to ~/.tmux.conf because that file lives on a
# persistent volume: an install upgraded from an older image still has the one
# BuilderBot used to write directly, which sets `mouse on` and never sources the
# file we own now. Set on the session itself, this holds whatever the config
# said, which is what a behavior the page promises has to do.
# Which run of the container this is, by the same rule server.py uses: pid 1's
# start time paired with the host's boot time, so it changes when the container
# is recreated and not when the dashboard is merely restarted.
boot_id() {
    local start btime
    start="$(sed 's/^.*) //' /proc/1/stat 2>/dev/null | awk '{print $20}')"
    btime="$(awk '/^btime /{print $2}' /proc/stat 2>/dev/null)"
    [ -n "$start" ] && [ -n "$btime" ] && printf '%s.%s' "$btime" "$start"
}

start() {
    local s="$1" dir="$2"; shift 2
    # tmux rewrites `.` and `:` in a session name to `_` (they are its target
    # syntax) without saying so, so a project called `example.com` would run
    # as `claude-example_com` while everything addressing it by the name it
    # asked for (the page's kill/keys/macros, the server's exclude) missed.
    # The substitution is made here, on purpose, and mirrored by tmux_name()
    # in server.py and tmuxName() in index.html: three places, one rule.
    s="${s//[.:]/_}"
    # THE ENVIRONMENT HAS TO BE HANDED OVER, NOT INHERITED. A new session gets
    # the tmux SERVER's environment, which is whatever the first connection
    # ever made carried, so once one session existed, every later account's
    # session ran with the first one's HOME: the owner's Claude login, the
    # owner's transcripts, whoever asked (bug #54). Measured on tmux 3.4:
    # HOME set for the client, HOME of the server in the pane. `-e` sets it
    # on the session this creates, and -A ignores it on an attach, which is
    # right: the session that exists already has its own.
    local -a envs=() v
    # Gradle's cache per project (B438). Gradle hands a cache lock over by
    # asking its owner on localhost, and each session has a network of its
    # own (R79), so the ask never arrived: one project's idle daemon held the
    # account's ~/.gradle and another project's build timed out on it. A
    # home per project keeps two projects' builds out of each other's locks;
    # a project's first build there fetches its own dependencies once.
    if on_node && [ -n "${GRADLE_USER_HOME:-}" ] && [ -n "${BB_PROJECT:-}" ]; then
        GRADLE_USER_HOME="$HOME/.gradle-projects/$(printf '%s' "$BB_PROJECT" | tr -c 'A-Za-z0-9._-' '_')"
    fi
    for v in HOME BB_TOKEN BB_ACCOUNT_NAME BB_ACCOUNT_UID BB_PROJECT BB_TREE \
             GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL CARGO_HOME \
             GRADLE_USER_HOME ANDROID_USER_HOME XDG_DATA_HOME \
             GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_TERMINAL_PROMPT; do
        [ -n "${!v:-}" ] && envs+=(-e "$v=${!v}")
    done
    # The server is started on its own first. When new-session is what
    # starts it, the server daemon keeps that new-session's argv (the -e
    # list above, token included) for the life of the server, where ps
    # shows it to every account on the machine. A server started bare has
    # nothing on its command line; the -e values still land in the
    # session's environment, which is where they were wanted.
    tmux start-server 2>/dev/null || true
    # ...and its environment brought up to date, whole. A pane inherits the
    # SERVER's environment (bug #54), which is frozen at the server's start,
    # so on a node, once one session existed, every later one ran with
    # the environment the agent had back then: no NODE_PATH from a recipe
    # installed since, no BB_CI_LOG_DIR from an agent updated since,
    # measured on bb-sandbox after the agent update that added it. Copied
    # in before every session, minus what is one account's rather than the
    # machine's; those ride on -e below, per session, and must never sit
    # where another account's pane could inherit them.
    local kv
    while IFS= read -r -d '' kv; do
        case "$kv" in
            TMUX*=*|_=*|PWD=*|OLDPWD=*|SHLVL=*|HOME=*|USER=*|LOGNAME=*|BB_TOKEN=*|BB_ACCOUNT_*=*|BB_PROJECT=*|BB_TREE=*|BB_TREE_OWNER=*|GIT_AUTHOR_*=*|GIT_COMMITTER_*=*|CARGO_HOME=*|GRADLE_USER_HOME=*|ANDROID_USER_HOME=*|XDG_DATA_HOME=*) continue ;;
        esac
        tmux set-environment -g "${kv%%=*}" "${kv#*=}" 2>/dev/null || true
    done < <(env -0)
    # ...and this account's identity taken OUT of the server's global
    # environment, where the first session's landed when the server was
    # started from a process that had it exported. A pane given no -e of its
    # own (a root shell, an account with no identity yet) would otherwise
    # inherit somebody else's name onto its commits, which is the very
    # mislabel the identity exists to stop.
    for v in GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
        tmux set-environment -gu "$v" 2>/dev/null || true
    done
    # -A -d creates it if it is missing and attaches to it if it is not, without
    # attaching yet: race-free where has-session followed by new-session is not.
    tmux new-session -A -d -s "$s" -c "$dir" "${envs[@]}" "$@"

    # Mouse mode decides who owns a drag. Off, the browser makes an ordinary
    # selection and the terminal copies it as the button comes up. On, tmux
    # takes the drag and the text reaches a tmux buffer the browser cannot see.
    # Shells want the clipboard; Claude's interface wants the mouse.
    # Plain name, not tmux's `=exact` prefix: set-option rejects that form
    # ("no such session: =shell"), and the session was just created here, so an
    # exact match is the one it resolves to anyway.
    case "$s" in
        claude-*) tmux set-option -t "$s" mouse on ;;
        *)        tmux set-option -t "$s" mouse off ;;
    esac

    # tmux's own right-click menu is drawn in the terminal, underneath the
    # browser's context menu, which covers it: two menus for one click, and
    # only one of them dismissable. The browser's cannot be suppressed from
    # here (the terminal is served from its own port and is a cross-origin
    # frame), so the one we control is the one that goes.
    tmux unbind-key -n MouseDown3Pane 2>/dev/null || true
    tmux unbind-key -n MouseDown3Status 2>/dev/null || true
    tmux unbind-key -n MouseDown3StatusLeft 2>/dev/null || true
    tmux unbind-key -n MouseDown3StatusRight 2>/dev/null || true

    exec tmux attach-session -t "$s"
}

case "$target" in
    shell)
        git_identity ""
        need_author "a shell"
        start "$(sess shell)" "$WORKSPACE"
        ;;

    # sh:N:PROJECT: an additional numbered terminal, so the Shell button can
    # open several at once instead of returning to the same one. An empty
    # PROJECT means the workspace root.
    sh:*)
        rest="${target#sh:}"
        num="${rest%%:*}"
        proj="${rest#*:}"
        case "$num" in
            ''|*[!0-9]*) bad "Invalid terminal number: ${num}" ;;
        esac
        if [ -z "$proj" ]; then
            git_identity ""
            need_author "a shell"
            start "$(sess "shell-${num}")" "$WORKSPACE"
        fi
        dir="$WORKSPACE/$proj"
        git_identity "$proj"
        need_author "a shell"
        [ "$proj" = "$(basename -- "$proj")" ] && [ "$proj" != "." ] && [ "$proj" != ".." ] && [ -d "$dir" ] \
            || bad "No such project: ${proj}"
        in_view "$proj" "$dir"
        start "$(sess "shell-${proj}-${num}")" "$dir" "${RUN[@]}"
        ;;

    claude:*)
        rest="${target#claude:}"
        # claude:PROJECT                  a fresh conversation
        # claude:PROJECT:r:UUID           resume that transcript
        # ...:b:BOOT                      and which run of the container asked
        resume="" want_boot=""
        case "$rest" in
            *:b:*) want_boot="${rest##*:b:}"; rest="${rest%:b:*}" ;;
        esac
        case "$rest" in
            *:r:*) resume="${rest##*:r:}"; proj="${rest%%:r:*}" ;;
            *)     proj="$rest" ;;
        esac
        dir="$WORKSPACE/$proj"
        git_identity "$proj"
        # Reject anything that is not a directory sitting directly in the
        # workspace: no traversal, no absolute paths, no invented names.
        # Checked against the PROJECT, before session_dir may answer with a
        # worktree: the name is what has to be real.
        if [ "$proj" != "$(basename -- "$proj")" ] || [ "$proj" = "." ] || [ "$proj" = ".." ] || [ ! -d "$dir" ]; then
            echo "No such project: ${proj}" >&2
            echo "Available:" >&2
            # Same rule the dashboard lists by: a directory holding
            # .bbignore is not a project, so offering it here as one would
            # only send someone back to a name that will be refused again.
            find "$WORKSPACE" -maxdepth 1 -mindepth 1 -type d \
                -not -exec test -e '{}/.bbignore' ';' -printf '  %f\n' >&2
            bad ""
        fi
        # Attaching to a session that is already running is always fine: the
        # conversation is there, and this is how a tab comes back to it.
        # *Starting* one is a decision, and it has to be a decision made now.
        #
        # A browser left open across a container restart still holds its Claude
        # tabs, and a phone waking up reloads the terminal iframe, which
        # spawns whatever its URL names, silently, minutes after a restart
        # nobody connected it to. Pruning the stored layout at boot cannot stop
        # that; the page never re-read it. So the URL carries the boot it was
        # opened in, and one from a previous run is refused here, where the
        # session would otherwise be created. On a node the boot in the URL
        # is the NODE's (the page takes it from the project's row), compared
        # against this machine's, so a controller restart does not orphan a
        # tab whose session is alive here, and a node reboot does refuse one.
        #
        # First of the checks, so a tab that is going to be refused anyway
        # does not first fetch a login it will not use.
        if ! tmux has-session -t "=$(sess "claude-${proj//[.:]/_}")" 2>/dev/null \
           && [ "$want_boot" != "$(boot_id)" ]; then
            bad "This tab is from before ${BB_NODE:-the container} restarted." \
                "Its conversation is still on disk. Open Claude on ${proj} from" \
                "the dashboard's Projects card to pick it up again. Starting a" \
                "session is a decision, and a reconnecting tab is not one."
        fi
        # Signed out, a session starts and dies on claude's own error, which
        # reads like the container is broken. Refused positively only: an
        # older claude with no `auth` subcommand, or one that cannot answer,
        # gets the benefit of the doubt, because a wrong refusal here is worse
        # than a confusing message.
        logged_in() {
            [ "$(claude auth status --json 2>/dev/null \
                 | tr -d ' ' | sed -n 's/.*"loggedIn":\([a-z]*\).*/\1/p')" != false ]
        }
        # EACH MACHINE KEEPS ITS OWN LOGIN, and opening a tab is when this
        # one says so (R47). `bb login --check` carries one sentence and no
        # secret: which Anthropic account this account is signed in as here.
        # Nothing is copied from another machine, because a refresh ROTATES
        # the refresh token and two machines holding one grant sign each
        # other out, which is what bug #64 and B100 were.
        #
        # So signing in on one node does NOT sign in another: each is signed
        # in from its own row on the Nodes tab, and a tab opened here before
        # that is told where. Never fatal and silent when nothing moved: a
        # controller that is down costs a session nothing.
        if on_node; then
            bb login --check >/dev/null 2>&1 || true
        fi
        if ! logged_in; then
            if on_node; then
                bad "This account is not signed in to Claude on ${BB_NODE:-this node}." \
                    "Open the Nodes tab, pick ${BB_NODE:-this node}, and press Sign in under" \
                    "Claude Code; then open this again. A login on another node does not travel."
            fi
            bad "This container is not signed in to Claude, and carries no Claude Code:" \
                "a session runs on a node, signed in from its row on the Nodes tab."
        fi
        if is_locked "$proj"; then
            bad "'${proj}' is locked: the operator runs this one, so no Claude" \
                "session starts here. Unlock it from the Projects card if that" \
                "was not what you meant."
        fi
        git_identity "$proj"
        need_author "a Claude session"
        cmd=(claude --remote-control "$proj")
        if [ -n "$resume" ]; then
            # Checked against a transcript that actually exists, so a mistyped
            # URL cannot turn into an argument claude tries to interpret.
            case "$resume" in
                *[!0-9a-fA-F-]*|"") bad "Not a session id: ${resume}" ;;
            esac
            if [ ! -f "$HOME/.claude/projects/${dir//\//-}/${resume}.jsonl" ]; then
                bad "No transcript ${resume} for ${proj}." \
                    "It may have been cleaned up; start a new conversation instead."
            fi
            cmd+=(--resume "$resume")
        fi
        # What this session is handed, in front of it: the house rules first,
        # then the open roadmap, then the open bugs. This is the whole reason
        # the list is worth keeping: a note left in a conversation dies with
        # it, and one left here is read by the next session without anybody
        # remembering to mention it.
        #
        # Assembled by preamble.py rather than here. It was three calls and
        # two shell joins in this file, which was fine while the launcher was
        # the only reader and stopped being fine when the Briefing tab wanted
        # to SHOW a person what their sessions are sent: two assemblies of one
        # string drift, and the one that drifts is the one nobody runs. The
        # order, the joins and the cap are all one decision now, over there.
        #
        # Named rather than inferred: bb takes the project from the working
        # directory, and this is not run from one. A controller that is not
        # answering makes this fail, which is caught here so the session still
        # starts; the else below is what says so, because an empty answer used
        # to be an ordinary state (a project with nothing on its lists) and
        # since the briefing joined it, empty means the fetch failed (B160).
        pre="$(BB_PROJECT="$proj" BB_UID="$account" bb preamble --json 2>/dev/null || true)"
        roadmap_block="$(printf '%s' "$pre" | jq -r '.text // ""' 2>/dev/null || true)"
        # The block goes in a file, so the kernel's argv ceiling is not the
        # limit; what bounds it is what a session should be asked to read,
        # since every conversation pays for all of it. Each part keeps to a
        # share (share.py) and says in the text what it left out; this says
        # so to whoever opened the terminal as well.
        printf '%s' "$pre" | jq -r '(.notes // [])[]' >&2 2>/dev/null || true
        # Kept beside the command rather than in it: the fallback below starts
        # the session without this block, and cannot if the two are one array.
        #
        # In a FILE, not in the argument. A single argv entry cannot exceed
        # MAX_ARG_STRLEN (131072 bytes on Linux), which is why preamble.py used
        # to cut the block and why a project with a long roadmap was told its
        # own list did not fit. `--append-system-prompt-file` has no such
        # ceiling, so the list a project keeps is the list its sessions get.
        # Beside session.env in this project's cache folder, which is the one
        # place a session's view keeps (R35), written 0600 like the token.
        prompt=()
        if [ -n "$roadmap_block" ]; then
            pref="$(cache_project_dir "$proj")/preamble.txt"
            if ( umask 077; printf '%s\n' "$roadmap_block" > "$pref.new" ) && mv -f "$pref.new" "$pref"; then
                prompt=(--append-system-prompt-file "$pref")
            else
                echo "WARNING: could not write this session's briefing to ${pref};" >&2
                echo "it starts without the rules, roadmap and bugs." >&2
            fi
        else
            echo "WARNING: could not fetch this session's briefing from the" >&2
            echo "controller, so it starts with none: no house rules, no" >&2
            echo "roadmap, no open bugs, and nothing about this machine." >&2
            echo "\`bb status\` says whether the controller is answering." >&2
        fi
        # Where this session works (roadmap #24). The owner gets the project
        # directory; anybody else gets a worktree of their own on a branch of
        # their own, so two people on one project cannot overwrite each other,
        # commit each other's half-finished work, or share a dist/.
        dir="$(session_dir "$proj" "$account")"
        # Claude Code's first run asks three things at the keyboard (a
        # text theme, whether to trust the folder, and the onboarding
        # screens), and a home this dashboard made has never answered them:
        # every account's home here, and every home on a node. A person at
        # a terminal can pick; an account with no shell is looking at a
        # read-only console, and the picker is the one screen its text box
        # cannot drive. So the answers are written before the session
        # starts, the way ~/.claude.json would hold them after: dark (every
        # dashboard scheme is dark, so there is nothing to ask), the
        # session's own directory trusted (bb-tty walls it in there; the
        # dialog would be asking about the tree it was just handed), and
        # onboarding done. Merged into whatever is there, never replacing a
        # file a person has already shaped, and only when the answer is
        # missing: a theme somebody set with /theme stays theirs.
        if ! claude_first_run "$dir"; then
            echo "WARNING: could not record ${dir} as trusted in ${HOME}/.claude.json." >&2
            echo "Claude Code ignores a workspace's own permission rules until it is," >&2
            echo "so this session will ask about every command and keep none of the" >&2
            echo "answers. Check that file exists and is writable." >&2
        fi
        # Every bb verb resolves the project as BB_PROJECT first and falls back
        # to the directory's name, which in a worktree is an account id. One
        # export rather than a special case in each of them.
        export BB_PROJECT="$proj"
        # Which tree this session is in, so the hook records a path relative
        # to it: the same file in two worktrees has to be one name, or
        # comparing across them compares nothing.
        export BB_TREE="$dir"
        if scope="$(claude_scope "$proj" "$dir")"; then
            cmd+=(--settings "$scope")
        else
            # Say so rather than starting an unconfined session that looks
            # identical to a confined one.
            echo "WARNING: could not build the project scope for '${proj}'." >&2
            echo "This session is NOT restricted to its own directory." >&2
        fi
        # An existing session is attached to rather than replaced, so clicking
        # a project twice returns to the same conversation instead of starting a
        # second one alongside it.
        # A session under a claude name must be running claude. tmux takes a
        # session with the command it was given, so a conversation that ends
        # leaves nothing behind, but if one ever does survive as a bare
        # shell, this tab is not the way into it: the name is claimed for
        # claude, and anything else wearing it is replaced rather than
        # attached to.
        # pane_start_command, not pane_current_command: the current one is
        # whatever is in the foreground this second, and claude runs its tools
        # as subprocesses, so a session busy running a build reports `bash`
        # and would have been killed here, mid-conversation. The start command
        # is what the pane was created with and does not move.
        mysess="$(sess "claude-${proj//[.:]/_}")"
        if tmux has-session -t "=$mysess" 2>/dev/null \
           && ! tmux list-panes -t "=$mysess" -F '#{pane_start_command}' 2>/dev/null \
                | grep -qi claude; then
            log "${mysess}: session is not running claude; replacing it"
            tmux kill-session -t "=$mysess" 2>/dev/null || true
        fi
        # The flag was missing and has just been put back. A session already
        # running here read the old answer when it started and cannot be told
        # otherwise, so it will go on asking about every command until it is
        # restarted, which is the whole of what somebody sees, and is worth a
        # line rather than a mystery.
        if [ "${CLAUDE_TRUST_ADDED:-0}" = 1 ] && tmux has-session -t "=$mysess" 2>/dev/null; then
            echo "NOTE: ${dir} was not trusted in ${HOME}/.claude.json; it is now." >&2
            echo "The session already running here started on the old answer, so it" >&2
            echo "will keep asking about every command until it is restarted." >&2
        fi
        # On a node, a session that is about to be MADE is announced to the
        # project's channel through the controller; its proxy announces a
        # local one and cannot see this one. A reattach is not a start.
        if on_node && ! tmux has-session -t "=$mysess" 2>/dev/null; then
            "$(dirname "$(readlink -f "$0")")/bb-prompt-relay" --started "$proj" "$account" \
                >/dev/null 2>&1 || true
        fi
        # A new project's brief, when whoever pressed Claude chose Build it:
        # taken now, as this session is made, which is the moment it leaves
        # the project's tree, and left beside the launcher for its first exec
        # to hand claude (brief.py). A reattach or a resume is not a new
        # session and takes nothing.
        # Only what a take that succeeded printed: a bb too old to know the
        # verb prints its help and fails, and that is not a prompt.
        if [ -z "$resume" ] && ! tmux has-session -t "=$mysess" 2>/dev/null; then
            first="$(BB_PROJECT="$proj" bb brief take 2>/dev/null)" || first=""
            if [ -n "$first" ]; then
                fpf="$(cache_project_dir "$proj")/first-prompt.txt"
                ( umask 077; printf '%s\n' "$first" > "$fpf.new" ) 2>/dev/null \
                    && mv -f "$fpf.new" "$fpf" 2>/dev/null || true
            fi
        fi
        # Through a launcher, always, not only when the prompt happens to be
        # long today. A path that is exercised on every session is one that
        # works; a fallback taken only past 16KB is one nobody finds out about
        # until a notebook grows. If the file cannot be written, the command
        # goes to tmux directly, which is what used to happen and is still
        # right for a short one.
        if launcher="$(claude_launcher "$proj" \
                          "$HOME/.claude/projects/${dir//\//-}" \
                          "${cmd[@]}" "${prompt[@]}")"; then
            in_view "$proj" "$dir" "$launcher"
            start "$(sess "claude-${proj}")" "$dir" "${RUN[@]}"
        else
            # Nowhere to write it. The command without the block still fits on
            # tmux's command line, and a session that starts knowing less is
            # worth more than one that refuses to start at all, which is what
            # passing the block here would produce for any real roadmap.
            echo "WARNING: could not write the launcher for '${proj}'," >&2
            echo "so this session starts without the project's roadmap and bugs," >&2
            echo "and on claude's own model rather than the one set for it." >&2
            echo "Everything else about it is the same. Check that ${HOME:-\$HOME}/.cache" >&2
            echo "is writable." >&2
            in_view "$proj" "$dir" "${cmd[@]}"
            start "$(sess "claude-${proj}")" "$dir" "${RUN[@]}"
        fi
        ;;
    shell:*)
        proj="${target#shell:}"
        dir="$WORKSPACE/$proj"
        git_identity "$proj"
        [ "$proj" = "$(basename -- "$proj")" ] && [ "$proj" != "." ] && [ "$proj" != ".." ] && [ -d "$dir" ] \
            || bad "No such project: ${proj}"
        in_view "$proj" "$dir"
        start "$(sess "shell-${proj}")" "$dir" "${RUN[@]}"
        ;;
    *)
        # A named scratch session. Restricted to characters tmux is happy with
        # so a stray URL cannot produce a session nobody can address again.
        case "$target" in
            *[!A-Za-z0-9._-]*) bad "Invalid session name: ${target}" ;;
        esac
        start "$target" "$WORKSPACE"
        ;;
esac
