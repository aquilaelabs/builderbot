#!/usr/bin/env python3
"""BuilderBot's own Codex hooks, trusted for one launch (B284).

Codex CLI runs a hook a person has not reviewed only under
--dangerously-bypass-hook-trust, which every ChatGPT session then opened on
as a warning. Codex records a reviewed hook as its key (the hooks file, the
event, the group and the handler) and the hash of its definition, under
hooks.state. This asks the Codex about to run for both, over its app server
(hooks/list), so the hash is Codex's own and never a copy of how it is made,
and prints the one -c argument that trusts BuilderBot's hooks and nothing
else: those in the account's hooks.json that run bb-agent-hook. A -c table
is merged into the account's own hooks.state, so a hook the person trusted
stays trusted.

    bb-codex-trust CODEX_HOME DIR

Prints `hooks.state={...}` and exits 0, or prints nothing and exits 1 when
this Codex cannot say (no app server, no hooks/list, none of ours listed):
the launcher then falls back to the bypass flag, so a guard is never
silently skipped.
"""
import json
import os
import select
import subprocess
import sys
import time

ASK_S = 10


def listed(cwd):
    """Codex's hooks/list for DIR, or None."""
    try:
        p = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, cwd=cwd)
    except OSError:
        return None
    try:
        for m in ({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                   "params": {"clientInfo": {"name": "builderbot", "version": "1"}}},
                  {"jsonrpc": "2.0", "method": "initialized"},
                  {"jsonrpc": "2.0", "id": 2, "method": "hooks/list", "params": {"cwds": [cwd]}}):
            p.stdin.write(json.dumps(m) + "\n")
        p.stdin.flush()
        end = time.monotonic() + ASK_S
        while time.monotonic() < end:
            ready, _, _ = select.select([p.stdout], [], [], max(0.0, end - time.monotonic()))
            if not ready:
                break
            line = p.stdout.readline()
            if not line:
                break
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == 2:
                return msg.get("result")
        return None
    except OSError:
        return None
    finally:
        p.kill()
        p.wait()


def main(argv):
    if len(argv) != 3:
        print(__doc__.strip().split("\n\n")[2], file=sys.stderr)
        return 2
    mine = os.path.realpath(os.path.join(argv[1], "hooks.json"))
    got = listed(argv[2])
    hooks = [h for d in ((got or {}).get("data") or []) for h in (d.get("hooks") or [])]
    ours = {h["key"]: h["currentHash"] for h in hooks
            if isinstance(h, dict) and h.get("key") and str(h.get("currentHash", "")).startswith("sha256:")
            and os.path.realpath(str(h.get("sourcePath") or "")) == mine
            and "bb-agent-hook" in str(h.get("command") or "")}
    if not ours:
        return 1
    # JSON's strings are TOML's basic strings for every character a path or a
    # hash carries.
    print("hooks.state={" + ", ".join(f"{json.dumps(k)}={{trusted_hash={json.dumps(v)}}}"
                                      for k, v in sorted(ours.items())) + "}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
