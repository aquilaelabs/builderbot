#!/usr/bin/env python3
"""Two hooks that hold a session to its house rules (R200), with the
project and the account baked into the command line by bb-tty's
claude_scope():

    bb-rule-hook guard PROJECT SESSION    # PreToolUse, on Bash
    bb-rule-hook recall PROJECT SESSION   # SessionStart, after a compaction
    bb-rule-hook start PROJECT SESSION    # SessionStart, when one begins
    bb-rule-hook map PROJECT SESSION      # PreToolUse, on Grep

GUARD refuses a Bash call that runs a command a rule refuses (rules.py,
`refuse`: the shipped ask-do-not-install, the operator's own, and the
briefing's never-do lines), with the rule's text as the reason, so a
habit is stopped where it happens rather than read about earlier and
forgotten. On the controller the store is read here; on a node the
controller's list is fetched on the hook trip and kept a minute
(scripts/lib/rulehook.py). A line the reader cannot parse, a list that
cannot be had, any failure of this script: the call goes ahead, since a
guard that cannot run is not worth a turn, and bb-gate already holds
every call while the controller is not answering.

MAP, and GUARD on a call it lets through: a search for where a name is
defined or called (grep for `def NAME`, `function NAME`, `NAME(`, or the
Grep tool's pattern) is handed `bb map find NAME`'s answer beside it, a
few lines, so a session that reached for grep out of habit still gets the
one-call answer and does not spend the reads it would have saved (the
operator, 12 Oct). The search runs either way; a name the map does not
know adds nothing.

START shows the person, as a system message and nothing else, what the
session was handed: each part of the block (bb preamble) with its size,
so what Claude starts from is on the screen rather than only in its
system prompt (the operator, 12 Oct).

RECALL runs when Claude Code has summarized a long conversation. The
briefing and the standing rules are in the system prompt and survive
that; what does not is the named rules that arrived on earlier turns, so
this says those again in full, from the record bb-work-note and
bb-prompt-relay keep of what fired in this conversation.
"""
import contextlib
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
import rulehook  # noqa: E402


def on_node():
    return os.environ.get("BUILDERBOT_ROLE", "").lower() in ("node", "worker", "agent")


def post_hook(body):
    import bbapi                                             # noqa: E402
    r = bbapi.call("/api/v1/hook", body, auth="Bearer " + os.environ.get("BB_TOKEN", ""), timeout=10)
    return r if isinstance(r, dict) else {}


def _write_json(p, d):
    with open(f"{p}.new", "w") as f:
        json.dump(d, f, indent=2)
    os.replace(f"{p}.new", p)


def local_rules():
    sys.path.insert(0, HERE)
    import rules                                             # noqa: E402
    rules.configure(state=os.environ.get("DASHBOARD_STATE", "/config"), write_json=_write_json)
    return rules


def guards(project):
    if not on_node():
        return local_rules().guards(project)
    have = rulehook.cached_guards(project)
    if have is None:
        got = post_hook({"kind": "guards"}).get("guards")
        if isinstance(got, list):
            rulehook.keep_guards(project, got)
            have = got
        else:
            have = rulehook.cached_guards(project, stale=True) or []
    return have


def map_first(req, patterns):
    """`bb map find` for the names these search patterns look up, said
    beside the search; nothing when there is none or the map knows none."""
    names = []
    for p in patterns:
        names += [n for n in rulehook.symbols(p) if n not in names]
    names = names[:rulehook.MAP_NAMES]
    if not names:
        return
    import subprocess
    bb = os.path.join(HERE, "..", "bb")
    said = []
    for n in names:
        try:
            r = subprocess.run(["bash", bb, "map", "find", n], capture_output=True, text=True, timeout=10,
                               cwd=req.get("cwd") or None)
        except (OSError, subprocess.SubprocessError):
            continue
        out = (r.stdout or "").strip()
        if r.returncode or not out or out.startswith("nothing defines"):
            continue
        lines = out.splitlines()
        said.append(f"$ bb map find {n}\n" + "\n".join(lines[:rulehook.MAP_LINES])
                    + (f"\n({len(lines) - rulehook.MAP_LINES} more lines)" if len(lines) > rulehook.MAP_LINES else ""))
    if not said:
        return
    text = ("The code map answers this lookup in one call; its answer, beside your search "
            "(bb map who-calls NAME gives the callers):\n" + "\n".join(said))
    json.dump({"systemMessage": rulehook.shown("looked it up in the map", text),
               "hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": text}}, sys.stdout)


def grep_tool(project, req):
    map_first(req, [str((req.get("tool_input") or {}).get("pattern") or "")])


def guard(project, req):
    if req.get("tool_name") not in (None, "Bash"):
        return
    command = str((req.get("tool_input") or {}).get("command") or "")
    if not command.strip():
        return
    background = bool((req.get("tool_input") or {}).get("run_in_background"))
    hit = rulehook.refused(guards(project), command, background)
    if not hit:
        map_first(req, rulehook.search_patterns(command))
        return
    why = rulehook.refusal(*hit)
    json.dump({"systemMessage": rulehook.shown("refused a command", why),
               "hookSpecificOutput": {"hookEventName": "PreToolUse",
                                      "permissionDecision": "deny",
                                      "permissionDecisionReason": why}}, sys.stdout)


def recall(project, req):
    names = rulehook.fired(project, req.get("session_id"))
    if not names:
        return
    if on_node():
        said = str(post_hook({"kind": "recall", "names": names}).get("rules") or "")
    else:
        r = local_rules()
        said = r.said(r.by_names(project, names), again=True)
    if said:
        json.dump({"systemMessage": rulehook.shown("told Claude again after the summary", said),
                   "hookSpecificOutput": {"hookEventName": "SessionStart",
                                          "additionalContext": said}}, sys.stdout)


def start(project, req):
    import subprocess
    bb = os.path.join(HERE, "..", "bb")
    r = subprocess.run(["bash", bb, "preamble", "--json"], capture_output=True, text=True, timeout=20,
                       env={**os.environ, "BB_PROJECT": project})
    got = json.loads(r.stdout or "{}")
    parts = got.get("parts") or []
    if not parts:
        return
    size = lambda n: f"{n / 1024:.1f} KB" if n >= 1024 else f"{n} bytes"
    said = ", ".join(f"{p.get('name')} {size(int(p.get('bytes') or 0))}" for p in parts)
    left = "; ".join(got.get("notes") or [])
    json.dump({"systemMessage": rulehook.shown(
        "briefed Claude", f"{said} ({size(int(got.get('bytes') or 0))} in all){'; ' + left if left else ''}."
                          " `bb preamble` prints it whole, as does the notebook's Briefing view.")}, sys.stdout)


def main():
    verb, project = (sys.argv[1:3] + ["", ""])[:2]
    if not project or verb not in ("guard", "recall", "start", "map"):
        return
    try:
        req = json.load(sys.stdin)
    except (ValueError, OSError):
        return
    if not isinstance(req, dict):
        return
    {"guard": guard, "recall": recall, "start": start, "map": grep_tool}[verb](project, req)


if __name__ == "__main__":
    with contextlib.suppress(Exception):   # never cost a turn
        main()
    sys.exit(0)
