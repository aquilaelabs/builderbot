#!/usr/bin/env python3
"""git's credential helper for a project's own token (R135): `git-credential-bb
FILE get` answers git's question with the token FILE holds, opened under the
install key when it is sealed, and only for the scheme and host it was
written for. store and erase are git telling a helper what worked; this one
keeps nothing it is told."""
import os
import re
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gitcreds  # noqa: E402
import signing  # noqa: E402


def main(argv):
    if len(argv) != 3 or argv[2] != "get":
        return 0
    asked = dict(ln.split("=", 1) for ln in sys.stdin.read().splitlines() if "=" in ln)
    signing.load_master()
    gitcreds.unseal = signing.unseal
    try:
        with open(argv[1]) as f:
            line = gitcreds.open_text(f.read())
    except OSError:
        return 0
    m = re.match(r"(https?)://([^:@/]*):([^@/]*)@([A-Za-z0-9.:%-]+)$", line)
    if not m or m.group(1) != asked.get("protocol") \
            or urllib.parse.unquote(m.group(4)).lower() != asked.get("host", "").lower():
        return 0
    print(f"username={urllib.parse.unquote(m.group(2))}")
    print(f"password={urllib.parse.unquote(m.group(3))}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
