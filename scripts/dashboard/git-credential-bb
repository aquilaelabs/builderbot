#!/usr/bin/env python3
"""git's credential helper for a project's own token (R135): `git-credential-bb
FILE get` answers git's question with the token FILE holds, opened under the
install key when it is sealed, and only for the scheme and host it was
written for; a project linked to a person's account (R154) answers with the
token that account keeps for the host. `git-credential-bb --account STATE
UID PROJECT get` answers from that account's own key store, for its own git
work: the entry PROJECT is linked to when it is the account's, else its
newest for the host.
store and erase are git telling a helper what worked; this one keeps
nothing it is told."""
import os
import re
import sys
import urllib.parse
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gitcreds  # noqa: E402
import signing  # noqa: E402


def main(argv):
    account = len(argv) == 6 and argv[1] == "--account"
    if not (account or len(argv) == 3) or argv[-1] != "get":
        return 0
    asked = dict(ln.split("=", 1) for ln in sys.stdin.read().splitlines() if "=" in ln)
    signing.load_master()
    gitcreds.unseal = signing.unseal
    if account:
        # Their own token, while they are signed in (R159): the entry they
        # gave this project, else their newest for the host asked about.
        gitcreds.STATE = Path(argv[2])
        if not gitcreds._live(argv[3]):
            return 0
        fid = gitcreds.given_by(argv[4], argv[3])
        line = gitcreds._accounts().forge_line(argv[3], fid=fid) if fid else ""
        if not line or urllib.parse.unquote(line.rsplit("@", 1)[-1]).lower() != asked.get("host", "").lower():
            line = gitcreds._accounts().forge_line(argv[3], host=asked.get("host", ""))
    else:
        f = Path(argv[1])
        gitcreds.STATE = f.parent.parent
        try:
            # The project's: any signed-in giver's token, else a line kept
            # as the project's own from before.
            line = gitcreds.read_line(f.name, uid="") if f.parent.name == "gitcreds" else gitcreds.open_text(f.read_text())
        except OSError:
            return 0
    m = re.match(r"(https?)://([^:@/]*):([^@/]*)@([A-Za-z0-9.:%-]+)$", line)
    if not m or m.group(1) != asked.get("protocol") \
            or urllib.parse.unquote(m.group(4)).lower() != asked.get("host", "").lower():
        return 0
    print(f"username={urllib.parse.unquote(m.group(2))}")
    print(f"password={urllib.parse.unquote(m.group(3))}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
