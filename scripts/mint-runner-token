#!/usr/bin/env bash
#
# Root-only helper that keeps each node's runner token and mints GitHub
# Actions runner registration and removal tokens from it, so the unprivileged
# `builder` user (and any Claude session running as it) never holds the
# token itself.
#
# The builder user may run exactly this script via sudo (the image's sudoers
# rule). A token comes in on stdin once and lives under a root-only directory
# keyed by node id; every other verb prints a derived answer and never the
# token. sudo's env_reset means the caller cannot inject values.
#
# A node holds one runner per git host, so a token is keyed by the node
# and the runner's SLOT: its address as a name (github.com-your-org).
#
#   mint-runner-token store NODE SLOT          keep RUNNER_URL=, RUNNER_TOKEN= (and RUNNER_FORGE=) read on stdin
#   mint-runner-token forget NODE SLOT         drop that runner's token
#   mint-runner-token --check NODE SLOT        exit 0 and print the URL and forge when a token is stored (offline)
#   mint-runner-token --validate NODE SLOT     ask the host whether that token is live
#   mint-runner-token --list                   "NODE SLOT" per stored token, one per line
#   mint-runner-token registration NODE SLOT   print a runner registration token
#   mint-runner-token remove NODE SLOT [ID]    GitHub: print a runner removal token; Gitea: delete runner ID there
#
set -euo pipefail

. /opt/builderbot/scripts/lib/common.sh

# Under /config rather than /run so a token survives the container being
# recreated; root-only, so the dashboard and every session reach it only
# through this script.
STORE=/config/runner-tokens

[ "$(id -u)" -eq 0 ] || die "must run as root (via sudo)"

kind="${1:-}"
node="${2:-}"
slot="${3:-}"
runner_id="${4:-}"
case "$kind" in
    store|forget|--check|--validate|registration|remove)
        [[ "$node" =~ ^n_[0-9a-f]{8}$ ]] && [[ "$slot" =~ ^[a-z0-9.-]{1,64}$ ]] \
            || die "usage: mint-runner-token $kind NODE_ID SLOT" ;;
    --list|--reset) ;;
    *) die "usage: mint-runner-token [store|forget|--check|--validate|registration|remove] NODE_ID SLOT, or --list, or --reset" ;;
esac
file="$STORE/$node.$slot.env"

case "$kind" in
    --reset)
        # Every stored token, for the controller's Reset: the nodes they
        # belonged to are being forgotten, and a token for a node id that
        # will never be minted again is a file nobody can reach or use.
        [ -d "$STORE" ] || { echo "reset: nothing stored"; exit 0; }
        n=0
        for f in "$STORE"/n_*.*.env; do
            [ -f "$f" ] || continue
            rm -f "$f"; n=$((n + 1))
        done
        echo "reset: $n token(s) forgotten"
        exit 0 ;;
    --list)
        [ -d "$STORE" ] || exit 0
        for f in "$STORE"/n_*.*.env; do
            [ -f "$f" ] || continue
            b="${f##*/}"; b="${b%.env}"
            printf '%s %s\n' "${b%%.*}" "${b#*.}"
        done
        exit 0 ;;
    store)
        url=""; token=""; forge="github"
        while IFS= read -r line; do
            case "$line" in
                RUNNER_URL=*)   url="${line#RUNNER_URL=}" ;;
                RUNNER_TOKEN=*) token="${line#RUNNER_TOKEN=}" ;;
                RUNNER_FORGE=*) forge="${line#RUNNER_FORGE=}" ;;
            esac
        done
        # http as well as https: a Gitea on the LAN serves plain http, and
        # the token then travels the way the node's own enrollment did.
        [[ "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9._/-]+$ ]] \
            || die "the URL is the https address of the repository or organization the runner registers with (http is accepted for a forge on your own network)"
        [[ "$token" =~ ^[A-Za-z0-9._-]{8,}$ ]] || die "the token is one line of letters, digits, . _ and -"
        [[ "$forge" =~ ^[a-z]{1,16}$ ]] || die "not a forge kind"
        install -d -m 0700 -o root -g root "$STORE"
        umask 077
        printf 'RUNNER_URL=%q\nRUNNER_FORGE=%q\nRUNNER_TOKEN=%q\n' "$url" "$forge" "$token" > "$file.new"
        mv -f "$file.new" "$file"
        echo "stored"
        exit 0 ;;
    forget)
        rm -f "$file"
        echo "forgotten"
        exit 0 ;;
esac

[ -f "$file" ] || die "no runner token stored for this runner on $node: add it in the runner section of the node's row on the Nodes tab"
# shellcheck disable=SC1090
. "$file"
[ -n "${RUNNER_URL:-}" ] && [ -n "${RUNNER_TOKEN:-}" ] || die "the token stored for $slot on $node is incomplete: store it again"

if [ "$kind" = "--check" ]; then
    printf 'RUNNER_URL=%s\nRUNNER_FORGE=%s\n' "$RUNNER_URL" "${RUNNER_FORGE:-github}"
    exit 0
fi

# Gitea and Forgejo: act_runner takes a registration token from the host's
# API, and a runner is deleted there by id rather than by a removal token.
if [ "${RUNNER_FORGE:-github}" = gitea ]; then
    scheme="${RUNNER_URL%%://*}"
    rest="${RUNNER_URL#*://}"
    host="${rest%%/*}"
    path="${rest#*/}"; path="${path%/}"; path="${path%.git}"
    case "$path" in
        */*) scope="repos/$path" ;;
        "")  die "could not read an owner from ${RUNNER_URL}" ;;
        *)   scope="orgs/$path" ;;
    esac
    gitea_api() {
        local method="$1" path="$2" resp code
        resp="$(curl -sS -w $'\n%{http_code}' -X "$method" \
            -H "Authorization: token ${RUNNER_TOKEN}" -H "Accept: application/json" \
            "${scheme}://${host}/api/v1${path}" 2>&1)" \
            || die "could not reach ${host} for ${path} (network/DNS?)"
        code="${resp##*$'\n'}"
        case "$code" in
            2*) printf '%s' "${resp%$'\n'*}" ;;
            401) die "${host} rejected the token (401): it is invalid, revoked or expired" ;;
            403) die "${host} denied the request (403) on ${path}: the token needs write on the organization or repository" ;;
            404) die "${host} has nothing at ${path}: check the address, or the token cannot see it" ;;
            *)   die "${host} answered ${code} on ${path}" ;;
        esac
    }
    case "$kind" in
        --validate)   gitea_api GET /user >/dev/null; echo "token accepted by ${host}" ;;
        registration) token="$(gitea_api GET "/${scope}/actions/runners/registration-token" | jq -r .token)"
                      [ -n "$token" ] && [ "$token" != "null" ] || die "${host} returned no token"
                      printf '%s\n' "$token" ;;
        remove)       [[ "$runner_id" =~ ^[0-9]{1,12}$ ]] || die "removing a Gitea runner needs its id"
                      gitea_api DELETE "/${scope}/actions/runners/${runner_id}" >/dev/null
                      echo "removed" ;;
    esac
    exit 0
fi
[ "${RUNNER_FORGE:-github}" = github ] || die "runners register with GitHub, Gitea or Forgejo; ${RUNNER_FORGE} has none here"
# github_api and scope_path in common.sh read RUNNER_TOKEN and RUNNER_URL,
# which the stored file has just set.

# Ask GitHub whether the token is actually live: /rate_limit answers to any
# valid token whatever its scopes, so a revoked one cannot pass as present.
if [ "$kind" = "--validate" ]; then
    github_api GET /rate_limit >/dev/null
    echo "token accepted by GitHub"
    exit
fi

token="$(github_api POST "$(scope_path "$kind")" | jq -r .token)"
[ -n "$token" ] && [ "$token" != "null" ] || die "GitHub returned no token"
printf '%s\n' "$token"
