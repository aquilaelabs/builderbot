# Copy to `.env` next to docker-compose.yml and fill in.
# Never commit the real .env — it holds tokens.

# ---------------------------------------------------------------------------
# Unraid basics
# ---------------------------------------------------------------------------
# 99:100 is nobody:users, what Unraid shares expect.
PUID=99
PGID=100
TZ=America/New_York

# Where BuilderBot keeps its own persistent state.
APPDATA_PATH=/mnt/user/appdata/BuilderBot

# ---------------------------------------------------------------------------
# Projects — the folder holding the repos Claude Code should be able to see
# ---------------------------------------------------------------------------
# Mounted whole, so every subfolder of it is a project at /workspace/<name>.
# Adding a project is making a folder here; the dashboard reports the ones with
# something wrong (no git repository, no CLAUDE.md, wrong ownership).
WORKSPACE_PATH=/mnt/user/development/projects

# The namespace every dev-instance compose project is named in. It exists
# because a daemon on this box also runs your real containers: the dashboard
# refuses any compose call outside this prefix, which is the only thing
# stopping it acting on one of them — so an empty value is IGNORED there and
# bbdev used regardless. Against a sandbox VM (ssh://) empty is honoured,
# because that machine holds nothing to protect. Changing it renames every

# Dev-instance volumes (optional). Uncomment the matching volume in
# docker-compose.yml. Its own share rather than a folder inside appdata:
# Unraid exports and backs up shares, not folders, so anything under appdata
# cannot be handed to a sandbox VM or backed up on its own terms. Not needed
# at all when the daemon is a sandbox VM node — that machine mounts the share
# and makes the per-instance directory itself.
# DEVDATA_PATH=/mnt/user/bb-sandbox/devdata

# Static-analysis reports (optional). Uncomment the matching read-only volume
# in docker-compose.yml. The scanner runs on the host; the container only ever
# sees its output, and reads it with `bb findings`.
# SCANNER_REPORTS_PATH=/mnt/user/appdata/scanners/reports

# ---------------------------------------------------------------------------
# package store — the big downloadable toolchains
# ---------------------------------------------------------------------------
# Android platforms, build-tools, the 800MB emulator and the multi-GB system
# images live here, along with Flutter/.NET/Swift if you install them. The
# point is that this is NOT in the image: the container is replaced on every
# update, this share is not, so nothing here is ever downloaded twice.
# Manage what is in it with `bb packages`; without a share the SDKs fall back to
# the home volume, which persists too but mixes them in with everything else.
SDK_PATH=/mnt/user/development/SDK
SDK_ROOT=/sdk

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# Option A: API key billing — paste a key from console.anthropic.com.
# Option B: Claude subscription — leave this blank and run
#           `docker exec -it builderbot bb login` once after first start.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# GitHub Actions runners — on NODES, never on this container
# ---------------------------------------------------------------------------
# CI runs on the nodes you enroll (the Nodes tab installs a runner on one).
# This container mints the short-lived registration tokens those installs
# need, and that is the whole of its part.
#
# Repo-level runners:  https://github.com/Stencil-Projects/BuilderBot
# Org-level runners:   https://github.com/Stencil-Projects
GITHUB_URL=https://github.com/Stencil-Projects/BuilderBot

# Fine-grained PAT with "Administration: read & write" on the target repo
# (or "Self-hosted runners: read & write" on the org). Used only to mint
# registration tokens for node runners.
#
# SHIELDING: a PAT set here is visible to every process in the container,
# including Claude sessions. To hide it, leave this empty and instead put
# GITHUB_PAT=... in a root-owned file mounted at /secrets (uncomment the
# secrets volume in docker-compose.yml) — tokens are then minted by a
# root-only helper and the PAT never enters Claude's environment. Token
# values are pattern- and literal-redacted from the logs either way.
GITHUB_PAT=

# ---------------------------------------------------------------------------
# Role: controller or node
# ---------------------------------------------------------------------------
# One image, two jobs. The default `controller` is the management instance —
# dashboard, terminals, runner, Claude. `node` makes this container a worker
# instead: it enrolls with a controller and runs its jobs (builds, tests,
# Android emulation), and the dashboard, the runner, Claude and the project
# hooks do not start. Use the same template twice to get one of each.
#
# A container node shares the host's GPU the ordinary Docker way, so the
# emulator can render on the card with no VM passthrough — map /dev/kvm and
# the GPU as you would for the controller. It is NOT a Docker host: dockerd
# inside a container wants --privileged, which is root on the server, so
# enroll it without the docker-host capability and leave dev instances to a
# VM node.
BUILDERBOT_ROLE=controller

# Node only. The dashboard's address as this container can reach it, and a
# one-time enrollment token from its Nodes tab (Enroll node shows one once).
# Both are ignored once the node has enrolled — its record lives under
# NODE_STORE_ROOT and survives image updates.
# CONTROLLER_URL=http://192.168.1.15:7680
# NODE_TOKEN=bbe_...
#
# Its stores are PATHS, not settings: identity, data, cache and artifacts under
# /config/node, packages at SDK_ROOT. Map a volume — an NFS one if you like —
# onto whichever you want elsewhere, the way you would for any container.

# Android — on a node, not here
# ---------------------------------------------------------------------------
# The image carries no JDK and no Android SDK (roadmap #24, 10c): builds,
# tests and the emulator run on the project's node, whose packages store
# holds the SDK, the emulator and the system images — installed from the
# dashboard's Tools tab with that node picked, or by `bb emu create <api>`
# on demand. Which API levels exist is what that store holds an image for;
# `bb emu list` on the node says. Nothing to set on a controller.
#
# The two settings below matter only on a container running as a NODE
# (BUILDERBOT_ROLE=node) that boots the emulator.
# Start an X server at boot for a passed-through NVIDIA GPU, so the emulator
# can render on it. Harmless with no GPU (the hook exits); set false to keep
# the container from starting an X server at all. Node role only.
ENABLE_GPU_DISPLAY=true

# Empty means auto: bb emu start tests whether EGL gives a vendor driver on
# the GPU's X display and uses -gpu host if it does, software if not. Set a
# value to force one — swiftshader_indirect, swangle_indirect or host.
ANDROID_EMULATOR_GPU=

# ---------------------------------------------------------------------------
# NVIDIA GPU (optional)
# ---------------------------------------------------------------------------
# Requires the NVIDIA Container Toolkit on the host (on Unraid: the
# Nvidia-Driver plugin) and the deploy: block in docker-compose.yml.
#
# Leave capabilities at "all" — the runtime's default of compute,utility
# injects CUDA but no GL/EGL/Vulkan, which looks like a working GPU right up
# until anything tries to render. `bb doctor` reports which you actually got.
#
# Visible devices: "all" is fine for a single card. With several, use the GPU
# UUID (Unraid lists them under Settings → Nvidia-Driver).
# Both are OFF by default now. A controller renders nothing — builds, tests
# and Android emulation run on a node — so claiming the card here takes it
# from whatever else on the server wants it, for no benefit. Set them on a
# container running as a node (BUILDERBOT_ROLE=node) that boots the emulator,
# and pair them with the runtime and /dev/kvm.
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=all

# ---------------------------------------------------------------------------
# Web dashboard (optional)
# ---------------------------------------------------------------------------
# Status page, bb macro buttons, and a browser terminal with persistent tmux
# sessions per project. Uncomment the ports block in docker-compose.yml too.
#
# The dashboard is not optional and has no switch: it IS the controller. Nodes
# dial into its API, so builds, tests, CI and emulation all go through it, and
# it is what starts a session with its guardrails and its notebook context. A
# container that should not run one is a NODE — set BUILDERBOT_ROLE=node above.
#
# THERE IS NO PASSWORD SETTING. The first page the dashboard serves asks you to
# make the owner account, and that is the only page it serves until you do —
# so open it as soon as the container is up, because until somebody claims it,
# whoever reaches the port can. What it publishes is a writable shell inside a
# container holding your loaded ssh-agent and read-write mounts of every
# project, so treat that account as equivalent to those.
#
# Afterwards, `bb users passwd <name>` changes a password and `bb users add`
# makes the others.
DASHBOARD_PORT=7680
# Loopback only — terminals are proxied through the dashboard port under
# /term, behind the same single sign-in, so this is never published.
DASHBOARD_TTYD_PORT=7681

# ---------------------------------------------------------------------------
# Package publishing (all optional)
# ---------------------------------------------------------------------------
# npm publish auth for registry.npmjs.org
NPM_TOKEN=
# `uv publish` reads UV_PUBLISH_TOKEN directly; `docker push ghcr.io/...`
# is wired up automatically from GITHUB_PAT when the socket is mounted.

# Recursively chown mounted projects to PUID:PGID on start. Off by default —
# only turn this on if permissions are actually fighting you.
CHOWN_PROJECTS=false

# Scrub GITHUB_PAT from session environments (recommended).
# false = legacy behavior: PAT visible inside, gh auto-authenticated.
SHIELD_SECRETS=true

# Image tag to run (latest, or a pinned sha/date tag).
BUILDERBOT_TAG=latest

# ---- dev instances (optional) ----------------------------------------------
# The sandbox VM the dashboard's Docker manager and dev instances build and
# run on is a NODE now, and it is enrolled with a token: press Enroll node on
# the dashboard's Nodes tab, then run nodes/provision-linux.sh on the machine with the
# controller URL and that token. Nothing here names it, and this container
# keeps no key that logs in anywhere. What this container's paths are called
# over there is set on the node's own row. DOCKER_HOST and
# DOCKER_HOST_PATHS, which named that machine in earlier releases, are gone
# with the ssh node kind they belonged to and are read nowhere.
# See docs/sandbox-vm.md.
