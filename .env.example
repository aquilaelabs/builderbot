# Copy to `.env` next to docker-compose.yml and fill in.
# Never commit the real .env — it holds tokens.

# ---------------------------------------------------------------------------
# Unraid basics
# ---------------------------------------------------------------------------
# 99:100 is nobody:users, what Unraid shares expect.
PUID=99
PGID=100
TZ=America/New_York

# Where BuilderBot keeps its own persistent state.
APPDATA_PATH=/mnt/user/appdata/BuilderBot

# ---------------------------------------------------------------------------
# Projects — the folder holding the repos Claude Code should be able to see
# ---------------------------------------------------------------------------
# Mounted whole, so every subfolder of it is a project at /workspace/<name>.
# Adding a project is making a folder here; the dashboard reports the ones with
# something wrong (no git repository, no CLAUDE.md, wrong ownership).
WORKSPACE_PATH=/mnt/user/development

# Static-analysis reports (optional). Uncomment the matching read-only volume
# in docker-compose.yml. The scanner runs on the host; the container only ever
# sees its output, and reads it with `bb findings`.
# SCANNER_REPORTS_PATH=/mnt/user/appdata/scanners/reports

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# Option A: API key billing — paste a key from console.anthropic.com.
# Option B: Claude subscription — leave this blank and run
#           `docker exec -it builderbot bb login` once after first start.
ANTHROPIC_API_KEY=

AUTO_UPDATE_CLAUDE=true
CLAUDE_CODE_VERSION=latest

# ---------------------------------------------------------------------------
# GitHub Actions runner
# ---------------------------------------------------------------------------
ENABLE_RUNNER=true

# Repo-level runner:  https://github.com/Stencil-Projects/BuilderBot
# Org-level runner:   https://github.com/Stencil-Projects
GITHUB_URL=https://github.com/Stencil-Projects/BuilderBot

# Fine-grained PAT with "Administration: read & write" on the target repo
# (or admin:org for an org runner). Used to mint runner registration tokens.
#
# SHIELDING: a PAT set here is visible to every process in the container,
# including Claude sessions. To hide it, leave this empty and instead put
# GITHUB_PAT=... in a root-owned file mounted at /secrets (uncomment the
# secrets volume in docker-compose.yml) — the runner then obtains tokens via
# a root-only helper and the PAT never enters Claude's environment. Token
# values are pattern- and literal-redacted from the logs either way.
GITHUB_PAT=

# Token used by git and gh INSIDE the container (clone/push/PRs).
#
# This one is readable by sessions on purpose: any credential git can
# authenticate with, a session running as the same user can read. That is
# unavoidable over HTTPS — only an ssh key in /secrets/ssh gives you "usable
# but unreadable". So scope GIT_PAT to repository *Contents* (read/write) and
# nothing else; Claude already has read/write on the mounted working trees,
# so a contents-scoped token grants no additional reach. Keep the powerful
# Administration scope in the shielded GITHUB_PAT above.
GIT_PAT=

RUNNER_NAME=builderbot
RUNNER_LABELS=builderbot,self-hosted,linux,x64,unraid
RUNNER_GROUP=
# Ephemeral: fresh registration per job. Safest default — no state leaks
# between workflow runs.
RUNNER_EPHEMERAL=true

# How long a `docker stop` may spend shutting down cleanly: deregistering the
# runner, powering the emulator off rather than yanking it, and ending Claude
# sessions. NOTE that Docker kills the container after ITS timeout regardless —
# 10s by default, and on Unraid that is Settings -> Docker -> Docker Stop
# Timeout, which overrides any --stop-timeout on the container. Raise that
# setting or nothing here has room to run.
SHUTDOWN_GRACE=90

# Terminals come back after a restart with this much of their screen. Bigger
# means a longer scrollback restored and a bigger file under /config/sessions.
BB_SESSION_HISTORY=2000

# How many previous boots' logs to keep (the log rotates on every start).
BB_LOG_KEEP=5

# ---------------------------------------------------------------------------
# git identity used for commits made inside the container
# ---------------------------------------------------------------------------
GIT_USER_NAME=Stencil923
# GitHub noreply: commits link to your profile without publishing an
# address, and it satisfies "block pushes that expose my email".
GIT_USER_EMAIL=124431934+Stencil923@users.noreply.github.com

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
# Creates the default AVD at startup; start it with `bb emu start`.
# For usable speed also uncomment the /dev/kvm devices: block in
# docker-compose.yml.
ENABLE_ANDROID_EMULATOR=false

# Comma-separated API levels to keep a system image and AVD for. As of 2026 the
# supported range is 34-37 (Android 14 through 17); 33 and below are EOL.
# Budget ~2GB each on the appdata share — they are downloaded once and persist
# across image updates. AVDs are named builderbot-<api>; boot one with
# `bb emu start 37`, and see what you have with `bb emu list`.
ANDROID_SYSTEM_IMAGES=36

# Emulator renderer. swiftshader_indirect (default) is software and always
# works. swangle_indirect is software too and usually faster. host uses a real
# GPU and needs the nvidia block below — expect to test it, the emulator is
# picky about host rendering with no display attached.
ANDROID_EMULATOR_GPU=swiftshader_indirect

# ---------------------------------------------------------------------------
# NVIDIA GPU (optional)
# ---------------------------------------------------------------------------
# Requires the NVIDIA Container Toolkit on the host (on Unraid: the
# Nvidia-Driver plugin) and the deploy: block in docker-compose.yml.
#
# Leave capabilities at "all" — the runtime's default of compute,utility
# injects CUDA but no GL/EGL/Vulkan, which looks like a working GPU right up
# until anything tries to render. `bb doctor` reports which you actually got.
#
# Visible devices: "all" is fine for a single card. With several, use the GPU
# UUID (Unraid lists them under Settings → Nvidia-Driver).
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ---------------------------------------------------------------------------
# Web dashboard (optional)
# ---------------------------------------------------------------------------
# Status page, bb macro buttons, and a browser terminal with persistent tmux
# sessions per project. Uncomment the ports block in docker-compose.yml too.
#
# DASHBOARD_AUTH is mandatory when enabled and the container will refuse to
# start the dashboard without it. What it exposes is a writable shell inside a
# container that holds your loaded ssh-agent and read-write mounts of every
# project — treat the credential as equivalent to those.
ENABLE_DASHBOARD=false
DASHBOARD_AUTH=
DASHBOARD_PORT=8080
DASHBOARD_TTYD_PORT=7681
# How many dashboard tabs may be open at once. Each terminal tab is an iframe
# running a full terminal emulator over its own websocket, so this is a ceiling
# on browser memory. The tab strip is stored on the container and shared by
# every browser that opens the dashboard.
DASHBOARD_MAX_TABS=12

# How often the dashboard re-runs `bb doctor` in the background, in seconds
# (minimum 300). The card's ↻ re-runs it on demand regardless.
DASHBOARD_DOCTOR_INTERVAL=1800

# Only if you publish the terminal on a different host port than 7681. The page
# tells the browser where the terminal lives, and the container cannot see host
# port mappings — mismatch means the page loads and only the terminal fails.
# DASHBOARD_TTYD_PUBLIC_PORT=

# ---------------------------------------------------------------------------
# Package publishing (all optional)
# ---------------------------------------------------------------------------
# npm publish auth for registry.npmjs.org
NPM_TOKEN=
# `uv publish` reads UV_PUBLISH_TOKEN directly; `docker push ghcr.io/...`
# is wired up automatically from GITHUB_PAT when the socket is mounted.

# ---------------------------------------------------------------------------
# Optional extras, installed on every container start
# ---------------------------------------------------------------------------
# EXTRA_APT_PACKAGES=postgresql-client redis-tools
# EXTRA_NPM_PACKAGES=pnpm typescript
# EXTRA_PIPX_PACKAGES=ruff httpie

# Unraid only, cosmetic. Unraid caches container icons under
# /var/lib/docker/unraid/images/<ContainerName>-icon.png and downloads the
# template's Icon URL only when that cache is empty — so a private repo's raw
# URL 404ing is fatal for the icon and nothing else. Mount that directory at
# /unraid-icons (see docker-compose.yml) and the container writes the file
# itself on every start. Unraid names it after the CONTAINER, which nothing
# inside a container can see, so set this if you renamed it.
UNRAID_ICON_NAME=BuilderBot

# Run <project>/.builderbot/setup.sh on start, if present.
PROJECT_BOOTSTRAP=false
# Recursively chown mounted projects to PUID:PGID on start. Off by default —
# only turn this on if permissions are actually fighting you.
CHOWN_PROJECTS=false

# Scrub GITHUB_PAT/RUNNER_TOKEN from session environments (recommended).
# false = legacy behavior: PAT visible inside, gh auto-authenticated.
SHIELD_SECRETS=true

# Image tag to run (latest, or a pinned sha/date tag).
BUILDERBOT_TAG=latest
