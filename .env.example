# Copy to `.env` next to docker-compose.yml. Only what the container or the
# host has to know before BuilderBot is running is here; everything else is
# set in the dashboard (Settings, a project's settings, the Nodes tab).

# The account that owns the files on your shares: 99:100 is Unraid's
# nobody:users.
PUID=99
PGID=100

# The container's clock, for its log lines. Optional: each person picks the
# zone the dashboard shows times in, on their Profile tab.
TZ=Etc/UTC

# Where BuilderBot keeps its own state (accounts, settings, notebooks, logs).
APPDATA_PATH=/mnt/user/appdata/BuilderBot

# The folder holding your projects: every subfolder is a project at
# /workspace/<name>.
WORKSPACE_PATH=/mnt/user/projects

# Where this controller keeps the browsers `bb capture shot` uses. A node keeps
# its own toolchains, in a directory of its own on whatever store its row names.
SDK_PATH=/mnt/user/sdk

# Optional: a static analyzer's SARIF output on the host, mounted read-only and
# read with `bb findings`. Empty where no scanner runs.
SCANNER_REPORTS_PATH=/mnt/user/appdata/scanners/reports

# The one published port: the dashboard, its API and the terminals under /term.
# There is no password setting: the first page asks you to make the owner, so
# open it as soon as the container is up.
DASHBOARD_PORT=7680

# Optional: features switched off for this whole install, comma-separated from
# tunnel, ftp, phone, devices, apps, image-updates, runner, enroll and shell, and the
# sentence each switched-off control shows. Empty leaves everything on.
FEATURES_OFF=
FEATURES_OFF_WHY=

# Tokens are not set here. Git keys and publishing tokens (NPM_TOKEN=... in an
# *.env file) go in the root-only secrets folder (docs/unraid.md, Shielding
# secrets), or a project's settings make its deploy key and hold its access
# token; a runner's token is typed on the Nodes tab.

# ---- BuilderBot's own dev instance only ----------------------------------
# An install leaves these alone. BuilderBot's dev instance on a node builds
# this checkout (BUILDERBOT_PULL=build, BUILDERBOT_TAG=dev). The lab's Gitea
# and Forgejo for `bb tests lab` are a stack of their own: lab/compose.yml.
BUILDERBOT_TAG=latest
BUILDERBOT_PULL=missing
