# The controller's address as a container on the node would reach it (the
# one the node's agent dials): the probe expects to reach it.
NETTEST_CTL=http://192.168.1.15:7680
# The node's own address, for its port 22 (expected blocked) and 80/443
# (expected reachable); empty means the bridge's gateway, which is the node.
NETTEST_NODE=
# An address on a private range the node is not: expected rejected at once.
NETTEST_PRIVATE=192.168.1.1
