# BuilderBot, installed bare metal: the controller's settings, in place of
# compose's .env and the Unraid template (R90). nodes/install-controller.sh
# writes this to /etc/builderbot-controller/controller.env once and never
# over your edits; every start reads it (scripts/lib/host-env.sh). After an
# edit: sudo systemctl restart builderbot-controller
#
# Root's file, readable by the controller's account and nobody else: a
# session on this machine's own node is kept out of it (the wall).
#
# A value with spaces in it goes in double quotes: BANNER_TEXT="Back at six".
#
# Not here, the container's alone: PUID PGID (the account the installer made
# has its own ids, and nothing is remapped).

# --- where things are: what compose mounts -----------------------------------
# The state (compose's /config): accounts, settings, notebooks, logs.
DASHBOARD_STATE=/var/lib/builderbot-controller/config
# The controller's own home (compose's /home/builder).
BUILDER_HOME=/var/lib/builderbot-controller/home
# The projects (compose's /workspace): every folder in it is a project.
WORKSPACE=/srv/builderbot/projects
# The toolchain store (compose's /sdk).
SDK_ROOT=/var/lib/builderbot-controller/sdk
# The root-only secrets folder (compose's /secrets): *.env files and ssh/.
BB_SECRETS_DIR=/etc/builderbot-controller/secrets
# The deploy-key agent's socket, in a folder only the account's group enters.
SSH_AUTH_SOCK=/run/builderbot-controller/ssh-agent.sock

# --- the settings compose passes ------------------------------------------
TZ=Etc/UTC
# The one port: the dashboard, its API and the terminals under /term.
DASHBOARD_PORT=7680
# Features switched off for this install, and the sentence each shows.
FEATURES_OFF=
FEATURES_OFF_WHY=
# One line every visitor sees under the header, with an optional link.
BANNER_TEXT=
BANNER_LINK=
BANNER_LINK_LABEL=

# --- written by the installer: change them by running it again ---------------
# The account the controller runs as.
BB_ACCOUNT=builderbot
