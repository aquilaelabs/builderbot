{
 "about": "Chromium, Firefox and WebKit with the module that drives them, for bb capture shot and browser tests. Needs node.",
 "label": "Playwright browsers",
 "layout": {
  "bin": [
   "node_modules/.bin"
  ],
  "env": {
   "NODE_PATH": "node_modules",
   "PLAYWRIGHT_BROWSERS_PATH": "",
   "PLAYWRIGHT_SKIP_BROWSER_GC": "=1"
  }
 },
 "name": "playwright",
 "platforms": [
  "linux/*"
 ],
 "shipped": {
  "probe": "playwright",
  "requires": [
   "node"
  ],
  "source": {
   "download": {
    "match": "Download url:\\s+(\\S+)",
    "resolver": "command-urls",
    "run": [
     "playwright",
     "install",
     "--dry-run",
     "chromium",
     "firefox",
     "webkit"
    ]
   },
   "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "{dir}"
   },
   "kind": "command",
   "link": {
    "as": "{dir}/chromium",
    "find": "*/chromium-*/chrome-linux*/chrome"
   },
   "requires": "npm",
   "run": [
    "sh",
    "-c",
    "npm install --prefix \"$1\" --no-audit --no-fund --loglevel=error playwright@latest && \"$1/node_modules/.bin/playwright\" install chromium firefox webkit",
    "--",
    "{dir}"
   ]
  },
  "system": {
   "apt": [
    "at-spi2-common|at-spi2-core",
    "fontconfig",
    "fonts-freefont-ttf",
    "fonts-liberation",
