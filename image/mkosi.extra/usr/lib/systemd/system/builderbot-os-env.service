[Unit]
Description=BuilderBot OS: the boot's own settings for the controller, from the ESP and the kernel's command line
ConditionKernelCommandLine=bbslot
DefaultDependencies=no
After=boot-efi.mount local-fs.target
Before=builderbot-controller.service

[Service]
Type=oneshot
ExecStart=/usr/lib/builderbot-os/env
# A prepared configuration on the stick, taken off it before the controller
# starts (R161 step 8); a blank one is nothing.
ExecStart=-/usr/lib/builderbot-os/firstboot-take
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
