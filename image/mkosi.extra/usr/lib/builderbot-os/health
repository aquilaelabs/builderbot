#!/usr/bin/env bash
# The health check a trial slot waits on (R161 step 2): the dashboard
# answering on its port and the node's agent running, within ten minutes of
# the boot; then the slot is marked good (slot good) and stays. A boot that
# never gets here is counted by GRUB, and the second such boot goes back to
# the slot before. Says nothing when no trial is on.
set -euo pipefail
SLOT="${BB_OS_SLOT:-/usr/lib/builderbot-os/slot}"
WORK="${BB_OS_WORK:-/var/lib/builderbot-os}"
# A boot that GRUB brought back to the slot before (R161 step 2): said in a
# file the census reports until the next update, and the mark cleared.
if [ "$(bash "$SLOT" fell-back 2>/dev/null)" = yes ]; then
    mkdir -p "$WORK"
    echo "the slot written by the last update did not come up healthy twice, so this boot is back on slot $(bash "$SLOT" current 2>/dev/null || echo '?') as it was" > "$WORK/fell-back"
fi
PORT="$(sed -n 's/^DASHBOARD_PORT=//p' /etc/builderbot-controller/controller.env 2>/dev/null | head -1)"
PORT="${PORT:-7680}"
# Healthy is the dashboard answering as it does when it works (a page or
# its redirect to the sign-in), never an error: a 500 or a 502 was taken
# for healthy and ended the trial of a slot that did not work (B471).
for i in $(seq 1 120); do
    code="$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${PORT}/" 2>/dev/null || true)"
    case "$code" in 2??|301|302|303|307|308) up=1 ;; *) up="" ;; esac
    if [ -n "$up" ] && systemctl is-active --quiet builderbot-agent 2>/dev/null; then
        bash "$SLOT" good
        echo "healthy after $((i * 5)) s: the dashboard answers $code and the agent runs; slot $(bash "$SLOT" current) is marked good"
        exit 0
    fi
    sleep 5
done
said="not healthy within ten minutes: the dashboard answered '${code:-nothing}', the agent $(systemctl is-active builderbot-agent 2>/dev/null || echo unknown)"
# This boot is the slot on trial: restart, so GRUB counts it and the second
# such boot goes back to the slot before by itself. Left running, a machine
# with no screen sat on a slot that did not work, the dashboard that would
# offer a restart being what was broken (B471).
if bash "$SLOT" status 2>/dev/null | grep -q '^trial:' \
        && [ "$(bash "$SLOT" current 2>/dev/null)" = "$(bash "$SLOT" next 2>/dev/null)" ]; then
    echo "$said; slot $(bash "$SLOT" current) is on trial, so this machine restarts and GRUB counts the boot" >&2
    [ -n "${BB_HEALTH_NO_REBOOT:-}" ] || systemctl reboot
    exit 1
fi
echo "$said" >&2
exit 1
