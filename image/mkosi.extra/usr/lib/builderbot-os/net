#!/usr/bin/env bash
# The stick's network settings (R161 step 12): BB_HOSTNAME and the static
# address keys in the stick's builderbot.env (the stick maker's --set, or the
# file edited by hand on the ESP), as the env step read them into
# /run/builderbot-os/net. With BB_NET_ADDRESS the wired interfaces take that
# address, its mask, gateway and DNS for this boot, from a runtime file that
# goes before the image's own DHCP file; without it, DHCP stands. Nothing is
# kept: the stick's file is read again at every boot.
#
#   BB_HOSTNAME=tower
#   BB_NET_ADDRESS=192.0.2.20  BB_NET_MASK=24 or 255.255.255.0
#   BB_NET_GATEWAY=192.0.2.1    BB_NET_DNS=1.1.1.1,9.9.9.9
set -euo pipefail
NETF="${BB_OS_RUN:-/run/builderbot-os}/net"
NETDIR="${BB_NETWORK_DIR:-/run/systemd/network}"
FILE="$NETDIR/10-builderbot-stick.network"

get() { [ -r "$NETF" ] && sed -n "s/^$1=//p" "$NETF" | tail -n 1; }
ipv4() { [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
         local o; for o in "${BASH_REMATCH[@]:1}"; do [ "$((10#$o))" -le 255 ] || return 1; done; }
# A mask as its prefix length: 24, or 255.255.255.0.
prefix() {
    local m="$1" n=0 seen0=0 o b parts
    if [[ "$m" =~ ^[0-9]{1,2}$ ]]; then
        [ "$((10#$m))" -ge 1 ] && [ "$((10#$m))" -le 32 ] && echo "$((10#$m))"; return
    fi
    ipv4 "$m" || return 1
    IFS=. read -r -a parts <<< "$m"
    for o in "${parts[@]}"; do
        for b in 128 64 32 16 8 4 2 1; do
            if [ $((10#$o & b)) -ne 0 ]; then [ "$seen0" = 1 ] && return 1; n=$((n + 1)); else seen0=1; fi
        done
    done
    [ "$n" -ge 1 ] && echo "$n"
}
dhcp() { echo "stick-net: $1: DHCP stands" >&2; rm -f "$FILE"; exit 0; }

host="$(get BB_HOSTNAME || true)"
if [ -n "$host" ]; then
    if [[ "$host" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
        if [ -z "${BB_NET_NO_APPLY:-}" ] && [ "$(cat /proc/sys/kernel/hostname)" != "$host" ]; then
            timeout 20 hostnamectl set-hostname "$host" 2>/dev/null || echo "$host" > /proc/sys/kernel/hostname || true
        fi
        echo "stick-net: the hostname is $host"
    else
        echo "stick-net: BB_HOSTNAME=$host is not a hostname: left as it is" >&2
    fi
fi

addr="$(get BB_NET_ADDRESS || true)"
if [ -z "$addr" ]; then
    rm -f "$FILE"
    exit 0
fi
mask="$(get BB_NET_MASK || true)"; gw="$(get BB_NET_GATEWAY || true)"; dns="$(get BB_NET_DNS || true)"
ipv4 "$addr" || dhcp "BB_NET_ADDRESS=$addr is not an IPv4 address"
p="$(prefix "${mask:-24}")" || dhcp "BB_NET_MASK=$mask is not a mask"
[ -z "$gw" ] || ipv4 "$gw" || dhcp "BB_NET_GATEWAY=$gw is not an IPv4 address"
servers=()
for d in ${dns//,/ }; do
    if ipv4 "$d"; then servers+=("$d"); else echo "stick-net: $d in BB_NET_DNS is not an IPv4 address: left out" >&2; fi
done
mkdir -p "$NETDIR"
{
    printf '[Match]\nName=en* eth*\n\n[Network]\nAddress=%s/%s\n' "$addr" "$p"
    if [ -n "$gw" ]; then printf 'Gateway=%s\n' "$gw"; fi
    for d in "${servers[@]}"; do printf 'DNS=%s\n' "$d"; done
} > "$FILE.new"
mv -f "$FILE.new" "$FILE"
[ -n "${BB_NET_NO_APPLY:-}" ] || networkctl reload >/dev/null 2>&1 || true
echo "stick-net: the wired interfaces take $addr/$p${gw:+ through $gw}${servers:+, DNS ${servers[*]}}"
