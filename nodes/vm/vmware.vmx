# A BuilderBot node on VMware — Workstation, Fusion or ESXi.
#
# Rendered by the dashboard's Create sandbox VM (vmtemplate.py). Save it as
# <name>.vmx in a folder of its own, make the disk beside it, and open it.
#
# The MAC is in VMware's own manual range (00:50:56:00:00:00 through
# 00:50:56:3F:FF:FF) because addressType static is refused outside it — the
# one detail this format does not share with the others.
.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "19"
displayName = "${name}"
guestOS = "other6xlinux-64"
firmware = "efi"
uefi.secureBoot.enabled = "FALSE"
uuid.bios = "${uuid_vmware}"

numvcpus = "${cores}"
cpuid.coresPerSocket = "${cores}"
memsize = "${memory_mb}"
vcpu.hotadd = "FALSE"
mem.hotadd = "FALSE"

scsi0.present = "TRUE"
scsi0.virtualDev = "pvscsi"
scsi0:0.present = "TRUE"
scsi0:0.deviceType = "scsi-hardDisk"
scsi0:0.fileName = "${name}.vmdk"

sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.deviceType = "cdrom-image"
sata0:0.fileName = "${iso_path}"
sata0:0.startConnected = "TRUE"

ethernet0.present = "TRUE"
ethernet0.virtualDev = "vmxnet3"
ethernet0.connectionType = "bridged"
ethernet0.addressType = "static"
ethernet0.address = "${mac}"

tools.syncTime = "TRUE"
vmci0.present = "TRUE"
