#cloud-config
# The same machine provision-linux.sh makes, built at first boot instead of by hand.
#
# Use this with a Debian or Ubuntu *cloud* image (the genericcloud qcow2), not
# an installer ISO — a cloud image is already a working root filesystem and
# grows its partition to fill whatever disk you give it, which is what makes
# "start at 64G and expand later" free rather than a resize exercise.
#
# Fill in the three marked places. Everything else is deliberate.

hostname: bb-sandbox
# Grows the root partition to the whole virtual disk on first boot. Resize the
# qcow2 later and it does it again, so the disk is never the thing you have to
# plan.
growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true

users:
  - name: bb
    groups: [docker, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      # <-- BuilderBot's public key. This is how it connects, and the reason
      #     no Docker port has to be opened at all.
      - ssh-ed25519 AAAA_REPLACE_ME

package_update: true
packages: [ca-certificates, curl, gnupg, qemu-guest-agent, nfs-common]

# Mounted at the SAME paths BuilderBot uses. Not a style preference: a compose
# file's bind mounts are resolved by whoever runs the container, so identical
# paths on both sides mean a relative bind is the same directory either way
# and nothing has to translate. Get this wrong and docker creates the missing
# source and mounts it empty, which reads as a bug in the app.
#
# The tags are what Unraid calls the shares it passes to the VM. Swap the
# virtiofs lines for nfs if you export them instead.
mounts:
  - [workspace, /workspace, virtiofs, "defaults,nofail", "0", "0"]
  - [devdata, /devdata, virtiofs, "defaults,nofail", "0", "0"]

runcmd:
  - install -m 0755 -d /etc/apt/keyrings
  - bash -c 'curl -fsSL https://download.docker.com/linux/$(. /etc/os-release; echo "$ID")/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg'
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - bash -c '. /etc/os-release; echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update -qq
  - apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker qemu-guest-agent
