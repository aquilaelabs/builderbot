#!/usr/bin/python3 -I
"""bb-session: run a session inside a view of this node that holds only its own
project (roadmap R35, B156).

Every session on a node runs as one account, and the projects share is
mounted whole, so file permissions cannot keep one project's session out of
another's tree, its test and CI logs, its cached token or its transcripts: the
share even squashes every writer to one uid. Namespaces can. This builds a
mount, PID and IPC namespace in which:

  * /workspace holds only the project, its worktrees and the account's Claude
    share, and in that share the other projects' transcripts are empty;
  * the account's home is the only home, and its BuilderBot cache holds only
    this project's folder and the account's own;
  * /tmp, /var/tmp and /dev/shm are the session's own;
  * the agent's stores show only what a session reads: its own CI logs and
    artifacts, and the emulator's logs; jobs, compose files, the runner's
    checkouts and the terminal log are gone;
  * the process list holds only the session's own processes.

Then it drops to the session account for good (no_new_privs) and runs the
session under a small init that forwards a stop and reaps what is orphaned.

Root, and the one thing the session account may run through sudo (the agent
writes that rule and /etc/bb-session.conf). So it trusts nothing it is handed:
the caller is the one sudo names, the project, account and paths are held to
their shapes and checked as real directories, and the session's environment
file is read only after the drop, as the session.

    bb-session check
        exit 0 when this machine can build the view; root only
    bb-session plan  --project P --account U --home H --cwd D
        the mounts, as JSON, without making any; anybody
    bb-session enter --project P --account U --home H --cwd D --env FILE -- COMMAND...
        the session, inside the view; through sudo
"""
import ctypes
import json
import os
import pwd
import re
import signal
import stat
import sys

CONF = "/etc/bb-session.conf"
STAGE = "/run/bb-session"
PROJECT = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")
ACCOUNT = re.compile(r"u_[0-9a-f]{8}")
ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
# What the pane itself knows better than the file bb-tty wrote: sudo keeps
# these, and the terminal tmux gave the pane is not the one ttyd gave bb-tty.
FROM_PANE = ("TERM", "COLORTERM", "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE", "LC_MESSAGES")

MS_RDONLY, MS_NOSUID, MS_NODEV, MS_NOEXEC = 1, 2, 4, 8
MS_REMOUNT = 32
MS_BIND, MS_REC, MS_PRIVATE = 4096, 16384, 1 << 18
MNT_DETACH = 2
CLONE_NEWNS, CLONE_NEWIPC, CLONE_NEWPID = 0x00020000, 0x08000000, 0x20000000
PR_SET_NO_NEW_PRIVS = 38


class Refused(Exception):
    """A sentence for the person at the terminal: why the session did not start."""


def conf():
    """The machine's layout, from the root-owned file the agent writes, over
    the defaults a provisioned node has."""
    c = {"SESSION_USER": "builder", "WORKSPACE": "/workspace", "HOME_ROOT": "",
         "DATA_STORE": "/var/lib/builderbot/data", "ARTIFACTS_STORE": "/var/lib/builderbot/artifacts",
         "RUNNER_DIR": "/var/lib/builderbot/runner", "HIDE": "/devdata",
         # The scoped packages store, whose .bb bundle is the bb and bb-tty a
         # session and the agent run. Empty until the agent writes it, and then
         # the bundle is read-only in the view (B157); empty here just leaves
         # it as it was, which an older agent's conf does.
         "PACKAGES_STORE": ""}
    # Another layout file only for somebody who is not root, which is `plan`
    # run by the suite: `enter` is root through sudo, which resets the
    # environment, and root reads the machine's own file whatever it says.
    path = os.environ.get("BB_SESSION_CONF", CONF) if os.geteuid() != 0 else CONF
    try:
        st = os.stat(path)
        if (st.st_uid == 0 or path != CONF) and not st.st_mode & 0o022:
            with open(path) as f:
                for line in f:
                    key, sep, value = line.strip().partition("=")
                    if sep and key in c and not line.startswith("#"):
                        c[key] = value.strip()
    except OSError:
        pass
    if not c["HOME_ROOT"]:
        try:
            c["HOME_ROOT"] = pwd.getpwnam(c["SESSION_USER"]).pw_dir
        except KeyError:
            c["HOME_ROOT"] = ""
    return c


def _real_dir(path):
    """Whether `path` is a directory itself, not a link to one."""
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def _slug(path):
    """A path as Claude Code names its transcript folder, compared loosely:
    every character that is not a letter or a digit becomes a dash."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def _ours(entry, ws, project):
    """Whether a folder in the account's transcripts belongs to this project:
    the project's own tree, or one of its worktrees (an account's uid on the
    end), so a project whose name starts another's never claims it."""
    name = _slug(entry)
    return name == _slug(f"{ws}/{project}") or re.fullmatch(
        re.escape(_slug(f"{ws}/.worktrees/{project}/")) + r"u-[0-9a-f]{8}", name) is not None


def args(argv):
    out, rest = {}, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest = argv[i + 1:]
            break
        if a in ("--project", "--account", "--home", "--cwd", "--env") and i + 1 < len(argv):
            out[a[2:]] = argv[i + 1]
            i += 2
            continue
        raise Refused(f"bb-session: '{a}' is not an option it takes")
    return out, rest


def plan(c, a, uid):
    """The mounts that make the view, as a list of steps, after checking
    everything they rest on. Pure: it reads the file system and changes
    nothing, so `plan` shows exactly what `enter` would do."""
    ws, home_root = c["WORKSPACE"].rstrip("/"), c["HOME_ROOT"].rstrip("/")
    project, account = a.get("project", ""), a.get("account", "")
    home, cwd = a.get("home", "").rstrip("/"), a.get("cwd", "").rstrip("/")
    if not PROJECT.fullmatch(project) or project.startswith("."):
        raise Refused(f"bb-session: '{project}' is not a project name")
    if not _real_dir(f"{ws}/{project}"):
        raise Refused(f"bb-session: {ws}/{project} is not a project directory")
    if not ACCOUNT.fullmatch(account):
        raise Refused("bb-session: the session names no account, so there is no home to give it")
    users = f"{home_root}/users"
    if not home_root or home not in (home_root, f"{users}/{account}"):
        raise Refused(f"bb-session: {home} is not {account}'s home on this node")
    try:
        st = os.lstat(home)
    except OSError:
        raise Refused(f"bb-session: {home} does not exist") from None
    if not stat.S_ISDIR(st.st_mode) or (uid is not None and st.st_uid != uid):
        raise Refused(f"bb-session: {home} is not a directory the session account owns")
    inside = (f"{ws}/{project}", f"{ws}/.worktrees/{project}")
    parts = cwd.split("/")
    if ".." in parts or not any(cwd == d or cwd.startswith(d + "/") for d in inside):
        raise Refused(f"bb-session: {cwd} is not inside {project} or its worktrees")

    base = home != home_root        # the account's home is under users; the base home is another's
    # BuilderBot's caches, by where they really are. An account's home links
    # .cache to the base home's (common.sh shares the tool folders), so the
    # two can be one folder, and covering one folder twice buries what the
    # first cover kept. A cache that is itself a link is refused rather than
    # left untrimmed: that would put every other project's token in view.
    caches = {}
    # Everything under u/<account> is that account's and nobody else's (B159);
    # machine/ is this box's and is shared on purpose.
    for h, keep in [(home, (f"u/{account}/project/{project}", f"u/{account}/account", "machine"))] \
            + ([(home_root, ("machine",))] if base else []):
        path = f"{h}/.cache/builderbot"
        if os.path.lexists(path) and not _real_dir(path):
            raise Refused(f"bb-session: {path} is not a directory, so the view could not leave other projects out of it")
        if _real_dir(path):
            caches.setdefault(os.path.realpath(path), set()).update(keep)
    caches = sorted(caches.items())
    data, art = c["DATA_STORE"].rstrip("/"), c["ARTIFACTS_STORE"].rstrip("/")

    # Everything that is about to be covered is bound aside first, so what
    # stays in the view can be bound back from there.
    steps = [("private", "/"), ("proc", "/proc"), ("tmpfs", STAGE, "mode=0700"),
             ("bind", ws, f"{STAGE}/ws"), ("bind", home, f"{STAGE}/home")]
    for i, (cache, _keep) in enumerate(caches):
        steps.append(("bind", cache, f"{STAGE}/cache{i}"))
    if data and _real_dir(data):
        steps.append(("bind", data, f"{STAGE}/data"))
    if art and _real_dir(art):
        steps.append(("bind", art, f"{STAGE}/artifacts"))

    # The projects share: this project, its worktrees, the account's share,
    # and in that share the other projects' transcripts empty.
    steps.append(("tmpfs", ws, "mode=0755"))
    for rel in (project, f".worktrees/{project}", f".claude/{account}"):
        if _real_dir(f"{ws}/{rel}"):
            steps.append(("bind", f"{STAGE}/ws/{rel}", f"{ws}/{rel}"))
    transcripts = f"{ws}/.claude/{account}/projects"
    if _real_dir(transcripts):
        for entry in sorted(os.listdir(transcripts)):
            if _real_dir(f"{transcripts}/{entry}") and not _ours(entry, ws, project):
                steps.append(("hide", f"{transcripts}/{entry}"))
    # Homes: the account's own is the only one, and when it is not the base
    # home, the base home's Claude login and history are out of sight too.
    if _real_dir(users):
        steps.append(("tmpfs", users, "mode=0755"))
        if base:
            steps.append(("bind", f"{STAGE}/home", f"{users}/{account}"))
    if base:
        if _real_dir(f"{home_root}/.claude"):
            steps.append(("hide", f"{home_root}/.claude"))
        if os.path.isfile(f"{home_root}/.claude.json") and not os.path.islink(f"{home_root}/.claude.json"):
            steps.append(("hidefile", f"{home_root}/.claude.json"))
    # BuilderBot's caches: this project's folder, the account's and the
    # machine's; the base home's down to the machine's.
    for i, (cache, keep) in enumerate(caches):
        steps.append(("tmpfs", cache, "mode=0700,owned"))
        for sub in sorted(keep):
            if _real_dir(f"{cache}/{sub}"):
                steps.append(("bind", f"{STAGE}/cache{i}/{sub}", f"{cache}/{sub}"))
    # The agent's stores: what a session reads, and nothing else.
    if data and _real_dir(data):
        steps.append(("tmpfs", data, "mode=0755"))
        for rel in ("emu", f"ci-logs/{project}"):
            if _real_dir(f"{data}/{rel}"):
                steps.append(("bind", f"{STAGE}/data/{rel}", f"{data}/{rel}"))
    if art and _real_dir(art):
        steps.append(("tmpfs", art, "mode=0755"))
        if _real_dir(f"{art}/{project}"):
            steps.append(("bind", f"{STAGE}/artifacts/{project}", f"{art}/{project}"))
    # The packages store's bundle is the bb and bb-tty a session runs and the
    # agent runs for a job (as the enrolled account, in the docker group), on
    # the shared store the squash makes writable by the session account. So a
    # session could rewrite what another account's session, or a job, then
    # executes. Read-only in the view (B157): the session still reads and runs
    # it, and cannot change it. Only the bundle; the toolchains beside it stay
    # writable, since a build legitimately writes under some of them.
    bundle = f"{c['PACKAGES_STORE'].rstrip('/')}/.bb" if c.get("PACKAGES_STORE") else ""
    if bundle and _real_dir(bundle):
        steps.append(("bindro", bundle, bundle))
    for hidden in [c["RUNNER_DIR"]] + [x for x in c["HIDE"].split(":") if x]:
        if _real_dir(hidden.rstrip("/")):
            steps.append(("hide", hidden.rstrip("/")))
    for t in ("/tmp", "/var/tmp", "/dev/shm"):
        if _real_dir(t):
            steps.append(("tmpfs", t, "mode=1777"))
    steps.append(("detach", STAGE))
    return steps


_libc = None


def _call(name, *argv):
    global _libc
    if _libc is None:
        _libc = ctypes.CDLL(None, use_errno=True)
    fn = getattr(_libc, name)
    if fn(*argv) != 0:
        err = ctypes.get_errno()
        raise OSError(err, f"{name}: {os.strerror(err)}")


def _mount(src, target, fstype, flags, data=None):
    _call("mount", src.encode() if src else None, target.encode(),
          fstype.encode() if fstype else None, ctypes.c_ulong(flags),
          data.encode() if data else None)


def _mkdirs(path, uid, gid):
    """Directories on a tmpfs this process mounted a moment ago, given to the
    session account so its own folders sit in folders it can use."""
    parts, cur = path.strip("/").split("/"), ""
    for p in parts:
        cur += "/" + p
        if not os.path.isdir(cur):
            os.mkdir(cur, 0o755)
            os.chown(cur, uid, gid)


def apply(steps, uid, gid):
    for step in steps:
        kind, target = step[0], step[-1] if step[0] in ("bind", "bindro") else step[1]
        if kind == "private":
            _mount(None, "/", None, MS_REC | MS_PRIVATE)
        elif kind == "proc":
            _mount("proc", "/proc", "proc", MS_NOSUID | MS_NODEV | MS_NOEXEC)
        elif kind == "tmpfs":
            opts = step[2]
            if opts.endswith(",owned"):
                opts = opts[: -len(",owned")] + f",uid={uid},gid={gid}"
            os.makedirs(target, exist_ok=True)
            _mount("tmpfs", target, "tmpfs", MS_NOSUID | MS_NODEV, opts)
        elif kind == "bind":
            src = step[1]
            if not os.path.isdir(target):
                _mkdirs(target, uid, gid)
            _mount(src, target, None, MS_BIND | MS_REC)
        elif kind == "bindro":
            # A read-only bind of a directory onto itself: bind first, then
            # remount read-only, which is the only way the flag takes on a bind.
            # The view's root is private, so this is read-only here and nowhere
            # else, and the agent still writes the bundle from outside the view.
            src = step[1]
            _mount(src, target, None, MS_BIND | MS_REC)
            _mount(src, target, None, MS_BIND | MS_REMOUNT | MS_RDONLY)
        elif kind == "hide":
            _mount("tmpfs", target, "tmpfs", MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=0500")
        elif kind == "hidefile":
            _mount("/dev/null", target, None, MS_BIND)
        elif kind == "detach":
            _call("umount2", target.encode(), ctypes.c_int(MNT_DETACH))


def _read_env(path, uid):
    """The session's environment, read AFTER the drop: a file bb-tty wrote as
    the session account, NUL-separated, refused when it is anything else."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 1 << 20:
            raise Refused("bb-session: the session's environment file is not the one bb-tty writes")
        raw = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(fd)
    env = {}
    for item in raw.split(b"\0"):
        key, sep, value = item.decode(errors="replace").partition("=")
        if sep and ENV_NAME.fullmatch(key):
            env[key] = value
    return env


def _drop(user, uid, gid):
    os.initgroups(user, gid)
    os.setgid(gid)
    os.setuid(uid)
    _call("prctl", ctypes.c_int(PR_SET_NO_NEW_PRIVS), ctypes.c_ulong(1), ctypes.c_ulong(0),
          ctypes.c_ulong(0), ctypes.c_ulong(0))


def _wait_forwarding(child):
    """Wait for `child`, handing it a stop the way it would have had one
    without this in between, and reaping whatever is orphaned meanwhile.
    Keyboard signals are not forwarded: the terminal sends those to the
    session's own process group, and a second Ctrl-C would read as two."""
    def forward(signum, _frame):
        try:
            os.kill(child, signum)
        except ProcessLookupError:
            pass
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGUSR1, signal.SIGUSR2):
        signal.signal(s, forward)
    for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU):
        signal.signal(s, signal.SIG_IGN)
    while True:
        try:
            pid, status = os.waitpid(-1, 0)
        except ChildProcessError:
            return 1
        except InterruptedError:
            continue
        if pid == child:
            return os.waitstatus_to_exitcode(status) if hasattr(os, "waitstatus_to_exitcode") \
                else (os.WEXITSTATUS(status) if os.WIFEXITED(status) else 128 + os.WTERMSIG(status))


def _default_signals():
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGUSR1, signal.SIGUSR2, signal.SIGINT,
              signal.SIGQUIT, signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU):
        signal.signal(s, signal.SIG_DFL)


def caller(c):
    """(name, uid, gid) of the session account, when sudo is how this was
    reached and the account sudo names is the session account."""
    if os.geteuid() != 0:
        raise Refused("bb-session: this runs as root, through sudo")
    try:
        pw = pwd.getpwnam(c["SESSION_USER"])
    except KeyError:
        raise Refused(f"bb-session: there is no session account {c['SESSION_USER']} here") from None
    if os.environ.get("SUDO_UID") != str(pw.pw_uid):
        raise Refused(f"bb-session: only {pw.pw_name} starts a session through this")
    return pw.pw_name, pw.pw_uid, pw.pw_gid


def enter(c, a, command):
    name, uid, gid = caller(c)
    if not command:
        raise Refused("bb-session: nothing to run")
    envfile = a.get("env", "")
    project, home = a.get("project", ""), a.get("home", "").rstrip("/")
    account = a.get("account", "")
    if not envfile.startswith(f"{home}/.cache/builderbot/u/{account}/project/{project}/"):
        raise Refused("bb-session: the environment file is not in the project's cache folder")
    steps = plan(c, a, uid)
    pane = {k: os.environ[k] for k in FROM_PANE if k in os.environ}
    os.makedirs(STAGE, mode=0o700, exist_ok=True)
    _call("unshare", ctypes.c_int(CLONE_NEWNS | CLONE_NEWIPC | CLONE_NEWPID))
    for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU):
        signal.signal(s, signal.SIG_IGN)
    init = os.fork()
    if init:
        # Outside: sudo waits on this, so this waits on the namespace's init
        # and passes a stop on to it.
        sys.exit(_wait_forwarding(init))
    # PID 1 of the new namespace: make the view, drop, run the session.
    try:
        apply(steps, uid, gid)
        _drop(name, uid, gid)
        env = _read_env(envfile, uid)
    except (OSError, Refused) as e:
        sys.stderr.write(f"{e}\nthe session did not start: this node could not build its view\n")
        sys.exit(70)
    env.update(pane)
    env["HOME"] = home
    env["PWD"] = a["cwd"]
    child = os.fork()
    if child == 0:
        try:
            _default_signals()
            os.chdir(a["cwd"])
            os.execvpe(command[0], command, env)
        except OSError as e:
            sys.stderr.write(f"bb-session: could not run {command[0]}: {e}\n")
            os._exit(127)
    sys.exit(_wait_forwarding(child))


def check(c):
    """Whether this machine can build a view: root, the session account, and
    a namespace of each kind with a proc mounted in it, made and let go."""
    if os.geteuid() != 0:
        raise Refused("bb-session: this runs as root")
    try:
        pwd.getpwnam(c["SESSION_USER"])
    except KeyError:
        raise Refused(f"bb-session: there is no session account {c['SESSION_USER']} here") from None
    pid = os.fork()
    if pid == 0:
        try:
            _call("unshare", ctypes.c_int(CLONE_NEWNS | CLONE_NEWIPC | CLONE_NEWPID))
            inner = os.fork()
            if inner == 0:
                _mount(None, "/", None, MS_REC | MS_PRIVATE)
                _mount("proc", "/proc", "proc", MS_NOSUID | MS_NODEV | MS_NOEXEC)
                os._exit(0)
            _, status = os.waitpid(inner, 0)
            os._exit(0 if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 else 1)
        except OSError:
            os._exit(1)
    _, status = os.waitpid(pid, 0)
    if not (os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0):
        raise Refused("bb-session: this kernel would not make the namespaces a session's view needs")


def main(argv):
    verb = argv[0] if argv else ""
    try:
        c = conf()
        if verb == "check":
            check(c)
            print("ok: a session here runs in a view of its own project")
            return 0
        a, command = args(argv[1:])
        if verb == "plan":
            print(json.dumps(plan(c, a, None)))
            return 0
        if verb == "enter":
            enter(c, a, command)
            return 0
        raise Refused("bb-session takes check, plan or enter")
    except Refused as e:
        sys.stderr.write(f"{e}\n")
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
