<?xml version='1.0' encoding='UTF-8'?>
<!--
  A BuilderBot node as an Unraid VM: the Docker sandbox, and since the
  controller stopped building anything itself, the machine a project's
  builds, tests, CI runner, Android emulator and Claude sessions all run on.

  Create the VM in Form view first so Unraid makes the domain folder and the
  vdisk, then switch to XML view and paste this over what is there. Keep two
  things Unraid generated: the <uuid>, because the OVMF nvram file below is
  named after it and a new one orphans it, and the <mac>, because that is the
  address your router hands a lease to and any reservation you made in Form
  view was made against.

  What differs from Unraid's placeholder is called out where it sits: q35
  rather than i440fx, shared memory backing, no CPU pinning, a virtio rng,
  and sizes for a machine that compiles.

  ONE FILE FOR EVERY DISTRIBUTION. The hardware is the same whatever is
  installed on it — virtio has been in every Linux kernel for fifteen
  years — so the only line that changes per distribution is the installer
  ISO below, and provision-linux.sh sorts out the rest inside the guest (the
  Debian, RHEL, Arch and SUSE families, Alpine, Void and Gentoo; a
  derivative is recognised by its ID_LIKE). The <vmtemplate> line is
  Unraid's icon and nothing more; change os= and icon= to taste.
-->
<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="kvm">
  <uuid>b091db01-cbdd-07b7-c797-79ca40d31a00</uuid>
  <name>bb-sandbox</name>
  <description>BuilderBot node — builds, tests, CI, the emulator and sessions run here; containers it can wreck</description>
  <metadata>
    <vmtemplate xmlns="http://unraid" name="Linux" icon="linux.png" os="linux" storage="default"/>
  </metadata>

  <!-- 16 GiB and 6 cores. This is no longer a box that only builds the odd
       image: a Gradle build wants 3-4 GiB, the Android emulator another 2-4
       with a system image behind it, a Claude session and its Playwright
       browsers the rest, and the three overlap on the same afternoon. The
       balloon below hands memory back when it is idle. 8 GiB and 4 cores
       still work for a Docker-only sandbox; below that Gradle swaps. -->
  <memory unit="KiB">16777216</memory>
  <currentMemory unit="KiB">16777216</currentMemory>
  <vcpu placement="static">6</vcpu>

  <!-- No <cputune>. Unraid's placeholder pins the single vCPU to cpuset 0,
       which is the host's busiest core; a sandbox that only occasionally
       builds something is better left to the scheduler than pinned onto the
       one core everything else is already contending for. Pin it from the
       Form view later if it starts competing with the emulator. -->

  <!-- host-passthrough hands the guest the host's CPU as it is, which is
       what lets /dev/kvm exist INSIDE the VM — and without /dev/kvm the
       Android emulator on this node has no acceleration and never finishes
       booting. The other half is the host's: nested virtualization has to be
       on for the kvm module. On Unraid that is one file, then a reboot:
         /boot/config/modprobe.d/kvm-amd.conf    options kvm-amd nested=1
         /boot/config/modprobe.d/kvm-intel.conf  options kvm-intel nested=1
       `bb emu gpu` and the Nodes tab's census say whether the guest got it. -->
  <cpu mode="host-passthrough" migratable="on">
    <topology sockets="1" cores="6" threads="1"/>
    <cache mode="passthrough"/>
    <maxphysaddr mode="passthrough"/>
    <!-- topoext is AMD's. Unraid put it in the placeholder, so this host is
         AMD; delete this line if you ever move the XML to an Intel box,
         where "require" will refuse to start. -->
    <feature policy="require" name="topoext"/>
  </cpu>

  <!-- Shared memory backing, which is what virtiofs needs and what the
       placeholder's <nosharepages/> is the opposite of. Kept even though no
       virtiofs share is configured below: it costs nothing, and it means
       adding one later is a <filesystem> block rather than a block plus a
       memory change nobody remembers is required. -->
  <memoryBacking>
    <source type="memfd"/>
    <access mode="shared"/>
  </memoryBacking>

  <os>
    <loader readonly="yes" type="pflash">/usr/share/qemu/ovmf-x64/OVMF_CODE-pure-efi.fd</loader>
    <nvram>/etc/libvirt/qemu/nvram/b091db01-cbdd-07b7-c797-79ca40d31a00_VARS-pure-efi.fd</nvram>
    <!-- q35, not i440fx. The placeholder pairs UEFI firmware with a 1996
         chipset; q35 is the machine OVMF is meant for and the one that gives
         PCIe and sane virtio placement. Bare "q35" resolves to the newest
         your QEMU has, which is what you want. -->
    <type arch="x86_64" machine="q35">hvm</type>
  </os>

  <features>
    <acpi/>
    <apic/>
  </features>

  <!-- utc, not localtime. localtime is for Windows guests; a Linux guest that
       believes the hardware clock is local time drifts by your offset. -->
  <clock offset="utc"/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>

  <devices>
    <emulator>/usr/local/sbin/qemu</emulator>

    <!-- The disk. qcow2 so it grows rather than being claimed up front, and
         discard='unmap' so the file SHRINKS again when Docker prunes images —
         without it a sandbox only ever gets bigger. Make it 200G, not the
         64G a Docker sandbox got by with: the packages store lands here
         (/var/lib/builderbot/packages — the Android SDK's system images
         alone are tens of gigabytes, the JDK, Flutter and the Playwright
         browsers on top) unless provision-linux.sh points the stores at a share
         instead. The guest grows into it; the file only takes what is used. -->
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" cache="writeback" discard="unmap" io="threads"/>
      <source file="/mnt/user/domains/bb-sandbox/vdisk1.qcow2"/>
      <target dev="vda" bus="virtio"/>
      <boot order="2"/>
    </disk>

    <!-- The installer. The ONE line that differs per distribution: put the
         ISO you downloaded into /mnt/user/isos and name it here, install
         (headless, no desktop, ssh on — docs/sandbox-vm.md has the screens
         that matter), then delete this whole block so it stops booting from
         the ISO. The filenames as their projects publish them:
           ubuntu-26.04-live-server-amd64.iso          Ubuntu Server (tested)
           debian-13.x.x-amd64-netinst.iso             Debian
           Rocky-9-latest-x86_64-minimal.iso           Rocky Linux
           AlmaLinux-9-latest-x86_64-minimal.iso       AlmaLinux
           CentOS-Stream-10-latest-x86_64-boot.iso     CentOS Stream
           Fedora-Server-netinst-x86_64-*.iso          Fedora Server
           archlinux-x86_64.iso                        Arch (manual install)
           manjaro-*-minimal-*.iso, EndeavourOS_*.iso, cachyos-*.iso
           openSUSE-Leap-16.x-NET-x86_64-Media.iso     openSUSE Leap
           openSUSE-Tumbleweed-NET-x86_64-Current.iso  openSUSE Tumbleweed
           alpine-virt-3.x.x-x86_64.iso                Alpine (the virt image)
           void-live-x86_64-*-base.iso                 Void
           install-amd64-minimal-*.iso                 Gentoo (a long install)
         Mint, Pop!_OS and Kali are desktop images with a desktop the node
         never shows anyone; they work, but a server image of their parent
         is the better machine. Raspberry Pi OS is an ARM image and not an
         Unraid VM. Rocky 9 and its siblings need x86-64-v2, which any
         host that can run this VM has; host-passthrough below hands it on. -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/mnt/user/isos/ubuntu-26.04-live-server-amd64.iso"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
      <boot order="1"/>
    </disk>

    <!-- No virtiofs shares here on purpose. They belong in this file and
         they are the faster answer, but virtiofsd is a host-side daemon that
         can refuse to start ("internal error: virtiofsd died unexpectedly")
         for reasons that are about the host and not about this XML — a
         source directory that is not there, or shfs under /mnt/user not
         giving it the xattrs passthrough mode wants. A recipe whose first
         step can fail that way is a bad recipe.

         So the shares come in over NFS instead, which needs nothing on the
         host side and is what provision-linux.sh mounts with its "nfs" option. See
         docs/sandbox-vm.md for both, including how to put virtiofs back once
         the machine is up and you can read a log if it complains.

         Either way they land at the SAME paths BuilderBot uses. That is the
         point of the design: a compose file's bind source is resolved by
         whoever runs the container, so identical paths mean a relative bind
         is the same directory on both sides and nothing has to translate. -->

    <!-- br0 gives the VM its own LAN address, which is what makes a
         container's web UI reachable from your browser AND lets BuilderBot
         reach the daemon. It exists only if Settings -> Network Settings ->
         Enable bridging is on. If it is not, change this to virbr0 and reach
         web UIs through a port forward instead. -->
    <interface type="bridge">
      <!-- Replace with the MAC Unraid generated for your VM. This one is a
           placeholder: pasting it over yours changes the address the VM asks
           for a lease with, so a DHCP reservation stops applying and the IP
           you put in DOCKER_HOST moves out from under you. -->
      <mac address="52:54:00:46:d2:fb"/>
      <source bridge="br0"/>
      <model type="virtio-net"/>
    </interface>

    <controller type="usb" index="0" model="ich9-ehci1">
      <address type="pci" domain="0x0000" bus="0x00" slot="0x07" function="0x7"/>
    </controller>
    <controller type="usb" index="0" model="ich9-uhci1">
      <master startport="0"/>
      <address type="pci" domain="0x0000" bus="0x00" slot="0x07" function="0x0" multifunction="on"/>
    </controller>
    <controller type="usb" index="0" model="ich9-uhci2">
      <master startport="2"/>
      <address type="pci" domain="0x0000" bus="0x00" slot="0x07" function="0x1"/>
    </controller>
    <controller type="usb" index="0" model="ich9-uhci3">
      <master startport="4"/>
      <address type="pci" domain="0x0000" bus="0x00" slot="0x07" function="0x2"/>
    </controller>

    <input type="tablet" bus="usb"/>
    <input type="mouse" bus="ps2"/>
    <input type="keyboard" bus="ps2"/>

    <!-- Kept even though the machine is headless: it is the console for the
         day networking is broken and ssh will not answer. Nothing installs a
         desktop behind it. -->
    <graphics type="vnc" sharePolicy="ignore" port="-1" autoport="yes" websocket="-1" listen="0.0.0.0">
      <listen type="address" address="0.0.0.0"/>
    </graphics>
    <video>
      <model type="qxl" ram="65536" vram="16384" vgamem="16384" heads="1" primary="yes"/>
      <address type="pci" domain="0x0000" bus="0x00" slot="0x1e" function="0x0"/>
    </video>

    <audio id="1" type="none"/>
    <!-- A text console beside the VNC one, for `virsh console` from the
         Unraid shell the day ssh is what broke. -->
    <serial type="pty"><target port="0"/></serial>
    <console type="pty"><target type="serial" port="0"/></console>
    <!-- Entropy from the host. Without it a fresh guest can sit at boot
         waiting on the random pool before sshd and the agent's TLS start. -->
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
    <!-- The guest agent both provisioning paths install, so Unraid can shut
         this down cleanly rather than pulling the plug. -->
    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>
    <memballoon model="virtio">
      <alias name="balloon0"/>
    </memballoon>

    <!-- The GPU, when it moves here (roadmap R20): the emulator renders on
         the card instead of falling back to software. Both functions of the
         card go together — the video device and its audio function — and the
         BuilderBot container has to give the card up first (its NVIDIA_*
         settings off, then a restart), because a device is one guest's at a
         time. Find the addresses under Tools -> System Devices and bind them
         to VFIO there; then uncomment this with them filled in. The guest
         still needs the driver and the headless X server provision-linux.sh does
         not yet install — R20's remaining step — so leave this commented
         until it does.
    <hostdev mode="subsystem" type="pci" managed="yes">
      <source><address domain="0x0000" bus="0x0X" slot="0x00" function="0x0"/></source>
      <address type="pci" domain="0x0000" bus="0x05" slot="0x00" function="0x0" multifunction="on"/>
    </hostdev>
    <hostdev mode="subsystem" type="pci" managed="yes">
      <source><address domain="0x0000" bus="0x0X" slot="0x00" function="0x1"/></source>
      <address type="pci" domain="0x0000" bus="0x05" slot="0x00" function="0x1"/>
    </hostdev>
    -->
  </devices>
</domain>
